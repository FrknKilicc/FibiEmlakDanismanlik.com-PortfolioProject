{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "Serilog": {
    "MinimumLevel": { "Default": "Information", "Override": { "Microsoft": "Warning", "Microsoft.Hosting.Lifetime": "Information", "Microsoft.EntityFrameworkCore": "Warning", "System.Net.Http.HttpClient": "Warning" } },
    "WriteTo": [
      { "Name": "Console" },
      { "Name": "File", "Args": { "path": "logs/api-.log", "rollingInterval": "Day", "retainedFileCountLimit": 14, "fileSizeLimitBytes": 10485760, "rollOnFileSizeLimit": true, "outputTemplate": "{Timestamp:yyyy-MM-dd HH:mm:ss.fff zzz} [{Level:u3}] {SourceContext} {Message:lj}{NewLine}{Exception}" } }
    ]
  },

  "ConnectionStrings": {
    "DefaultConnection": ""
  },

  "Jwt": {
    "Issuer": "FibiEmlakDanismanlik.WebApi",
    "Audience": "FibiEmlakDanismanlik.Admin",
    "ExpireMinutes": 60
  },

  "Captcha": {
    "Enabled": true,
    "VerifyUrl": "https://challenges.cloudflare.com/turnstile/v0/siteverify"
  },

  "FibiMarketDataSync": {
    "Enabled": true,
    "IntervalHours": 12,
    "InitialDelaySeconds": 30,
    "EvdsBaseUrl": "https://evds2.tcmb.gov.tr/service/evds/",
    "UserAgentContact": "info@fibiemlak.com"
  },

  "FileStorage": {
    "RootPath": "",
    "PublicBaseUrl": ""
  }

}
