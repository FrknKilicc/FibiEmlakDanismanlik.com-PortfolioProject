#!/usr/bin/env bash
# Fibi Emlak: SSH'ta şifreyle girişi kapatır, yalnızca anahtarla girişe izin verir.
# Kullanım: sudo fibi-harden-ssh <kullanici>
#   <kullanici>: senin sunucuya girdiğin hesap (ör. root veya ubuntu).
#
# KİLİTLENMEMEK İÇİN: bu betik, o kullanıcı için bir SSH anahtarı tanımlı değilse hiçbir şey yapmaz.
# Çalıştırdıktan sonra mevcut oturumu KAPATMA; yeni bir pencereden anahtarla girebildiğini dene.
set -euo pipefail

ADMIN_USER="${1:-}"
[[ -n "$ADMIN_USER" ]] || { echo "Kullanım: sudo fibi-harden-ssh <kullanici>" >&2; exit 2; }
home_dir="$(getent passwd "$ADMIN_USER" | cut -d: -f6)"
[[ -n "$home_dir" ]] || { echo "Kullanıcı bulunamadı: $ADMIN_USER" >&2; exit 2; }

if ! grep -qE '^(ssh-ed25519|ssh-rsa|ecdsa-)' "$home_dir/.ssh/authorized_keys" 2>/dev/null; then
    echo "$ADMIN_USER için SSH anahtarı yok ($home_dir/.ssh/authorized_keys). Kilitlenmemek için durdum." >&2
    echo "Önce rehberdeki 'Bilgisayarından SSH anahtarı' adımını yap." >&2
    exit 3
fi

cat > /etc/ssh/sshd_config.d/10-fibi-hardening.conf <<'EOF'
PasswordAuthentication no
KbdInteractiveAuthentication no
PermitRootLogin prohibit-password
PubkeyAuthentication yes
MaxAuthTries 4
X11Forwarding no
EOF

sshd -t
systemctl reload ssh
echo "Tamam: şifreyle giriş kapatıldı. Bu pencereyi kapatmadan YENİ bir pencereden giriş yapmayı dene."
echo "Sorun olursa bu pencereden geri al: sudo rm /etc/ssh/sshd_config.d/10-fibi-hardening.conf && sudo systemctl reload ssh"
