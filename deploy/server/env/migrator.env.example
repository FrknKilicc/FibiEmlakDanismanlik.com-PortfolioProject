# /etc/fibi/migrator.env  (sahip root, izin 600). Yalnızca fibi-migrate ve fibi-backup kullanır; uygulamalar okumaz.
# Şema değiştirme yetkili hesap (db_ddladmin + okuma/yazma). Uygulama hesabından farklı, güçlü bir şifre kullan.
MIGRATOR_USER=fibiemlak_migrator
MIGRATOR_PASSWORD=<MIGRATOR_SIFRESI>
DB_NAME=fibiemlak.com
