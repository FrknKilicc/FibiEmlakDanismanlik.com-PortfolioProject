# /etc/fibi/api.env  (sahip root:fibi, izin 640). Bu dosya repoya GERÇEK değerlerle eklenmez.
# <...> ile işaretli değerleri doldur. Diğer satırlar kurulumla uyumludur, değiştirme.

# Veritabanı: uygulama hesabı yalnızca okuma/yazma yapar (şema değiştiremez)
ConnectionStrings__DefaultConnection=Server=127.0.0.1;Database=fibiemlak.com;User Id=fibiemlak_app;Password=<UYGULAMA_SIFRESI>;TrustServerCertificate=True;Encrypt=True

# JWT imzalama anahtarı: en az 64 karakter rastgele. Üretmek için: openssl rand -base64 64 | tr -d '\n'
Jwt__Key=<JWT_ANAHTARI>

# Cloudflare Turnstile (ücretsiz) gizli anahtarı. Boş kalırsa panel girişi çalışmaz (bilinçli olarak kapalı başarısız).
Captcha__TurnstileSecretKey=<TURNSTILE_SECRET_KEY>

# TCMB EVDS anahtarı (piyasa verisi). Yoksa boş bırak; senkronizasyon atlanır.
FibiMarketDataSync__EvdsApiKey=

# Dosya ve anahtar yolları (kurulum betiği bu klasörleri oluşturur)
FileStorage__RootPath=/var/lib/fibi/uploads
FileStorage__PublicBaseUrl=https://fibiemlak.com
DataProtection__KeysPath=/var/lib/fibi/dp-keys/api
Serilog__WriteTo__1__Args__path=/var/log/fibi/api-.log
AllowedHosts=*
