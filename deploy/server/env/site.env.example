# /etc/fibi/site.env  (sahip root:fibi, izin 640). Bu dosya repoya GERÇEK değerlerle eklenmez.

Url__ApiUrl=http://127.0.0.1:5000/api/
Seo__SiteBaseUrl=https://fibiemlak.com

# Cloudflare Turnstile: site anahtarı + gizli anahtar. İkisi de boşsa formlarda captcha gösterilmez (yalnızca hız sınırı çalışır).
Captcha__TurnstileSiteKey=<TURNSTILE_SITE_KEY>
Captcha__TurnstileSecretKey=<TURNSTILE_SECRET_KEY>
Captcha__ScriptUrl=https://challenges.cloudflare.com/turnstile/v0/api.js
Captcha__VerifyUrl=https://challenges.cloudflare.com/turnstile/v0/siteverify

Serilog__WriteTo__1__Args__path=/var/log/fibi/site-.log
# yeni.fibiemlak.com: DNS geçişinden önceki deneme adresi; geçişten sonra silinebilir
AllowedHosts=fibiemlak.com;www.fibiemlak.com;yeni.fibiemlak.com;localhost;127.0.0.1
