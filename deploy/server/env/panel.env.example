# /etc/fibi/panel.env  (sahip root:fibi, izin 640). Bu dosya repoya GERÇEK değerlerle eklenmez.

Url__ApiUrl=http://127.0.0.1:5000/api/
Url__SiteUrl=https://fibiemlak.com

# Cloudflare Turnstile site anahtarı (doğrulamayı WebApi yapar)
Captcha__Enabled=true
Captcha__TurnstileSiteKey=<TURNSTILE_SITE_KEY>

DataProtection__KeysPath=/var/lib/fibi/dp-keys/panel
Serilog__WriteTo__1__Args__path=/var/log/fibi/panel-.log
AllowedHosts=panel.fibiemlak.com;localhost;127.0.0.1
