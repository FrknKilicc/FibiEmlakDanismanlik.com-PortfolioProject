@model FibiEmlakDanismanlik.WebUI.Models.FibiServices.FibiServicePageVm

<!-- Sayfa Başlığı ve Breadcrumb -->
<section class="page-title centred" style="background-image: url(/Realshed/assets/images/background/skyscrapers-pageBanner.jpg);">
    <div class="auto-container">
        <div class="content-box clearfix">
            <h1>@Model.Active.Title</h1>
            <ul class="bread-crumb clearfix">
                <li><a href="@Url.Action("Index", "UILayout")">Anasayfa</a></li>
                <li><a href="@Url.Action("Index", "FibiServices")">FİBİ Hizmetler</a></li>
                <li>@Model.Active.Title</li>
            </ul>
        </div>
    </div>
</section>

<!-- FİBİ Hizmetler Navigasyon Barı -->
<section id="fibiServiceRoot" class="fibi-service-nav-section" data-api="@Model.ApiUrl" data-module-id="@Model.Active.ModuleId">
    <div class="auto-container">
        <ul class="fibi-service-nav">
            @foreach (var item in Model.Items)
            {
                var isActive = string.Equals(item.Key, Model.Active.Key, StringComparison.OrdinalIgnoreCase);
                <li>
                    <a href="@Url.Action(item.ActionName, "FibiServices")" class="@(isActive ? "is-active" : "")" @(isActive ? "aria-current=\"page\"" : "")>
                        <i class="@item.IconClass"></i>
                        <span class="fibi-nav-title">
                            @item.Title
                            @if (!item.IsAvailable)
                            {
                                <span class="fibi-soon-badge">Yakında</span>
                            }
                        </span>
                        <span class="fibi-nav-desc">@item.ShortDescription</span>
                    </a>
                </li>
            }
        </ul>
    </div>
</section>
