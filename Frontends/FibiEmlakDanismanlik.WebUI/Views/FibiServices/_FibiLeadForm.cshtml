@model FibiEmlakDanismanlik.WebUI.Models.FibiServices.FibiServicePageVm

<!-- Ortak Lead Formu (Analiz tamamlandığında dinamik olarak gösterilir) -->
<section id="fibiLeadSection" class="fibi-lead-section" hidden>
    <div class="auto-container">
        <div class="fibi-panel fibi-lead-panel">
            <div class="sec-title centred">
                <h5>Uzman Danışmanlık</h5>
                <h2>Ücretsiz Detaylı Uzman Raporu / Yerinde Ekspertiz Talep Edin</h2>
                <p>Analiz özetiniz talebinize otomatik eklenir; uzmanımız sizi arayarak mülkünüze özel değerlendirme yapar.</p>
            </div>
            <form id="fibiLeadForm" class="default-form" novalidate>
                <div class="row clearfix">
                    <div class="col-lg-4 col-md-6 col-sm-12 form-group">
                        <label for="leadFullName">Ad Soyad <span class="text-danger">*</span></label>
                        <input type="text" id="leadFullName" name="fullName" placeholder="Adınız Soyadınız" maxlength="150" required>
                    </div>
                    <div class="col-lg-4 col-md-6 col-sm-12 form-group">
                        <label for="leadPhoneNumber">Telefon <span class="text-danger">*</span></label>
                        <input type="tel" id="leadPhoneNumber" name="phoneNumber" placeholder="05xx xxx xx xx" maxlength="20" required>
                    </div>
                    <div class="col-lg-4 col-md-12 col-sm-12 form-group">
                        <label for="leadEmail">E-posta</label>
                        <input type="email" id="leadEmail" name="email" placeholder="ornek@eposta.com" maxlength="150">
                    </div>
                    <div class="col-lg-12 col-md-12 col-sm-12 form-group">
                        <label for="leadCustomerNote">Notunuz</label>
                        <textarea id="leadCustomerNote" name="customerNote" placeholder="Mülkünüz veya talebinizle ilgili eklemek istediğiniz detaylar..." maxlength="1000" rows="3"></textarea>
                    </div>
                    <div class="col-lg-12 col-md-12 col-sm-12 form-group">
                        <div class="fibi-checkbox-group">
                            <label class="fibi-checkbox-label" for="leadKvkkConsent">
                                <input type="checkbox" id="leadKvkkConsent" name="kvkkConsent" required>
                                <span><a href="/gizlilik-politikasi" target="_blank">Gizlilik Politikası</a> ve <a href="/kvkk-aydinlatma-metni" target="_blank">KVKK Aydınlatma Metni</a>'ni okudum, kişisel verilerimin talebimle ilgili iletişim amacıyla işlenmesini kabul ediyorum.</span>
                            </label>
                        </div>
                    </div>
                    <div class="col-lg-12 col-md-12 col-sm-12 form-group text-center">
                        <button type="submit" id="leadSubmitBtn" class="theme-btn btn-one">Talebimi Gönder</button>
                    </div>
                </div>
            </form>
        </div>
    </div>
</section>
