@model FibiEmlakDanismanlik.WebUI.Models.ListingsMap.ListingsMapPageVm
@{
    ViewData["Title"] = "Haritada İlanlar";
    Layout = "~/Views/ThemeScaff/ScaffTemplate.cshtml";
}

@section Styles {
    <link rel="stylesheet" href="~/lib/leaflet/leaflet.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/lib/leaflet.markercluster/MarkerCluster.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/lib/leaflet.markercluster/MarkerCluster.Default.css" asp-append-version="true" />
    <link rel="stylesheet" href="/css/leaflet-markers.css" />
    <link rel="stylesheet" href="~/css/listings-map.css" asp-append-version="true" />
}

<!-- Sayfa Başlığı ve Breadcrumb -->
<section class="page-title centred" style="background-image: url(/Realshed/assets/images/background/skyscrapers-pageBanner.jpg);">
    <div class="auto-container">
        <div class="content-box clearfix">
            <h1>Haritada İlanlar</h1>
            <ul class="bread-crumb clearfix">
                <li><a href="@Url.Action("Index", "UILayout")">Anasayfa</a></li>
                <li><a href="@Url.Action("Index", "AllForSalePage")">İlanlar</a></li>
                <li>Haritada İlanlar</li>
            </ul>
        </div>
    </div>
</section>

<!-- Haritada İlanlar Bölümü -->
<section class="listings-map-section">
    <div class="auto-container">
        <div id="listingsMapRoot"
             data-api="@Model.ApiUrl"
             data-initial-usage="@Model.InitialUsage"
             data-initial-category="@Model.InitialCategory">

            <!-- Filtre Çubuğu -->
            <div class="lm-toolbar">
                <!-- Kullanım Grubu (Tümü / Satılık / Kiralık) -->
                <div class="lm-group lm-group--usage" role="group" aria-label="İlan Türü">
                    <button type="button"
                            class="lm-btn @(string.IsNullOrEmpty(Model.InitialUsage) ? "is-active" : "")"
                            data-usage=""
                            aria-pressed="@(string.IsNullOrEmpty(Model.InitialUsage) ? "true" : "false")">
                        Tümü
                    </button>
                    <button type="button"
                            class="lm-btn @(Model.InitialUsage == "sale" ? "is-active" : "")"
                            data-usage="sale"
                            aria-pressed="@(Model.InitialUsage == "sale" ? "true" : "false")">
                        Satılık
                    </button>
                    <button type="button"
                            class="lm-btn @(Model.InitialUsage == "rent" ? "is-active" : "")"
                            data-usage="rent"
                            aria-pressed="@(Model.InitialUsage == "rent" ? "true" : "false")">
                        Kiralık
                    </button>
                </div>

                <!-- Kategori Grubu (Tümü / Konut / Arsa / İşyeri) -->
                <div class="lm-group lm-group--category" role="group" aria-label="Kategori">
                    <button type="button"
                            class="lm-btn @(string.IsNullOrEmpty(Model.InitialCategory) ? "is-active" : "")"
                            data-category=""
                            aria-pressed="@(string.IsNullOrEmpty(Model.InitialCategory) ? "true" : "false")">
                        Tümü
                    </button>
                    <button type="button"
                            class="lm-btn @(Model.InitialCategory == "housing" ? "is-active" : "")"
                            data-category="housing"
                            aria-pressed="@(Model.InitialCategory == "housing" ? "true" : "false")">
                        Konut
                    </button>
                    <button type="button"
                            class="lm-btn @(Model.InitialCategory == "land" ? "is-active" : "")"
                            data-category="land"
                            aria-pressed="@(Model.InitialCategory == "land" ? "true" : "false")">
                        Arsa
                    </button>
                    <button type="button"
                            class="lm-btn @(Model.InitialCategory == "commercial" ? "is-active" : "")"
                            data-category="commercial"
                            aria-pressed="@(Model.InitialCategory == "commercial" ? "true" : "false")">
                        İşyeri
                    </button>
                </div>

                <!-- İl Filtresi -->
                <div class="lm-city-wrapper">
                    <select id="lmCity" class="ignore" aria-label="İl Seçimi">
                        <option value="">Tüm İller</option>
                    </select>
                    <select id="lmDistrict" class="ignore" aria-label="İlçe Seçimi" disabled>
                        <option value="">Tüm İlçeler</option>
                    </select>
                </div>

                <!-- Haritada Görünen / Toplam İlan Sayacı -->
                <span id="lmCount">Yükleniyor...</span>
            </div>

            <!-- İçerik: Solda Harita, Sağda İlan Listesi -->
            <div class="lm-body">
                <div id="lmMap" class="lm-map"></div>
                <aside class="lm-list">
                    <div id="lmList"></div>
                </aside>
            </div>

            <!-- Lejant -->
            <div class="lm-legend">
                <div class="lm-legend-item">
                    <span class="lm-legend-dot lm-legend-dot--sale"></span>
                    <span>Satılık</span>
                </div>
                <div class="lm-legend-item">
                    <span class="lm-legend-dot lm-legend-dot--rent"></span>
                    <span>Kiralık</span>
                </div>
                <div class="lm-legend-item">
                    <span class="lm-legend-dot lm-legend-dot--approx"></span>
                    <span>Yaklaşık konum (mahalle/ilçe merkezi)</span>
                </div>
            </div>

        </div>
    </div>
</section>

@section Scripts {
    <script src="~/lib/leaflet/leaflet.js" asp-append-version="true"></script>
    <script src="~/lib/leaflet.markercluster/leaflet.markercluster.js" asp-append-version="true"></script>
    <script src="~/js/listings-map.js" asp-append-version="true"></script>
}
