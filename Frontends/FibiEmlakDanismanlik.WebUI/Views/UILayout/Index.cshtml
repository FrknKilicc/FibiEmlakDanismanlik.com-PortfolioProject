@{
    Layout = null;
}
<!DOCTYPE html>
<html lang="en">
<head>
    @await Component.InvokeAsync("_HeadLayoutViewComponentPartial")
</head>
<!-- page wrapper -->
<body>

    <div class="boxed_wrapper">
        <!-- switcher menu -->
        <div class="switcher">
            <div class="switch_btn">
                <button><i class="fas fa-palette"></i></button>
            </div>
            <div class="switch_menu">
                <!-- color changer -->
                <div class="switcher_container">
                    <ul id="styleOptions" title="switch styling">
                        <li>
                            <a href="javascript: void(0)" data-theme="green" class="green-color"></a>
                        </li>
                        <li>
                            <a href="javascript: void(0)" data-theme="pink" class="pink-color"></a>
                        </li>
                        <li>
                            <a href="javascript: void(0)" data-theme="violet" class="violet-color"></a>
                        </li>
                        <li>
                            <a href="javascript: void(0)" data-theme="crimson" class="crimson-color"></a>
                        </li>
                        <li>
                            <a href="javascript: void(0)" data-theme="orange" class="orange-color"></a>
                        </li>
                    </ul>
                </div> 
            </div>
        </div>
        <!-- end switcher menu -->


        <!-- main header -->
        @await Component.InvokeAsync("_HeaderLayoutViewComponentPartial")
        <!-- main-header end -->

        <!-- Mobile Menu  -->
        <div class="mobile-menu">
            <div class="menu-backdrop"></div>
            <div class="close-btn"><i class="fas fa-times"></i></div>
            
            <nav class="menu-box">
                <div class="nav-logo">
                    <a href="@Url.Action("Index", "UILayout")">
                        <img src="/Realshed/assets/images/FibiLogo.png" alt="Fibi Emlak">
                    </a>
                </div>
                <div class="menu-outer"><!--Here Menu Will Come Automatically Via Javascript / Same Menu as in Header--></div>
                <div class="contact-info">
                    <h4>İletişim Bilgisi</h4>
                    <ul>
                        <li>Telsih Mahallesi - Zeytinburnu | İstanbul</li>
                        <li><a href="tel:+8801682648101">+88 01682648101</a></li>
                        <li><a href="mailto:info@example.com">info@fibiemlak.com</a></li>
                    </ul>
                </div>
                <div class="social-links">
                    <ul class="clearfix">
                        <li><a href="/Realshed/index.html"><span class="fab fa-twitter"></span></a></li>
                        <li><a href="/Realshed/index.html"><span class="fab fa-facebook-square"></span></a></li>
                        <li><a href="/Realshed/index.html"><span class="fab fa-pinterest-p"></span></a></li>
                        <li><a href="/Realshed/index.html"><span class="fab fa-instagram"></span></a></li>
                        <li><a href="/Realshed/index.html"><span class="fab fa-youtube"></span></a></li>
                    </ul>
                </div>
            </nav>
        </div>
        
        <!-- End Mobile Menu -->


        <!-- banner-style-two -->
        @await Component.InvokeAsync("_MainBannerViewComponentPartial")
        <!-- banner-style-two end -->


        <!-- search-field-section -->
        @await Component.InvokeAsync("_SearchFieldSectionComponentPartial") @* Kirala  ve satın al *@
        <!-- search-field-section end -->


        <!-- feature-style-two -->
     @*   <div id="props">

       </div>  *@
        @await Component.InvokeAsync("_FeaturedPropertViewComponentPartial")  @* anasayfa  ilan widget *@

       

        <!-- feature-style-two end -->


        <!-- cta-section -->
        @await Component.InvokeAsync("_CtaSectionViewComponentPartial")
        <!-- cta-section end -->


        <!-- deals-style-two -->
        @await Component.InvokeAsync("_TheHotPropertyViewComponentPartial") @* Özel Teklifler*@
        <!-- deals-style-two end -->


        <!-- chooseus-section -->
        @await Component.InvokeAsync("_ChooseUsSectionViewComponentPartial") @* Neden Biz *@
        <!-- chooseus-section end -->


        <!-- team-section -->
        @await Component.InvokeAsync("_MeetOurAgentsViewComponentPartial") @* Çalışanlar *@
        <!-- team-section end -->


        <!-- testimonial-style-two -->
        @await Component.InvokeAsync("_HomeTestimonialsViewComponentPartial") @* Yorumlar *@
        <!-- testimonial-style-two end -->


        <!-- place-style-two -->
        @await Component.InvokeAsync("_MostPopularPlacesViewComponentPartial") @* popüler konumlar *@
        <!-- place-style-two end -->


        <!-- clients-section -->
        @await Component.InvokeAsync("_OurPartnersViewComponentPartial") @* Partnerlerimiz *@
        <!-- clients-section end -->


        <!-- news-section -->
        @await Component.InvokeAsync("_GetLast3BlogWithAuthorViewComponentPartial", new { viewName = "HomeNews" })
        <!-- news-section end -->


        <!-- subscribe-section -->
        <section class="subscribe-section bg-color-3">
            <div class="pattern-layer" style="background-image: url(/Realshed/assets/images/shape/shape-2.png);"></div>
            <div class="auto-container">
                <div class="row clearfix">
                    <div class="col-lg-6 col-md-6 col-sm-12 text-column">
                        <div class="text">
                            <span>Subscribe</span>
                            <h2>Sign Up To Our Newsletter To Get The Latest News And Offers.</h2>
                        </div>
                    </div>
                    <div class="col-lg-6 col-md-6 col-sm-12 form-column">
                        <div class="form-inner">
                            <form action="contact.html" method="post" class="subscribe-form">
                                <div class="form-group">
                                    <input type="email" name="email" placeholder="Enter your email" required="">
                                    <button type="submit">Subscribe Now</button>
                                </div>
                            </form>
                        </div>
                    </div>
                </div>
            </div>
        </section>
        <!-- subscribe-section end -->

        <!-- main-footer -->
        @await Component.InvokeAsync("_FooterLayoutViewComponentPartial")  @*footer *@
        <!-- main-footer end -->

        <!--Scroll to top-->
        <button class="scroll-top scroll-to-target" data-target="html">
            <span class="fal fa-angle-up"></span>
        </button>
    </div>

    <script src="/Realshed/assets/js/jquery.js"></script>
    <script src="/Realshed/assets/js/popper.min.js"></script>
    <script src="/Realshed/assets/js/bootstrap.min.js"></script>
    <script src="/Realshed/assets/js/owl.js"></script>
    <script src="/Realshed/assets/js/wow.js"></script>
    <script src="/Realshed/assets/js/scrollbar.js"></script>
    <script src="/Realshed/assets/js/jquery.nice-select.min.js"></script>
    <script src="/Realshed/assets/js/jQuery.style.switcher.min.js"></script>
    <script src="/Realshed/assets/js/jquery-ui.js"></script>
    <script src="/Realshed/assets/js/jquery.paroller.min.js"></script>
    <script src="/Realshed/assets/js/nav-tool.js"></script>
    <script src="/Realshed/assets/js/script.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/select2@4.1.0-rc.0/dist/js/select2.min.js"></script>
    <script src="~/js/home-search.js" asp-append-version="true"></script>
    <script src="~/js/best-deals.js" asp-append-version="true"></script>
    <script src="~/js/popular-places.js" asp-append-version="true"></script>

    <script>
        if ("scrollRestoration" in history) {
            history.scrollRestoration = "manual";
        }

        $(window).on("load", function () {
            setTimeout(function () {
                window.scrollTo(0, 0);
            }, 0);
        });
    </script>
</body>
</html>

