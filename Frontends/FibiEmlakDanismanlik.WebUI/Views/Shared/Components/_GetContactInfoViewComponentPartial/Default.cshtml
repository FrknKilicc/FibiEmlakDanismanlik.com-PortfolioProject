@using FibiEmlakDanismanlik.WebUI.Models
@model List<ResultContactDto>

<!--Page Title-->
<section class="page-title centred" style="background-image: url(/images/page-title/page-title-bg.jpg);">
    <div class="auto-container">
        <div class="content-box clearfix">
            <h1>İletişim</h1>
            <ul class="bread-crumb clearfix">
                <li><a href="@Url.Action("Index","UILayout")">Anasayfa</a></li>
                <li>İletişim</li>
            </ul>
        </div>
    </div>
</section>
<!--End Page Title-->
<!-- contact-info-section -->
<section class="contact-info-section sec-pad centred">
    <div class="auto-container">
        <div class="sec-title">
            <h5>Bizimle İletişime geç</h5>
            <h2>İletişim Adresleri</h2>
        </div>
        @foreach (var item in Model ?? new List<ResultContactDto>())
        {
            var hasEmail1 = !string.IsNullOrWhiteSpace(item.EMail1);
            var hasEmail2 = !string.IsNullOrWhiteSpace(item.EMail2);
            var email1 = (item.EMail1 ?? string.Empty).Trim().ToLowerInvariant();
            var email2 = (item.EMail2 ?? string.Empty).Trim().ToLowerInvariant();

            var p1 = PhoneFormatter.Format(item.PhoneNumber1);
            var p2 = PhoneFormatter.Format(item.PhoneNumber2);
            var hasPhone1 = !string.IsNullOrWhiteSpace(p1.Display);
            var hasPhone2 = !string.IsNullOrWhiteSpace(p2.Display);

            <div class="row clearfix">
                <div class="col-lg-4 col-md-6 col-sm-12 info-block">
                    <div class="info-block-one">
                        <div class="inner-box">
                            <div class="icon-box"><i class="icon-32"></i></div>
                            <h4>E-posta</h4>
                            <p>
                                @if (hasEmail1)
                                {
                                    <a href="mailto:@email1">@item.EMail1</a>
                                }
                                @if (hasEmail1 && hasEmail2)
                                {
                                    <br />
                                }
                                @if (hasEmail2)
                                {
                                    <a href="mailto:@email2">@item.EMail2</a>
                                }
                            </p>
                        </div>
                    </div>
                </div>
                <div class="col-lg-4 col-md-6 col-sm-12 info-block">
                    <div class="info-block-one">
                        <div class="inner-box">
                            <div class="icon-box"><i class="icon-33"></i></div>
                            <h4>Telefon</h4>
                            <p>
                                @if (hasPhone1)
                                {
                                    <a href="@p1.Href">@p1.Display</a>
                                }
                                @if (hasPhone1 && hasPhone2)
                                {
                                    <br />
                                }
                                @if (hasPhone2)
                                {
                                    <a href="@p2.Href">@p2.Display</a>
                                }
                            </p>
                        </div>
                    </div>
                </div>
                <div class="col-lg-4 col-md-6 col-sm-12 info-block">
                    <div class="info-block-one">
                        <div class="inner-box" style="height:344px;">
                            <div class="icon-box"><i class="icon-34"></i></div>
                            <h4>Ofis Adresi</h4>
                            <p>@item.OfficeAddress <br />Türkiye</p>
                        </div>
                    </div>
                </div>
            </div>
        }
    </div>
</section>
<!-- contact-info-section end -->
