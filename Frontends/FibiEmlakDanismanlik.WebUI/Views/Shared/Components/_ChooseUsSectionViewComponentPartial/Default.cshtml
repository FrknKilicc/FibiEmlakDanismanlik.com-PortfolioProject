@inject FibiEmlakDanismanlik.WebUI.Services.SiteTextService SiteTextService
@{
    var texts = await SiteTextService.GetAsync();
    var cards = new[]
    {
        (Icon: "icon-19", N: 1),
        (Icon: "icon-26", N: 2),
        (Icon: "icon-21", N: 3)
    };
}
<section class="chooseus-section alternate-2 bg-color-1">
    <div class="auto-container">
        <div class="upper-box clearfix">
            <div class="sec-title">
                <h5>@texts["home.chooseus.eyebrow"]</h5>
                <h2>@texts["home.chooseus.title"]</h2>
            </div>
            <div class="btn-box">
            </div>
        </div>
        <div class="lower-box">
            <div class="row clearfix">
                @foreach (var card in cards)
                {
                    <div class="col-lg-4 col-md-6 col-sm-12 chooseus-block">
                        <div class="chooseus-block-one">
                            <div class="inner-box">
                                <div class="icon-box"><i class="@card.Icon"></i></div>
                                <h4>@texts[$"home.chooseus.card{card.N}.title"]</h4>
                                <p>@texts[$"home.chooseus.card{card.N}.text"]</p>
                            </div>
                        </div>
                    </div>
                }
            </div>
        </div>
    </div>
</section>
