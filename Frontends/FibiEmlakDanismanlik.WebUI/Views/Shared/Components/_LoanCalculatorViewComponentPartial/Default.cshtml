@using System.Globalization
@model FibiEmlakDanismanlik.WebUI.Models.LoanCalculatorVm

@if (Model != null && Model.Rates != null && Model.Rates.Any())
{
    var trCulture = new CultureInfo("tr-TR");
    var invCulture = CultureInfo.InvariantCulture;
    var orderedRates = Model.Rates.OrderBy(r => Model.IsHousing ? r.HousingLoanMonthlyRate : r.CommercialLoanMonthlyRate).ToList();
    var firstRate = orderedRates.First();
    var maxAllowedTerm = firstRate.MaxTermMonths > 0 ? firstRate.MaxTermMonths : 120;
    int[] availableTerms = { 12, 24, 36, 48, 60, 120 };
    var defaultSelectedTerm = availableTerms.Where(t => t <= maxAllowedTerm).DefaultIfEmpty(maxAllowedTerm).Max();
    var latestUpdatedDate = Model.Rates.Max(r => r.UpdatedDate).ToString("dd.MM.yyyy");
    var defaultDownPaymentAmount = Math.Round(Model.Price * 0.30m);

    <div class="loan-calculator sidebar-widget"
         data-price="@Model.Price.ToString(invCulture)"
         data-kind="@(Model.IsHousing ? "konut" : "ticari")">
        <div class="widget-title">
            <h5>Kredi Hesaplama</h5>
        </div>
        <div class="widget-content">
            <div class="form-group">
                <label for="loanBankSelect">Banka</label>
                <select id="loanBankSelect" class="loan-select loan-calc-bank ignore">
                    @for (int i = 0; i < orderedRates.Count; i++)
                    {
                        var rateItem = orderedRates[i];
                        var rateVal = Model.IsHousing ? rateItem.HousingLoanMonthlyRate : rateItem.CommercialLoanMonthlyRate;
                        var isSelected = i == 0;
                        <option value="@rateItem.BankLoanRateId"
                                data-rate="@rateVal.ToString(invCulture)"
                                data-max-term="@rateItem.MaxTermMonths"
                                data-fee="@rateItem.AllocationFeeRate.ToString(invCulture)"
                                selected="@(isSelected ? "selected" : null)">
                            @rateItem.BankName (%@rateVal.ToString("0.00", trCulture))
                        </option>
                    }
                </select>
            </div>

            <div class="form-group">
                <div class="down-payment-header">
                    <label for="loanDownPaymentRange">Peşinat Oranı</label>
                    <span class="down-payment-badge">
                        %<span class="loan-calc-downpayment-percent">30</span>
                        (<span class="loan-calc-downpayment-amount">@defaultDownPaymentAmount.ToString("N0", trCulture) TL</span>)
                    </span>
                </div>
                <input type="range"
                       id="loanDownPaymentRange"
                       class="loan-range loan-calc-downpayment-range"
                       min="10"
                       max="90"
                       step="5"
                       value="30" />
                <div class="range-limits">
                    <span>%10</span>
                    <span>%90</span>
                </div>
            </div>

            <div class="form-group">
                <label for="loanTermSelect">Vade</label>
                <select id="loanTermSelect" class="loan-select loan-calc-term ignore">
                    @foreach (var term in availableTerms)
                    {
                        var isDisabled = term > maxAllowedTerm;
                        var isSelected = term == defaultSelectedTerm;
                        <option value="@term"
                                disabled="@(isDisabled ? "disabled" : null)"
                                selected="@(isSelected ? "selected" : null)">
                            @term Ay
                        </option>
                    }
                </select>
            </div>

            <div class="loan-results-box">
                <div class="result-item">
                    <span class="result-label">Kredi Tutarı</span>
                    <span class="result-value loan-calc-amount">-</span>
                </div>
                <div class="result-item highlight">
                    <span class="result-label">Aylık Taksit</span>
                    <span class="result-value loan-calc-monthly-installment">-</span>
                </div>
                <div class="result-item">
                    <span class="result-label">Toplam Geri Ödeme</span>
                    <span class="result-value loan-calc-total-payment">-</span>
                </div>
                <div class="result-item">
                    <span class="result-label">Toplam Faiz</span>
                    <span class="result-value loan-calc-total-interest">-</span>
                </div>
                <div class="result-item">
                    <span class="result-label">Kredi Tahsis Ücreti</span>
                    <span class="result-value loan-calc-allocation-fee">-</span>
                </div>
            </div>

            <p class="loan-disclaimer">
                <i class="fas fa-info-circle"></i>
                @(Model.IsHousing ? "Konut kredisi oranı kullanılır." : "İşyeri ve arsa için ticari kredi oranı kullanılır.")
                Oranlar tahminidir (@latestUpdatedDate), bağlayıcı değildir; vergi, sigorta ve ekspertiz masrafları dahil değildir. Kesin oran için bankanıza danışın.@if (!string.IsNullOrWhiteSpace(firstRate.DataSource)) { <text> Kaynak: @firstRate.DataSource</text> }
            </p>
        </div>
    </div>
}
