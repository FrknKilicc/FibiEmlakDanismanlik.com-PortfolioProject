@model List<ResultAgentDto>
@inject FibiEmlakDanismanlik.WebUI.Services.SiteTextService SiteTextService
@{
    var texts = await SiteTextService.GetAsync();
}
<section class="team-section sec-pad centred">
    <div class="auto-container">
        <div class="sec-title">
            <h5>@texts["home.agents.eyebrow"]</h5>
            <h2>@texts["home.agents.title"]</h2>
        </div>
        <div class="three-item-carousel owl-carousel owl-theme owl-nav-none dots-style-one agent-carousel">
            @foreach (var item in Model)
            {
                <div class="team-block-one">
                    <div class="inner-box">
                        <figure class="image-box"><img src="@item.AgentImgUrl" alt="@item.AgentName"></figure>
                        <div class="lower-content">
                            <div class="inner">
                                <h4><a href="@Url.Action("Index", "Agent")">@item.AgentName</a></h4>
                                <span class="designation">@item.AgentTitle</span>
                            </div>
                        </div>
                    </div>
                </div>
            }
        </div>
    </div>
</section>