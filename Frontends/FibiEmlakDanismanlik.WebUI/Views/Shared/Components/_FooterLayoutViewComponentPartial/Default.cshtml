@model FibiEmlakDanismanlik.WebUI.Models.Footer.FooterViewModel
<footer class="main-footer">
    <div class="footer-top bg-color-2">
        <div class="auto-container">
            <div class="row clearfix">
                <div class="col-lg-3 col-md-6 col-sm-12 footer-column">
                    <div class="footer-widget about-widget">
                        <div class="widget-title">
                            <h3>@Model.AboutTitle</h3>
                        </div>
                        <div class="text">
                            @if (!string.IsNullOrWhiteSpace(Model.AboutSummary))
                            {
                                <p>@Model.AboutSummary</p>
                            }
                            <a href="@Url.Action("Index","AboutUs")" class="fibi-footer-more">Devamını Oku <i class="fas fa-angle-right"></i></a>
                        </div>
                        @if (Model.SocialMedias.Any())
                        {
                            <ul class="fibi-footer-social">
                                @foreach (var item in Model.SocialMedias)
                                {
                                    <li><a href="@item.Url" target="_blank" rel="noopener" title="@item.Name" aria-label="@item.Name"><i class="@item.Icon"></i></a></li>
                                }
                            </ul>
                        }
                    </div>
                </div>
                <div class="col-lg-3 col-md-6 col-sm-12 footer-column">
                    <div class="footer-widget links-widget ml-70">
                        <div class="widget-title">
                            <h3>Sayfalar</h3>
                        </div>
                        <div class="widget-content">
                            <ul class="links-list class">
                                <li><a href="@Url.Action("Index","AboutUs")">Hakkımızda</a></li>
                                <li><a href="@Url.Action("Index","AllForSalePage")">Satılık İlanlar</a></li>
                                <li><a href="@Url.Action("Index","AllForRentalPage")">Kiralık İlanlar</a></li>
                                <li><a href="@Url.Action("Index","FibiServices")">FİBİ Hizmetler</a></li>
                                <li><a href="@Url.Action("Index","Blog")">Blog</a></li>
                                <li><a href="@Url.Action("Index","FrequentlyAskedQuestion")">Sıkça Sorulan Sorular</a></li>
                                <li><a href="@Url.Action("Index","Contact")">İletişim</a></li>
                            </ul>
                        </div>
                    </div>
                </div>
                <div class="col-lg-3 col-md-6 col-sm-12 footer-column">
                    <div class="footer-widget post-widget">
                        <div class="widget-title">
                            <h3>En Son Haberler</h3>
                        </div>
                        <div class="post-inner">
                            @if (!Model.LatestBlogs.Any())
                            {
                                <p>Henüz haber eklenmedi.</p>
                            }
                            else
                            {
                                foreach (var item in Model.LatestBlogs)
                                {
                                    <div class="post">
                                        <figure class="post-thumb"><a href="@BlogUrl.DetailPath(item.BlogId, item.BlogTitle)"><img src="@item.BlogImgUrl" alt="@item.BlogTitle" width="90" height="90" loading="lazy" style="object-fit:cover;" onerror="this.onerror=null;this.src='/Realshed/assets/images/FibiLogo-footer.png';"></a></figure>
                                        <h5><a href="@BlogUrl.DetailPath(item.BlogId, item.BlogTitle)">@item.BlogTitle</a></h5>
                                        <p>@item.CreatedDate.ToString("dd MMMM yyyy", new System.Globalization.CultureInfo("tr-TR"))</p>
                                    </div>
                                }
                            }
                        </div>
                    </div>
                </div>
                <div class="col-lg-3 col-md-6 col-sm-12 footer-column">
                    <div class="footer-widget contact-widget">
                        <div class="widget-title">
                            <h3>İletişim</h3>
                        </div>
                        <div class="widget-content">
                            @if (Model.Contact == null)
                            {
                                <p>İletişim bilgileri yüklenemedi.</p>
                            }
                            else
                            {
                                var email = Model.Contact.EMail1?.ToLowerInvariant() ?? "";
                                <ul class="info-list clearfix">
                                    @if (!string.IsNullOrWhiteSpace(Model.Contact.OfficeAddress))
                                    {
                                        <li><i class="fas fa-map-marker-alt"></i> @Model.Contact.OfficeAddress</li>
                                    }
                                    @if (!string.IsNullOrWhiteSpace(Model.PhoneDisplay))
                                    {
                                        <li><i class="fas fa-phone"></i><a href="@Model.PhoneHref">@Model.PhoneDisplay</a></li>
                                    }
                                    @if (!string.IsNullOrWhiteSpace(email))
                                    {
                                        <li><i class="fas fa-envelope"></i><a href="mailto:@email">@email</a></li>
                                    }
                                </ul>
                            }
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
    <style>
        .footer-bottom .footer-logo .fibi-footer-logo { display: block; height: 64px; width: auto; background: #fff; padding: 6px 16px; border-radius: 14px; box-shadow: 0 4px 14px rgba(0,0,0,0.25); }
        @@media (max-width: 767px) {
            .footer-bottom .footer-logo .fibi-footer-logo { height: 54px; padding: 5px 12px; }
        }
        .footer-top a.fibi-footer-more { display: inline-block; margin-top: 6px; color: #2dbe6c; font-weight: 600; font-size: 14px; }
        .footer-top a.fibi-footer-more:hover { color: #fff; }
        .footer-top .post-widget .post .post-thumb { overflow: hidden; }
        .footer-top .post-widget .post .post-thumb img { width: 90px; height: 90px; object-fit: cover; display: block; }
        .fibi-footer-social { list-style: none; padding: 0; margin: 22px 0 0; display: flex; gap: 10px; flex-wrap: wrap; }
        .fibi-footer-social a { display: inline-flex; width: 38px; height: 38px; align-items: center; justify-content: center; border-radius: 50%; background: rgba(255,255,255,0.08); color: rgba(255,255,255,0.7); transition: all 0.3s ease; }
        .fibi-footer-social a:hover { background: #2dbe6c; color: #fff; }
    </style>
    <div class="footer-bottom">
        <div class="auto-container">
            <div class="inner-box clearfix">
                <figure class="footer-logo"><a href="@Url.Action("Index", "UILayout")"><img class="fibi-footer-logo" src="/Realshed/assets/images/FibiLogo-footer.png" alt="Fibi Emlak Danışmanlık"></a></figure>
                <div class="copyright pull-left">
                    <p>&copy; 2026 <a href="@Url.Action("Index", "UILayout")">Fibi Emlak Danışmanlık</a>. Tüm hakları saklıdır.</p>
                </div>
                <ul class="footer-nav pull-right clearfix">
                    <li><a href="@Url.Action("Terms","Legal")">Kullanım Koşulları</a></li>
                    <li><a href="@Url.Action("Privacy","Legal")">Gizlilik Politikası</a></li>
                    <li><a href="@Url.Action("Kvkk","Legal")">KVKK Aydınlatma Metni</a></li>
                </ul>
            </div>
        </div>
    </div>
</footer>
