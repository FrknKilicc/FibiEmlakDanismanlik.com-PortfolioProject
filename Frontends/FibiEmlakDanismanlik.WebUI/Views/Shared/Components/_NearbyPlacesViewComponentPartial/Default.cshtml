@model List<FibiEmlakDanismanlik.WebUI.Models.Nearby.NearbyCategoryGroupVm>

<div class="nearby-box content-widget">
    <div class="title-box">
        <h4>Konum Avantajı</h4>
    </div>

    <div class="inner-box">
        @foreach (var cat in Model.OrderBy(x => x.SortOrder))
        {
            if (cat.Items == null || cat.Items.Count == 0)
            {
                continue;
            }

            <div class="single-item">
                <div class="icon-box">
                    <i class="@(string.IsNullOrWhiteSpace(cat.IconCss) ? "fas fa-map-marker-alt" : cat.IconCss)"></i>
                </div>

                <div class="inner">
                    <h5>@cat.CategoryName:</h5>

                    @foreach (var item in cat.Items.Take(3))
                    {
                        var distanceFormatted = item.DistanceKm < 1
                            ? $"{(int)Math.Round((double)item.DistanceKm * 1000 / 10) * 10} m"
                            : $"{item.DistanceKm.ToString("0.0", new System.Globalization.CultureInfo("tr-TR"))} km";

                        <div class="box clearfix">
                            <div class="text pull-left">
                                <h6>
                                    @item.PlaceName
                                    <span>(@distanceFormatted)</span>
                                </h6>
                            </div>

                            <span class="nearby-proximity pull-right @(item.DistanceKm < 1 ? "is-walk" : "")">@(item.DistanceKm < 1 ? "Yürüme mesafesi" : "Yakın çevre")</span>
                        </div>
                    }
                </div>
            </div>
        }
    </div>
    <p class="nearby-source">Mesafeler kuş uçuşu ve yaklaşıktır. Kaynak: © OpenStreetMap katkıcıları.</p>
</div>

<style>
    .nearby-box .nearby-proximity { font-size: 12px; font-weight: 500; color: #93959e; background: #f4f5f7; border-radius: 12px; padding: 2px 10px; }
    .nearby-box .nearby-proximity.is-walk { color: #15803d; background: #dcfce7; }
    .nearby-box .nearby-source { margin: 14px 0 0; font-size: 12px; color: #93959e; }
</style>