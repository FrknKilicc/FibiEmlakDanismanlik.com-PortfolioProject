<script>
    (function () {
        var API_BASE = '@ViewBag.ApiUrl';
        var FORSALE_USAGE = 1;
        var FORRENT_USAGE = 2;

        function fetchOptions(url) {
            return fetch(url).then(function(res) {
                if (!res.ok) throw new Error('HTTP ' + res.status);
                return res.json();
            }).catch(function(err) {
                console.error('Fetch error:', err);
                return [];
            });
        }

        function populateSelect(selectEl, data, placeholder) {
            if (!selectEl) return;
            selectEl.innerHTML = '';
            var opt0 = document.createElement('option');
            opt0.value = '';
            opt0.textContent = placeholder;
            selectEl.appendChild(opt0);

            data.forEach(function (item) {
                var opt = document.createElement('option');
                opt.value = item.id;
                opt.textContent = item.name || item.text;
                selectEl.appendChild(opt);
            });
        }

        function initSelect2(selectId, placeholderText) {
            if (window.jQuery && window.jQuery.fn.select2) {
                var $el = window.jQuery('#' + selectId);
                var $ns = $el.next('.nice-select');
                if ($ns.length) $ns.remove();
                $el.css('display', '');
                $el.removeClass('nice-select wide');

                if ($el.hasClass('select2-hidden-accessible')) {
                    $el.select2('destroy');
                }

                $el.select2({
                    placeholder: placeholderText,
                    allowClear: true,
                    width: '100%'
                });
            }
        }

        function updateAdvancedFilters(tabSelector, listingTypeId) {
            var $tab = window.jQuery(tabSelector);
            if (!listingTypeId) {
                $tab.find('.adv-filter-room, .adv-filter-bath, .adv-filter-floor, .adv-filter-price, .adv-filter-area, .adv-filter-distance').show();
                return;
            }
            fetchOptions(API_BASE + 'listingtypes/advanced-filters?listingTypeId=' + listingTypeId)
                .then(function(filters) {
                    if (filters.showRooms) $tab.find('.adv-filter-room').show(); else $tab.find('.adv-filter-room').hide();
                    if (filters.showBath) $tab.find('.adv-filter-bath').show(); else $tab.find('.adv-filter-bath').hide();
                    if (filters.showFloor) $tab.find('.adv-filter-floor').show(); else $tab.find('.adv-filter-floor').hide();
                    if (filters.showPrice) $tab.find('.adv-filter-price').show(); else $tab.find('.adv-filter-price').hide();
                    if (filters.showArea) $tab.find('.adv-filter-area').show(); else $tab.find('.adv-filter-area').hide();
                    if (filters.showDistance) $tab.find('.adv-filter-distance').show(); else $tab.find('.adv-filter-distance').hide();
                });
        }

        function initLocationCascading(usageType, tabSelector, listDropdownId, cityDropdownId, districtDropdownId) {
            try {
                initSelect2(cityDropdownId, 'İl Seçiniz');
                initSelect2(districtDropdownId, 'İlçe Seçiniz');

                fetchOptions(API_BASE + 'listingtypes?usageType=' + usageType)
                    .then(function(data) {
                        var selectEl = document.getElementById(listDropdownId);
                        populateSelect(selectEl, data, 'İlan Tipi Seçiniz');
                        initSelect2(listDropdownId, 'İlan Tipi Seçiniz');
                    });

                window.jQuery(document).off('change', '#' + listDropdownId).on('change', '#' + listDropdownId, function() {
                    var listingTypeId = window.jQuery(this).val();
                    var cityEl = document.getElementById(cityDropdownId);
                    var districtEl = document.getElementById(districtDropdownId);
                    
                    if (!listingTypeId) {
                        populateSelect(cityEl, [], 'İl Seçiniz');
                        window.jQuery(cityEl).prop('disabled', true);
                        initSelect2(cityDropdownId, 'İl Seçiniz');
                        
                        populateSelect(districtEl, [], 'İlçe Seçiniz');
                        window.jQuery(districtEl).prop('disabled', true);
                        initSelect2(districtDropdownId, 'İlçe Seçiniz');
                        
                        updateAdvancedFilters(tabSelector, null);
                        return;
                    }
                    
                    window.jQuery(cityEl).prop('disabled', false);
                    fetchOptions(API_BASE + 'Location/available-cities?usageType=' + usageType + '&listingTypeId=' + listingTypeId)
                        .then(function(cities) {
                            populateSelect(cityEl, cities, 'İl Seçiniz');
                            initSelect2(cityDropdownId, 'İl Seçiniz');
                            
                            populateSelect(districtEl, [], 'İlçe Seçiniz');
                            window.jQuery(districtEl).prop('disabled', true);
                            initSelect2(districtDropdownId, 'İlçe Seçiniz');
                        });
                    
                    updateAdvancedFilters(tabSelector, listingTypeId);
                });

                window.jQuery(document).off('change', '#' + cityDropdownId).on('change', '#' + cityDropdownId, function() {
                    var cityId = window.jQuery(this).val();
                    var listingTypeId = window.jQuery('#' + listDropdownId).val();
                    var $dist = window.jQuery('#' + districtDropdownId);
                    
                    if (!cityId || !listingTypeId) {
                        populateSelect(document.getElementById(districtDropdownId), [], 'İlçe Seçiniz');
                        $dist.prop('disabled', true);
                        initSelect2(districtDropdownId, 'İlçe Seçiniz');
                        return;
                    }

                    fetchOptions(API_BASE + 'Location/available-districts?cityId=' + cityId + '&usageType=' + usageType + '&listingTypeId=' + listingTypeId)
                        .then(function(districts) {
                            populateSelect(document.getElementById(districtDropdownId), districts, 'İlçe Seçiniz');
                            $dist.prop('disabled', false);
                            initSelect2(districtDropdownId, 'İlçe Seçiniz');
                        });
                });
            } catch (err) {
                console.error('Cascading init error:', err);
            }
        }
        
        function debounce(func, wait) {
            var timeout;
            return function() {
                var context = this, args = arguments;
                clearTimeout(timeout);
                timeout = setTimeout(function() {
                    func.apply(context, args);
                }, wait);
            };
        }

        function initPropertySearch(usageType, listDropdownId, searchInputClass, suggestionsListClass) {
            try {
                // Clear Icon Logic
                window.jQuery(document).off('input', '.' + searchInputClass).on('input', '.' + searchInputClass, function() {
                    var $input = window.jQuery(this);
                    var $clearBtn = $input.siblings('.clear-search');
                    if ($input.val().length > 0) {
                        $clearBtn.show();
                    } else {
                        $clearBtn.hide();
                    }
                });

                window.jQuery(document).off('click', '.clear-search').on('click', '.clear-search', function() {
                    var $input = window.jQuery(this).siblings('.' + searchInputClass);
                    var $list = window.jQuery(this).siblings('.' + suggestionsListClass);
                    $input.val('').trigger('input');
                    $list.hide();
                    window.jQuery(this).hide();
                });

                // AJAX Debounced Search
                var handleSearch = debounce(function(e) {
                    var $input = window.jQuery(e.target);
                    if (!$input.closest('.tab').hasClass('active-tab')) return;

                    var term = $input.val();
                    var $list = $input.siblings('.' + suggestionsListClass);
                    var $listDropdown = window.jQuery('#' + listDropdownId);
                    var listingTypeId = $listDropdown.val() || '';

                    // Construct URL, omit listingTypeId if empty to prevent 400 Bad Request
                    var url = API_BASE + 'search/suggestions?usageType=' + usageType + '&searchTerm=' + encodeURIComponent(term);
                    if (listingTypeId) {
                        url += '&listingTypeId=' + listingTypeId;
                    }

                    if (term.length >= 3) {
                        fetchOptions(url)
                            .then(function(results) {
                                $list.empty();
                                if (results.length > 0) {
                                    results.forEach(function(item) {
                                        var li = window.jQuery('<li></li>').text(item.title);
                                        li.on('click', function() {
                                            $input.val(item.title);
                                            $list.hide();
                                            $input.siblings('.clear-search').show();
                                        });
                                        $list.append(li);
                                    });
                                    $list.show();
                                } else {
                                    $list.hide();
                                }
                            });
                    } else {
                        $list.hide();
                    }
                }, 300);

                window.jQuery(document).on('keyup', '.' + searchInputClass, handleSearch);

                window.jQuery(document).off('click.suggest').on('click.suggest', function(e) {
                    if (!window.jQuery(e.target).closest('.form-group').length) {
                        window.jQuery('.' + suggestionsListClass).hide();
                    }
                });
            } catch (err) {
                console.error('Auto-suggest init error:', err);
            }
        }

        function loadSelect2(callback) {
            if (window.jQuery && window.jQuery.fn.select2) {
                callback();
                return;
            }
            var head = document.getElementsByTagName('head')[0];
            if (!document.getElementById('select2-css')) {
                var link = document.createElement('link');
                link.id = 'select2-css';
                link.rel = 'stylesheet';
                link.href = 'https://cdn.jsdelivr.net/npm/select2@4.1.0-rc.0/dist/css/select2.min.css';
                head.appendChild(link);
            }
            var script = document.createElement('script');
            script.src = 'https://cdn.jsdelivr.net/npm/select2@4.1.0-rc.0/dist/js/select2.min.js';
            script.onload = callback;
            document.body.appendChild(script);
        }

        function init() {
            // Tab 1: Satılık
            loadSelect2(function() { 
                initLocationCascading(FORSALE_USAGE, '#tab-1', 'listingTypeDropdown-forsale', 'cityDropdown-forsale', 'districtDropdown-forsale');
                initPropertySearch(FORSALE_USAGE, 'listingTypeDropdown-forsale', 'search-field-input', 'suggestions-list');

                // Tab 2: Kiralık
                initLocationCascading(FORRENT_USAGE, '#tab-2', 'listingTypeDropdown-forrent', 'cityDropdown-forrent', 'districtDropdown-forrent');
                initPropertySearch(FORRENT_USAGE, 'listingTypeDropdown-forrent', 'search-field-input', 'suggestions-list'); 
            });
        }

        if (document.readyState === 'loading') {
            document.addEventListener('DOMContentLoaded', init);
        } else {
            init();
        }
    })();
</script>

