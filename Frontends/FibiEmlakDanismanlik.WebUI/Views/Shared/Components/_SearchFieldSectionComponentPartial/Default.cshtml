<style>
    /* ── Search Field Section Layout ── */
    .search-field-section {
        direction: ltr !important;
        text-align: left !important;
    }
    .search-field-section * {
        box-sizing: border-box;
    }

    /* ── Select2 Global Overrides ── */
    .search-field-section .select2-container {
        z-index: 99999 !important;
        width: 100% !important;
    }
    .search-field-section .select2-container--default .select2-selection--single {
        position: relative !important;
        height: 50px !important;
        padding: 0 45px 0 15px !important;
        border-radius: 8px !important;
        border: 1px solid #e0e0e0 !important;
        box-shadow: 0 2px 8px rgba(0,0,0,0.04) !important;
        display: flex;
        align-items: center;
        background-color: #fff;
        transition: border-color 0.2s ease, box-shadow 0.2s ease;
    }
    .search-field-section .select2-container--default .select2-selection--single:hover {
        border-color: #3ea843 !important;
    }
    .search-field-section .select2-container--default.select2-container--focus .select2-selection--single,
    .search-field-section .select2-container--default.select2-container--open .select2-selection--single {
        border-color: #3ea843 !important;
        box-shadow: 0 0 0 3px rgba(62,168,67,0.12) !important;
    }
    .search-field-section .select2-container--default .select2-selection--single .select2-selection__arrow {
        position: absolute !important;
        top: 50% !important;
        transform: translateY(-50%) !important;
        right: 12px !important;
        width: 20px !important;
        height: 20px !important;
    }
    .search-field-section .select2-container--default .select2-selection--single .select2-selection__arrow b {
        border-color: #888 transparent transparent transparent !important;
    }
    .search-field-section .select2-container--default.select2-container--open .select2-selection--single .select2-selection__arrow b {
        border-color: transparent transparent #888 transparent !important;
    }
    .search-field-section .select2-container--default .select2-selection--single .select2-selection__clear {
        position: absolute !important;
        top: 50% !important;
        transform: translateY(-50%) !important;
        right: 30px !important;
        width: 18px !important;
        height: 18px !important;
        line-height: 16px !important;
        text-align: center !important;
        margin: 0 !important;
        padding: 0 !important;
        color: #d0021b !important;
        font-size: 16px !important;
        font-weight: bold !important;
        cursor: pointer !important;
        z-index: 5 !important;
        background: transparent !important;
    }
    .search-field-section .select2-container--default .select2-selection--single .select2-selection__clear:hover {
        color: #a00010 !important;
    }
    .search-field-section .select2-container--default .select2-selection--single .select2-selection__rendered {
        line-height: 50px !important;
        color: #333;
        font-size: 14px;
        padding: 0 !important;
        overflow: hidden;
        text-overflow: ellipsis;
        white-space: nowrap;
        width: 100%;
        display: block;
    }
    .search-field-section .select2-container--default .select2-selection--single .select2-selection__placeholder {
        color: #999;
    }
    .search-field-section .select2-container--default.select2-container--disabled .select2-selection--single {
        background-color: #f7f7f7 !important;
        border-color: #e5e5e5 !important;
        cursor: not-allowed;
        opacity: 0.7;
    }
    .search-field-section .select2-dropdown {
        border-radius: 8px !important;
        border: 1px solid #e0e0e0 !important;
        box-shadow: 0 8px 24px rgba(0,0,0,0.12) !important;
        margin-top: 4px;
        z-index: 999999 !important;
    }
    .search-field-section .select2-results__option {
        padding: 10px 15px;
        font-size: 14px;
    }
    .search-field-section .select2-results__option--highlighted[aria-selected] {
        background-color: #3ea843 !important;
    }
    .search-field-section .select2-search--dropdown .select2-search__field {
        border-radius: 6px !important;
        border: 1px solid #e0e0e0 !important;
        padding: 8px 12px;
    }

    /* ── Advanced Search Panel ── */
    .advanced-search {
        z-index: 999 !important;
        overflow: visible !important;
        direction: ltr !important;
        text-align: left !important;
    }

    /* ── Mülk Ara Input ── */
    .search-field-input {
        height: 50px !important;
        padding: 10px 35px 10px 38px !important;
        border-radius: 8px !important;
        border: 1px solid #e0e0e0 !important;
        box-shadow: 0 2px 8px rgba(0,0,0,0.04) !important;
        font-size: 14px;
        color: #333;
        width: 100%;
        box-sizing: border-box;
        background-color: #fff;
        transition: border-color 0.2s ease, box-shadow 0.2s ease;
        outline: none;
    }
    .search-field-input:focus {
        border-color: #3ea843 !important;
        box-shadow: 0 0 0 3px rgba(62,168,67,0.12) !important;
    }
    .search-field-input::placeholder { color: #999; }

    /* ── Auto-Suggest List ── */
    .suggestions-list {
        display: none;
        position: absolute;
        top: 100%;
        left: 0;
        right: 0;
        z-index: 99999;
        background: #fff;
        border: 1px solid #e0e0e0;
        border-radius: 8px;
        max-height: 250px;
        overflow-y: auto;
        padding: 0;
        margin-top: 4px;
        list-style: none;
        box-shadow: 0 8px 24px rgba(0,0,0,0.12);
    }
    .suggestions-list li {
        padding: 10px 15px;
        border-bottom: 1px solid #f5f5f5;
        cursor: pointer;
        transition: background 0.15s;
        color: #333;
        font-size: 14px;
    }
    .suggestions-list li:hover { background: #f0faf0; color: #2d8f32; }
    .suggestions-list li:last-child { border-bottom: none; }

    .clear-search {
        position: absolute;
        right: 15px;
        top: 50%;
        transform: translateY(-50%);
        cursor: pointer;
        display: none;
        z-index: 10;
        color: #d0021b;
        font-size: 16px;
    }

    /* ── Range Sliders (Strict LTR & Pixel Perfect) ── */
