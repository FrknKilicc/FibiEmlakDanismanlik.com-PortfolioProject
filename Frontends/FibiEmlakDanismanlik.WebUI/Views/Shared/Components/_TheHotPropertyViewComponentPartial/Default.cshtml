@model BestDealsViewModel
@{
    if (Model == null || ((Model.ForSale == null || !Model.ForSale.Any()) && (Model.ForRent == null || !Model.ForRent.Any())))
    {
        return;
    }

    var trCulture = new System.Globalization.CultureInfo("tr-TR");
    var typeOrder = new[] { "Konut", "İşyeri", "Arsa" };

    var panelList = new[]
    {
        new { UsageType = 1, Items = Model.ForSale ?? new List<ResultBestDealDto>() },
        new { UsageType = 2, Items = Model.ForRent ?? new List<ResultBestDealDto>() }
    };
}

<section class="deals-style-two sec-pad" id="bestDealsRoot">
    <div class="auto-container">
        <div class="sec-title centred">
            <h5>Fırsat ilanlar</h5>
            <h2>Özel Teklifler</h2>
        </div>

        @foreach (var panel in panelList)
        {
            var isRent = panel.UsageType == 2;
            var distinctTypes = panel.Items
                .Select(x => x.ListingTypeName)
                .Where(x => !string.IsNullOrWhiteSpace(x))
                .Distinct(StringComparer.OrdinalIgnoreCase)
                .OrderBy(x =>
                {
                    var idx = Array.FindIndex(typeOrder, t => string.Equals(t, x, StringComparison.OrdinalIgnoreCase));
                    return idx >= 0 ? idx : 999;
                })
                .ToList();

            <div class="best-deals-panel" data-usagetype="@panel.UsageType" style="@(isRent ? "display:none;" : null)">
                @if (distinctTypes.Count > 1)
                {
                    <ul class="best-deals-filters clearfix">
                        <li class="active" data-type="*">Tümü</li>
                        @foreach (var typeName in distinctTypes)
                        {
                            <li data-type="@typeName">@typeName</li>
                        }
                    </ul>
                }

                @if (!panel.Items.Any())
                {
                    <p class="best-deals-empty">Şu an vitrin ilanı yok.</p>
                }
                else
                {
                    <div class="deals-carousel owl-carousel owl-theme dots-style-one owl-nav-none">
                        @foreach (var item in panel.Items)
                        {
                            var detailUrl = ListingUrl.DetailPath(isRent, item.ListingId, item.ListingTypeId, null, item.PropertyName, item.District);

                            var locParts = new List<string>();
                            if (!string.IsNullOrWhiteSpace(item.District))
                            {
                                locParts.Add(item.District.Trim());
                            }
                            if (!string.IsNullOrWhiteSpace(item.City))
                            {
                                locParts.Add(item.City.Trim());
                            }
                            var locationText = string.Join(", ", locParts);

                            var desc = FibiEmlakDanismanlik.WebUI.Models.PageMeta.StripHtmlAndTruncate(item.PropertyDescription, 120);

                            var isKonut = string.Equals(item.ListingTypeName, "Konut", StringComparison.OrdinalIgnoreCase);
                            var isIsyeri = string.Equals(item.ListingTypeName, "İşyeri", StringComparison.OrdinalIgnoreCase) ||
                                           string.Equals(item.ListingTypeName, "Isyeri", StringComparison.OrdinalIgnoreCase);
                            var isArsa = string.Equals(item.ListingTypeName, "Arsa", StringComparison.OrdinalIgnoreCase);

                            <div class="single-item" data-type="@item.ListingTypeName">
                                <div class="row clearfix">
                                    <div class="col-lg-6 col-md-6 col-sm-12 deals-block">
                                        <div class="image-box">
                                            <figure class="image">
                                                <img src="@(string.IsNullOrWhiteSpace(item.ImageUrl) ? "/Realshed/assets/images/resource/deals-1.jpg" : item.ImageUrl)" alt="@item.PropertyName" onerror="this.onerror=null;this.src='/Realshed/assets/images/resource/deals-1.jpg';" fibi-responsive fibi-sizes="(max-width: 767px) 100vw, 370px">
                                            </figure>
                                            <div class="listing-badges">
                                                <div class="batch"><i class="icon-11"></i></div>
                                                <span class="category">@item.ListingTypeName</span>
                                                <div class="buy-btn">
                                                    <a href="@detailUrl">@(isRent ? "Kiralık" : "Satılık")</a>
                                                </div>
                                            </div>
                                        </div>
                                    </div>
                                    <div class="col-lg-6 col-md-6 col-sm-12 deals-block">
                                        <div class="deals-block-one">
                                            <div class="inner-box">
                                                <div class="lower-content">
                                                    <div class="title-text">
                                                        <h4><a href="@detailUrl">@item.PropertyName</a></h4>
                                                    </div>
                                                    <div class="price-box clearfix">
                                                        <div class="price-info pull-left">
                                                            <h6>@(isRent ? "Kira:" : "Fiyat:")</h6>
                                                            @if (isRent)
                                                            {
                                                                <h4>@(item.Price.ToString("N0", trCulture) + " ₺") <span class="price-period">/ ay</span></h4>
                                                            }
                                                            else
                                                            {
                                                                <h4>@(item.Price.ToString("N0", trCulture) + " ₺")</h4>
                                                            }
                                                        </div>
                                                        <div class="author-box pull-right">
                                                            <figure class="author-thumb">
                                                                <img src="@(string.IsNullOrWhiteSpace(item.AgentImgUrl) ? "/Realshed/assets/images/feature/author-1.jpg" : item.AgentImgUrl)" alt="" onerror="this.onerror=null;this.src='/Realshed/assets/images/feature/author-1.jpg';">
                                                                <span>@item.AgentName</span>
                                                            </figure>
                                                        </div>
                                                    </div>
                                                    <p>
                                                        @if (!string.IsNullOrEmpty(locationText))
                                                        {
                                                            <i class="fas fa-map-marker-alt"></i> @locationText<br />
                                                        }
                                                        @desc
                                                    </p>
                                                    <ul class="more-details clearfix">
                                                        @if (isKonut)
                                                        {
                                                            @if (!string.IsNullOrWhiteSpace(item.NumberOfRoom) && item.NumberOfRoom != "0")
                                                            {
                                                                <li><i class="icon-14"></i>@item.NumberOfRoom</li>
                                                            }
                                                            @if (item.NumberOfBathRoom.HasValue && item.NumberOfBathRoom.Value > 0)
                                                            {
                                                                <li><i class="icon-15"></i>@item.NumberOfBathRoom Banyo</li>
                                                            }
                                                            @if (item.Area.HasValue && item.Area.Value > 0)
                                                            {
                                                                <li><i class="icon-16"></i>@(item.Area.Value.ToString("N0", trCulture) + " m²")</li>
                                                            }
                                                        }
                                                        else if (isIsyeri)
                                                        {
                                                            @if (item.NumberOfSection.HasValue && item.NumberOfSection.Value > 0)
                                                            {
                                                                <li><i class="icon-14"></i>@item.NumberOfSection Bölüm</li>
                                                            }
                                                            @if (item.NumberOfBathRoom.HasValue && item.NumberOfBathRoom.Value > 0)
                                                            {
                                                                <li><i class="icon-15"></i>@item.NumberOfBathRoom WC</li>
                                                            }
                                                            @if (item.Area.HasValue && item.Area.Value > 0)
                                                            {
                                                                <li><i class="icon-16"></i>@(item.Area.Value.ToString("N0", trCulture) + " m²")</li>
                                                            }
                                                        }
                                                        else if (isArsa)
                                                        {
                                                            @if (item.Area.HasValue && item.Area.Value > 0)
                                                            {
                                                                <li><i class="icon-16"></i>@(item.Area.Value.ToString("N0", trCulture) + " m²")</li>
                                                            }
                                                            @if (!string.IsNullOrWhiteSpace(item.ZoningStatus))
                                                            {
                                                                <li><i class="fas fa-map"></i>@item.ZoningStatus</li>
                                                            }
                                                        }
                                                        else
                                                        {
                                                            @if (!string.IsNullOrWhiteSpace(item.NumberOfRoom) && item.NumberOfRoom != "0")
                                                            {
                                                                <li><i class="icon-14"></i>@item.NumberOfRoom</li>
                                                            }
                                                            @if (item.NumberOfBathRoom.HasValue && item.NumberOfBathRoom.Value > 0)
                                                            {
                                                                <li><i class="icon-15"></i>@item.NumberOfBathRoom Banyo</li>
                                                            }
                                                            @if (item.Area.HasValue && item.Area.Value > 0)
                                                            {
                                                                <li><i class="icon-16"></i>@(item.Area.Value.ToString("N0", trCulture) + " m²")</li>
                                                            }
                                                        }
                                                    </ul>
                                                    <div class="other-info-box clearfix">
                                                        <div class="btn-box pull-left"><a href="@detailUrl" class="theme-btn btn-one">Detayları Gör</a></div>
                                                    </div>
                                                </div>
                                            </div>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        }
                    </div>
                }
            </div>
        }
    </div>
</section>

<style>
    .price-info .price-period { font-size: 14px; font-weight: 500; color: #93959e; }
    #bestDealsRoot .best-deals-filters { text-align:center; margin-bottom:40px; }
    #bestDealsRoot .best-deals-filters li { display:inline-block; font-size:15px; line-height:26px; color:#93959e; font-weight:500; cursor:pointer; border:1px solid #e5e7ec; border-radius:5px; padding:11px 28px; margin:0 3.5px 7px; transition:all 500ms ease; }
    #bestDealsRoot .best-deals-filters li:hover, #bestDealsRoot .best-deals-filters li.active { color:#fff; background:#2dbe6c; border-color:#2dbe6c; }
    #bestDealsRoot .best-deals-empty { text-align:center; color:#93959e; padding:40px 0; }
    #bestDealsRoot .deals-block .image-box .image img { height: 425px; object-fit: cover; }
    @@media (max-width: 991px) { #bestDealsRoot .deals-block .image-box .image img { height: 280px; } }
</style>
