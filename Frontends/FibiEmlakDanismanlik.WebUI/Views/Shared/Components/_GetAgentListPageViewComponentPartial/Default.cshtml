@model FibiEmlakDanismanlik.WebUI.Models.AgentListingPageVm



<!--Page Title-->
<section class="page-title centred" style="background-image: url(/Realshed/assets/images/background/skyscrapers-pageBanner.jpg);">
    <div class="auto-container">
        <div class="content-box clearfix">
            <h1>Emlak Danışmanlarımız</h1>
            <ul class="bread-crumb clearfix">
                <li><a href="@Url.Action("Index","UILayout")">Anasayfa</a></li>
                <li>Ekibimiz</li>
            </ul>
        </div>
    </div>
</section>
<!--End Page Title-->
<!-- agents-page-section -->
<section class="agents-page-section agents-list">
    <div class="auto-container">
        <div class="row clearfix">
            <div class="col-lg-4 col-md-12 col-sm-12 sidebar-side">
                <div class="default-sidebar agent-sidebar">
                    <div class="quick-property-widget sidebar-widget">
                        <div class="widget-title">
                            <h5>Size Uygun İlanlar</h5>
                        </div>

                        <div class="quick-property-list">
                            <a class="quick-property-link"
                               asp-controller="AllForSalePage"
                               asp-action="Index"
                               asp-route-listingTypeName="Konut"
                               asp-route-page="1">
                                <span class="quick-property-icon"><i class="fas fa-home"></i></span>
                                <span class="quick-property-content">
                                    <strong>Satılık Konutlar</strong>
                                    <small>Ev, daire ve villa ilanlarını incele</small>
                                </span>
                                <span class="quick-property-arrow"><i class="fas fa-angle-right"></i></span>
                            </a>

                            <a class="quick-property-link"
                               asp-controller="AllForRentalPage"
                               asp-action="Index"
                               asp-route-listingTypeName="Konut"
                               asp-route-page="1">
                                <span class="quick-property-icon"><i class="fas fa-key"></i></span>
                                <span class="quick-property-content">
                                    <strong>Kiralık Konutlar</strong>
                                    <small>Kiralamaya uygun evleri listele</small>
                                </span>
                                <span class="quick-property-arrow"><i class="fas fa-angle-right"></i></span>
                            </a>

                            <a class="quick-property-link"
                               asp-controller="AllForSalePage"
                               asp-action="Index"
                               asp-route-listingTypeName="Arsa"
                               asp-route-page="1">
                                <span class="quick-property-icon"><i class="fas fa-map"></i></span>
                                <span class="quick-property-content">
                                    <strong>Satılık Arsalar</strong>
                                    <small>Yatırımlık arsa fırsatlarına bak</small>
                                </span>
                                <span class="quick-property-arrow"><i class="fas fa-angle-right"></i></span>
                            </a>

                            <a class="quick-property-link"
                               asp-controller="AllForSalePage"
                               asp-action="Index"
                               asp-route-listingTypeName="İşyeri"
                               asp-route-page="1">
                                <span class="quick-property-icon"><i class="fas fa-building"></i></span>
                                <span class="quick-property-content">
                                    <strong>Ticari İlanlar</strong>
                                    <small>Ofis, dükkan ve işyerlerini gör</small>
                                </span>
                                <span class="quick-property-arrow"><i class="fas fa-angle-right"></i></span>
                            </a>
                        </div>
                    </div>
                    <div class="featured-widget sidebar-widget">
                        @await Component.InvokeAsync("_TopFeaturedPropertyForAgentPageViewComponentPartial")
                    </div>
                    <div class="blog-sidebar">
                        @await Component.InvokeAsync("_GetLast3BlogWithAuthorViewComponentPartial")
                    </div>
                </div>
            </div>
            <div class="col-lg-8 col-md-12 col-sm-12 content-side">
                <div class="agency-content-side">
                    @if (Model.Total > 0)
                    {
                        <div class="item-shorting clearfix">
                            <div class="left-column pull-left">
                                <h5>Ekibimiz: <span>@Model.Total danışmandan @Model.FirstItemNo–@Model.LastItemNo arası gösteriliyor</span></h5>
                            </div>
                        </div>
                    }

                    @if (Model.Items != null && Model.Items.Count > 0)
                    {
                        <div class="wrapper list">
                            <div class="agents-list-content list-item">
                                @foreach (var item in Model.Items)
                                {
                                    <div class="agents-block-one">
                                        <div class="inner-box">
                                            <figure class="image-box">
                                                <img src="@(string.IsNullOrWhiteSpace(item.AgentImgUrl) ? Url.Content("~/Realshed/assets/images/feature/feature-1.jpg") : item.AgentImgUrl)" class="agent-card-img" alt="@item.AgentName">
                                            </figure>
                                            <div class="content-box">
                                                <div class="upper clearfix">
                                                    <div class="title-inner pull-left">
                                                        <h4>@item.AgentName</h4>
                                                        <span class="designation">@item.AgentTitle</span>
                                                    </div>
                                                </div>
                                                @if (!string.IsNullOrWhiteSpace(item.AgentDescription))
                                                {
                                                    <div class="text">
                                                        <p>@item.AgentDescription</p>
                                                    </div>
                                                }
                                                <ul class="info clearfix">
                                                    @if (!string.IsNullOrWhiteSpace(item.Mail))
                                                    {
                                                        <li><i class="fab fa fa-envelope"></i><a href="mailto:@item.Mail">@item.Mail</a></li>
                                                    }
                                                    @if (!string.IsNullOrWhiteSpace(item.AgentPhoneNumber))
                                                    {
                                                        <li><i class="fab fa fa-phone"></i><a href="tel:@(item.AgentPhoneNumber.Replace(" ", ""))">@item.AgentPhoneNumber</a></li>
                                                    }
                                                </ul>
                                                <div class="btn-box">
                                                    <a href="@Url.Action("Index", "Contact")#contact-message-form" class="theme-btn btn-two">
                                                        Bizimle İletişime Geçin
                                                    </a>
                                                </div>
                                            </div>
                                        </div>
                                    </div>
                                }
                            </div>
                        </div>
                    }
                    else
                    {
                        <div class="agents-empty-state">
                            <p>Şu anda listelenecek danışman bulunmuyor.</p>
                        </div>
                    }

                    @await Html.PartialAsync(
                        "~/Views/Shared/Components/_PaginationViewComponentPartial/Default.cshtml",
                        new FibiEmlakDanismanlik.WebUI.Models.PaginationVm
                        {
                            Page = Model.Page,
                            PageSize = Model.PageSize,
                            TotalPages = Model.TotalPages
                        })
                </div>
            </div>
        </div>
    </div>
</section>
<!-- agents-page-section end -->