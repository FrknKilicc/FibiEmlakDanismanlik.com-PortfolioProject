@model List<ResultOurPartnersDto>
@inject FibiEmlakDanismanlik.WebUI.Services.SiteTextService SiteTextService
@{
    var texts = await SiteTextService.GetAsync();
}

@if (Model != null && Model.Count > 0)
{
    <style>
        .clients-section .logo-list li .logo { display:flex; align-items:center; justify-content:center; min-height:70px; margin:0; }
        .clients-section .logo-list li img { max-width:100%; height:auto; }
        @@media (max-width: 991px) { .clients-section .clients-logo { margin-left:0; margin-top:30px; } }
        @@media (max-width: 499px) {
            .clients-section .logo-list li { width: 50%; margin-bottom: 24px; padding: 0 8px; }
            .clients-section .logo-list li .logo { min-height: 56px; }
        }
    </style>
    <section class="clients-section bg-color-1">
        <div class="pattern-layer" style="background-image: url(/Realshed/assets/images/shape/shape-1.png);"></div>
        <div class="auto-container">
            <div class="row clearfix">
                <div class="col-lg-4 col-md-12 col-sm-12 title-column">
                    <div class="sec-title">
                        <h5>@texts["home.partners.eyebrow"]</h5>
                        <h2>@texts["home.partners.title"]</h2>
                    </div>
                </div>
                <div class="col-lg-8 col-md-12 col-sm-12 inner-column">
                    <div class="clients-logo">
                        <ul class="logo-list clearfix">
                            @foreach (var item in Model)
                            {
                                var logoUrl = item.PartnerLogoUrl ?? string.Empty;
                                if (!logoUrl.StartsWith("http://", StringComparison.OrdinalIgnoreCase) &&
                                    !logoUrl.StartsWith("https://", StringComparison.OrdinalIgnoreCase) &&
                                    !logoUrl.StartsWith("/"))
                                {
                                    logoUrl = "/" + logoUrl;
                                }
                                <li>
                                    <figure class="logo"><img src="@logoUrl" alt="@item.PartnerName" title="@item.PartnerName" width="180" height="70" loading="lazy"></figure>
                                </li>
                            }
                        </ul>
                    </div>
                </div>
            </div>
        </div>
    </section>
}
