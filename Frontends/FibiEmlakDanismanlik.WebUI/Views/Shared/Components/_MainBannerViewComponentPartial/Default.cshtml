@model List<ResultMainBannerDto>


<section class="banner-style-two centred">
    <div class="banner-carousel owl-theme owl-carousel owl-nav-none">
        @foreach (var item in Model)
        {
            <div class="slide-item">
                <div class="image-layer" style="background-image:url(@item.MainBannerUrl)"></div>
                <div class="auto-container">
                    <div class="content-box">
                        <h2>@item.MainBannerDesc</h2>
                        <p>Fibi Emlak Danışmanlık, Kazandıran Gayrimenkul Çözümleri</p>
                    </div>
                </div>
            </div>
        }
    </div>
</section>

<style>
    /* Owl kurulana kadar .owl-carousel display:none; banner yüksekliği sonradan gelip
       altındaki bölümleri itiyordu (CLS). Kurulumdan önce yalnızca ilk slayt görünsün. */
    .banner-style-two .banner-carousel.owl-carousel:not(.owl-loaded) { display: block; }
    .banner-style-two .banner-carousel.owl-carousel:not(.owl-loaded) > .slide-item:not(:first-child) { display: none; }
</style>