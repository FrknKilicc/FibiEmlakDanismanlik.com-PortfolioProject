   @model ResultAllForSaleListinForPageDto
@{
    ViewData["Title"] = "Index";
    Layout = "~/Views/ThemeScaff/ScaffTemplate.cshtml";
}
@await Component.InvokeAsync("_AllForSaleDetailPageViewComponentPartial", new { id = Model.ListingId, listingTypeId = Model.ListingTypeId > 0 ? Model.ListingTypeId : (int?)null })
@section Styles {
    <link rel="stylesheet" href="/Realshed/assets/css/timePicker.css" />
    <link rel="stylesheet" href="https://unpkg.com/leaflet@1.9.4/dist/leaflet.css" />
    <link rel="stylesheet" href="/css/leaflet-markers.css" />
    <link rel="stylesheet" href="~/css/listing-specs.css" asp-append-version="true" />
    <style>
        .property-details .map-approx-note { margin: 10px 0 0; font-size: 13px; color: #93959e; }
        .property-details .map-approx-note i { color: #2dbe6c; margin-right: 4px; }
        .property-details .price-box .price-period { font-size: 15px; font-weight: 500; color: #93959e; }
        .property-details .author-widget .agent-title { margin: -4px 0 10px; font-size: 13px; color: #93959e; letter-spacing: .3px; }
    </style>
}
@section Scripts {
    <script>
        $(function () {
            var $phone = $('input[name="CustomerContactPhone"]');
            if ($phone.length) {
                $phone.on('input', function () {
                    this.value = this.value.replace(/\D/g, '');
                });
            }
        });
    </script>
    <script>
        $(function () {
            if ($('#datepicker').length) {
                $('#datepicker').datepicker({
                    dateFormat: 'dd.mm.yy',
                    firstDay: 1
                });
            }
        });
    </script>
    <script>
        $(function () {
            const timeInput = document.getElementById('timeInput');
            const timeIcon = document.getElementById('timeIcon');

            if (timeInput && timeIcon) {
                timeIcon.style.cursor = 'pointer';
                const openPicker = () => {
                    if (typeof timeInput.showPicker === 'function') timeInput.showPicker();
                    else timeInput.focus();
                };
                timeIcon.addEventListener('click', openPicker);
                timeInput.addEventListener('focus', openPicker);
            }
        });

    </script>
    <script src="https://unpkg.com/leaflet@1.9.4/dist/leaflet.js"></script>
    <script src="/js/listing-detail-map.js"></script>
}