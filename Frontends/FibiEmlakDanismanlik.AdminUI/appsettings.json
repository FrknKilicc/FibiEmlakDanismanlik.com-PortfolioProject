{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "Serilog": {
    "MinimumLevel": { "Default": "Information", "Override": { "Microsoft": "Warning", "Microsoft.Hosting.Lifetime": "Information", "Microsoft.EntityFrameworkCore": "Warning", "System.Net.Http.HttpClient": "Warning" } },
    "WriteTo": [
      { "Name": "Console" },
      { "Name": "File", "Args": { "path": "logs/panel-.log", "rollingInterval": "Day", "retainedFileCountLimit": 14, "fileSizeLimitBytes": 10485760, "rollOnFileSizeLimit": true, "outputTemplate": "{Timestamp:yyyy-MM-dd HH:mm:ss.fff zzz} [{Level:u3}] {SourceContext} {Message:lj}{NewLine}{Exception}" } }
    ]
  },
  "Url": {
    "ApiUrl": "https://localhost:7015/api/",
    "SiteUrl": ""
  },
  "Captcha": {
    "Enabled": true,
    "ScriptUrl": "https://challenges.cloudflare.com/turnstile/v0/api.js"
  },
  "AdminSession": {
    "IdleTimeoutMinutes": 30,
    "AbsoluteTimeoutHours": 8
  }
}
