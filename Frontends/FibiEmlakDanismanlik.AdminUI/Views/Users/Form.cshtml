@model FibiEmlakDanismanlik.AdminUI.Models.Users.UserFormViewModel
@using FibiEmlakDanismanlik.AdminUI.Models.Users
@inject FibiEmlakDanismanlik.AdminUI.Infrastructure.SiteImageUrl SiteImageUrl

@{
    var title = Model.IsNew ? "Yeni Kullanıcı" : "Kullanıcıyı Düzenle";
    ViewData["Title"] = title;

    var errName = Model.GetFieldError("AgentName");
    var errTitle = Model.GetFieldError("AgentTitle");
    var errMail = Model.GetFieldError("Mail");
    var errPhone = Model.GetFieldError("AgentPhoneNumber");
    var errPassword = Model.GetFieldError("Password");
    var errRole = Model.GetFieldError("Role");
    var errDesc = Model.GetFieldError("AgentDescription");
    var errImg = Model.GetFieldError("AgentImgUrl");
}

<div class="pagetitle d-flex flex-wrap justify-content-between align-items-center gap-2 mb-3">
    <div>
        <h1>@title</h1>
        <nav>
            <ol class="breadcrumb mb-0">
                <li class="breadcrumb-item"><a href="/">Ana Sayfa</a></li>
                <li class="breadcrumb-item"><a href="/kullanicilar">Kullanıcılar</a></li>
                <li class="breadcrumb-item active">@title</li>
            </ol>
        </nav>
    </div>
    <div>
        <a href="/kullanicilar" class="btn btn-outline-secondary btn-sm">
            <i class="bi bi-arrow-left me-1"></i> Kullanıcılara Dön
        </a>
    </div>
</div>

@if (TempData["Success"] != null)
{
    <div class="alert alert-success alert-dismissible fade show d-flex align-items-center mb-4" role="alert">
        <i class="bi bi-check-circle-fill flex-shrink-0 me-2 fs-5"></i>
        <div>@TempData["Success"]</div>
        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Kapat"></button>
    </div>
}

@if (TempData["Error"] != null)
{
    <div class="alert alert-danger alert-dismissible fade show d-flex align-items-center mb-4" role="alert">
        <i class="bi bi-exclamation-triangle-fill flex-shrink-0 me-2 fs-5"></i>
        <div>@TempData["Error"]</div>
        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Kapat"></button>
    </div>
}

@if (!string.IsNullOrWhiteSpace(Model.ErrorMessage))
{
    <div class="alert alert-danger alert-dismissible fade show d-flex align-items-center mb-4" role="alert">
        <i class="bi bi-exclamation-triangle-fill flex-shrink-0 me-2 fs-5"></i>
        <div>@Model.ErrorMessage</div>
        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Kapat"></button>
    </div>
}

<form method="post" action="@(Model.IsNew ? "/kullanicilar/yeni" : $"/kullanicilar/{Model.Form.AgentId}")">
    @Html.AntiForgeryToken()
    @if (!Model.IsNew)
    {
        <input type="hidden" name="AgentId" value="@Model.Form.AgentId" />
    }

    <div class="row g-4">
        <!-- Sol Kolon: Kimlik ve Rol/Yetki -->
        <div class="col-lg-6 col-12">
            <!-- 1. Kimlik Kartı -->
            <div class="card shadow-sm border-0 mb-4">
                <div class="card-body pt-3">
                    <h5 class="card-title p-0 pb-2 border-bottom mb-3">
                        <i class="bi bi-person me-2 text-primary"></i>Kimlik
                    </h5>

                    <div class="mb-3">
                        <label for="AgentName" class="form-label small fw-semibold">
                            Ad Soyad <span class="text-danger">*</span>
                        </label>
                        <input type="text"
                               class="form-control @(errName != null ? "is-invalid" : "")"
                               id="AgentName"
                               name="AgentName"
                               value="@Model.Form.AgentName"
                               placeholder="Örn: Ahmet Yılmaz"
                               required />
                        @if (errName != null)
                        {
                            <div class="invalid-feedback d-block">@errName</div>
                        }
                    </div>

                    <div class="mb-3">
                        <label for="AgentTitle" class="form-label small fw-semibold">
                            Unvan
                        </label>
                        <input type="text"
                               class="form-control @(errTitle != null ? "is-invalid" : "")"
                               id="AgentTitle"
                               name="AgentTitle"
                               value="@Model.Form.AgentTitle"
                               placeholder="Örn: Gayrimenkul Danışmanı" />
                        @if (errTitle != null)
                        {
                            <div class="invalid-feedback d-block">@errTitle</div>
                        }
                    </div>

                    <div class="mb-3">
                        <label for="Mail" class="form-label small fw-semibold">
                            E-posta Adresi <span class="text-danger">*</span>
                        </label>
                        <input type="email"
                               class="form-control @(errMail != null ? "is-invalid" : "")"
                               id="Mail"
                               name="Mail"
                               value="@Model.Form.Mail"
                               placeholder="ahmet.yilmaz@fibiemlak.com"
                               required />
                        @if (errMail != null)
                        {
                            <div class="invalid-feedback d-block">@errMail</div>
                        }
                    </div>

                    <div class="mb-2">
                        <label for="AgentPhoneNumber" class="form-label small fw-semibold">
                            Telefon
                        </label>
                        <input type="tel"
                               class="form-control @(errPhone != null ? "is-invalid" : "")"
                               id="AgentPhoneNumber"
                               name="AgentPhoneNumber"
                               value="@Model.Form.AgentPhoneNumber"
                               placeholder="0532 123 45 67" />
                        @if (errPhone != null)
                        {
                            <div class="invalid-feedback d-block">@errPhone</div>
                        }
                    </div>
                </div>
            </div>

            <!-- 2. Rol ve Yetki Kartı -->
            <div class="card shadow-sm border-0 mb-4">
                <div class="card-body pt-3">
                    <h5 class="card-title p-0 pb-2 border-bottom mb-3">
                        <i class="bi bi-shield-check me-2 text-primary"></i>Rol ve Yetki
                    </h5>

                    <div class="mb-3">
                        <label for="Role" class="form-label small fw-semibold">
                            Rol <span class="text-danger">*</span>
                        </label>
                        @if (Model.IsSelf)
                        {
                            <select class="form-select @(errRole != null ? "is-invalid" : "")" id="Role" disabled>
                                <option value="@Model.Form.Role">@UserLabels.RoleName(Model.Existing?.Role)</option>
                            </select>
                            <input type="hidden" name="Role" value="@Model.Form.Role" />
                            <div class="form-text">Kendi rolünüzü değiştiremezsiniz.</div>
                        }
                        else if (Model.IsOwner)
                        {
                            <select class="form-select @(errRole != null ? "is-invalid" : "")" id="Role" name="Role">
                                <option value="1" selected="@(Model.Form.Role == 1 ? "selected" : null)">Sahip</option>
                                <option value="2" selected="@(Model.Form.Role == 2 ? "selected" : null)">Yönetici</option>
                                <option value="3" selected="@(Model.Form.Role == 3 ? "selected" : null)">Danışman</option>
                            </select>
                        }
                        else
                        {
                            <select class="form-select @(errRole != null ? "is-invalid" : "")" id="Role" name="Role">
                                <option value="3" selected="selected">Danışman</option>
                            </select>
                            <div class="form-text">Yöneticiler yalnızca Danışman rolünde kullanıcı ekleyebilir ve düzenleyebilir.</div>
                        }
                        @if (errRole != null)
                        {
                            <div class="invalid-feedback d-block">@errRole</div>
                        }
                    </div>

                    <div class="form-check form-switch mb-3">
                        <input type="checkbox"
                               class="form-check-input"
                               id="CanViewAllListings"
                               name="CanViewAllListings"
                               value="true"
                               @(Model.Form.CanViewAllListings ? "checked" : "") />
                        <input type="hidden" name="CanViewAllListings" value="false" />
                        <label class="form-check-label small fw-semibold" for="CanViewAllListings">
                            Tüm ilanları görebilir (düzenleyemez)
                        </label>
                        <div class="form-text">İşaretlendiğinde kullanıcı kendi portföyünde olmayan şirket ilanlarını da inceleyebilir.</div>
                    </div>

                    <div class="form-check form-switch mb-3">
                        <input type="checkbox"
                               class="form-check-input"
                               id="ShowOnWebsite"
                               name="ShowOnWebsite"
                               value="true"
                               @(Model.Form.ShowOnWebsite ? "checked" : "") />
                        <input type="hidden" name="ShowOnWebsite" value="false" />
                        <label class="form-check-label small fw-semibold" for="ShowOnWebsite">
                            Sitede danışman olarak göster
                        </label>
                        <div class="form-text">Web sitesinde 'Danışmanlarımız' sayfasında ve ilan detay kartlarında listelenir.</div>
                    </div>

                    @if (!Model.IsNew)
                    {
                        <div class="form-check form-switch mb-2 pt-2 border-top">
                            @if (Model.IsSelf)
                            {
                                <input type="checkbox"
                                       class="form-check-input"
                                       id="IsActive"
                                       disabled
                                       @(Model.Form.IsActive ? "checked" : "") />
                                <input type="hidden" name="IsActive" value="@(Model.Form.IsActive ? "true" : "false")" />
                                <label class="form-check-label small fw-semibold" for="IsActive">
                                    Aktif
                                </label>
                                <div class="form-text text-muted">Kendi hesabınızı pasife alamazsınız.</div>
                            }
                            else
                            {
                                <input type="checkbox"
                                       class="form-check-input"
                                       id="IsActive"
                                       name="IsActive"
                                       value="true"
                                       @(Model.Form.IsActive ? "checked" : "") />
                                <input type="hidden" name="IsActive" value="false" />
                                <label class="form-check-label small fw-semibold" for="IsActive">
                                    Aktif
                                </label>
                                <div class="form-text">Pasife alınan kullanıcı sisteme giriş yapamaz; açık olan oturumları sonlandırılır.</div>
                            }
                        </div>
                    }
                </div>
            </div>
        </div>

        <!-- Sağ Kolon: Şifre, Güvenlik, Profil -->
        <div class="col-lg-6 col-12">
            <!-- 3. Şifre Kartı -->
            <div class="card shadow-sm border-0 mb-4">
                <div class="card-body pt-3">
                    <h5 class="card-title p-0 pb-2 border-bottom mb-3">
                        <i class="bi bi-key me-2 text-primary"></i>Şifre
                    </h5>

                    @if (Model.IsNew)
                    {
                        <div class="mb-2">
                            <label for="Password" class="form-label small fw-semibold">
                                Geçici şifre (en az 12 karakter) <span class="text-danger">*</span>
                            </label>
                            <input type="password"
                                   class="form-control @(errPassword != null ? "is-invalid" : "")"
                                   id="Password"
                                   name="Password"
                                   autocomplete="new-password"
                                   minlength="12"
                                   required />
                            @if (errPassword != null)
                            {
                                <div class="invalid-feedback d-block">@errPassword</div>
                            }
                            <div class="form-text">Kullanıcı ilk girişte şifresini değiştirmek ve iki adımlı doğrulamayı kurmak zorundadır.</div>
                        </div>
                    }
                    else
                    {
                        <div class="mb-2">
                            <label for="Password" class="form-label small fw-semibold">
                                Yeni geçici şifre (boş bırakırsanız değişmez)
                            </label>
                            <input type="password"
                                   class="form-control @(errPassword != null ? "is-invalid" : "")"
                                   id="Password"
                                   name="Password"
                                   autocomplete="new-password"
                                   minlength="12" />
                            @if (errPassword != null)
                            {
                                <div class="invalid-feedback d-block">@errPassword</div>
                            }
                            <div class="form-text">Yeni şifre belirlendiğinde kullanıcının tüm açık oturumları sonlandırılır ve ilk girişte şifresini değiştirmesi istenir.</div>
                        </div>
                    }
                </div>
            </div>

            <!-- 4. Güvenlik Kartı (Yalnızca Düzenlemede) -->
            @if (!Model.IsNew)
            {
                <div class="card shadow-sm border-0 mb-4">
                    <div class="card-body pt-3">
                        <h5 class="card-title p-0 pb-2 border-bottom mb-3">
                            <i class="bi bi-shield-lock me-2 text-primary"></i>Güvenlik
                        </h5>

                        <div class="p-3 bg-light rounded border mb-3 small text-muted">
                            <div class="d-flex justify-content-between mb-1">
                                <span>İki Adımlı Doğrulama (2FA):</span>
                                <span class="fw-semibold @(Model.Existing?.TwoFactorEnabled == true ? "text-success" : "text-secondary")">
                                    @(Model.Existing?.TwoFactorEnabled == true ? "Açık" : "Kapalı / Kurulmamış")
                                </span>
                            </div>
                            <div class="d-flex justify-content-between mb-1">
                                <span>Son Giriş:</span>
                                <span class="fw-semibold text-dark">@UserLabels.ToTurkeyTime(Model.Existing?.LastLoginAtUtc)</span>
                            </div>
                            <div class="d-flex justify-content-between">
                                <span>Hesap Durumu:</span>
                                <span class="fw-semibold @(Model.Existing?.IsLockedOut == true ? "text-danger" : "text-success")">
                                    @(Model.Existing?.IsLockedOut == true ? "Kilitli (Çok sayıda hatalı giriş)" : "Normal")
                                </span>
                            </div>
                        </div>

                        <div class="form-check mb-3">
                            <input type="checkbox"
                                   class="form-check-input"
                                   id="ResetTwoFactor"
                                   name="ResetTwoFactor"
                                   value="true"
                                   @(Model.Form.ResetTwoFactor ? "checked" : "") />
                            <input type="hidden" name="ResetTwoFactor" value="false" />
                            <label class="form-check-label small fw-semibold" for="ResetTwoFactor">
                                İki adımlı doğrulamayı sıfırla
                            </label>
                            <div class="form-text">Kullanıcının 2FA anahtarını sıfırlar; kullanıcı sonraki girişte yeniden kurulum yapar. Açık oturumlar sonlandırılır.</div>
                        </div>

                        @if (Model.Existing?.IsLockedOut == true)
                        {
                            <div class="form-check mb-2">
                                <input type="checkbox"
                                       class="form-check-input"
                                       id="Unlock"
                                       name="Unlock"
                                       value="true"
                                       @(Model.Form.Unlock ? "checked" : "") />
                                <input type="hidden" name="Unlock" value="false" />
                                <label class="form-check-label small fw-bold text-danger" for="Unlock">
                                    Hesap kilidini kaldır
                                </label>
                                <div class="form-text">Hatalı şifre denemeleri nedeniyle oluşan kilidi temizler ve oturum açmasını sağlar.</div>
                            </div>
                        }
                    </div>
                </div>
            }

            <!-- 5. Profil Kartı -->
            <div class="card shadow-sm border-0 mb-4">
                <div class="card-body pt-3">
                    <h5 class="card-title p-0 pb-2 border-bottom mb-3">
                        <i class="bi bi-person-lines-fill me-2 text-primary"></i>Profil
                    </h5>

                    <div class="mb-3">
                        <label for="AgentDescription" class="form-label small fw-semibold">Danışman Açıklaması / Biyografi</label>
                        <textarea class="form-control @(errDesc != null ? "is-invalid" : "")"
                                  id="AgentDescription"
                                  name="AgentDescription"
                                  rows="4"
                                  placeholder="Danışmanın uzmanlık alanları, deneyimi veya biyografisi...">@Model.Form.AgentDescription</textarea>
                        @if (errDesc != null)
                        {
                            <div class="invalid-feedback d-block">@errDesc</div>
                        }
                    </div>

                    <div class="mb-2">
                        <label for="AgentImgUrl" class="form-label small fw-semibold">Profil Fotoğrafı URL</label>
                        <input type="text"
                               class="form-control @(errImg != null ? "is-invalid" : "")"
                               id="AgentImgUrl"
                               name="AgentImgUrl"
                               value="@Model.Form.AgentImgUrl"
                               placeholder="https://... veya /uploads/..." />
                        @if (errImg != null)
                        {
                            <div class="invalid-feedback d-block">@errImg</div>
                        }
                        <div class="mt-2" data-image-upload data-target="AgentImgUrl" data-folder="agent" data-preview="agentImgPreview"></div>
                    </div>

                    @{
                        var agentPreview = SiteImageUrl.Preview(Model.Form.AgentImgUrl);
                    }
                    <div class="mt-2">
                        <img id="agentImgPreview"
                             src="@(agentPreview ?? "")"
                             alt="Danışman Fotoğrafı"
                             class="rounded border @(string.IsNullOrEmpty(agentPreview) ? "d-none" : "")"
                             style="width: 96px; height: 96px; object-fit: cover;" />
                    </div>
                </div>
            </div>
        </div>

        <!-- 6. Kaydet / Vazgeç Butonları -->
        <div class="col-12">
            <div class="card shadow-sm border-0">
                <div class="card-body p-3">
                    <div class="d-flex flex-wrap align-items-center gap-2 mb-2">
                        <button type="submit" class="btn btn-primary px-4">
                            <i class="bi bi-check-lg me-1"></i> Kaydet
                        </button>
                        <a href="/kullanicilar" class="btn btn-outline-secondary px-3">
                            Vazgeç
                        </a>
                    </div>
                    <div class="small text-muted">
                        <i class="bi bi-info-circle me-1"></i>Pasife alınan kullanıcı giriş yapamaz; kayıtları silinmez.
                    </div>
                </div>
            </div>
        </div>
    </div>
</form>

@section Scripts {
    <script src="~/js/image-upload.js" asp-append-version="true"></script>
}
