@model FibiEmlakDanismanlik.AdminUI.Models.Users.UserIndexViewModel
@using FibiEmlakDanismanlik.AdminUI.Models.Users

@{
    ViewData["Title"] = "Kullanıcılar";
}

<div class="pagetitle d-flex flex-wrap justify-content-between align-items-center gap-2 mb-3">
    <div>
        <h1>Kullanıcılar</h1>
        <nav>
            <ol class="breadcrumb mb-0">
                <li class="breadcrumb-item"><a href="/">Ana Sayfa</a></li>
                <li class="breadcrumb-item active">Kullanıcılar</li>
            </ol>
        </nav>
    </div>
    <div>
        <a href="/kullanicilar/yeni" class="btn btn-primary btn-sm">
            <i class="bi bi-person-plus me-1"></i> Yeni Kullanıcı
        </a>
    </div>
</div>

@if (TempData["Success"] != null)
{
    <div class="alert alert-success alert-dismissible fade show d-flex align-items-center mb-4" role="alert">
        <i class="bi bi-check-circle-fill flex-shrink-0 me-2 fs-5"></i>
        <div>@TempData["Success"]</div>
        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Kapat"></button>
    </div>
}

@if (TempData["Error"] != null)
{
    <div class="alert alert-danger alert-dismissible fade show d-flex align-items-center mb-4" role="alert">
        <i class="bi bi-exclamation-triangle-fill flex-shrink-0 me-2 fs-5"></i>
        <div>@TempData["Error"]</div>
        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Kapat"></button>
    </div>
}

@if (!string.IsNullOrWhiteSpace(Model.ErrorMessage))
{
    <div class="alert alert-danger alert-dismissible fade show d-flex align-items-center mb-4" role="alert">
        <i class="bi bi-exclamation-triangle-fill flex-shrink-0 me-2 fs-5"></i>
        <div>@Model.ErrorMessage</div>
        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Kapat"></button>
    </div>
}

<!-- Filtre Formu (GET) -->
<div class="card mb-4 shadow-sm border-0">
    <div class="card-body pt-3">
        <form method="get" action="/kullanicilar" class="row g-2 align-items-end">
            <div class="col-xl-4 col-md-5 col-12">
                <label for="filterAra" class="form-label small fw-semibold text-muted mb-1">Arama</label>
                <div class="input-group input-group-sm">
                    <span class="input-group-text"><i class="bi bi-search"></i></span>
                    <input type="text" class="form-control form-control-sm" id="filterAra" name="ara" value="@Model.Ara" placeholder="Ad, e-posta veya telefon" />
                </div>
            </div>

            <div class="col-xl-3 col-md-3 col-sm-6 col-12">
                <label for="filterRol" class="form-label small fw-semibold text-muted mb-1">Rol</label>
                <select class="form-select form-select-sm" id="filterRol" name="rol">
                    <option value="" selected="@(string.IsNullOrWhiteSpace(Model.Rol) ? "selected" : null)">Tümü</option>
                    <option value="Owner" selected="@(string.Equals(Model.Rol, "Owner", StringComparison.OrdinalIgnoreCase) ? "selected" : null)">Sahip</option>
                    <option value="Manager" selected="@(string.Equals(Model.Rol, "Manager", StringComparison.OrdinalIgnoreCase) ? "selected" : null)">Yönetici</option>
                    <option value="Consultant" selected="@(string.Equals(Model.Rol, "Consultant", StringComparison.OrdinalIgnoreCase) ? "selected" : null)">Danışman</option>
                </select>
            </div>

            <div class="col-xl-3 col-md-4 col-sm-6 col-12 d-flex align-items-center pb-1">
                <div class="form-check form-switch mb-0">
                    <input class="form-check-input" type="checkbox" id="filterPasif" name="pasif" value="true" @(Model.PasifleriGoster ? "checked" : "") />
                    <label class="form-check-label small fw-semibold text-muted" for="filterPasif">Pasifleri göster</label>
                </div>
            </div>

            <div class="col-auto d-flex gap-2 ms-auto mt-2">
                <button type="submit" class="btn btn-sm btn-primary px-3">
                    <i class="bi bi-funnel me-1"></i> Filtrele
                </button>
                <a href="/kullanicilar" class="btn btn-sm btn-outline-secondary px-3">
                    <i class="bi bi-x-circle me-1"></i> Temizle
                </a>
            </div>
        </form>
    </div>
</div>

@if (Model.Users == null || !Model.Users.Any())
{
    <div class="card border-0 shadow-sm">
        <div class="card-body text-center py-5">
            <i class="bi bi-people fs-1 text-muted d-block mb-3"></i>
            <h5 class="fw-semibold text-secondary">Kayıt bulunamadı.</h5>
            <p class="text-muted small mb-0">Arama kriterlerine uygun kullanıcı bulunamadı.</p>
        </div>
    </div>
}
else
{
    <!-- Masaüstü Tablo Görünümü -->
    <div class="card border-0 shadow-sm d-none d-md-block mb-4">
        <div class="card-body p-0">
            <div class="table-responsive">
                <table class="table table-hover align-middle mb-0">
                    <thead class="table-light text-muted small text-uppercase">
                        <tr>
                            <th scope="col" class="ps-3">Ad / Unvan</th>
                            <th scope="col">E-posta</th>
                            <th scope="col">Telefon</th>
                            <th scope="col">Rol</th>
                            <th scope="col">Durum</th>
                            <th scope="col" class="text-center">Sitede</th>
                            <th scope="col">Son Giriş</th>
                            <th scope="col" class="text-end pe-3">İşlem</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var user in Model.Users)
                        {
                            <tr>
                                <td class="ps-3">
                                    <div class="fw-semibold text-dark">
                                        @user.AgentName
                                        @if (user.AgentId == Model.CurrentAgentId)
                                        {
                                            <span class="badge bg-info-subtle text-info border border-info-subtle ms-1">siz</span>
                                        }
                                    </div>
                                    @if (!string.IsNullOrWhiteSpace(user.AgentTitle))
                                    {
                                        <div class="small text-muted">@user.AgentTitle</div>
                                    }
                                </td>
                                <td>
                                    <span class="small text-dark">@(user.Mail ?? "—")</span>
                                </td>
                                <td>
                                    <span class="small text-dark text-nowrap">@(user.AgentPhoneNumber ?? "—")</span>
                                </td>
                                <td>
                                    <span class="badge bg-@UserLabels.RoleBadge(user.Role)">
                                        @UserLabels.RoleName(user.Role)
                                    </span>
                                </td>
                                <td>
                                    <div class="d-flex flex-wrap gap-1 align-items-center">
                                        @if (user.IsActive)
                                        {
                                            <span class="badge bg-success">Aktif</span>
                                        }
                                        else
                                        {
                                            <span class="badge bg-secondary">Pasif</span>
                                        }

                                        @if (user.IsLockedOut)
                                        {
                                            <span class="badge bg-danger">Kilitli</span>
                                        }

                                        @if (user.TwoFactorEnabled)
                                        {
                                            <span class="badge bg-success" title="İki Adımlı Doğrulama Açık">2FA</span>
                                        }
                                        else
                                        {
                                            <span class="badge bg-secondary-subtle text-secondary border" title="İki Adımlı Doğrulama Kapalı">2FA</span>
                                        }

                                        @if (user.MustChangePassword)
                                        {
                                            <span class="badge bg-warning text-dark" title="İlk girişte şifre değiştirilmeli">Şifre değişmeli</span>
                                        }
                                    </div>
                                </td>
                                <td class="text-center">
                                    @if (user.ShowOnWebsite)
                                    {
                                        <span class="text-success fw-bold fs-6" title="Sitede danışman olarak gösteriliyor">✓</span>
                                    }
                                    else
                                    {
                                        <span class="text-muted">—</span>
                                    }
                                </td>
                                <td class="text-nowrap small text-muted">
                                    @UserLabels.ToTurkeyTime(user.LastLoginAtUtc)
                                </td>
                                <td class="text-end pe-3">
                                    <a href="/kullanicilar/@user.AgentId" class="btn btn-outline-primary btn-sm text-nowrap">
                                        <i class="bi bi-pencil me-1"></i> Düzenle
                                    </a>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>

    <!-- Mobil Kart Görünümü (d-md-none) -->
    <div class="d-md-none mb-4">
        @foreach (var user in Model.Users)
        {
            <div class="card mb-3 shadow-sm border-0">
                <div class="card-body p-3">
                    <div class="d-flex justify-content-between align-items-start mb-2">
                        <div>
                            <span class="badge bg-@UserLabels.RoleBadge(user.Role) me-1">@UserLabels.RoleName(user.Role)</span>
                            @if (user.IsActive)
                            {
                                <span class="badge bg-success">Aktif</span>
                            }
                            else
                            {
                                <span class="badge bg-secondary">Pasif</span>
                            }
                        </div>
                        <div class="d-flex gap-1">
                            @if (user.TwoFactorEnabled)
                            {
                                <span class="badge bg-success">2FA</span>
                            }
                            else
                            {
                                <span class="badge bg-secondary-subtle text-secondary border">2FA</span>
                            }
                            @if (user.IsLockedOut)
                            {
                                <span class="badge bg-danger">Kilitli</span>
                            }
                        </div>
                    </div>

                    <div class="mb-2">
                        <h6 class="fw-bold text-dark mb-0">
                            @user.AgentName
                            @if (user.AgentId == Model.CurrentAgentId)
                            {
                                <span class="badge bg-info-subtle text-info border border-info-subtle ms-1">siz</span>
                            }
                        </h6>
                        @if (!string.IsNullOrWhiteSpace(user.AgentTitle))
                        {
                            <div class="small text-muted">@user.AgentTitle</div>
                        }
                    </div>

                    <div class="d-flex flex-column gap-1 small text-muted p-2 bg-light rounded mb-3">
                        <div class="d-flex justify-content-between">
                            <span>E-posta:</span>
                            <span class="text-dark text-break fw-medium">@(user.Mail ?? "—")</span>
                        </div>
                        <div class="d-flex justify-content-between">
                            <span>Telefon:</span>
                            <span class="text-dark fw-medium">@(user.AgentPhoneNumber ?? "—")</span>
                        </div>
                        <div class="d-flex justify-content-between">
                            <span>Sitede Göster:</span>
                            <span class="fw-bold @(user.ShowOnWebsite ? "text-success" : "text-muted")">@(user.ShowOnWebsite ? "✓" : "—")</span>
                        </div>
                        <div class="d-flex justify-content-between">
                            <span>Son Giriş:</span>
                            <span class="text-dark">@UserLabels.ToTurkeyTime(user.LastLoginAtUtc)</span>
                        </div>
                        @if (user.MustChangePassword)
                        {
                            <div class="d-flex justify-content-between pt-1 border-top">
                                <span>Şifre Durumu:</span>
                                <span class="badge bg-warning text-dark">Şifre değişmeli</span>
                            </div>
                        }
                    </div>

                    <div class="d-flex justify-content-end">
                        <a href="/kullanicilar/@user.AgentId" class="btn btn-outline-primary btn-sm px-3 w-100 text-center">
                            <i class="bi bi-pencil me-1"></i> Düzenle
                        </a>
                    </div>
                </div>
            </div>
        }
    </div>
}
