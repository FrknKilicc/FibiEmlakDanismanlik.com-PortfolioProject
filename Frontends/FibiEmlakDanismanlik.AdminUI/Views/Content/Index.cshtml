@model FibiEmlakDanismanlik.AdminUI.Models.Content.ContentIndexViewModel
@using FibiEmlakDanismanlik.AdminUI.Models.Content
@inject FibiEmlakDanismanlik.AdminUI.Infrastructure.SiteImageUrl SiteImageUrl

@{
    ViewData["Title"] = "İçerik";
    var currentSekme = Model.Sekme ?? "hakkimizda";
}

<div class="pagetitle d-flex flex-wrap justify-content-between align-items-center gap-2 mb-3">
    <div>
        <h1>İçerik</h1>
        <nav>
            <ol class="breadcrumb mb-0">
                <li class="breadcrumb-item"><a href="/">Ana Sayfa</a></li>
                <li class="breadcrumb-item active">İçerik</li>
            </ol>
        </nav>
    </div>
</div>

@if (TempData["Success"] != null)
{
    <div class="alert alert-success alert-dismissible fade show d-flex align-items-center mb-4" role="alert">
        <i class="bi bi-check-circle-fill flex-shrink-0 me-2 fs-5"></i>
        <div>@TempData["Success"]</div>
        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Kapat"></button>
    </div>
}

@if (TempData["Error"] != null)
{
    <div class="alert alert-danger alert-dismissible fade show d-flex align-items-center mb-4" role="alert">
        <i class="bi bi-exclamation-triangle-fill flex-shrink-0 me-2 fs-5"></i>
        <div>@TempData["Error"]</div>
        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Kapat"></button>
    </div>
}

@if (!string.IsNullOrWhiteSpace(Model.ErrorMessage))
{
    <div class="alert alert-danger alert-dismissible fade show d-flex align-items-center mb-4" role="alert">
        <i class="bi bi-exclamation-triangle-fill flex-shrink-0 me-2 fs-5"></i>
        <div>@Model.ErrorMessage</div>
        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Kapat"></button>
    </div>
}

<!-- Sekmeler (Nav-pills ile linkler) -->
<partial name="_ContentNav" model="currentSekme" />

<!-- ========================================== -->
<!-- 1. HAKKIMIZDA SEKME İÇERİĞİ               -->
<!-- ========================================== -->
@if (currentSekme == "hakkimizda")
{
    var errTitle = Model.GetFieldError("about", "AboutUsTitle");
    var errDesc = Model.GetFieldError("about", "AboutUsDesc");
    var errImg = Model.GetFieldError("about", "AboutUsImgUrl");

    <div class="row">
        <div class="col-lg-9 col-12">
            <div class="card shadow-sm border-0 mb-4">
                <div class="card-body pt-3">
                    <h5 class="card-title p-0 pb-2 border-bottom mb-3">
                        <i class="bi bi-info-circle me-2 text-primary"></i>Hakkımızda İçeriği
                    </h5>

                    <form method="post" action="/icerik/hakkimizda">
                        @Html.AntiForgeryToken()
                        <input type="hidden" name="AboutUsId" value="@(Model.AboutUs?.AboutUsId ?? 0)" />

                        <div class="mb-3">
                            <label for="aboutUsTitle" class="form-label small fw-semibold">
                                Başlık <span class="text-danger">*</span>
                            </label>
                            <input type="text"
                                   class="form-control @(errTitle != null ? "is-invalid" : "")"
                                   id="aboutUsTitle"
                                   name="AboutUsTitle"
                                   value="@Model.AboutUs?.AboutUsTitle"
                                   placeholder="Örn: Fibi Emlak Danışmanlık Hakkında"
                                   required />
                            @if (errTitle != null)
                            {
                                <div class="invalid-feedback d-block">@errTitle</div>
                            }
                        </div>

                        <div class="mb-3">
                            <label for="aboutUsImgUrl" class="form-label small fw-semibold">
                                Görsel Adresi (URL / Yol)
                            </label>
                            <input type="text"
                                   class="form-control @(errImg != null ? "is-invalid" : "")"
                                   id="aboutUsImgUrl"
                                   name="AboutUsImgUrl"
                                   value="@Model.AboutUs?.AboutUsImgUrl"
                                   placeholder="https://... veya /uploads/..." />
                            @if (errImg != null)
                            {
                                <div class="invalid-feedback d-block">@errImg</div>
                            }
                            <div class="mt-2" data-image-upload data-target="aboutUsImgUrl" data-folder="about" data-preview="aboutUsImgPreview"></div>

                            @{
                                var aboutPreview = SiteImageUrl.Preview(Model.AboutUs?.AboutUsImgUrl);
                            }
                            <div class="mt-2 p-2 border rounded bg-light d-inline-block">
                                <div class="small text-muted mb-1">Mevcut Görsel Önizleme:</div>
                                <img id="aboutUsImgPreview"
                                     src="@(aboutPreview ?? "")"
                                     alt="Hakkımızda Görseli"
                                     class="img-thumbnail @(string.IsNullOrEmpty(aboutPreview) ? "d-none" : "")"
                                     style="max-height: 120px; max-width: 260px; object-fit: cover;" />
                            </div>
                        </div>

                        <div class="mb-4">
                            <label for="aboutUsDesc" class="form-label small fw-semibold">
                                Açıklama
                            </label>
                            <textarea class="form-control @(errDesc != null ? "is-invalid" : "")"
                                      id="aboutUsDesc"
                                      name="AboutUsDesc"
                                      rows="14"
                                      placeholder="Şirketimiz hakkında ayrıntılı açıklama metni...">@Model.AboutUs?.AboutUsDesc</textarea>
                            <div class="form-text text-muted">HTML kullanılabilir; sitede güvenli hale getirilerek gösterilir.</div>
                            @if (errDesc != null)
                            {
                                <div class="invalid-feedback d-block">@errDesc</div>
                            }
                        </div>

                        <div class="d-flex align-items-center gap-2">
                            <button type="submit" class="btn btn-primary px-4">
                                <i class="bi bi-check-lg me-1"></i> Kaydet
                            </button>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
}

<!-- ========================================== -->
<!-- 2. İLETİŞİM BİLGİLERİ SEKME İÇERİĞİ        -->
<!-- ========================================== -->
@if (currentSekme == "iletisim")
{
    var errMail1 = Model.GetFieldError("contact", "EMail1");
    var errMail2 = Model.GetFieldError("contact", "EMail2");
    var errPhone1 = Model.GetFieldError("contact", "PhoneNumber1");
    var errPhone2 = Model.GetFieldError("contact", "PhoneNumber2");
    var errAddress = Model.GetFieldError("contact", "OfficeAddress");

    <div class="row">
        <div class="col-lg-8 col-12">
            <div class="card shadow-sm border-0 mb-4">
                <div class="card-body pt-3">
                    <h5 class="card-title p-0 pb-2 border-bottom mb-3">
                        <i class="bi bi-telephone me-2 text-primary"></i>İletişim Bilgileri
                    </h5>

                    <form method="post" action="/icerik/iletisim">
                        @Html.AntiForgeryToken()
                        <input type="hidden" name="ContactId" value="@(Model.Contact?.ContactId ?? 0)" />

                        <div class="row g-3 mb-3">
                            <div class="col-md-6 col-12">
                                <label for="eMail1" class="form-label small fw-semibold">
                                    E-posta 1 <span class="text-danger">*</span>
                                </label>
                                <input type="email"
                                       class="form-control @(errMail1 != null ? "is-invalid" : "")"
                                       id="eMail1"
                                       name="EMail1"
                                       value="@Model.Contact?.EMail1"
                                       placeholder="info@fibiemlak.com"
                                       required />
                                @if (errMail1 != null)
                                {
                                    <div class="invalid-feedback d-block">@errMail1</div>
                                }
                            </div>

                            <div class="col-md-6 col-12">
                                <label for="eMail2" class="form-label small fw-semibold">
                                    E-posta 2
                                </label>
                                <input type="email"
                                       class="form-control @(errMail2 != null ? "is-invalid" : "")"
                                       id="eMail2"
                                       name="EMail2"
                                       value="@Model.Contact?.EMail2"
                                       placeholder="destek@fibiemlak.com" />
                                @if (errMail2 != null)
                                {
                                    <div class="invalid-feedback d-block">@errMail2</div>
                                }
                            </div>
                        </div>

                        <div class="row g-3 mb-3">
                            <div class="col-md-6 col-12">
                                <label for="phoneNumber1" class="form-label small fw-semibold">
                                    Telefon 1 <span class="text-danger">*</span>
                                </label>
                                <input type="tel"
                                       class="form-control @(errPhone1 != null ? "is-invalid" : "")"
                                       id="phoneNumber1"
                                       name="PhoneNumber1"
                                       value="@Model.Contact?.PhoneNumber1"
                                       placeholder="0212 123 45 67"
                                       required />
                                @if (errPhone1 != null)
                                {
                                    <div class="invalid-feedback d-block">@errPhone1</div>
                                }
                            </div>

                            <div class="col-md-6 col-12">
                                <label for="phoneNumber2" class="form-label small fw-semibold">
                                    Telefon 2
                                </label>
                                <input type="tel"
                                       class="form-control @(errPhone2 != null ? "is-invalid" : "")"
                                       id="phoneNumber2"
                                       name="PhoneNumber2"
                                       value="@Model.Contact?.PhoneNumber2"
                                       placeholder="0532 123 45 67" />
                                @if (errPhone2 != null)
                                {
                                    <div class="invalid-feedback d-block">@errPhone2</div>
                                }
                            </div>
                        </div>

                        <div class="mb-4">
                            <label for="officeAddress" class="form-label small fw-semibold">
                                Ofis Adresi <span class="text-danger">*</span>
                            </label>
                            <textarea class="form-control @(errAddress != null ? "is-invalid" : "")"
                                      id="officeAddress"
                                      name="OfficeAddress"
                                      rows="3"
                                      placeholder="Şirket merkez veya şube adresi..."
                                      required>@Model.Contact?.OfficeAddress</textarea>
                            @if (errAddress != null)
                            {
                                <div class="invalid-feedback d-block">@errAddress</div>
                            }
                        </div>

                        <div class="d-flex align-items-center gap-2">
                            <button type="submit" class="btn btn-primary px-4">
                                <i class="bi bi-check-lg me-1"></i> Kaydet
                            </button>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
}

<!-- ========================================== -->
<!-- 3. SOSYAL MEDYA SEKME İÇERİĞİ              -->
<!-- ========================================== -->
@if (currentSekme == "sosyal-medya")
{
    var errNewName = Model.GetFieldError("social-new", "Name");
    var errNewUrl = Model.GetFieldError("social-new", "Url");
    var errNewIcon = Model.GetFieldError("social-new", "Icon");
    var errNewOrder = Model.GetFieldError("social-new", "Order");

    <div class="card shadow-sm border-0 mb-4">
        <div class="card-body pt-3">
            <div class="d-flex justify-content-between align-items-center pb-2 border-bottom mb-3">
                <h5 class="card-title p-0 m-0">
                    <i class="bi bi-share me-2 text-primary"></i>Sosyal Medya Hesapları
                </h5>
            </div>

            <div class="alert alert-info py-2 px-3 small d-flex align-items-center mb-3">
                <i class="bi bi-info-circle-fill me-2 fs-6"></i>
                <div>İkon sınıfı Font Awesome biçiminde (ör. <code>fab fa-instagram</code>, <code>fab fa-facebook</code>). Adres http:// veya https:// ile başlamalı.</div>
            </div>

            @if (Model.SocialMedia == null || !Model.SocialMedia.Any())
            {
                <div class="text-center py-4 text-muted">
                    <i class="bi bi-share fs-2 d-block mb-2"></i>
                    Henüz kayıtlı sosyal medya hesabı bulunmuyor.
                </div>
            }
            else
            {
                <div class="table-responsive mb-4">
                    <table class="table table-hover align-middle mb-0">
                        <thead class="table-light text-muted small text-uppercase">
                            <tr>
                                <th scope="col" style="width: 70px;">Sıra</th>
                                <th scope="col">Ad</th>
                                <th scope="col">Adres</th>
                                <th scope="col">İkon</th>
                                <th scope="col">Durum</th>
                                <th scope="col" class="text-end" style="min-width: 170px;">İşlemler</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var item in Model.SocialMedia)
                            {
                                var formKey = $"social-{item.Id}";
                                bool isThisOpen = Model.IsForm(formKey);
                                var errItemName = Model.GetFieldError(formKey, "Name");
                                var errItemUrl = Model.GetFieldError(formKey, "Url");
                                var errItemIcon = Model.GetFieldError(formKey, "Icon");
                                var errItemOrder = Model.GetFieldError(formKey, "Order");

                                <tr>
                                    <td class="fw-semibold">@item.Order</td>
                                    <td class="fw-semibold text-dark">@item.Name</td>
                                    <td>
                                        @if (!string.IsNullOrWhiteSpace(item.Url))
                                        {
                                            <a href="@item.Url" target="_blank" rel="noopener noreferrer" class="text-break text-decoration-none">
                                                @item.Url <i class="bi bi-box-arrow-up-right small ms-1"></i>
                                            </a>
                                        }
                                        else
                                        {
                                            <span class="text-muted">—</span>
                                        }
                                    </td>
                                    <td>
                                        @if (!string.IsNullOrWhiteSpace(item.Icon))
                                        {
                                            <span class="text-nowrap"><i class="@item.Icon me-1"></i> <code>@item.Icon</code></span>
                                        }
                                        else
                                        {
                                            <span class="text-muted">—</span>
                                        }
                                    </td>
                                    <td>
                                        @if (item.IsActive)
                                        {
                                            <span class="badge bg-success">Aktif</span>
                                        }
                                        else
                                        {
                                            <span class="badge bg-secondary">Pasif</span>
                                        }
                                    </td>
                                    <td class="text-end">
                                        <!-- Düzenle Detayı -->
                                        <details class="d-inline-block text-start mb-1" @(isThisOpen ? "open" : "")>
                                            <summary class="btn btn-outline-primary btn-sm">
                                                <i class="bi bi-pencil me-1"></i> Düzenle
                                             </summary>
                                            <div class="card card-body p-3 shadow-sm border mt-2" style="min-width: 280px; max-width: 100%;">
                                                <h6 class="fw-semibold mb-2 text-primary border-bottom pb-1">Hesabı Düzenle</h6>
                                                <form method="post" action="/icerik/sosyal-medya/@item.Id">
                                                    @Html.AntiForgeryToken()
                                                    <input type="hidden" name="Id" value="@item.Id" />

                                                    <div class="mb-2">
                                                        <label class="form-label small fw-semibold">Ad</label>
                                                        <input type="text"
                                                               class="form-control form-control-sm @(errItemName != null ? "is-invalid" : "")"
                                                               name="Name"
                                                               value="@item.Name"
                                                               required />
                                                        @if (errItemName != null)
                                                        {
                                                            <div class="invalid-feedback d-block">@errItemName</div>
                                                        }
                                                    </div>

                                                    <div class="mb-2">
                                                        <label class="form-label small fw-semibold">Adres (URL)</label>
                                                        <input type="url"
                                                               class="form-control form-control-sm @(errItemUrl != null ? "is-invalid" : "")"
                                                               name="Url"
                                                               value="@item.Url"
                                                               placeholder="https://..."
                                                               required />
                                                        @if (errItemUrl != null)
                                                        {
                                                            <div class="invalid-feedback d-block">@errItemUrl</div>
                                                        }
                                                    </div>

                                                    <div class="mb-2">
                                                        <label class="form-label small fw-semibold">İkon Sınıfı</label>
                                                        <input type="text"
                                                               class="form-control form-control-sm @(errItemIcon != null ? "is-invalid" : "")"
                                                               name="Icon"
                                                               value="@item.Icon"
                                                               placeholder="fab fa-instagram" />
                                                        @if (errItemIcon != null)
                                                        {
                                                            <div class="invalid-feedback d-block">@errItemIcon</div>
                                                        }
                                                    </div>

                                                    <div class="mb-2">
                                                        <label class="form-label small fw-semibold">Sıra</label>
                                                        <input type="number"
                                                               class="form-control form-control-sm @(errItemOrder != null ? "is-invalid" : "")"
                                                               name="Order"
                                                               value="@item.Order" />
                                                        @if (errItemOrder != null)
                                                        {
                                                            <div class="invalid-feedback d-block">@errItemOrder</div>
                                                        }
                                                    </div>

                                                    <div class="form-check form-switch mb-3">
                                                        <input type="checkbox"
                                                               class="form-check-input"
                                                               id="isActive_@item.Id"
                                                               name="IsActive"
                                                               value="true"
                                                               @(item.IsActive ? "checked" : "") />
                                                        <input type="hidden" name="IsActive" value="false" />
                                                        <label class="form-check-label small" for="isActive_@item.Id">Aktif</label>
                                                    </div>

                                                    <button type="submit" class="btn btn-primary btn-sm w-100">
                                                        <i class="bi bi-check-lg me-1"></i> Güncelle
                                                    </button>
                                                </form>
                                            </div>
                                        </details>

                                        <!-- Sil Onay Detayı -->
                                        <details class="d-inline-block text-start ms-1 mb-1">
                                            <summary class="btn btn-outline-danger btn-sm">
                                                <i class="bi bi-trash me-1"></i> Sil
                                            </summary>
                                            <div class="card card-body p-2 shadow-sm border mt-2 bg-light" style="min-width: 200px;">
                                                <div class="small text-danger fw-semibold mb-2">Silmek istediğinize emin misiniz?</div>
                                                <form method="post" action="/icerik/sosyal-medya/@item.Id/sil">
                                                    @Html.AntiForgeryToken()
                                                    <button type="submit" class="btn btn-danger btn-sm w-100">
                                                        Evet, Sil
                                                    </button>
                                                </form>
                                            </div>
                                        </details>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            }

            <!-- Yeni Sosyal Medya Hesabı Formu -->
            <div class="card bg-light border-0 shadow-sm mt-3">
                <div class="card-body p-3">
                    <h6 class="fw-bold text-dark mb-3">
                        <i class="bi bi-plus-circle me-1 text-primary"></i> Yeni Sosyal Medya Hesabı Ekle
                    </h6>

                    <form method="post" action="/icerik/sosyal-medya">
                        @Html.AntiForgeryToken()

                        <div class="row g-3">
                            <div class="col-md-3 col-12">
                                <label for="newSocialName" class="form-label small fw-semibold">
                                    Hesap Adı <span class="text-danger">*</span>
                                </label>
                                <input type="text"
                                       class="form-control form-control-sm @(errNewName != null ? "is-invalid" : "")"
                                       id="newSocialName"
                                       name="Name"
                                       value="@Model.NewSocial?.Name"
                                       placeholder="Örn: Instagram"
                                       required />
                                @if (errNewName != null)
                                {
                                    <div class="invalid-feedback d-block">@errNewName</div>
                                }
                            </div>

                            <div class="col-md-4 col-12">
                                <label for="newSocialUrl" class="form-label small fw-semibold">
                                    Adres (URL) <span class="text-danger">*</span>
                                </label>
                                <input type="url"
                                       class="form-control form-control-sm @(errNewUrl != null ? "is-invalid" : "")"
                                       id="newSocialUrl"
                                       name="Url"
                                       value="@Model.NewSocial?.Url"
                                       placeholder="https://instagram.com/fibiemlak"
                                       required />
                                @if (errNewUrl != null)
                                {
                                    <div class="invalid-feedback d-block">@errNewUrl</div>
                                }
                            </div>

                            <div class="col-md-3 col-sm-6 col-12">
                                <label for="newSocialIcon" class="form-label small fw-semibold">
                                    İkon Sınıfı
                                </label>
                                <input type="text"
                                       class="form-control form-control-sm @(errNewIcon != null ? "is-invalid" : "")"
                                       id="newSocialIcon"
                                       name="Icon"
                                       value="@Model.NewSocial?.Icon"
                                       placeholder="fab fa-instagram" />
                                @if (errNewIcon != null)
                                {
                                    <div class="invalid-feedback d-block">@errNewIcon</div>
                                }
                            </div>

                            <div class="col-md-2 col-sm-6 col-12">
                                <label for="newSocialOrder" class="form-label small fw-semibold">
                                    Sıra
                                </label>
                                <input type="number"
                                       class="form-control form-control-sm @(errNewOrder != null ? "is-invalid" : "")"
                                       id="newSocialOrder"
                                       name="Order"
                                       value="@(Model.NewSocial?.Order ?? 1)" />
                                @if (errNewOrder != null)
                                {
                                    <div class="invalid-feedback d-block">@errNewOrder</div>
                                }
                            </div>

                            <div class="col-12 d-flex flex-wrap align-items-center justify-content-between gap-2 pt-2">
                                <div class="form-check form-switch mb-0">
                                    <input type="checkbox"
                                           class="form-check-input"
                                           id="newSocialIsActive"
                                           name="IsActive"
                                           value="true"
                                           @(Model.NewSocial == null || Model.NewSocial.IsActive ? "checked" : "") />
                                    <input type="hidden" name="IsActive" value="false" />
                                    <label class="form-check-label small fw-semibold" for="newSocialIsActive">Aktif</label>
                                </div>

                                <button type="submit" class="btn btn-primary btn-sm px-3">
                                    <i class="bi bi-plus-lg me-1"></i> Hesap Ekle
                                </button>
                            </div>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
}

<!-- ========================================== -->
<!-- 4. SSS SEKME İÇERİĞİ                      -->
<!-- ========================================== -->
@if (currentSekme == "sss")
{
    var errNewQuestion = Model.GetFieldError("faq-new", "Question");
    var errNewAnswer = Model.GetFieldError("faq-new", "Answer");

    <div class="card shadow-sm border-0 mb-4">
        <div class="card-body pt-3">
            <h5 class="card-title p-0 pb-2 border-bottom mb-3">
                <i class="bi bi-question-circle me-2 text-primary"></i>Sıkça Sorulan Sorular
            </h5>

            @if (Model.Faqs == null || !Model.Faqs.Any())
            {
                <div class="text-center py-4 text-muted">
                    <i class="bi bi-question-circle fs-2 d-block mb-2"></i>
                    Henüz kayıtlı soru bulunmuyor.
                </div>
            }
            else
            {
                <div class="d-flex flex-column gap-3 mb-4">
                    @foreach (var item in Model.Faqs)
                    {
                        var formKey = $"faq-{item.FrequentlyAskedQuestionId}";
                        bool isThisOpen = Model.IsForm(formKey);
                        var errItemQ = Model.GetFieldError(formKey, "Question");
                        var errItemA = Model.GetFieldError(formKey, "Answer");

                        <div class="card border shadow-none mb-0">
                            <div class="card-body p-3">
                                <div class="d-flex flex-wrap justify-content-between align-items-start gap-2 mb-2">
                                    <h6 class="fw-bold text-dark mb-0 flex-grow-1">
                                        <i class="bi bi-question-diamond text-primary me-1"></i> @item.Question
                                    </h6>
                                    <div class="d-flex gap-1">
                                        <details class="d-inline-block" @(isThisOpen ? "open" : "")>
                                            <summary class="btn btn-outline-primary btn-sm">
                                                <i class="bi bi-pencil me-1"></i> Düzenle
                                            </summary>
                                            <div class="card card-body p-3 shadow-sm border mt-2 text-start" style="min-width: 280px; max-width: 100%;">
                                                <h6 class="fw-semibold mb-2 text-primary border-bottom pb-1">Soruyu Düzenle</h6>
                                                <form method="post" action="/icerik/sss/@item.FrequentlyAskedQuestionId">
                                                    @Html.AntiForgeryToken()
                                                    <input type="hidden" name="FrequentlyAskedQuestionId" value="@item.FrequentlyAskedQuestionId" />

                                                    <div class="mb-2">
                                                        <label class="form-label small fw-semibold">Soru <span class="text-danger">*</span></label>
                                                        <input type="text"
                                                               class="form-control form-control-sm @(errItemQ != null ? "is-invalid" : "")"
                                                               name="Question"
                                                               value="@item.Question"
                                                               required />
                                                        @if (errItemQ != null)
                                                        {
                                                            <div class="invalid-feedback d-block">@errItemQ</div>
                                                        }
                                                    </div>

                                                    <div class="mb-3">
                                                        <label class="form-label small fw-semibold">Cevap <span class="text-danger">*</span></label>
                                                        <textarea class="form-control form-control-sm @(errItemA != null ? "is-invalid" : "")"
                                                                  name="Answer"
                                                                  rows="4"
                                                                  required>@item.Answer</textarea>
                                                        @if (errItemA != null)
                                                        {
                                                            <div class="invalid-feedback d-block">@errItemA</div>
                                                        }
                                                    </div>

                                                    <button type="submit" class="btn btn-primary btn-sm w-100">
                                                        <i class="bi bi-check-lg me-1"></i> Güncelle
                                                    </button>
                                                </form>
                                            </div>
                                        </details>

                                        <details class="d-inline-block">
                                            <summary class="btn btn-outline-danger btn-sm">
                                                <i class="bi bi-trash me-1"></i> Sil
                                            </summary>
                                            <div class="card card-body p-2 shadow-sm border mt-2 bg-light text-start" style="min-width: 200px;">
                                                <div class="small text-danger fw-semibold mb-2">Bu soruyu silmek istediğinize emin misiniz?</div>
                                                <form method="post" action="/icerik/sss/@item.FrequentlyAskedQuestionId/sil">
                                                    @Html.AntiForgeryToken()
                                                    <button type="submit" class="btn btn-danger btn-sm w-100">
                                                        Evet, Sil
                                                    </button>
                                                </form>
                                            </div>
                                        </details>
                                    </div>
                                </div>

                                <div class="text-secondary small text-break" style="white-space: pre-line;">
                                    @item.Answer
                                </div>
                            </div>
                        </div>
                    }
                </div>
            }

            <!-- Yeni Soru Formu -->
            <div class="card bg-light border-0 shadow-sm mt-3">
                <div class="card-body p-3">
                    <h6 class="fw-bold text-dark mb-3">
                        <i class="bi bi-plus-circle me-1 text-primary"></i> Yeni Soru Ekle
                    </h6>

                    <form method="post" action="/icerik/sss">
                        @Html.AntiForgeryToken()

                        <div class="mb-3">
                            <label for="newFaqQuestion" class="form-label small fw-semibold">
                                Soru <span class="text-danger">*</span>
                            </label>
                            <input type="text"
                                   class="form-control @(errNewQuestion != null ? "is-invalid" : "")"
                                   id="newFaqQuestion"
                                   name="Question"
                                   value="@Model.NewFaq?.Question"
                                   placeholder="Örn: Evimi satmak için hangi belgeler gereklidir?"
                                   required />
                            @if (errNewQuestion != null)
                            {
                                <div class="invalid-feedback d-block">@errNewQuestion</div>
                            }
                        </div>

                        <div class="mb-3">
                            <label for="newFaqAnswer" class="form-label small fw-semibold">
                                Cevap <span class="text-danger">*</span>
                            </label>
                            <textarea class="form-control @(errNewAnswer != null ? "is-invalid" : "")"
                                      id="newFaqAnswer"
                                      name="Answer"
                                      rows="4"
                                      placeholder="Sorunun ayrıntılı yanıtı..."
                                      required>@Model.NewFaq?.Answer</textarea>
                            @if (errNewAnswer != null)
                            {
                                <div class="invalid-feedback d-block">@errNewAnswer</div>
                            }
                        </div>

                        <div class="d-flex justify-content-end">
                            <button type="submit" class="btn btn-primary btn-sm px-4">
                                <i class="bi bi-plus-lg me-1"></i> Soru Ekle
                            </button>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
}

<!-- ========================================== -->
<!-- 5. BANNER SEKME İÇERİĞİ                   -->
<!-- ========================================== -->
@if (currentSekme == "banner")
{
    var errNewBannerUrl = Model.GetFieldError("banner-new", "MainBannerUrl");
    var errNewBannerDesc = Model.GetFieldError("banner-new", "MainBannerDesc");

    <div class="card shadow-sm border-0 mb-4">
        <div class="card-body pt-3">
            <h5 class="card-title p-0 pb-2 border-bottom mb-3">
                <i class="bi bi-image me-2 text-primary"></i>Ana Sayfa Banner Görselleri
            </h5>

            <div class="alert alert-info py-2 px-3 small d-flex align-items-center mb-3">
                <i class="bi bi-info-circle-fill me-2 fs-6"></i>
                <div>Görsel adresi site içi yol (<code>/...</code>) ya da https adresi olmalı; dosya yükleme butonu ile görsel yükleyebilirsiniz.</div>
            </div>

            @if (Model.Banners == null || !Model.Banners.Any())
            {
                <div class="text-center py-4 text-muted">
                    <i class="bi bi-image fs-2 d-block mb-2"></i>
                    Henüz kayıtlı banner bulunmuyor.
                </div>
            }
            else
            {
                <div class="row g-3 mb-4">
                    @foreach (var item in Model.Banners)
                    {
                        var formKey = $"banner-{item.MainBannerId}";
                        bool isThisOpen = Model.IsForm(formKey);
                        var errItemUrl = Model.GetFieldError(formKey, "MainBannerUrl");
                        var errItemDesc = Model.GetFieldError(formKey, "MainBannerDesc");

                        var bannerPreview = SiteImageUrl.Preview(item.MainBannerUrl);

                        <div class="col-lg-6 col-12">
                            <div class="card border shadow-none h-100">
                                <div class="card-body p-3 d-flex flex-column justify-content-between">
                                    <div>
                                        <div class="mb-2 text-center bg-light p-2 rounded">
                                            <img id="bannerPreview-@item.MainBannerId"
                                                 src="@(bannerPreview ?? "")"
                                                 alt="Banner Önizleme"
                                                 class="img-fluid rounded @(string.IsNullOrEmpty(bannerPreview) ? "d-none" : "")"
                                                 style="max-height: 140px; width: 100%; object-fit: cover;" />
                                        </div>

                                        <div class="mb-2">
                                            <span class="small text-muted fw-semibold d-block">Görsel Adresi:</span>
                                            <span class="small text-dark text-break font-monospace">@(item.MainBannerUrl ?? "—")</span>
                                        </div>

                                        @if (!string.IsNullOrWhiteSpace(item.MainBannerDesc))
                                        {
                                            <div class="mb-2">
                                                <span class="small text-muted fw-semibold d-block">Açıklama:</span>
                                                <span class="small text-secondary text-break">@item.MainBannerDesc</span>
                                            </div>
                                        }
                                    </div>

                                    <div class="pt-2 border-top mt-2 d-flex flex-wrap justify-content-end gap-2">
                                        <details class="d-inline-block text-start" @(isThisOpen ? "open" : "")>
                                            <summary class="btn btn-outline-primary btn-sm">
                                                <i class="bi bi-pencil me-1"></i> Düzenle
                                            </summary>
                                            <div class="card card-body p-3 shadow-sm border mt-2" style="min-width: 280px; max-width: 100%;">
                                                <h6 class="fw-semibold mb-2 text-primary border-bottom pb-1">Bannerı Düzenle</h6>
                                                <form method="post" action="/icerik/banner/@item.MainBannerId">
                                                    @Html.AntiForgeryToken()
                                                    <input type="hidden" name="MainBannerId" value="@item.MainBannerId" />

                                                    <div class="mb-2">
                                                        <label class="form-label small fw-semibold" for="bannerUrl-@item.MainBannerId">Görsel Adresi (URL / Yol) <span class="text-danger">*</span></label>
                                                        <input type="text"
                                                               class="form-control form-control-sm @(errItemUrl != null ? "is-invalid" : "")"
                                                               id="bannerUrl-@item.MainBannerId"
                                                               name="MainBannerUrl"
                                                               value="@item.MainBannerUrl"
                                                               placeholder="https://... veya /uploads/..."
                                                               required />
                                                        @if (errItemUrl != null)
                                                        {
                                                            <div class="invalid-feedback d-block">@errItemUrl</div>
                                                        }
                                                        <div class="mt-2" data-image-upload data-target="bannerUrl-@item.MainBannerId" data-folder="banner" data-preview="bannerPreview-@item.MainBannerId"></div>
                                                    </div>

                                                    <div class="mb-3">
                                                        <label class="form-label small fw-semibold">Açıklama</label>
                                                        <input type="text"
                                                               class="form-control form-control-sm @(errItemDesc != null ? "is-invalid" : "")"
                                                               name="MainBannerDesc"
                                                               value="@item.MainBannerDesc"
                                                               placeholder="Banner açıklaması..." />
                                                        @if (errItemDesc != null)
                                                        {
                                                            <div class="invalid-feedback d-block">@errItemDesc</div>
                                                        }
                                                    </div>

                                                    <button type="submit" class="btn btn-primary btn-sm w-100">
                                                        <i class="bi bi-check-lg me-1"></i> Güncelle
                                                    </button>
                                                </form>
                                            </div>
                                        </details>

                                        <details class="d-inline-block text-start">
                                            <summary class="btn btn-outline-danger btn-sm">
                                                <i class="bi bi-trash me-1"></i> Sil
                                            </summary>
                                            <div class="card card-body p-2 shadow-sm border mt-2 bg-light" style="min-width: 200px;">
                                                <div class="small text-danger fw-semibold mb-2">Bu bannerı silmek istediğinize emin misiniz?</div>
                                                <form method="post" action="/icerik/banner/@item.MainBannerId/sil">
                                                    @Html.AntiForgeryToken()
                                                    <button type="submit" class="btn btn-danger btn-sm w-100">
                                                        Evet, Sil
                                                    </button>
                                                </form>
                                            </div>
                                        </details>
                                    </div>
                                </div>
                            </div>
                        </div>
                    }
                </div>
            }

            <!-- Yeni Banner Formu -->
            <div class="card bg-light border-0 shadow-sm mt-3">
                <div class="card-body p-3">
                    <h6 class="fw-bold text-dark mb-3">
                        <i class="bi bi-plus-circle me-1 text-primary"></i> Yeni Banner Ekle
                    </h6>

                    <form method="post" action="/icerik/banner">
                        @Html.AntiForgeryToken()

                        <div class="row g-3">
                            <div class="col-md-6 col-12">
                                <label for="bannerUrl-new" class="form-label small fw-semibold">
                                    Görsel Adresi (URL / Yol) <span class="text-danger">*</span>
                                </label>
                                <input type="text"
                                       class="form-control form-control-sm @(errNewBannerUrl != null ? "is-invalid" : "")"
                                       id="bannerUrl-new"
                                       name="MainBannerUrl"
                                       value="@Model.NewBanner?.MainBannerUrl"
                                       placeholder="https://... veya /uploads/..."
                                       required />
                                @if (errNewBannerUrl != null)
                                {
                                    <div class="invalid-feedback d-block">@errNewBannerUrl</div>
                                }
                                <div class="mt-2" data-image-upload data-target="bannerUrl-new" data-folder="banner" data-preview="bannerPreview-new"></div>
                                @{
                                    var newBannerPreview = SiteImageUrl.Preview(Model.NewBanner?.MainBannerUrl);
                                }
                                <div class="mt-2 text-center bg-light p-2 rounded">
                                    <img id="bannerPreview-new"
                                         src="@(newBannerPreview ?? "")"
                                         alt="Banner Önizleme"
                                         class="img-fluid rounded @(string.IsNullOrEmpty(newBannerPreview) ? "d-none" : "")"
                                         style="max-height: 120px; width: 100%; object-fit: cover;" />
                                </div>
                            </div>

                            <div class="col-md-6 col-12">
                                <label for="newBannerDesc" class="form-label small fw-semibold">
                                    Açıklama
                                </label>
                                <input type="text"
                                       class="form-control form-control-sm @(errNewBannerDesc != null ? "is-invalid" : "")"
                                       id="newBannerDesc"
                                       name="MainBannerDesc"
                                       value="@Model.NewBanner?.MainBannerDesc"
                                       placeholder="Banner başlığı veya kısa açıklama..." />
                                @if (errNewBannerDesc != null)
                                {
                                    <div class="invalid-feedback d-block">@errNewBannerDesc</div>
                                }
                            </div>

                            <div class="col-12 d-flex justify-content-end pt-1">
                                <button type="submit" class="btn btn-primary btn-sm px-4">
                                    <i class="bi bi-plus-lg me-1"></i> Banner Ekle
                                </button>
                            </div>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
}

@section Scripts {
    <script src="~/js/image-upload.js" asp-append-version="true"></script>
}
