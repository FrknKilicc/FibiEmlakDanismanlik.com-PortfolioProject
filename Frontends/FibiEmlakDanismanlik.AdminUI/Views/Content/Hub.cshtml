@model FibiEmlakDanismanlik.AdminUI.Models.Content.ContentHubViewModel
@{
    ViewData["Title"] = "İçerik";
}

<div class="pagetitle d-flex flex-wrap justify-content-between align-items-center gap-3 mb-4">
    <div>
        <h1>İçerik</h1>
        <nav>
            <ol class="breadcrumb mb-1">
                <li class="breadcrumb-item"><a href="/">Ana Sayfa</a></li>
                <li class="breadcrumb-item active">İçerik</li>
            </ol>
        </nav>
        <p class="text-muted small mb-0">Sitede görünen tüm içerikleri buradan yönetin.</p>
    </div>
    <div class="content-search-wrapper" style="min-width: 260px; max-width: 360px;">
        <div class="input-group">
            <span class="input-group-text bg-transparent border-end-0 text-muted">
                <i class="bi bi-search"></i>
            </span>
            <input type="search" id="hubSearchInput" class="form-control border-start-0 ps-0" placeholder="İçeriklerde ara..." aria-label="İçeriklerde ara">
        </div>
    </div>
</div>

@if (TempData["Success"] != null)
{
    <div class="alert alert-success alert-dismissible fade show d-flex align-items-center mb-4" role="alert">
        <i class="bi bi-check-circle-fill flex-shrink-0 me-2 fs-5"></i>
        <div>@TempData["Success"]</div>
        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Kapat"></button>
    </div>
}

@if (TempData["Error"] != null)
{
    <div class="alert alert-danger alert-dismissible fade show d-flex align-items-center mb-4" role="alert">
        <i class="bi bi-exclamation-triangle-fill flex-shrink-0 me-2 fs-5"></i>
        <div>@TempData["Error"]</div>
        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Kapat"></button>
    </div>
}

<div id="hubGroupsContainer">
    @foreach (var group in Model.Groups)
    {
        <div class="content-hub-group mb-4" data-group>
            <div class="d-flex flex-column mb-3">
                <h5 class="fw-bold mb-1">@group.Title</h5>
                @if (!string.IsNullOrWhiteSpace(group.Description))
                {
                    <p class="text-muted small mb-0">@group.Description</p>
                }
            </div>
            <div class="row g-3">
                @foreach (var tile in group.Tiles)
                {
                    <div class="col-xl-3 col-lg-4 col-sm-6 content-hub-col" data-tile-key="@tile.Key" data-search-text="@(tile.Title + " " + tile.Description)">
                        <div class="card h-100 content-hub-tile border">
                            <div class="card-body d-flex flex-column p-3">
                                <div class="d-flex align-items-center justify-content-between mb-3">
                                    <div class="content-hub-icon-circle d-flex align-items-center justify-content-center">
                                        <i class="bi @tile.Icon fs-4"></i>
                                    </div>
                                    @if (!string.IsNullOrWhiteSpace(tile.Warning))
                                    {
                                        <span class="badge text-bg-warning d-inline-flex align-items-center gap-1 font-monospace" style="font-size: 0.75rem;">
                                            <i class="bi bi-exclamation-triangle-fill"></i>
                                            <span>@tile.Warning</span>
                                        </span>
                                    }
                                </div>
                                <h6 class="card-title fw-bold mb-1 p-0 fs-6">@tile.Title</h6>
                                <p class="card-text text-muted small content-hub-desc mb-3">@tile.Description</p>

                                <div class="mt-auto pt-2 border-top">
                                    <div class="d-flex align-items-center justify-content-between">
                                        <div class="text-muted small d-flex align-items-center gap-1">
                                            <span class="fw-medium">@tile.Stat</span>
                                        </div>
                                        <div class="d-flex align-items-center gap-2">
                                            @if (!string.IsNullOrWhiteSpace(tile.SiteUrl))
                                            {
                                                <a href="@tile.SiteUrl" target="_blank" rel="noopener" class="btn btn-sm btn-link text-muted p-0 position-relative z-2" title="Sitede gör" aria-label="@tile.Title sitede gör">
                                                    <i class="bi bi-box-arrow-up-right"></i>
                                                </a>
                                            }
                                            <a href="@tile.Url" class="btn btn-sm btn-primary stretched-link py-1 px-3 content-hub-btn">
                                                Yönet
                                            </a>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                }
            </div>
        </div>
    }
</div>

<div id="hubNoResults" class="alert alert-light text-center py-5 d-none border">
    <i class="bi bi-search fs-1 text-muted d-block mb-2"></i>
    <strong class="d-block mb-1">Sonuç yok</strong>
    <p class="text-muted small mb-0">Aradığınız kriterlere uygun içerik bölümü bulunamadı.</p>
</div>

<script>
    document.addEventListener('DOMContentLoaded', function () {
        var searchInput = document.getElementById('hubSearchInput');
        var groups = document.querySelectorAll('[data-group]');
        var noResults = document.getElementById('hubNoResults');

        if (searchInput) {
            searchInput.addEventListener('input', function () {
                var query = this.value.trim().toLocaleLowerCase('tr-TR');
                var totalVisible = 0;

                groups.forEach(function (group) {
                    var groupVisible = 0;
                    var cols = group.querySelectorAll('.content-hub-col');

                    cols.forEach(function (col) {
                        var text = (col.getAttribute('data-search-text') || '').toLocaleLowerCase('tr-TR');
                        if (!query || text.indexOf(query) !== -1) {
                            col.classList.remove('d-none');
                            groupVisible++;
                            totalVisible++;
                        } else {
                            col.classList.add('d-none');
                        }
                    });

                    if (groupVisible === 0 && query) {
                        group.classList.add('d-none');
                    } else {
                        group.classList.remove('d-none');
                    }
                });

                if (noResults) {
                    if (totalVisible === 0 && query) {
                        noResults.classList.remove('d-none');
                    } else {
                        noResults.classList.add('d-none');
                    }
                }
            });
        }
    });
</script>
