@model FibiEmlakDanismanlik.AdminUI.Models.Dashboard.ReportsViewModel
@using FibiEmlakDanismanlik.AdminUI.Models.Dashboard
@using FibiEmlakDanismanlik.AdminUI.Models.Deals
@using System.Globalization

@{
    ViewData["Title"] = "Raporlar";

    var monthlyCsvUrl = Microsoft.AspNetCore.WebUtilities.QueryHelpers.AddQueryString("/raporlar/aylik.csv", new Dictionary<string, string?>
    {
        ["baslangic"] = Model.Baslangic,
        ["bitis"] = Model.Bitis
    });

    var calisanlarCsvUrl = Microsoft.AspNetCore.WebUtilities.QueryHelpers.AddQueryString("/raporlar/calisanlar.csv", new Dictionary<string, string?>
    {
        ["baslangic"] = Model.Baslangic,
        ["bitis"] = Model.Bitis
    });

    var islemlerCsvUrl = Microsoft.AspNetCore.WebUtilities.QueryHelpers.AddQueryString("/raporlar/islemler.csv", new Dictionary<string, string?>
    {
        ["baslangic"] = Model.Baslangic,
        ["bitis"] = Model.Bitis
    });

    string FormatDateTr(string? d)
    {
        if (!string.IsNullOrWhiteSpace(d))
        {
            var trimmed = d.Trim();
            var part = trimmed.Length >= 10 ? trimmed.Substring(0, 10) : trimmed;
            if (DateTime.TryParseExact(part, "yyyy-MM-dd", CultureInfo.InvariantCulture, DateTimeStyles.None, out var dt))
            {
                return dt.ToString("dd.MM.yyyy");
            }
            if (DateTime.TryParse(trimmed, CultureInfo.InvariantCulture, DateTimeStyles.None, out var parsedDt))
            {
                return parsedDt.ToString("dd.MM.yyyy");
            }
            return trimmed;
        }
        return "";
    }

    var fromText = FormatDateTr(Model.Data?.From ?? Model.Baslangic);
    var toText = FormatDateTr(Model.Data?.To ?? Model.Bitis);
    var rangeText = (!string.IsNullOrWhiteSpace(fromText) && !string.IsNullOrWhiteSpace(toText))
        ? $"{fromText} – {toText}"
        : (!string.IsNullOrWhiteSpace(fromText) ? $"{fromText} sonrası" : (!string.IsNullOrWhiteSpace(toText) ? $"{toText} öncesi" : ""));

    var monthlyList = Model.Data?.Finance?.Monthly ?? new List<DashboardMonthPointDto>();
    var agentList = Model.Data?.Agents ?? new List<DashboardAgentDto>();
    var range = Model.Data?.Finance?.Range;
}

<div class="pagetitle d-flex flex-wrap justify-content-between align-items-center gap-2 mb-3">
    <div>
        <h1 class="mb-1">Raporlar</h1>
        <nav>
            <ol class="breadcrumb mb-0">
                <li class="breadcrumb-item"><a href="/">Ana Sayfa</a></li>
                <li class="breadcrumb-item active">Raporlar</li>
            </ol>
        </nav>
    </div>
    @if (!string.IsNullOrWhiteSpace(rangeText))
    {
        <div class="text-muted small">
            <i class="bi bi-calendar3 me-1"></i>Aralık: @rangeText
        </div>
    }
</div>

@if (!string.IsNullOrWhiteSpace(Model.ErrorMessage))
{
    <div class="alert alert-danger alert-dismissible fade show d-flex align-items-center mb-4" role="alert">
        <i class="bi bi-exclamation-triangle-fill flex-shrink-0 me-2 fs-5"></i>
        <div>@Model.ErrorMessage</div>
        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Kapat"></button>
    </div>
}

<!-- Filtre ve CSV İndirme Kartı -->
<div class="card mb-4 shadow-sm border-0">
    <div class="card-body pt-3 pb-3">
        <div class="row g-3 align-items-end">
            <!-- Tarih Aralığı Formu -->
            <div class="col-12 col-xl-6">
                <form method="get" action="/raporlar" class="row g-2 align-items-end">
                    <div class="col-sm-5 col-6">
                        <label for="filterBaslangic" class="form-label small fw-semibold text-muted mb-1">Başlangıç</label>
                        <input type="date" class="form-control form-control-sm" id="filterBaslangic" name="baslangic" value="@Model.Baslangic" />
                    </div>
                    <div class="col-sm-5 col-6">
                        <label for="filterBitis" class="form-label small fw-semibold text-muted mb-1">Bitiş</label>
                        <input type="date" class="form-control form-control-sm" id="filterBitis" name="bitis" value="@Model.Bitis" />
                    </div>
                    <div class="col-sm-2 col-12 d-flex gap-1">
                        <button type="submit" class="btn btn-sm btn-primary w-100">
                            <i class="bi bi-funnel me-1"></i> Filtrele
                        </button>
                    </div>
                </form>
                @if (!string.IsNullOrWhiteSpace(rangeText))
                {
                    <div class="text-muted small mt-2">
                        <i class="bi bi-calendar3 me-1"></i>Aralık: @rangeText
                    </div>
                }
            </div>

            <!-- CSV İndir Butonları -->
            <div class="col-12 col-xl-6">
                <div class="d-flex flex-wrap justify-content-xl-end gap-2">
                    <a href="@monthlyCsvUrl" class="btn btn-sm btn-outline-success d-inline-flex align-items-center text-nowrap">
                        <i class="bi bi-file-earmark-spreadsheet me-1"></i>
                        <span>Aylık Özet CSV</span>
                        <small class="text-muted ms-1">(Excel'de açılır)</small>
                    </a>
                    <a href="@calisanlarCsvUrl" class="btn btn-sm btn-outline-success d-inline-flex align-items-center text-nowrap">
                        <i class="bi bi-file-earmark-spreadsheet me-1"></i>
                        <span>Çalışan Performansı CSV</span>
                        <small class="text-muted ms-1">(Excel'de açılır)</small>
                    </a>
                    <a href="@islemlerCsvUrl" class="btn btn-sm btn-outline-success d-inline-flex align-items-center text-nowrap">
                        <i class="bi bi-file-earmark-spreadsheet me-1"></i>
                        <span>İşlem Listesi CSV</span>
                        <small class="text-muted ms-1">(Excel'de açılır)</small>
                    </a>
                </div>
            </div>
        </div>
    </div>
</div>

<!-- Özet Satırı (Range) -->
@if (range != null)
{
    <section class="section dashboard pb-0 deal-summary">
        <div class="row g-2 g-md-3 mb-4">
            <!-- 1. Tamamlanan -->
            <div class="col-xl-2 col-md-4 col-6">
                <div class="card info-card h-100 hover-card mb-0 shadow-sm border-0">
                    <div class="card-body">
                        <div class="text-muted small fw-semibold text-truncate mb-1">Tamamlanan</div>
                        <div class="d-flex align-items-center">
                            <div class="card-icon rounded-circle d-flex align-items-center justify-content-center flex-shrink-0 text-success bg-success-subtle" style="width: 40px; height: 40px; min-width: 40px; font-size: 1.2rem;">
                                <i class="bi bi-check2-circle"></i>
                            </div>
                            <div class="ps-2 min-w-0">
                                <h6 class="fs-5 fw-bold mb-0 lh-1">@range.CompletedCount</h6>
                                <span class="text-muted small text-truncate d-none d-md-block pt-1">İşlem kapandı</span>
                            </div>
                        </div>
                    </div>
                </div>
            </div>

            <!-- 2. Komisyon -->
            <div class="col-xl-2 col-md-4 col-6">
                <div class="card info-card h-100 hover-card mb-0 shadow-sm border-0">
                    <div class="card-body">
                        <div class="text-muted small fw-semibold text-truncate mb-1">Komisyon</div>
                        <div class="d-flex align-items-center">
                            <div class="card-icon rounded-circle d-flex align-items-center justify-content-center flex-shrink-0 text-primary bg-primary-subtle" style="width: 40px; height: 40px; min-width: 40px; font-size: 1.2rem;">
                                <i class="bi bi-cash-stack"></i>
                            </div>
                            <div class="ps-2 min-w-0">
                                <h6 class="fs-6 fw-bold mb-0 lh-1 text-truncate">@DealLabels.Money(range.CompletedCommissionTotal)</h6>
                                <span class="text-muted small text-truncate d-none d-md-block pt-1">Toplam ciro</span>
                            </div>
                        </div>
                    </div>
                </div>
            </div>

            <!-- 3. Dağıtılan Prim -->
            <div class="col-xl-2 col-md-4 col-6">
                <div class="card info-card h-100 hover-card mb-0 shadow-sm border-0">
                    <div class="card-body">
                        <div class="text-muted small fw-semibold text-truncate mb-1">Dağıtılan prim</div>
                        <div class="d-flex align-items-center">
                            <div class="card-icon rounded-circle d-flex align-items-center justify-content-center flex-shrink-0 text-info bg-info-subtle" style="width: 40px; height: 40px; min-width: 40px; font-size: 1.2rem;">
                                <i class="bi bi-people"></i>
                            </div>
                            <div class="ps-2 min-w-0">
                                <h6 class="fs-6 fw-bold mb-0 lh-1 text-truncate">@DealLabels.Money(range.CompletedSharesTotal)</h6>
                                <span class="text-muted small text-truncate d-none d-md-block pt-1">Hak edişler</span>
                            </div>
                        </div>
                    </div>
                </div>
            </div>

            <!-- 4. Şirket Payı -->
            <div class="col-xl-2 col-md-4 col-6">
                <div class="card info-card h-100 hover-card mb-0 shadow-sm border-0 bg-success-subtle border-start border-success border-4">
                    <div class="card-body">
                        <div class="text-success small fw-bold text-truncate mb-1">Şirket payı</div>
                        <div class="d-flex align-items-center">
                            <div class="card-icon rounded-circle d-flex align-items-center justify-content-center flex-shrink-0 text-success bg-white shadow-sm" style="width: 40px; height: 40px; min-width: 40px; font-size: 1.2rem;">
                                <i class="bi bi-bank"></i>
                            </div>
                            <div class="ps-2 min-w-0">
                                <h6 class="fs-6 fw-bold text-success mb-0 lh-1 text-truncate">@DealLabels.Money(range.CompanyShareTotal)</h6>
                                <span class="text-muted small text-truncate d-none d-md-block pt-1">Net şirket geliri</span>
                            </div>
                        </div>
                    </div>
                </div>
            </div>

            <!-- 5. Ödenecek Prim -->
            <div class="col-xl-2 col-md-4 col-6">
                <div class="card info-card h-100 hover-card mb-0 shadow-sm border-0">
                    <div class="card-body">
                        <div class="text-muted small fw-semibold text-truncate mb-1">Ödenecek prim</div>
                        <div class="d-flex align-items-center">
                            <div class="card-icon rounded-circle d-flex align-items-center justify-content-center flex-shrink-0 text-danger bg-danger-subtle" style="width: 40px; height: 40px; min-width: 40px; font-size: 1.2rem;">
                                <i class="bi bi-wallet2"></i>
                            </div>
                            <div class="ps-2 min-w-0">
                                <h6 class="fs-6 fw-bold mb-0 lh-1 text-truncate">@DealLabels.Money(range.PendingSharesTotal)</h6>
                                <span class="text-muted small text-truncate d-none d-md-block pt-1">Bekleyen ödeme</span>
                            </div>
                        </div>
                    </div>
                </div>
            </div>

            <!-- 6. Yanan Kapora -->
            <div class="col-xl-2 col-md-4 col-6">
                <div class="card info-card h-100 hover-card mb-0 shadow-sm border-0">
                    <div class="card-body">
                        <div class="text-muted small fw-semibold text-truncate mb-1">Yanan kapora</div>
                        <div class="d-flex align-items-center">
                            <div class="card-icon rounded-circle d-flex align-items-center justify-content-center flex-shrink-0 text-secondary bg-secondary-subtle" style="width: 40px; height: 40px; min-width: 40px; font-size: 1.2rem;">
                                <i class="bi bi-shield-x"></i>
                            </div>
                            <div class="ps-2 min-w-0">
                                <h6 class="fs-6 fw-bold mb-0 lh-1 text-truncate">@DealLabels.Money(range.KeptDepositTotal)</h6>
                                <span class="text-muted small text-truncate d-none d-md-block pt-1">İade edilmeyen</span>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </section>
}

<!-- Tablo 1: Aylık Özet Tablosu -->
<div class="card border-0 shadow-sm mb-4">
    <div class="card-header bg-transparent border-0 pt-3 pb-0 d-flex justify-content-between align-items-center">
        <h5 class="card-title p-0 m-0 fs-6">Aylık Özet</h5>
        <span class="text-muted small">Son 12 Ay</span>
    </div>
    <div class="card-body pt-2 p-0">
        @if (monthlyList.Any())
        {
            <div class="table-responsive">
                <table class="table table-hover align-middle mb-0">
                    <thead class="bg-body-tertiary text-muted small text-uppercase">
                        <tr>
                            <th scope="col" class="ps-3">Ay</th>
                            <th scope="col" class="text-end">Kapora</th>
                            <th scope="col" class="text-end">Tamamlanan</th>
                            <th scope="col" class="text-end">Komisyon</th>
                            <th scope="col" class="text-end">Prim</th>
                            <th scope="col" class="text-end pe-3">Şirket Payı</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var m in monthlyList)
                        {
                            var companyShare = m.Commission - m.Shares;
                            <tr>
                                <td class="ps-3 fw-medium text-body text-nowrap">
                                    @LeadStatusKeys.MonthName(m.Month) @m.Year
                                </td>
                                <td class="text-end">@m.DepositCount</td>
                                <td class="text-end">@m.CompletedCount</td>
                                <td class="text-end fw-semibold text-body text-nowrap">@DealLabels.Money(m.Commission)</td>
                                <td class="text-end text-muted text-nowrap">@DealLabels.Money(m.Shares)</td>
                                <td class="text-end pe-3 fw-bold text-success text-nowrap">@DealLabels.Money(companyShare)</td>
                            </tr>
                        }
                    </tbody>
                    <tfoot class="bg-body-tertiary fw-bold">
                        <tr class="bg-body-tertiary">
                            <td class="ps-3 text-body bg-body-tertiary">Toplam</td>
                            <td class="text-end bg-body-tertiary">@monthlyList.Sum(x => x.DepositCount)</td>
                            <td class="text-end bg-body-tertiary">@monthlyList.Sum(x => x.CompletedCount)</td>
                            <td class="text-end text-body text-nowrap bg-body-tertiary">@DealLabels.Money(monthlyList.Sum(x => x.Commission))</td>
                            <td class="text-end text-muted text-nowrap bg-body-tertiary">@DealLabels.Money(monthlyList.Sum(x => x.Shares))</td>
                            <td class="text-end pe-3 text-success text-nowrap bg-body-tertiary">@DealLabels.Money(monthlyList.Sum(x => x.Commission - x.Shares))</td>
                        </tr>
                    </tfoot>
                </table>
            </div>
        }
        else
        {
            <p class="text-muted small mb-0 py-4 text-center">Aylık finansal veri bulunamadı.</p>
        }
    </div>
</div>

<!-- Tablo 2: Çalışan Performansı Tablosu -->
<div class="card border-0 shadow-sm mb-4">
    <div class="card-header bg-transparent border-0 pt-3 pb-0 d-flex justify-content-between align-items-center">
        <h5 class="card-title p-0 m-0 fs-6">Çalışan Performansı</h5>
        <span class="text-muted small">@(!string.IsNullOrWhiteSpace(rangeText) ? rangeText : "Seçili Aralıkta")</span>
    </div>
    <div class="card-body pt-2 p-0">
        @if (agentList.Any())
        {
            <div class="table-responsive">
                <table class="table table-hover align-middle mb-0">
                    <thead class="bg-body-tertiary text-muted small text-uppercase">
                        <tr>
                            <th scope="col" class="ps-3">Çalışan</th>
                            <th scope="col" class="text-end">Atanan Talep</th>
                            <th scope="col" class="text-end">Kazanılan Talep</th>
                            <th scope="col" class="text-end">Tamamlanan İşlem</th>
                            <th scope="col" class="text-end">Prim</th>
                            <th scope="col" class="text-end">Ödenen</th>
                            <th scope="col" class="text-end pe-3">Bekleyen</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var a in agentList)
                        {
                            <tr>
                                <td class="ps-3 fw-semibold text-body text-nowrap">
                                    @a.AgentName
                                </td>
                                <td class="text-end">@a.AssignedLeads</td>
                                <td class="text-end">
                                    <span class="badge bg-success-subtle text-success border border-success-subtle px-2">@a.WonLeads</span>
                                </td>
                                <td class="text-end">@a.DealCount</td>
                                <td class="text-end fw-semibold text-body text-nowrap">@DealLabels.Money(a.ShareTotal)</td>
                                <td class="text-end text-success text-nowrap">@DealLabels.Money(a.PaidTotal)</td>
                                <td class="text-end pe-3 fw-semibold text-danger text-nowrap">@DealLabels.Money(a.PendingTotal)</td>
                            </tr>
                        }
                    </tbody>
                    <tfoot class="bg-body-tertiary fw-bold">
                        <tr class="bg-body-tertiary">
                            <td class="ps-3 text-body bg-body-tertiary">Toplam</td>
                            <td class="text-end bg-body-tertiary">@agentList.Sum(x => x.AssignedLeads)</td>
                            <td class="text-end bg-body-tertiary">@agentList.Sum(x => x.WonLeads)</td>
                            <td class="text-end bg-body-tertiary">@agentList.Sum(x => x.DealCount)</td>
                            <td class="text-end text-body text-nowrap bg-body-tertiary">@DealLabels.Money(agentList.Sum(x => x.ShareTotal))</td>
                            <td class="text-end text-success text-nowrap bg-body-tertiary">@DealLabels.Money(agentList.Sum(x => x.PaidTotal))</td>
                            <td class="text-end pe-3 text-danger text-nowrap bg-body-tertiary">@DealLabels.Money(agentList.Sum(x => x.PendingTotal))</td>
                        </tr>
                    </tfoot>
                </table>
            </div>
        }
        else
        {
            <p class="text-muted small mb-0 py-4 text-center">Çalışan performansı verisi bulunamadı.</p>
        }
    </div>
</div>

<div class="small text-muted mb-4 ps-1">
    <i class="bi bi-info-circle me-1"></i>Tutarlar KDV hariç. Aylık tablo son 12 ayı, diğerleri seçili aralığı gösterir.
</div>
