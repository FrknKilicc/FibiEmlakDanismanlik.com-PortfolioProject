@model FibiEmlakDanismanlik.AdminUI.Models.Leads.LeadIndexViewModel
@inject FibiEmlakDanismanlik.AdminUI.Infrastructure.CurrentAdmin CurrentAdmin
@using FibiEmlakDanismanlik.AdminUI.Models.Leads
@{
    ViewData["Title"] = "Müşteri Talepleri";

    var totalItems = Model.Response.Total;
    var currentPage = Model.Sayfa;
    var pageSize = Model.Response.PageSize > 0 ? Model.Response.PageSize : 25;
    var totalPages = Model.TotalPages;
    var startItem = totalItems == 0 ? 0 : ((currentPage - 1) * pageSize) + 1;
    var endItem = Math.Min(currentPage * pageSize, totalItems);

    // En fazla 7 sayfa numarası hesaplama
    int startPage = 1;
    int endPage = totalPages;
    if (totalPages > 7)
    {
        startPage = Math.Max(1, currentPage - 3);
        endPage = Math.Min(totalPages, startPage + 6);
        if (endPage - startPage < 6)
        {
            startPage = Math.Max(1, endPage - 6);
        }
    }
}

<div class="pagetitle d-flex flex-wrap justify-content-between align-items-center gap-2 mb-3">
    <div>
        <h1>Müşteri Talepleri</h1>
        <nav>
            <ol class="breadcrumb mb-0">
                <li class="breadcrumb-item"><a href="/">Ana Sayfa</a></li>
                <li class="breadcrumb-item active">Talepler</li>
            </ol>
        </nav>
    </div>
</div>

@if (TempData["Success"] != null)
{
    <div class="alert alert-success alert-dismissible fade show d-flex align-items-center mb-4" role="alert">
        <i class="bi bi-check-circle-fill flex-shrink-0 me-2 fs-5"></i>
        <div>@TempData["Success"]</div>
        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Kapat"></button>
    </div>
}

@if (TempData["Error"] != null)
{
    <div class="alert alert-danger alert-dismissible fade show d-flex align-items-center mb-4" role="alert">
        <i class="bi bi-exclamation-triangle-fill flex-shrink-0 me-2 fs-5"></i>
        <div>@TempData["Error"]</div>
        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Kapat"></button>
    </div>
}

@if (!string.IsNullOrWhiteSpace(Model.ErrorMessage))
{
    <div class="alert alert-danger alert-dismissible fade show d-flex align-items-center mb-4" role="alert">
        <i class="bi bi-exclamation-triangle-fill flex-shrink-0 me-2 fs-5"></i>
        <div>@Model.ErrorMessage</div>
        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Kapat"></button>
    </div>
}

@{
    var summaryColClass = CurrentAdmin.IsManagerOrAbove ? "col-xl-3 col-md-6 col-6" : "col-xl-4 col-md-4 col-6";
}

<!-- Özet Kartları (NiceAdmin info-card) -->
<section class="section dashboard pb-0">
    <div class="row g-2 g-md-3 mb-3">
        <!-- Toplam Talep Kartı -->
        <div class="@summaryColClass">
            <a href="/talepler" class="text-decoration-none text-dark d-block h-100">
                <div class="card info-card sales-card h-100 hover-card mb-0">
                    <div class="card-body p-2 p-md-3">
                        <div class="text-muted small fw-semibold text-truncate mb-1">Toplam Talep</div>
                        <div class="d-flex align-items-center">
                            <div class="card-icon rounded-circle d-flex align-items-center justify-content-center flex-shrink-0" style="width: 44px; height: 44px; min-width: 44px; font-size: 1.25rem;">
                                <i class="bi bi-chat-left-text"></i>
                            </div>
                            <div class="ps-2 ps-md-3 min-w-0">
                                <h6 class="fs-5 fw-bold mb-0 lh-1">@Model.Response.Summary.Total</h6>
                                <span class="text-muted small text-truncate d-none d-md-block pt-1">Tüm müşteri formları</span>
                            </div>
                        </div>
                    </div>
                </div>
            </a>
        </div>

        <!-- Yeni (Son 7 Gün) Kartı -->
        <div class="@summaryColClass">
            <a href="/talepler?durum=1" class="text-decoration-none text-dark d-block h-100">
                <div class="card info-card revenue-card h-100 hover-card mb-0">
                    <div class="card-body p-2 p-md-3">
                        <div class="text-muted small fw-semibold text-truncate mb-1">Yeni (Son 7 Gün)</div>
                        <div class="d-flex align-items-center">
                            <div class="card-icon rounded-circle d-flex align-items-center justify-content-center flex-shrink-0 text-primary bg-primary-subtle" style="width: 44px; height: 44px; min-width: 44px; font-size: 1.25rem;">
                                <i class="bi bi-bell"></i>
                            </div>
                            <div class="ps-2 ps-md-3 min-w-0">
                                <h6 class="fs-5 fw-bold mb-0 lh-1">@Model.Response.Summary.NewLast7Days</h6>
                                <span class="text-muted small text-truncate d-none d-md-block pt-1">İlgilenilmeyi bekleyen</span>
                            </div>
                        </div>
                    </div>
                </div>
            </a>
        </div>

        @if (CurrentAdmin.IsManagerOrAbove)
        {
            <!-- Atanmamış Talepler Kartı (Sahip / Yönetici) -->
            <div class="@summaryColClass">
                <a href="/talepler?atanmamis=true" class="text-decoration-none text-dark d-block h-100">
                    <div class="card info-card customers-card h-100 hover-card mb-0">
                        <div class="card-body p-2 p-md-3">
                            <div class="text-muted small fw-semibold text-truncate mb-1">Atanmamış</div>
                            <div class="d-flex align-items-center">
                                <div class="card-icon rounded-circle d-flex align-items-center justify-content-center flex-shrink-0 text-danger bg-danger-subtle" style="width: 44px; height: 44px; min-width: 44px; font-size: 1.25rem;">
                                    <i class="bi bi-person-x"></i>
                                </div>
                                <div class="ps-2 ps-md-3 min-w-0">
                                    <h6 class="fs-5 fw-bold mb-0 lh-1">@Model.Response.Summary.Unassigned</h6>
                                    <span class="text-muted small text-truncate d-none d-md-block pt-1">Danışman atanmamış</span>
                                </div>
                            </div>
                        </div>
                    </div>
                </a>
            </div>
        }

        <!-- Yaklaşan Randevu (7 Gün) Kartı -->
        <div class="@summaryColClass">
            <a href="/talepler?durum=3" class="text-decoration-none text-dark d-block h-100">
                <div class="card info-card h-100 hover-card mb-0">
                    <div class="card-body p-2 p-md-3">
                        <div class="text-muted small fw-semibold text-truncate mb-1">Yaklaşan Randevu</div>
                        <div class="d-flex align-items-center">
                            <div class="card-icon rounded-circle d-flex align-items-center justify-content-center flex-shrink-0 text-warning bg-warning-subtle" style="width: 44px; height: 44px; min-width: 44px; font-size: 1.25rem;">
                                <i class="bi bi-calendar-event"></i>
                            </div>
                            <div class="ps-2 ps-md-3 min-w-0">
                                <h6 class="fs-5 fw-bold mb-0 lh-1">@Model.Response.Summary.AppointmentsUpcoming</h6>
                                <span class="text-muted small text-truncate d-none d-md-block pt-1">Gelecek 7 gün randevuları</span>
                            </div>
                        </div>
                    </div>
                </div>
            </a>
        </div>
    </div>
</section>

<!-- Durum Sekmeleri / Rozetleri (ByStatus sayıları ile) -->
<div class="d-flex flex-wrap align-items-center gap-2 mb-3">
    <a href="@Model.StatusFilterUrl(null)" class="btn btn-sm @(!Model.Durum.HasValue ? "btn-dark shadow-sm" : "btn-outline-dark")">
        Tümü (@Model.Response.Summary.Total)
    </a>
    @for (int st = 1; st <= 7; st++)
    {
        var count = LeadLabels.GetStatusCount(Model.Response.Summary.ByStatus, st);
        var badgeClass = LeadLabels.StatusBadge(st);
        var stName = LeadLabels.StatusName(st);
        var isActive = Model.Durum == st;
        <a href="@Model.StatusFilterUrl(st)" class="btn btn-sm @(isActive ? $"btn-{badgeClass} shadow-sm" : $"btn-outline-{badgeClass}")">
            @stName (@count)
        </a>
    }
</div>

<!-- Filtreleme Formu (GET) -->
<div class="card mb-4 shadow-sm border-0">
    <div class="card-body pt-3">
        <form method="get" action="/talepler" class="row g-2 align-items-end">
            <div class="col-lg-3 col-md-6 col-12">
                <label for="filterAra" class="form-label small fw-semibold text-muted mb-1">Arama</label>
                <div class="input-group input-group-sm">
                    <span class="input-group-text"><i class="bi bi-search"></i></span>
                    <input type="text" class="form-control form-control-sm" id="filterAra" name="ara" value="@Model.Ara" placeholder="Talep no, müşteri adı, telefon..." />
                </div>
            </div>

            <div class="col-lg-2 col-md-3 col-sm-6 col-12">
                <label for="filterKaynak" class="form-label small fw-semibold text-muted mb-1">Kaynak</label>
                <select class="form-select form-select-sm" id="filterKaynak" name="kaynak">
                    <option value="">Tüm Kaynaklar</option>
                    <option value="iletisim" selected="@(string.Equals(Model.Kaynak, "iletisim", StringComparison.OrdinalIgnoreCase) ? "selected" : null)">İletişim / Randevu</option>
                    <option value="fibi" selected="@(string.Equals(Model.Kaynak, "fibi", StringComparison.OrdinalIgnoreCase) ? "selected" : null)">FİBİ Hizmet</option>
                </select>
            </div>

            <div class="col-lg-2 col-md-3 col-sm-6 col-12">
                <label for="filterDurumSelect" class="form-label small fw-semibold text-muted mb-1">Durum</label>
                <select class="form-select form-select-sm" id="filterDurumSelect" name="durum">
                    <option value="">Tüm Durumlar</option>
                    @for (int st = 1; st <= 7; st++)
                    {
                        <option value="@st" selected="@(Model.Durum == st ? "selected" : null)">@LeadLabels.StatusName(st)</option>
                    }
                </select>
            </div>

            @if (CurrentAdmin.IsManagerOrAbove)
            {
                <div class="col-lg-2 col-md-4 col-sm-6 col-12">
                    <label for="filterDanisman" class="form-label small fw-semibold text-muted mb-1">Danışman</label>
                    <select class="form-select form-select-sm" id="filterDanisman" name="danisman">
                        <option value="">Tüm Danışmanlar</option>
                        @foreach (var ag in Model.Agents)
                        {
                            <option value="@ag.AgentId" selected="@(Model.DanismanId == ag.AgentId ? "selected" : null)">@ag.AgentName</option>
                        }
                    </select>
                </div>

                <div class="col-lg-3 col-md-4 col-sm-6 col-12 d-flex align-items-center pb-2">
                    <div class="form-check mb-0">
                        <input class="form-check-input" type="checkbox" id="filterAtanmamis" name="atanmamis" value="true" checked="@(Model.Atanmamis == true ? "checked" : null)" />
                        <label class="form-check-label small fw-semibold text-muted" for="filterAtanmamis">
                            Sadece Atanmamışlar
                        </label>
                    </div>
                </div>
            }

            <div class="col-auto d-flex gap-2 ms-auto mt-2">
                <button type="submit" class="btn btn-sm btn-primary px-3">
                    <i class="bi bi-funnel me-1"></i> Filtrele
                </button>
                <a href="/talepler" class="btn btn-sm btn-outline-secondary px-3">
                    <i class="bi bi-x-circle me-1"></i> Temizle
                </a>
            </div>
        </form>
    </div>
</div>

@if (Model.Response.Items == null || !Model.Response.Items.Any())
{
    <!-- Sonuç Bulunamadı Kutusu -->
    <div class="card border-0 shadow-sm">
        <div class="card-body text-center py-5">
            <i class="bi bi-inbox fs-1 text-muted d-block mb-3"></i>
            <h5 class="fw-semibold text-secondary">Talep bulunamadı.</h5>
            <p class="text-muted small mb-3">Arama kriterlerinizi değiştirerek veya filtreleri temizleyerek tekrar deneyebilirsiniz.</p>
            <a href="/talepler" class="btn btn-sm btn-outline-primary px-4">
                Filtreleri Temizle
            </a>
        </div>
    </div>
}
else
{
    <!-- Masaüstü Tablo Görünümü (d-none d-md-block) -->
    <div class="card border-0 shadow-sm d-none d-md-block mb-4">
        <div class="card-body p-0">
            <div class="table-responsive">
                <table class="table table-hover align-middle mb-0">
                    <thead class="table-light text-muted small text-uppercase">
                        <tr>
                            <th scope="col" class="ps-3" style="width: 100px;">Talep No</th>
                            <th scope="col">Ad Soyad</th>
                            <th scope="col">Telefon</th>
                            <th scope="col">Kaynak</th>
                            <th scope="col">İlan / Hizmet</th>
                            <th scope="col">Durum</th>
                            <th scope="col">Atanan Danışman</th>
                            <th scope="col">Tarih</th>
                            <th scope="col">Randevu</th>
                            <th scope="col">Son Hareket</th>
                            <th scope="col" class="text-end pe-3">İşlem</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var item in Model.Response.Items)
                        {
                            var detailUrl = $"/talepler/{LeadLabels.SourceSlug(item.Source)}/{item.LeadId}";
                            <tr>
                                <td class="ps-3">
                                    <a href="@detailUrl" class="fw-bold text-dark text-decoration-none font-monospace">
                                        @item.Key
                                    </a>
                                </td>
                                <td>
                                    <div class="fw-semibold">
                                        <a href="@detailUrl" class="text-dark text-decoration-none">
                                            @item.FullName
                                        </a>
                                    </div>
                                    @if (!string.IsNullOrWhiteSpace(item.Email))
                                    {
                                        <small class="text-muted">@item.Email</small>
                                    }
                                </td>
                                <td>
                                    <a href="tel:@item.Phone" class="text-decoration-none text-nowrap">
                                        <i class="bi bi-telephone me-1 text-muted"></i>@item.Phone
                                    </a>
                                </td>
                                <td>
                                    <span class="badge @(item.Source == 1 ? "bg-info-subtle text-info border border-info-subtle" : "bg-purple-subtle text-purple border border-purple-subtle")">
                                        @LeadLabels.SourceName(item.Source)
                                    </span>
                                </td>
                                <td>
                                    @if (item.ListingId.HasValue && item.ListingId.Value > 0)
                                    {
                                        <a href="/ilanlar/@item.ListingTypeId/@item.ListingId" class="text-decoration-none text-dark small fw-medium d-block text-truncate" style="max-width: 200px;" title="@item.ListingTitle">
                                            <i class="bi bi-house-door me-1 text-muted"></i>@(item.ListingTitle ?? $"İlan #{item.ListingId}")
                                        </a>
                                    }
                                    else if (!string.IsNullOrWhiteSpace(item.ServiceModule))
                                    {
                                        <span class="small fw-medium">
                                            @item.ServiceModule
                                            @if (!string.IsNullOrWhiteSpace(item.NeighborhoodName))
                                            {
                                                <span class="text-muted">(@item.NeighborhoodName)</span>
                                            }
                                        </span>
                                    }
                                    else
                                    {
                                        <span class="text-muted small">-</span>
                                    }
                                </td>
                                <td>
                                    <span class="badge bg-@LeadLabels.StatusBadge(item.Status)">
                                        @LeadLabels.StatusName(item.Status)
                                    </span>
                                </td>
                                <td>
                                    @if (!string.IsNullOrWhiteSpace(item.AssignedAgentName))
                                    {
                                        <span class="small text-dark fw-medium">@item.AssignedAgentName</span>
                                    }
                                    else
                                    {
                                        <span class="badge bg-light text-secondary border">Atanmamış</span>
                                    }
                                </td>
                                <td>
                                    <small class="text-muted text-nowrap">@item.CreatedDate.ToString("dd.MM.yyyy HH:mm")</small>
                                </td>
                                <td>
                                    @if (item.AppointmentDateTime.HasValue)
                                    {
                                        <span class="badge bg-warning-subtle text-dark border border-warning-subtle text-nowrap">
                                            <i class="bi bi-calendar-event me-1"></i>@item.AppointmentDateTime.Value.ToString("dd.MM.yyyy HH:mm")
                                        </span>
                                    }
                                    else
                                    {
                                        <span class="text-muted small">-</span>
                                    }
                                </td>
                                <td>
                                    <small class="text-muted text-nowrap">@LeadLabels.FormatTurkeyTime(item.LastActivityAtUtc)</small>
                                </td>
                                <td class="text-end pe-3">
                                    <a href="@detailUrl" class="btn btn-outline-primary btn-sm text-nowrap">
                                        <i class="bi bi-eye me-1"></i> Görüntüle
                                    </a>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>

    <!-- Mobil Kart Görünümü (d-md-none) -->
    <div class="d-md-none mb-4">
        @foreach (var item in Model.Response.Items)
        {
            var detailUrl = $"/talepler/{LeadLabels.SourceSlug(item.Source)}/{item.LeadId}";
            <div class="card mb-3 shadow-sm border-0">
                <div class="card-body p-3">
                    <div class="d-flex justify-content-between align-items-start mb-2">
                        <div>
                            <span class="badge bg-light text-dark border font-monospace me-1">@item.Key</span>
                            <span class="badge bg-@LeadLabels.StatusBadge(item.Status)">@LeadLabels.StatusName(item.Status)</span>
                        </div>
                        <span class="badge @(item.Source == 1 ? "bg-info-subtle text-info border border-info-subtle" : "bg-purple-subtle text-purple border border-purple-subtle")">
                            @LeadLabels.SourceName(item.Source)
                        </span>
                    </div>

                    <h6 class="mb-1 fw-bold">
                        <a href="@detailUrl" class="text-dark text-decoration-none">@item.FullName</a>
                    </h6>

                    <div class="small mb-2">
                        <a href="tel:@item.Phone" class="text-decoration-none text-muted">
                            <i class="bi bi-telephone me-1"></i>@item.Phone
                        </a>
                    </div>

                    @if (item.ListingId.HasValue && item.ListingId.Value > 0)
                    {
                        <div class="small text-muted mb-2">
                            <i class="bi bi-house-door me-1"></i>
                            <a href="/ilanlar/@item.ListingTypeId/@item.ListingId" class="text-decoration-none text-dark">
                                @(item.ListingTitle ?? $"İlan #{item.ListingId}")
                            </a>
                        </div>
                    }
                    else if (!string.IsNullOrWhiteSpace(item.ServiceModule))
                    {
                        <div class="small text-muted mb-2">
                            <i class="bi bi-gear me-1"></i>@item.ServiceModule
                            @if (!string.IsNullOrWhiteSpace(item.NeighborhoodName))
                            {
                                <span>(@item.NeighborhoodName)</span>
                            }
                        </div>
                    }

                    <div class="d-flex flex-wrap gap-2 small text-muted mb-2 pt-2 border-top">
                        <div>
                            <i class="bi bi-clock me-1"></i>@item.CreatedDate.ToString("dd.MM.yyyy HH:mm")
                        </div>
                        @if (item.AppointmentDateTime.HasValue)
                        {
                            <div class="text-warning fw-medium">
                                <i class="bi bi-calendar-event me-1"></i>Randevu: @item.AppointmentDateTime.Value.ToString("dd.MM.yyyy HH:mm")
                            </div>
                        }
                    </div>

                    <div class="d-flex justify-content-between align-items-center pt-2 border-top">
                        <span class="small text-muted">
                            <i class="bi bi-person me-1"></i>@(item.AssignedAgentName ?? "Atanmamış")
                        </span>
                        <a href="@detailUrl" class="btn btn-primary btn-sm px-3">
                            <i class="bi bi-eye me-1"></i> İncele
                        </a>
                    </div>
                </div>
            </div>
        }
    </div>

    <!-- Sayfalama ve Bilgi Çubuğu -->
    <div class="d-flex flex-column flex-md-row justify-content-between align-items-center gap-2 mb-4">
        <div class="text-muted small">
            @totalItems talepten @startItem–@endItem arası gösteriliyor
        </div>

        @if (totalPages > 1)
        {
            <nav aria-label="Talep sayfalaması">
                <ul class="pagination pagination-sm mb-0">
                    <!-- Önceki Butonu -->
                    <li class="page-item @(currentPage <= 1 ? "disabled" : "")">
                        <a class="page-link" href="@(currentPage > 1 ? Model.PageUrl(currentPage - 1) : "#")" tabindex="@(currentPage <= 1 ? "-1" : "0")" aria-label="Önceki">
                            <span aria-hidden="true">&laquo;</span>
                        </a>
                    </li>

                    @for (int p = startPage; p <= endPage; p++)
                    {
                        <li class="page-item @(p == currentPage ? "active" : "")">
                            <a class="page-link" href="@Model.PageUrl(p)">@p</a>
                        </li>
                    }

                    <!-- Sonraki Butonu -->
                    <li class="page-item @(currentPage >= totalPages ? "disabled" : "")">
                        <a class="page-link" href="@(currentPage < totalPages ? Model.PageUrl(currentPage + 1) : "#")" tabindex="@(currentPage >= totalPages ? "-1" : "0")" aria-label="Sonraki">
                            <span aria-hidden="true">&raquo;</span>
                        </a>
                    </li>
                </ul>
            </nav>
        }
    </div>
}
