@model List<string>
@{
    ViewData["Title"] = "Kurtarma Kodları";
    Layout = "_AuthLayout";
}

<div class="card mb-3 w-100">
  <div class="card-body">
    <div class="pt-4 pb-2">
      <h5 class="card-title text-center pb-0 fs-4">Kurtarma Kodlarınız</h5>
      <p class="text-center small">İki adımlı doğrulama cihazınıza erişemediğiniz durumlarda bu kodları kullanabilirsiniz</p>
    </div>

    <div class="alert alert-warning" role="alert">
      <i class="bi bi-exclamation-triangle me-1"></i>
      <strong>Önemli:</strong> Bu kodlar yalnızca bir kez gösterilir; güvenli bir yere kaydedin. Her kod tek kullanımlıktır.
    </div>

    <div class="recovery-codes-box bg-light p-3 border rounded mb-3" id="recoveryCodesContainer" data-codes="@string.Join("\n", Model ?? new List<string>())">
      <div class="row g-2">
        @if (Model != null)
        {
          @for (var i = 0; i < Model.Count; i++)
          {
            <div class="col-6">
              <div class="p-2 border rounded bg-white text-center font-monospace fw-bold user-select-all small recovery-code-item" data-code="@Model[i]">
                @Model[i]
              </div>
            </div>
          }
        }
      </div>
    </div>

    <div class="row g-2">
      <div class="col-12">
        <button type="button" class="btn btn-outline-primary w-100" id="btnDownloadCodes">
          <i class="bi bi-download me-1"></i> Kodları İndir (.txt)
        </button>
      </div>
      <div class="col-12">
        <a href="/" class="btn btn-primary w-100">
          <i class="bi bi-check2-circle me-1"></i> Kaydettim, Devam Et
        </a>
      </div>
    </div>
  </div>
</div>

@section Scripts {
  <script src="~/js/recovery-codes.js" asp-append-version="true"></script>
}
