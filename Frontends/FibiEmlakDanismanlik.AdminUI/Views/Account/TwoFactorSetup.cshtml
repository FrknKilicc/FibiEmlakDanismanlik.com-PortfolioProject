@model FibiEmlakDanismanlik.AdminUI.Models.Account.TwoFactorSetupViewModel
@{
    ViewData["Title"] = "İki Adımlı Doğrulama Kurulumu";
    Layout = "_AuthLayout";
}

<div class="card mb-3 w-100">
  <div class="card-body">
    <div class="pt-4 pb-2">
      <h5 class="card-title text-center pb-0 fs-4">İki Adımlı Doğrulama Kurulumu</h5>
      <p class="text-center small">Hesap güvenliğinizi artırmak için kimlik doğrulayıcı uygulamanızı yapılandırın</p>
    </div>

    @if (!ViewData.ModelState.IsValid && ViewData.ModelState[string.Empty]?.Errors.Count > 0)
    {
      <div class="alert alert-danger" role="alert">
        <i class="bi bi-exclamation-octagon me-1"></i>
        @foreach (var error in ViewData.ModelState[string.Empty]!.Errors)
        {
          <div>@error.ErrorMessage</div>
        }
      </div>
    }

    <div class="alert alert-light border p-3 mb-3">
      <div class="fw-bold mb-2 small text-primary"><i class="bi bi-info-circle me-1"></i> Adım Adım Kurulum Talimatı:</div>
      <ol class="small mb-0 ps-3">
        <li class="mb-1">Telefonunuzda <strong>Google Authenticator</strong> veya <strong>Microsoft Authenticator</strong> uygulamasını açın.</li>
        <li class="mb-1">Uygulamada hesap ekleme <strong>(+)</strong> seçeneğine dokunup <strong>QR Kodu Tara</strong>'yı seçin.</li>
        <li class="mb-1">Aşağıdaki QR kodu telefonunuzun kamerasıyla tarayın.</li>
        <li>QR kodu tarayamıyorsanız, uygulamada <strong>Kurulum Anahtarı Gir</strong> seçeneğini kullanarak aşağıdaki gizli anahtarı elle ekleyin.</li>
      </ol>
    </div>

    @if (!string.IsNullOrWhiteSpace(Model?.QrCodeBase64))
    {
      <div class="text-center my-3">
        <img src="@Model.QrCodeBase64" alt="İki Adımlı Doğrulama QR Kodu" class="img-fluid border rounded p-2 bg-white" style="max-width: 220px;" />
      </div>
    }

    @if (!string.IsNullOrWhiteSpace(Model?.ManualSecret))
    {
      <div class="mb-3 text-center">
        <label class="form-label small text-muted mb-1">Elle Giriş Anahtarı (Gizli Anahtar)</label>
        <div class="p-2 bg-light border rounded font-monospace fw-bold text-dark user-select-all small">
          @Model.ManualSecret
        </div>
        <div class="text-muted small mt-1" style="font-size: 0.75rem;">(Anahtar türü: Zamana Dayalı / TOTP)</div>
      </div>
    }

    <form asp-action="TwoFactorSetup" asp-controller="Account" method="post" class="row g-3">
      <div class="col-12">
        <label asp-for="Code" class="form-label text-center d-block fw-semibold">Uygulamadaki 6 Haneli Doğrulama Kodu</label>
        <div class="input-group">
          <span class="input-group-text"><i class="bi bi-shield-check"></i></span>
          <input asp-for="Code" class="form-control text-center font-monospace fs-5 tracking-wide"
                 inputmode="numeric"
                 autocomplete="one-time-code"
                 maxlength="6"
                 pattern="\d{6}"
                 placeholder="000000"
                 required />
        </div>
        <span asp-validation-for="Code" class="text-danger small mt-1 d-block text-center"></span>
      </div>

      <div class="col-12">
        <button class="btn btn-primary w-100" type="submit">Doğrula ve Etkinleştir</button>
      </div>

      <div class="col-12 text-center">
        <a asp-action="Login" class="small text-muted">Giriş ekranına dön</a>
      </div>
    </form>
  </div>
</div>
