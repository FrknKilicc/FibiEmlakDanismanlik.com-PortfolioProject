@model FibiEmlakDanismanlik.AdminUI.Models.Account.ChangePasswordViewModel
@{
    ViewData["Title"] = "Şifre Değiştir";
    Layout = "_AuthLayout";
}

<div class="card mb-3 w-100">
  <div class="card-body">
    <div class="pt-4 pb-2">
      <h5 class="card-title text-center pb-0 fs-4">Yeni Şifre Belirleyin</h5>
      <p class="text-center small">Güvenliğiniz için hesabınızın şifresini güncellemeniz gerekmektedir</p>
    </div>

    @if (!ViewData.ModelState.IsValid && ViewData.ModelState[string.Empty]?.Errors.Count > 0)
    {
      <div class="alert alert-danger" role="alert">
        <i class="bi bi-exclamation-octagon me-1"></i>
        @foreach (var error in ViewData.ModelState[string.Empty]!.Errors)
        {
          <div>@error.ErrorMessage</div>
        }
      </div>
    }

    <div class="alert alert-info py-2" role="alert">
      <div class="small fw-semibold mb-1"><i class="bi bi-shield-lock me-1"></i> Şifre Gereksinimleri:</div>
      <ul class="small mb-0 ps-3">
        <li>En az 12 karakter uzunluğunda olmalıdır.</li>
        <li>En az bir büyük harf (A-Z) ve bir küçük harf (a-z) içermelidir.</li>
        <li>En az bir rakam (0-9) içermelidir.</li>
      </ul>
    </div>

    <form asp-action="ChangePassword" asp-controller="Account" method="post" class="row g-3">
      <div class="col-12">
        <label asp-for="NewPassword" class="form-label">Yeni Şifre</label>
        <div class="input-group">
          <span class="input-group-text"><i class="bi bi-key"></i></span>
          <input asp-for="NewPassword" class="form-control" type="password" autocomplete="new-password" placeholder="En az 12 karakter" required>
        </div>
        <span asp-validation-for="NewPassword" class="text-danger small mt-1 d-block"></span>
      </div>

      <div class="col-12">
        <label asp-for="ConfirmPassword" class="form-label">Yeni Şifre (Tekrar)</label>
        <div class="input-group">
          <span class="input-group-text"><i class="bi bi-key-fill"></i></span>
          <input asp-for="ConfirmPassword" class="form-control" type="password" autocomplete="new-password" placeholder="Yeni şifrenizi tekrar girin" required>
        </div>
        <span asp-validation-for="ConfirmPassword" class="text-danger small mt-1 d-block"></span>
      </div>

      <div class="col-12">
        <button class="btn btn-primary w-100" type="submit">Şifreyi Güncelle ve Devam Et</button>
      </div>

      <div class="col-12 text-center">
        <a asp-action="Login" class="small text-muted">Giriş ekranına dön</a>
      </div>
    </form>
  </div>
</div>
