@model FibiEmlakDanismanlik.AdminUI.Models.Account.TwoFactorVerifyViewModel
@{
    ViewData["Title"] = "İki Adımlı Doğrulama";
    Layout = "_AuthLayout";
    var isRecovery = Model?.UseRecoveryCode == true;
}

<div class="card mb-3 w-100">
  <div class="card-body">
    <div class="pt-4 pb-2">
      <h5 class="card-title text-center pb-0 fs-4">İki Adımlı Doğrulama</h5>
      <p class="text-center small">Hesabınıza güvenle erişebilmek için doğrulama kodunuzu giriniz</p>
    </div>

    @if (!ViewData.ModelState.IsValid && ViewData.ModelState[string.Empty]?.Errors.Count > 0)
    {
      <div class="alert alert-danger" role="alert">
        <i class="bi bi-exclamation-octagon me-1"></i>
        @foreach (var error in ViewData.ModelState[string.Empty]!.Errors)
        {
          <div>@error.ErrorMessage</div>
        }
      </div>
    }

    <form asp-action="TwoFactorVerify" asp-controller="Account" method="post" class="row g-3">
      <input type="hidden" asp-for="UseRecoveryCode" id="useRecoveryCodeInput" />
      <input type="hidden" asp-for="ReturnUrl" />

      <!-- TOTP Kodu Alanı -->
      <div class="col-12 @(isRecovery ? "d-none" : "")" id="totpSection">
        <label asp-for="Code" class="form-label text-center d-block fw-semibold">6 Haneli Doğrulama Kodu</label>
        <div class="input-group">
          <span class="input-group-text"><i class="bi bi-shield-check"></i></span>
          <input asp-for="Code" class="form-control text-center font-monospace fs-5"
                 id="totpCodeInput"
                 inputmode="numeric"
                 autocomplete="one-time-code"
                 maxlength="6"
                 pattern="\d{6}"
                 placeholder="000000" />
        </div>
        <span asp-validation-for="Code" class="text-danger small mt-1 d-block text-center"></span>

        <div class="text-center mt-2">
          <button type="button" class="btn btn-link btn-sm text-decoration-none" id="btnSwitchToRecovery">
            <i class="bi bi-key me-1"></i> Cihazınıza erişemiyor musunuz? Kurtarma kodu kullanın
          </button>
        </div>
      </div>

      <!-- Kurtarma Kodu Alanı -->
      <div class="col-12 @(!isRecovery ? "d-none" : "")" id="recoverySection">
        <label asp-for="RecoveryCode" class="form-label text-center d-block fw-semibold">Kurtarma Kodu</label>
        <div class="input-group">
          <span class="input-group-text"><i class="bi bi-key-fill"></i></span>
          <input asp-for="RecoveryCode" class="form-control text-center font-monospace"
                 id="recoveryCodeInput"
                 autocomplete="off"
                 placeholder="Kurtarma kodunu giriniz" />
        </div>
        <span asp-validation-for="RecoveryCode" class="text-danger small mt-1 d-block text-center"></span>

        <div class="text-center mt-2">
          <button type="button" class="btn btn-link btn-sm text-decoration-none" id="btnSwitchToTotp">
            <i class="bi bi-phone me-1"></i> Doğrulama kodu (TOTP) ile giriş yap
          </button>
        </div>
      </div>

      <div class="col-12">
        <button class="btn btn-primary w-100" type="submit">Doğrula ve Giriş Yap</button>
      </div>

      <div class="col-12 text-center">
        <a asp-action="Login" class="small text-muted">Giriş ekranına dön</a>
      </div>
    </form>
  </div>
</div>

@section Scripts {
  <script src="~/js/two-factor.js" asp-append-version="true"></script>
}
