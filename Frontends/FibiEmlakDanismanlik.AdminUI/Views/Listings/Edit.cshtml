                            <input class="form-check-input" type="checkbox" role="switch" id="homeLoan" name="HomeLoan" value="true" checked="@(Model.Form.HomeLoan == true ? "checked" : null)" disabled="@disabledAttr" />
                            <input type="hidden" name="HomeLoan" value="false" disabled="@disabledAttr" />
                            <label class="form-check-label fw-medium" for="homeLoan">Konut Kredisine Uygun</label>
                        </div>
                    </div>
                }

                @if (Model.Form.Has("LandLoan"))
                {
                    <div class="col-lg-3 col-md-4 col-sm-6 col-12">
                        <div class="form-check form-switch">
                            <input class="form-check-input" type="checkbox" role="switch" id="landLoan" name="LandLoan" value="true" checked="@(Model.Form.LandLoan == true ? "checked" : null)" disabled="@disabledAttr" />
                            <input type="hidden" name="LandLoan" value="false" disabled="@disabledAttr" />
                            <label class="form-check-label fw-medium" for="landLoan">Krediye Uygun</label>
                        </div>
                    </div>
                }

                @if (Model.Form.Has("DevelopmentRight"))
                {
                    <div class="col-lg-3 col-md-4 col-sm-6 col-12">
                        <div class="form-check form-switch">
                            <input class="form-check-input" type="checkbox" role="switch" id="developmentRight" name="DevelopmentRight" value="true" checked="@(Model.Form.DevelopmentRight == true ? "checked" : null)" disabled="@disabledAttr" />
                            <input type="hidden" name="DevelopmentRight" value="false" disabled="@disabledAttr" />
                            <label class="form-check-label fw-medium" for="developmentRight">Kat Karşılığı / İmar İzni</label>
                        </div>
                    </div>
                }

                @if (Model.Form.Has("Transferable"))
                {
                    <div class="col-lg-3 col-md-4 col-sm-6 col-12">
                        <div class="form-check form-switch">
                            <input class="form-check-input" type="checkbox" role="switch" id="transferable" name="Transferable" value="true" checked="@(Model.Form.Transferable == true ? "checked" : null)" disabled="@disabledAttr" />
                            <input type="hidden" name="Transferable" value="false" disabled="@disabledAttr" />
                            <label class="form-check-label fw-medium" for="transferable">Devren</label>
                        </div>
                    </div>
                }
            </div>
        </div>
    </div>

    <!-- 5. Olanaklar Kartı -->
    @if (Model.ApplicableAmenities.Any())
    {
        var groupedAmenities = Model.ApplicableAmenities
            .GroupBy(a => string.IsNullOrWhiteSpace(a.GroupName) ? "Genel Özellikler" : a.GroupName)
            .OrderBy(g => g.Key);

        <div class="card mb-4 shadow-sm border-0">
            <div class="card-body pt-3">
                <h5 class="card-title p-0 pb-3 border-bottom mb-3">
                    <i class="bi bi-check2-square me-2 text-primary"></i>Olanaklar ve Donatılar
                </h5>
                @foreach (var group in groupedAmenities)
                {
                    <div class="mb-3">
                        <h6 class="fw-bold text-muted small text-uppercase mb-2">
                            <i class="bi bi-tag me-1"></i>@group.Key
                        </h6>
                        <div class="row g-2">
                            @foreach (var amenity in group)
                            {
                                <div class="col-lg-3 col-md-4 col-sm-6 col-12">
                                    <div class="form-check">
                                        <input class="form-check-input" type="checkbox" name="AmenityIds" value="@amenity.Key" id="amenity_@amenity.Key" checked="@(Model.Form.AmenityIds != null && Model.Form.AmenityIds.Contains(amenity.Key) ? "checked" : null)" disabled="@disabledAttr" />
                                        <label class="form-check-label small" for="amenity_@amenity.Key">
                                            @amenity.DisplayName
                                        </label>
                                    </div>
                                </div>
                            }
                        </div>
                    </div>
                }
            </div>
        </div>
    }

    <!-- 6. Altta Sabit (Sticky) Eylem Çubuğu -->
    <div class="card shadow-lg border position-sticky bottom-0 bg-white z-3 mb-4 rounded-3">
        <div class="card-body p-3 d-flex flex-wrap justify-content-between align-items-center gap-2">
            <div class="text-muted small">
                @if (Model.IsNew)
                {
                    <span>Yeni ilan oluşturuluyor. Kaydettikten sonra fotoğraf ve vitrin ayarlarını düzenleyebilirsiniz.</span>
                }
                else
                {
                    <span>İlan No: #@Model.Form.ListingId</span>
                }
            </div>
            <div class="d-flex align-items-center gap-2 ms-auto">
                <a href="/ilanlar" class="btn btn-outline-secondary px-4">
                    <i class="bi bi-x-lg me-1"></i> Vazgeç
                </a>
                @if (Model.CanEdit)
                {
                    <button type="submit" id="submitBtn" class="btn btn-primary px-4 shadow-sm">
                        <i class="bi bi-check-lg me-1"></i> @(Model.IsNew ? "Kaydet ve fotoğraf eklemeye geç" : "Değişiklikleri Kaydet")
                    </button>
                }
            </div>
        </div>
    </div>
</form>

@section Scripts {
    <script src="~/js/listing-form.js" asp-append-version="true"></script>
}
