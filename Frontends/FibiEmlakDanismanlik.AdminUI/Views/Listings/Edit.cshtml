            .OrderBy(g => g.Key);

        <div class="card mb-4 shadow-sm border-0">
            <div class="card-body pt-3">
                <h5 class="card-title p-0 pb-3 border-bottom mb-3">
                    <i class="bi bi-check2-square me-2 text-primary"></i>Olanaklar ve Donatılar
                </h5>
                @foreach (var group in groupedAmenities)
                {
                    <div class="mb-3">
                        <h6 class="fw-bold text-muted small text-uppercase mb-2">
                            <i class="bi bi-tag me-1"></i>@group.Key
                        </h6>
                        <div class="row g-2">
                            @foreach (var amenity in group)
                            {
                                <div class="col-lg-3 col-md-4 col-sm-6 col-12">
                                    <div class="form-check">
                                        <input class="form-check-input" type="checkbox" name="AmenityIds" value="@amenity.Key" id="amenity_@amenity.Key" checked="@(Model.Form.AmenityIds != null && Model.Form.AmenityIds.Contains(amenity.Key) ? "checked" : null)" disabled="@disabledAttr" />
                                        <label class="form-check-label small" for="amenity_@amenity.Key">
                                            @amenity.DisplayName
                                        </label>
                                    </div>
                                </div>
                            }
                        </div>
                    </div>
                }
            </div>
        </div>
    }

