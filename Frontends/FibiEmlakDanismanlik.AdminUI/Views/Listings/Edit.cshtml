                @if (Model.Form.Has("TitleDeedStatus"))
                {
                    <div class="col-lg-4 col-md-6 col-12">
                        <label for="titleDeedStatus" class="form-label fw-semibold">Tapu Durumu</label>
                        <select class="form-select @(Model.GetFieldError("TitleDeedStatus") != null ? "is-invalid" : "")" id="titleDeedStatus" name="TitleDeedStatus" disabled="@disabledAttr">
                            <option value="">Seçiniz</option>
                            @foreach (var opt in ListingFormViewModel.GetOptionsWithCustom(ListingFormViewModel.TitleDeedStatusOptions, Model.Form.TitleDeedStatus))
                            {
                                <option value="@opt" selected="@(string.Equals(Model.Form.TitleDeedStatus, opt, StringComparison.OrdinalIgnoreCase) ? "selected" : null)">@opt</option>
                            }
                        </select>
                        @if (Model.GetFieldError("TitleDeedStatus") != null)
                        {
                            <div class="invalid-feedback d-block">@Model.GetFieldError("TitleDeedStatus")</div>
                        }
                    </div>
                }

                @if (Model.Form.Has("ZoningStatus"))
                {
                    <div class="col-lg-4 col-md-6 col-12">
                        <label for="zoningStatus" class="form-label fw-semibold">İmar Durumu</label>
                        <select class="form-select @(Model.GetFieldError("ZoningStatus") != null ? "is-invalid" : "")" id="zoningStatus" name="ZoningStatus" disabled="@disabledAttr">
                            <option value="">Seçiniz</option>
                            @foreach (var opt in ListingFormViewModel.GetOptionsWithCustom(ListingFormViewModel.ZoningStatusOptions, Model.Form.ZoningStatus))
                            {
                                <option value="@opt" selected="@(string.Equals(Model.Form.ZoningStatus, opt, StringComparison.OrdinalIgnoreCase) ? "selected" : null)">@opt</option>
                            }
                        </select>
                        @if (Model.GetFieldError("ZoningStatus") != null)
                        {
                            <div class="invalid-feedback d-block">@Model.GetFieldError("ZoningStatus")</div>
                        }
                    </div>
                }

                @if (Model.Form.Has("SharePercentage"))
                {
                    <div class="col-lg-4 col-md-6 col-12">
                        <label for="sharePercentage" class="form-label fw-semibold">Hisse Oranı</label>
                        <div class="input-group">
                            <input type="number" step="any" min="0" max="100" class="form-control @(Model.GetFieldError("SharePercentage") != null ? "is-invalid" : "")" id="sharePercentage" name="SharePercentage" value="@Model.Form.SharePercentage?.ToString(invCulture)" disabled="@disabledAttr" />
                            <span class="input-group-text">%</span>
                        </div>
                        @if (Model.GetFieldError("SharePercentage") != null)
                        {
                            <div class="invalid-feedback d-block">@Model.GetFieldError("SharePercentage")</div>
                        }
                    </div>
                }

                @if (Model.Form.Has("ParcelNumber"))
                {
                    <div class="col-lg-4 col-md-6 col-12">
                        <label for="parcelNumber" class="form-label fw-semibold">Parsel No</label>
                        <input type="text" class="form-control @(Model.GetFieldError("ParcelNumber") != null ? "is-invalid" : "")" id="parcelNumber" name="ParcelNumber" value="@Model.Form.ParcelNumber" disabled="@disabledAttr" />
                        @if (Model.GetFieldError("ParcelNumber") != null)
                        {
                            <div class="invalid-feedback d-block">@Model.GetFieldError("ParcelNumber")</div>
                        }
                    </div>
                }

                @if (Model.Form.Has("PlotNumber"))
                {
                    <div class="col-lg-4 col-md-6 col-12">
                        <label for="plotNumber" class="form-label fw-semibold">Ada No</label>
                        <input type="text" class="form-control @(Model.GetFieldError("PlotNumber") != null ? "is-invalid" : "")" id="plotNumber" name="PlotNumber" value="@Model.Form.PlotNumber" disabled="@disabledAttr" />
                        @if (Model.GetFieldError("PlotNumber") != null)
                        {
                            <div class="invalid-feedback d-block">@Model.GetFieldError("PlotNumber")</div>
                        }
                    </div>
                }

                @if (Model.Form.Has("MapSheetNumber"))
                {
                    <div class="col-lg-4 col-md-6 col-12">
                        <label for="mapSheetNumber" class="form-label fw-semibold">Pafta No</label>
                        <input type="text" class="form-control @(Model.GetFieldError("MapSheetNumber") != null ? "is-invalid" : "")" id="mapSheetNumber" name="MapSheetNumber" value="@Model.Form.MapSheetNumber" disabled="@disabledAttr" />
                        @if (Model.GetFieldError("MapSheetNumber") != null)
                        {
                            <div class="invalid-feedback d-block">@Model.GetFieldError("MapSheetNumber")</div>
                        }
                    </div>
                }

                @if (Model.Form.Has("FloorAreaRatio"))
                {
                    <div class="col-lg-4 col-md-6 col-12">
                        <label for="floorAreaRatio" class="form-label fw-semibold">KAKS / Emsal</label>
                        <input type="number" step="any" min="0" class="form-control @(Model.GetFieldError("FloorAreaRatio") != null ? "is-invalid" : "")" id="floorAreaRatio" name="FloorAreaRatio" value="@Model.Form.FloorAreaRatio?.ToString(invCulture)" disabled="@disabledAttr" />
                        @if (Model.GetFieldError("FloorAreaRatio") != null)
                        {
                            <div class="invalid-feedback d-block">@Model.GetFieldError("FloorAreaRatio")</div>
                        }
                    </div>
                }

                @if (Model.Form.Has("BaseAreaRatio"))
                {
                    <div class="col-lg-4 col-md-6 col-12">
                        <label for="baseAreaRatio" class="form-label fw-semibold">TAKS</label>
                        <input type="number" step="any" min="0" class="form-control @(Model.GetFieldError("BaseAreaRatio") != null ? "is-invalid" : "")" id="baseAreaRatio" name="BaseAreaRatio" value="@Model.Form.BaseAreaRatio?.ToString(invCulture)" disabled="@disabledAttr" />
                        @if (Model.GetFieldError("BaseAreaRatio") != null)
                        {
                            <div class="invalid-feedback d-block">@Model.GetFieldError("BaseAreaRatio")</div>
                        }
                    </div>
                }

                @if (Model.Form.Has("ZoningPlan"))
                {
                    <div class="col-lg-4 col-md-6 col-12">
                        <label for="zoningPlan" class="form-label fw-semibold">İmar Planı</label>
                        <input type="text" class="form-control @(Model.GetFieldError("ZoningPlan") != null ? "is-invalid" : "")" id="zoningPlan" name="ZoningPlan" value="@Model.Form.ZoningPlan" disabled="@disabledAttr" />
                        @if (Model.GetFieldError("ZoningPlan") != null)
                        {
                            <div class="invalid-feedback d-block">@Model.GetFieldError("ZoningPlan")</div>
                        }
                    </div>
                }
            </div>

            <!-- Evet / Hayır Seçenekleri (Form-Switch) -->
            <div class="row g-3 mt-3 pt-3 border-top">
                @if (Model.Form.Has("IsElevator"))
                {
                    <div class="col-lg-3 col-md-4 col-sm-6 col-12">
                        <div class="form-check form-switch">
                            <input class="form-check-input" type="checkbox" role="switch" id="isElevator" name="IsElevator" value="true" checked="@(Model.Form.IsElevator == true ? "checked" : null)" disabled="@disabledAttr" />
                            <input type="hidden" name="IsElevator" value="false" disabled="@disabledAttr" />
                            <label class="form-check-label fw-medium" for="isElevator">Asansör</label>
                        </div>
                    </div>
                }

                @if (Model.Form.Has("BlackBox"))
                {
                    <div class="col-lg-3 col-md-4 col-sm-6 col-12">
                        <div class="form-check form-switch">
                            <input class="form-check-input" type="checkbox" role="switch" id="blackBox" name="BlackBox" value="true" checked="@(Model.Form.BlackBox == true ? "checked" : null)" disabled="@disabledAttr" />
                            <input type="hidden" name="BlackBox" value="false" disabled="@disabledAttr" />
                            <label class="form-check-label fw-medium" for="blackBox">Karanlık Oda / Kiler</label>
                        </div>
                    </div>
                }

                @if (Model.Form.Has("ParkingLot"))
                {
                    <div class="col-lg-3 col-md-4 col-sm-6 col-12">
                        <div class="form-check form-switch">
                            <input class="form-check-input" type="checkbox" role="switch" id="parkingLot" name="ParkingLot" value="true" checked="@(Model.Form.ParkingLot == true ? "checked" : null)" disabled="@disabledAttr" />
                            <input type="hidden" name="ParkingLot" value="false" disabled="@disabledAttr" />
                            <label class="form-check-label fw-medium" for="parkingLot">Otopark</label>
                        </div>
                    </div>
                }

                @if (Model.Form.Has("Furnished"))
                {
                    <div class="col-lg-3 col-md-4 col-sm-6 col-12">
                        <div class="form-check form-switch">
                            <input class="form-check-input" type="checkbox" role="switch" id="furnished" name="Furnished" value="true" checked="@(Model.Form.Furnished == true ? "checked" : null)" disabled="@disabledAttr" />
                            <input type="hidden" name="Furnished" value="false" disabled="@disabledAttr" />
                            <label class="form-check-label fw-medium" for="furnished">Eşyalı</label>
                        </div>
                    </div>
                }

                @if (Model.Form.Has("WithinTheComplex"))
                {
                    <div class="col-lg-3 col-md-4 col-sm-6 col-12">
                        <div class="form-check form-switch">
                            <input class="form-check-input" type="checkbox" role="switch" id="withinTheComplex" name="WithinTheComplex" value="true" checked="@(Model.Form.WithinTheComplex == true ? "checked" : null)" disabled="@disabledAttr" />
                            <input type="hidden" name="WithinTheComplex" value="false" disabled="@disabledAttr" />
                            <label class="form-check-label fw-medium" for="withinTheComplex">Site İçerisinde</label>
                        </div>
                    </div>
                }

                @if (Model.Form.Has("Exchange"))
                {
                    <div class="col-lg-3 col-md-4 col-sm-6 col-12">
                        <div class="form-check form-switch">
                            <input class="form-check-input" type="checkbox" role="switch" id="exchange" name="Exchange" value="true" checked="@(Model.Form.Exchange == true ? "checked" : null)" disabled="@disabledAttr" />
                            <input type="hidden" name="Exchange" value="false" disabled="@disabledAttr" />
                            <label class="form-check-label fw-medium" for="exchange">Takaslı</label>
                        </div>
                    </div>
                }

                @if (Model.Form.Has("HomeLoan"))
                {
                    <div class="col-lg-3 col-md-4 col-sm-6 col-12">
