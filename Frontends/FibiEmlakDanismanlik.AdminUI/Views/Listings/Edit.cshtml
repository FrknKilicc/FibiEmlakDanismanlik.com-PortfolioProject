@using System.Globalization
@using FibiEmlakDanismanlik.AdminUI.Models.ListingAlerts
@model FibiEmlakDanismanlik.AdminUI.Models.Listings.ListingFormViewModel
@inject FibiEmlakDanismanlik.AdminUI.Infrastructure.CurrentAdmin CurrentAdmin
@{
    var isNew = Model.IsNew;
    var pageTitle = isNew ? $"Yeni İlan: {Model.Form.TypeTitle}" : Model.Form.PropertyName;
    ViewData["Title"] = pageTitle;
    var disabledAttr = !Model.CanEdit ? "disabled" : null;
    var invCulture = CultureInfo.InvariantCulture;
}

<div class="pagetitle d-flex flex-wrap justify-content-between align-items-center gap-2 mb-3">
    <div>
        <div class="d-flex align-items-center gap-2 flex-wrap">
            <h1 class="mb-0">@pageTitle</h1>
            @if (!isNew)
            {
                <span class="text-muted fs-5 fw-normal">#@Model.Form.ListingId</span>
                <span class="badge bg-@Model.StatusBadgeClass(Model.Form.PropertyStatus) fs-6">
                    @(string.IsNullOrWhiteSpace(Model.Form.PropertyStatus) ? "Taslak" : Model.Form.PropertyStatus)
                </span>
            }
        </div>
        <nav class="mt-1">
            <ol class="breadcrumb mb-0">
                <li class="breadcrumb-item"><a href="/">Ana Sayfa</a></li>
                <li class="breadcrumb-item"><a href="/ilanlar">İlanlar</a></li>
                @if (isNew)
                {
                    <li class="breadcrumb-item active">Yeni İlan (@Model.Form.TypeTitle)</li>
                }
                else
                {
                    <li class="breadcrumb-item active">@Model.Form.TypeTitle</li>
                    <li class="breadcrumb-item active">#@Model.Form.ListingId</li>
                }
            </ol>
        </nav>
    </div>

    <div class="d-flex gap-2">
        <a href="/ilanlar" class="btn btn-outline-secondary">
            <i class="bi bi-arrow-left me-1"></i> İlan Listesine Dön
        </a>
    </div>
</div>

@if (TempData["Success"] != null)
{
    <div class="alert alert-success alert-dismissible fade show d-flex align-items-center mb-4" role="alert">
        <i class="bi bi-check-circle-fill flex-shrink-0 me-2 fs-5"></i>
        <div>@TempData["Success"]</div>
        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Kapat"></button>
    </div>
}

@if (TempData["Error"] != null)
{
    <div class="alert alert-danger alert-dismissible fade show d-flex align-items-center mb-4" role="alert">
        <i class="bi bi-exclamation-triangle-fill flex-shrink-0 me-2 fs-5"></i>
        <div>@TempData["Error"]</div>
        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Kapat"></button>
    </div>
}

@if (!string.IsNullOrWhiteSpace(Model.ErrorMessage))
{
    <div class="alert alert-danger alert-dismissible fade show d-flex align-items-center mb-4" role="alert">
        <i class="bi bi-exclamation-triangle-fill flex-shrink-0 me-2 fs-5"></i>
        <div>@Model.ErrorMessage</div>
        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Kapat"></button>
    </div>
}

@if (!Model.CanEdit)
{
    <div class="alert alert-info d-flex align-items-center mb-4" role="alert">
        <i class="bi bi-info-circle-fill flex-shrink-0 me-2 fs-5"></i>
        <div>Bu ilanı yalnızca görüntüleyebilirsiniz. Düzenleme yetkiniz bulunmamaktadır.</div>
    </div>
}

@if (!isNew)
{
    <!-- Fotoğraflar Kartı (Formun Üstünde, Tam Genişlik) -->
    <div class="card mb-4 shadow-sm border-0" id="photosCard"
         data-listing-type-id="@Model.Form.ListingTypeId"
         data-listing-id="@Model.Form.ListingId"
         data-can-edit="@Model.CanEdit.ToString().ToLowerInvariant()">
        <div class="card-body pt-3">
            <div class="d-flex justify-content-between align-items-center pb-2 border-bottom mb-3 flex-wrap gap-2">
                <h5 class="card-title p-0 m-0">
                    <i class="bi bi-images me-2 text-primary"></i>İlan Fotoğrafları
                </h5>
                <div class="d-flex align-items-center gap-2">
                    <span class="text-muted small fw-medium" id="photoCountBadge">
                        Toplam @(Model.Images?.Count ?? 0) / 30 fotoğraf
                    </span>
                    @if (Model.CanEdit)
                    {
                        <button type="button" id="saveOrderBtn" class="btn btn-success btn-sm d-none">
                            <i class="bi bi-check2-circle me-1"></i> Sıralamayı Kaydet
                        </button>
                    }
                </div>
            </div>

            <div id="photosAlertArea"></div>

            @if (Model.CanEdit)
            {
                <div id="photoDropzone" class="photo-dropzone p-4 mb-3 text-center border border-2 border-dashed rounded-3 bg-light">
                    <i class="bi bi-cloud-arrow-up display-5 text-primary mb-2 d-block"></i>
                    <div class="fw-semibold fs-6">Fotoğrafları buraya sürükleyip bırakın</div>
                    <div class="text-muted small mb-2">veya bilgisayarınızdan seçin</div>
                    <label class="btn btn-outline-primary btn-sm mb-1 px-3">
                        <i class="bi bi-folder2-open me-1"></i> Fotoğraf Seç
                        <input type="file" id="photoFileInput" class="d-none" multiple accept="image/jpeg,image/png,image/webp" />
                    </label>
                    <div class="text-muted small mt-2">
                        En fazla 30 fotoğraf, her biri en fazla 15 MB. JPG, PNG veya WebP desteklenir. Konum (GPS) bilgisi otomatik silinir.
                    </div>
                </div>

                <div id="photoUploadProgressWrapper" class="progress mb-3 d-none" style="height: 10px;">
                    <div id="photoUploadProgressBar" class="progress-bar progress-bar-striped progress-bar-animated bg-success" role="progressbar" style="width: 0%" aria-valuenow="0" aria-valuemin="0" aria-valuemax="100"></div>
                </div>
            }

            <div id="photoGrid" class="row g-3 photo-grid">
                @if (Model.Images != null && Model.Images.Count > 0)
                {
                    @foreach (var img in Model.Images.OrderBy(i => i.SortOrder))
                    {
                        <div class="col-6 col-sm-4 col-md-3 col-lg-2 photo-item" data-image-id="@img.ListingImageId" draggable="@(Model.CanEdit ? "true" : "false")">
                            <div class="card h-100 border shadow-none photo-card position-relative overflow-hidden">
                                <div class="photo-thumb-wrapper ratio ratio-4x3 bg-light">
                                    <img src="@(string.IsNullOrWhiteSpace(img.ThumbUrl) ? img.Url : img.ThumbUrl)" class="object-fit-cover w-100 h-100" alt="Fotoğraf @img.ListingImageId" loading="lazy" />
                                </div>
                                <span class="badge bg-primary position-absolute top-0 start-0 m-2 cover-badge @(img.IsCover ? "" : "d-none")">
                                    <i class="bi bi-star-fill me-1"></i> Kapak
                                </span>
                                @if (Model.CanEdit)
                                {
                                    <div class="card-footer p-1 bg-white border-top-0 d-flex justify-content-between gap-1">
                                        <button type="button" class="btn btn-sm btn-outline-secondary flex-grow-1 p-1 set-cover-btn @(img.IsCover ? "d-none" : "")" data-action="set-cover" title="Kapak yap">
                                            <i class="bi bi-star"></i> Kapak
                                        </button>
                                        <button type="button" class="btn btn-sm btn-outline-danger p-1 px-2 delete-photo-btn" data-action="delete" title="Fotoğrafı sil">
                                            <i class="bi bi-trash"></i>
                                        </button>
                                    </div>
                                }
                            </div>
                        </div>
                    }
                }
                else
                {
                    <div class="col-12 text-center py-4 text-muted empty-photos-placeholder">
                        <i class="bi bi-images display-6 d-block mb-2 text-secondary"></i>
                        Henüz hiç fotoğraf eklenmemiş.
                    </div>
                }
            </div>
        </div>
    </div>
}

<div class="row g-4">
    <div class="@(!isNew ? "col-lg-8 col-12" : "col-12")">
        <form action="/ilanlar/kaydet" method="post" id="listingForm" novalidate>
    @Html.AntiForgeryToken()

    <input type="hidden" name="ListingTypeId" value="@Model.Form.ListingTypeId" />
    <input type="hidden" name="ListingId" value="@Model.Form.ListingId" />
    <input type="hidden" name="PropertyStatus" value="@Model.Form.PropertyStatus" />

    <!-- Konum Gizli Değerleri (Adlar metin olarak API'ye gider) -->
    <input type="hidden" id="cityInput" name="City" value="@Model.Form.City" />
    <input type="hidden" id="districtInput" name="District" value="@Model.Form.District" />
    <input type="hidden" id="neighborhoodInput" name="Neighborhood" value="@Model.Form.Neighborhood" />
    <input type="hidden" id="cityIdInput" name="CityId" value="@Model.Form.CityId" />
    <input type="hidden" id="districtIdInput" name="DistrictId" value="@Model.Form.DistrictId" />
    <input type="hidden" id="neighborhoodIdInput" name="NeighborhoodId" value="@Model.Form.NeighborhoodId" />

    <!-- 1. Temel Bilgiler Kartı -->
    <div class="card mb-4 shadow-sm border-0">
        <div class="card-body pt-3">
            <h5 class="card-title p-0 pb-3 border-bottom mb-3">
                <i class="bi bi-info-circle me-2 text-primary"></i>Temel Bilgiler
            </h5>
            <div class="row g-3">
                <div class="col-12">
                    <label for="propertyName" class="form-label fw-semibold">
                        İlan Başlığı <span class="text-danger">*</span>
                    </label>
                    <input type="text" class="form-control @(Model.GetFieldError("PropertyName") != null ? "is-invalid" : "")" id="propertyName" name="PropertyName" value="@Model.Form.PropertyName" maxlength="200" required disabled="@disabledAttr" placeholder="Örn: Kadıköy Moda Sahilde Geniş 3+1 Daire" />
                    @if (Model.GetFieldError("PropertyName") != null)
                    {
                        <div class="invalid-feedback d-block">@Model.GetFieldError("PropertyName")</div>
                    }
                </div>

                <div class="col-12">
                    <label for="propertyDescription" class="form-label fw-semibold">
                        İlan Açıklaması <span class="text-danger">*</span>
                    </label>
                    <textarea class="form-control @(Model.GetFieldError("PropertyDescription") != null ? "is-invalid" : "")" id="propertyDescription" name="PropertyDescription" rows="8" maxlength="8000" required disabled="@disabledAttr" placeholder="İlan detaylarını buraya yazınız... Paragraflar için boş satır bırakabilirsiniz.">@Model.Form.PropertyDescription</textarea>
                    <div class="form-text">Düz metin olarak giriniz, paragraflar için boş satır bırakabilirsiniz.</div>
                    @if (Model.GetFieldError("PropertyDescription") != null)
                    {
                        <div class="invalid-feedback d-block">@Model.GetFieldError("PropertyDescription")</div>
                    }
                </div>

                @if (Model.Form.Category == "housing")
                {
                    <div class="col-md-6 col-12">
                        <label for="housingCategoryId" class="form-label fw-semibold">Konut Kategorisi</label>
                        <select class="form-select @(Model.GetFieldError("HousingCategoryId") != null ? "is-invalid" : "")" id="housingCategoryId" name="HousingCategoryId" disabled="@disabledAttr">
                            <option value="">Seçiniz</option>
                            @foreach (var cat in Model.Lookups.HousingCategories)
                            {
                                <option value="@cat.HousingCategoryId" selected="@(Model.Form.HousingCategoryId == cat.HousingCategoryId ? "selected" : null)">@cat.HousingCategoryName</option>
                            }
                        </select>
                        @if (Model.GetFieldError("HousingCategoryId") != null)
                        {
                            <div class="invalid-feedback d-block">@Model.GetFieldError("HousingCategoryId")</div>
                        }
                    </div>
                }
                else if (Model.Form.Category == "land")
                {
                    <div class="col-md-6 col-12">
                        <label for="landCategoryId" class="form-label fw-semibold">Arsa Kategorisi</label>
                        <select class="form-select @(Model.GetFieldError("LandCategoryId") != null ? "is-invalid" : "")" id="landCategoryId" name="LandCategoryId" disabled="@disabledAttr">
                            <option value="">Seçiniz</option>
                            @foreach (var cat in Model.Lookups.LandCategories)
                            {
                                <option value="@cat.LandCategoryId" selected="@(Model.Form.LandCategoryId == cat.LandCategoryId ? "selected" : null)">@cat.LandCategoryName</option>
                            }
                        </select>
                        @if (Model.GetFieldError("LandCategoryId") != null)
                        {
                            <div class="invalid-feedback d-block">@Model.GetFieldError("LandCategoryId")</div>
                        }
                    </div>
                }

                @if (CurrentAdmin.IsManagerOrAbove)
                {
                    <div class="col-md-6 col-12">
                        <label for="agentId" class="form-label fw-semibold">Sorumlu Danışman</label>
                        <select class="form-select @(Model.GetFieldError("AgentId") != null ? "is-invalid" : "")" id="agentId" name="AgentId" disabled="@disabledAttr">
                            <option value="">Danışman Seçiniz</option>
                            @foreach (var agent in Model.Lookups.Agents)
                            {
                                <option value="@agent.AgentId" selected="@(Model.Form.AgentId == agent.AgentId ? "selected" : null)">@agent.AgentName</option>
                            }
                        </select>
                        @if (Model.GetFieldError("AgentId") != null)
                        {
                            <div class="invalid-feedback d-block">@Model.GetFieldError("AgentId")</div>
                        }
                    </div>
                }
                else
                {
                    <input type="hidden" name="AgentId" value="@Model.Form.AgentId" />
                }
            </div>
        </div>
    </div>

    <!-- 2. Fiyat Kartı -->
    <div class="card mb-4 shadow-sm border-0">
        <div class="card-body pt-3">
            <h5 class="card-title p-0 pb-3 border-bottom mb-3">
                <i class="bi bi-tag me-2 text-primary"></i>Fiyat ve Ödeme Bilgileri
            </h5>
            <div class="row g-3">
                @if (Model.Form.Has("Price"))
                {
                    <div class="col-md-6 col-12">
                        <label for="priceInput" class="form-label fw-semibold">
                            Satış Fiyatı <span class="text-danger">*</span>
                        </label>
                        <div class="input-group">
                            <input type="number" step="any" min="0" class="form-control @(Model.GetFieldError("Price") != null ? "is-invalid" : "")" id="priceInput" name="Price" value="@Model.Form.Price?.ToString(invCulture)" disabled="@disabledAttr" />
                            <span class="input-group-text">₺</span>
                        </div>
                        @if (Model.GetFieldError("Price") != null)
                        {
                            <div class="invalid-feedback d-block">@Model.GetFieldError("Price")</div>
                        }
                    </div>
                }

                @if (Model.Form.Has("Rent"))
                {
                    <div class="col-md-6 col-12">
                        <label for="rentInput" class="form-label fw-semibold">
                            Aylık Kira <span class="text-danger">*</span>
                        </label>
                        <div class="input-group">
                            <input type="number" step="any" min="0" class="form-control @(Model.GetFieldError("Rent") != null ? "is-invalid" : "")" id="rentInput" name="Rent" value="@Model.Form.Rent?.ToString(invCulture)" disabled="@disabledAttr" />
                            <span class="input-group-text">₺ / ay</span>
                        </div>
                        @if (Model.GetFieldError("Rent") != null)
                        {
                            <div class="invalid-feedback d-block">@Model.GetFieldError("Rent")</div>
                        }
                    </div>
                }

                @if (Model.Form.Has("Deposit"))
                {
                    <div class="col-md-6 col-12">
                        <label for="depositInput" class="form-label fw-semibold">Depozito</label>
                        <div class="input-group">
                            <input type="number" step="any" min="0" class="form-control @(Model.GetFieldError("Deposit") != null ? "is-invalid" : "")" id="depositInput" name="Deposit" value="@Model.Form.Deposit?.ToString(invCulture)" disabled="@disabledAttr" />
                            <span class="input-group-text">₺</span>
                        </div>
                        @if (Model.GetFieldError("Deposit") != null)
                        {
                            <div class="invalid-feedback d-block">@Model.GetFieldError("Deposit")</div>
                        }
                    </div>
                }

                @if (Model.Form.Has("Dues"))
                {
                    <div class="col-md-6 col-12">
                        <label for="duesInput" class="form-label fw-semibold">Aidat</label>
                        <div class="input-group">
                            <input type="number" step="any" min="0" class="form-control @(Model.GetFieldError("Dues") != null ? "is-invalid" : "")" id="duesInput" name="Dues" value="@Model.Form.Dues?.ToString(invCulture)" disabled="@disabledAttr" />
                            <span class="input-group-text">₺ / ay</span>
                        </div>
                        @if (Model.GetFieldError("Dues") != null)
                        {
                            <div class="invalid-feedback d-block">@Model.GetFieldError("Dues")</div>
                        }
                    </div>
                }

                @if (Model.Form.Has("PricePerSquareMeter"))
                {
                    <div class="col-md-6 col-12">
                        <label for="m2PriceInput" class="form-label fw-semibold">m² Birim Fiyatı</label>
                        <div class="input-group">
                            <input type="number" step="any" min="0" class="form-control @(Model.GetFieldError("PricePerSquareMeter") != null ? "is-invalid" : "")" id="m2PriceInput" name="PricePerSquareMeter" value="@Model.Form.PricePerSquareMeter?.ToString(invCulture)" disabled="@disabledAttr" />
                            <span class="input-group-text">₺ / m²</span>
                        </div>
                        <div class="form-text">Alan ve Fiyat/Kira girildiğinde otomatik önerilir, elle değiştirilebilir.</div>
                        @if (Model.GetFieldError("PricePerSquareMeter") != null)
                        {
                            <div class="invalid-feedback d-block">@Model.GetFieldError("PricePerSquareMeter")</div>
                        }
                    </div>
                }
            </div>
        </div>
    </div>

    <!-- 3. Konum Kartı -->
    <div class="card mb-4 shadow-sm border-0">
        <div class="card-body pt-3">
            <h5 class="card-title p-0 pb-3 border-bottom mb-3">
                <i class="bi bi-geo-alt me-2 text-primary"></i>Konum Bilgileri
            </h5>
            <div class="row g-3">
                <div class="col-md-4 col-12">
                    <label for="citySelect" class="form-label fw-semibold">
                        İl <span class="text-danger">*</span>
                    </label>
                    <select id="citySelect" class="form-select @(Model.GetFieldError("City") != null ? "is-invalid" : "")" data-current-name="@Model.Form.City" data-current-id="@Model.Form.CityId" disabled="@disabledAttr">
                        <option value="">Yükleniyor...</option>
                    </select>
                    @if (Model.GetFieldError("City") != null)
                    {
                        <div class="invalid-feedback d-block">@Model.GetFieldError("City")</div>
                    }
                </div>

                <div class="col-md-4 col-12">
                    <label for="districtSelect" class="form-label fw-semibold">
                        İlçe <span class="text-danger">*</span>
                    </label>
                    <select id="districtSelect" class="form-select @(Model.GetFieldError("District") != null ? "is-invalid" : "")" data-current-name="@Model.Form.District" data-current-id="@Model.Form.DistrictId" disabled="@(disabledAttr != null ? "disabled" : "disabled")">
                        <option value="">Önce İl Seçiniz</option>
                    </select>
                    @if (Model.GetFieldError("District") != null)
                    {
                        <div class="invalid-feedback d-block">@Model.GetFieldError("District")</div>
                    }
                </div>

                <div class="col-md-4 col-12">
                    <label for="neighborhoodSelect" class="form-label fw-semibold">Mahalle</label>
                    <select id="neighborhoodSelect" class="form-select @(Model.GetFieldError("Neighborhood") != null ? "is-invalid" : "")" data-current-name="@Model.Form.Neighborhood" data-current-id="@Model.Form.NeighborhoodId" disabled="@(disabledAttr != null ? "disabled" : "disabled")">
                        <option value="">Önce İlçe Seçiniz</option>
                    </select>
                    @if (Model.GetFieldError("Neighborhood") != null)
                    {
                        <div class="invalid-feedback d-block">@Model.GetFieldError("Neighborhood")</div>
                    }
                </div>

                <div class="col-12">
                    <label for="addressDesc" class="form-label fw-semibold">Açık Adres</label>
                    <textarea class="form-control @(Model.GetFieldError("AddressDesc") != null ? "is-invalid" : "")" id="addressDesc" name="AddressDesc" rows="3" disabled="@disabledAttr" placeholder="Cadde, sokak, bina no, kapı no...">@Model.Form.AddressDesc</textarea>
                    @if (Model.GetFieldError("AddressDesc") != null)
                    {
                        <div class="invalid-feedback d-block">@Model.GetFieldError("AddressDesc")</div>
                    }
                </div>
            </div>
        </div>
    </div>

    <!-- 4. Özellikler Kartı -->
    <div class="card mb-4 shadow-sm border-0">
        <div class="card-body pt-3">
            <h5 class="card-title p-0 pb-3 border-bottom mb-3">
                <i class="bi bi-sliders me-2 text-primary"></i>İlan Özellikleri
            </h5>
            <div class="row g-3">
                @if (Model.Form.Has("NumberOfRoom"))
                {
                    <div class="col-lg-4 col-md-6 col-12">
                        <label for="numberOfRoom" class="form-label fw-semibold">Oda Sayısı</label>
                        <select class="form-select @(Model.GetFieldError("NumberOfRoom") != null ? "is-invalid" : "")" id="numberOfRoom" name="NumberOfRoom" disabled="@disabledAttr">
                            <option value="">Seçiniz</option>
                            @foreach (var opt in ListingFormViewModel.GetOptionsWithCustom(ListingFormViewModel.NumberOfRoomOptions, Model.Form.NumberOfRoom))
                            {
                                <option value="@opt" selected="@(string.Equals(Model.Form.NumberOfRoom, opt, StringComparison.OrdinalIgnoreCase) ? "selected" : null)">@opt</option>
                            }
                        </select>
                        @if (Model.GetFieldError("NumberOfRoom") != null)
                        {
                            <div class="invalid-feedback d-block">@Model.GetFieldError("NumberOfRoom")</div>
                        }
                    </div>
                }

                @if (Model.Form.Has("GrossArea"))
                {
                    <div class="col-lg-4 col-md-6 col-12">
                        <label for="grossArea" class="form-label fw-semibold">Brüt Alan</label>
                        <div class="input-group">
                            <input type="number" step="any" min="0" class="form-control @(Model.GetFieldError("GrossArea") != null ? "is-invalid" : "")" id="grossArea" name="GrossArea" value="@Model.Form.GrossArea?.ToString(invCulture)" disabled="@disabledAttr" />
                            <span class="input-group-text">m²</span>
                        </div>
                        @if (Model.GetFieldError("GrossArea") != null)
                        {
                            <div class="invalid-feedback d-block">@Model.GetFieldError("GrossArea")</div>
                        }
                    </div>
                }

                @if (Model.Form.Has("NetArea"))
                {
                    <div class="col-lg-4 col-md-6 col-12">
                        <label for="netArea" class="form-label fw-semibold">Net Alan</label>
                        <div class="input-group">
                            <input type="number" step="any" min="0" class="form-control @(Model.GetFieldError("NetArea") != null ? "is-invalid" : "")" id="netArea" name="NetArea" value="@Model.Form.NetArea?.ToString(invCulture)" disabled="@disabledAttr" />
                            <span class="input-group-text">m²</span>
                        </div>
                        @if (Model.GetFieldError("NetArea") != null)
                        {
                            <div class="invalid-feedback d-block">@Model.GetFieldError("NetArea")</div>
                        }
                    </div>
                }

                @if (Model.Form.Has("OpenArea"))
                {
                    <div class="col-lg-4 col-md-6 col-12">
                        <label for="openArea" class="form-label fw-semibold">Açık Alan</label>
                        <div class="input-group">
                            <input type="number" step="any" min="0" class="form-control @(Model.GetFieldError("OpenArea") != null ? "is-invalid" : "")" id="openArea" name="OpenArea" value="@Model.Form.OpenArea?.ToString(invCulture)" disabled="@disabledAttr" />
                            <span class="input-group-text">m²</span>
                        </div>
                        @if (Model.GetFieldError("OpenArea") != null)
                        {
                            <div class="invalid-feedback d-block">@Model.GetFieldError("OpenArea")</div>
                        }
                    </div>
                }

                @if (Model.Form.Has("Area"))
                {
                    <div class="col-lg-4 col-md-6 col-12">
