@model FibiEmlakDanismanlik.AdminUI.Models.Content.SiteContentListViewModel<FibiEmlakDanismanlik.AdminUI.Models.Content.TestimonialDto>

@{
    ViewData["Title"] = "Müşteri Yorumları";
}

<div class="pagetitle d-flex flex-wrap justify-content-between align-items-center gap-2 mb-3">
    <div>
        <h1 class="mb-0">Müşteri Yorumları</h1>
        <nav class="mt-1">
            <ol class="breadcrumb mb-0">
                <li class="breadcrumb-item"><a href="/">Ana Sayfa</a></li>
                <li class="breadcrumb-item"><a href="/icerik">İçerik</a></li>
                <li class="breadcrumb-item active">Müşteri Yorumları</li>
            </ol>
        </nav>
    </div>
    <div>
        <a href="/icerik/yorumlar/yeni" class="btn btn-primary btn-sm">
            <i class="bi bi-plus-lg me-1"></i> Yeni Yorum Ekle
        </a>
    </div>
</div>

@if (TempData["Success"] != null)
{
    <div class="alert alert-success alert-dismissible fade show d-flex align-items-center mb-4" role="alert">
        <i class="bi bi-check-circle-fill flex-shrink-0 me-2 fs-5"></i>
        <div>@TempData["Success"]</div>
        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Kapat"></button>
    </div>
}

@if (TempData["Error"] != null)
{
    <div class="alert alert-danger alert-dismissible fade show d-flex align-items-center mb-4" role="alert">
        <i class="bi bi-exclamation-triangle-fill flex-shrink-0 me-2 fs-5"></i>
        <div>@TempData["Error"]</div>
        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Kapat"></button>
    </div>
}

@if (!string.IsNullOrWhiteSpace(Model.ErrorMessage))
{
    <div class="alert alert-danger alert-dismissible fade show d-flex align-items-center mb-4" role="alert">
        <i class="bi bi-exclamation-triangle-fill flex-shrink-0 me-2 fs-5"></i>
        <div>@Model.ErrorMessage</div>
        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Kapat"></button>
    </div>
}

<partial name="_ContentNav" model="@("yorumlar")" />

<div class="card shadow-sm border-0 mb-4">
    <div class="card-body pt-3">
        <div class="d-flex justify-content-between align-items-center pb-2 border-bottom mb-3">
            <h5 class="card-title p-0 m-0">
                <i class="bi bi-chat-quote me-2 text-primary"></i>Kayıtlı Yorumlar
                <span class="badge bg-secondary-subtle text-secondary border ms-2 fs-6">@Model.Items.Count</span>
            </h5>
        </div>

        @if (Model.Items == null || !Model.Items.Any())
        {
            <div class="text-center py-5">
                <i class="bi bi-chat-quote display-4 text-muted d-block mb-3"></i>
                <h6 class="text-dark fw-semibold">Henüz müşteri yorumu eklenmemiş</h6>
                <p class="text-muted small mb-3">Web sitenizde gösterilmek üzere müşteri deneyimlerini ve yorumlarını buradan ekleyebilirsiniz.</p>
                <a href="/icerik/yorumlar/yeni" class="btn btn-primary btn-sm">
                    <i class="bi bi-plus-lg me-1"></i> İlk Yorumu Ekle
                </a>
            </div>
        }
        else
        {
            <div class="table-responsive">
                <table class="table table-hover align-middle mb-0">
                    <thead class="table-light text-muted small text-uppercase">
                        <tr>
                            <th scope="col" style="width: 70px;">Sıra</th>
                            <th scope="col">Müşteri Adı</th>
                            <th scope="col">Unvan / Kısa Bilgi</th>
                            <th scope="col">Yorum</th>
                            <th scope="col" style="width: 110px;">Durum</th>
                            <th scope="col" class="text-end" style="width: 170px;">İşlemler</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var item in Model.Items)
                        {
                            <tr>
                                <td class="fw-semibold text-secondary">#@item.DisplayOrder</td>
                                <td>
                                    <div class="fw-semibold text-dark">@item.Name</div>
                                </td>
                                <td>
                                    @(string.IsNullOrWhiteSpace(item.Title) ? "—" : item.Title)
                                </td>
                                <td>
                                    <div class="small text-secondary text-break" style="max-width: 380px;">
                                        @if (!string.IsNullOrWhiteSpace(item.Testimonail))
                                        {
                                            var commentText = item.Testimonail.Length > 120 ? item.Testimonail.Substring(0, 120) + "..." : item.Testimonail;
                                            <span>«@commentText»</span>
                                        }
                                        else
                                        {
                                            <span class="text-muted">—</span>
                                        }
                                    </div>
                                </td>
                                <td>
                                    @if (item.IsActive)
                                    {
                                        <span class="badge bg-success-subtle text-success border border-success-subtle">
                                            <i class="bi bi-check-circle me-1"></i>Yayında
                                        </span>
                                    }
                                    else
                                    {
                                        <span class="badge bg-secondary-subtle text-secondary border">
                                            <i class="bi bi-eye-slash me-1"></i>Gizli
                                        </span>
                                    }
                                </td>
                                <td class="text-end">
                                    <div class="d-inline-flex gap-1">
                                        <a href="/icerik/yorumlar/@item.Id" class="btn btn-outline-primary btn-sm" title="Düzenle">
                                            <i class="bi bi-pencil me-1"></i> Düzenle
                                        </a>
                                        <form method="post" action="/icerik/yorumlar/@item.Id/sil" class="d-inline" data-confirm="«@(item.Name)» adlı müşterinin yorumu silinsin mi? Bu işlem geri alınamaz.">
                                            @Html.AntiForgeryToken()
                                            <button type="submit" class="btn btn-outline-danger btn-sm" title="Sil">
                                                <i class="bi bi-trash"></i>
                                            </button>
                                        </form>
                                    </div>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }
    </div>
</div>
