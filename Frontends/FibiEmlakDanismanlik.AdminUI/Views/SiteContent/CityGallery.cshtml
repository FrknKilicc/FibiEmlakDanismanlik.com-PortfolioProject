@model FibiEmlakDanismanlik.AdminUI.Models.Content.SiteContentListViewModel<FibiEmlakDanismanlik.AdminUI.Models.Content.CityGalleryImageDto>
@inject FibiEmlakDanismanlik.AdminUI.Infrastructure.SiteImageUrl SiteImageUrl

@{
    ViewData["Title"] = "Şehir Galerisi";
}

<div class="pagetitle d-flex flex-wrap justify-content-between align-items-center gap-2 mb-3">
    <div>
        <h1 class="mb-0">Şehir Galerisi</h1>
        <nav class="mt-1">
            <ol class="breadcrumb mb-0">
                <li class="breadcrumb-item"><a href="/">Ana Sayfa</a></li>
                <li class="breadcrumb-item"><a href="/icerik">İçerik</a></li>
                <li class="breadcrumb-item active">Şehir Galerisi</li>
            </ol>
        </nav>
    </div>
    <div>
        <a href="/icerik/sehir-galerisi/yeni" class="btn btn-primary btn-sm">
            <i class="bi bi-plus-lg me-1"></i> Yeni Şehir Görseli Ekle
        </a>
    </div>
</div>

@if (TempData["Success"] != null)
{
    <div class="alert alert-success alert-dismissible fade show d-flex align-items-center mb-4" role="alert">
        <i class="bi bi-check-circle-fill flex-shrink-0 me-2 fs-5"></i>
        <div>@TempData["Success"]</div>
        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Kapat"></button>
    </div>
}

@if (TempData["Error"] != null)
{
    <div class="alert alert-danger alert-dismissible fade show d-flex align-items-center mb-4" role="alert">
        <i class="bi bi-exclamation-triangle-fill flex-shrink-0 me-2 fs-5"></i>
        <div>@TempData["Error"]</div>
        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Kapat"></button>
    </div>
}

@if (!string.IsNullOrWhiteSpace(Model.ErrorMessage))
{
    <div class="alert alert-danger alert-dismissible fade show d-flex align-items-center mb-4" role="alert">
        <i class="bi bi-exclamation-triangle-fill flex-shrink-0 me-2 fs-5"></i>
        <div>@Model.ErrorMessage</div>
        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Kapat"></button>
    </div>
}

<partial name="_ContentNav" model="@("sehir-galerisi")" />

<div class="alert alert-info d-flex align-items-center mb-4">
    <i class="bi bi-info-circle-fill flex-shrink-0 me-2 fs-5"></i>
    <div>Bu görseller İletişim sayfasındaki şehir galerisinde gösterilir.</div>
</div>

<div class="card shadow-sm border-0 mb-4">
    <div class="card-body pt-3">
        <div class="d-flex justify-content-between align-items-center pb-2 border-bottom mb-3">
            <h5 class="card-title p-0 m-0">
                <i class="bi bi-geo-alt me-2 text-primary"></i>Kayıtlı Şehir Görselleri
                <span class="badge bg-secondary-subtle text-secondary border ms-2 fs-6">@Model.Items.Count</span>
            </h5>
        </div>

        @if (Model.Items == null || !Model.Items.Any())
        {
            <div class="text-center py-5">
                <i class="bi bi-geo-alt display-4 text-muted d-block mb-3"></i>
                <h6 class="text-dark fw-semibold">Henüz şehir görseli eklenmemiş</h6>
                <p class="text-muted small mb-3">İletişim sayfasında yer alan şehir galerisi için görselleri buradan ekleyip düzenleyebilirsiniz.</p>
                <a href="/icerik/sehir-galerisi/yeni" class="btn btn-primary btn-sm">
                    <i class="bi bi-plus-lg me-1"></i> İlk Şehir Görselini Ekle
                </a>
            </div>
        }
        else
        {
            var cityGroups = Model.Items
                .GroupBy(x => string.IsNullOrWhiteSpace(x.CityName) ? "Diğer" : x.CityName)
                .OrderBy(g => g.Key);

            foreach (var group in cityGroups)
            {
                <div class="mb-4">
                    <div class="d-flex align-items-center gap-2 mb-3 pb-1 border-bottom">
                        <i class="bi bi-pin-map-fill text-primary fs-5"></i>
                        <h6 class="fw-bold text-dark mb-0 fs-6">@group.Key</h6>
                        <span class="badge bg-light text-secondary border small">@group.Count() görsel</span>
                    </div>

                    <div class="row row-cols-1 row-cols-sm-2 row-cols-md-3 row-cols-lg-4 g-3">
                        @foreach (var item in group.OrderBy(x => x.DisplayOrder))
                        {
                            var preview = SiteImageUrl.Preview(item.ImageUrl);

                            <div class="col">
                                <div class="card h-100 border shadow-none bg-white">
                                    <div class="position-relative">
                                        @if (!string.IsNullOrEmpty(preview))
                                        {
                                            <img src="@preview"
                                                 alt="@(item.Title ?? item.CityName)"
                                                 class="card-img-top"
                                                 style="height: 160px; object-fit: cover;" />
                                        }
                                        else
                                        {
                                            <div class="bg-light d-flex align-items-center justify-content-center text-muted" style="height: 160px;">
                                                <i class="bi bi-image me-1"></i> Görsel yok
                                            </div>
                                        }

                                        <div class="position-absolute top-0 start-0 m-2">
                                            <span class="badge bg-dark bg-opacity-75">
                                                Sıra: #@item.DisplayOrder
                                            </span>
                                        </div>

                                        <div class="position-absolute top-0 end-0 m-2">
                                            @if (item.IsActive)
                                            {
                                                <span class="badge bg-success-subtle text-success border border-success-subtle">
                                                    Yayında
                                                </span>
                                            }
                                            else
                                            {
                                                <span class="badge bg-secondary-subtle text-secondary border">
                                                    Gizli
                                                </span>
                                            }
                                        </div>
                                    </div>

                                    <div class="card-body p-3 d-flex flex-column justify-content-between">
                                        <div>
                                            <h6 class="fw-bold text-dark mb-1 text-truncate" title="@item.Title">
                                                @(string.IsNullOrWhiteSpace(item.Title) ? item.CityName : item.Title)
                                            </h6>
                                            @if (!string.IsNullOrWhiteSpace(item.Description))
                                            {
                                                <p class="small text-muted mb-2 text-truncate" title="@item.Description">
                                                    @item.Description
                                                </p>
                                            }
                                        </div>

                                        <div class="pt-2 border-top mt-2 d-flex justify-content-between align-items-center gap-1">
                                            <a href="/icerik/sehir-galerisi/@item.CityGalleryImageId" class="btn btn-outline-primary btn-sm flex-grow-1">
                                                <i class="bi bi-pencil me-1"></i> Düzenle
                                            </a>
                                            <form method="post" action="/icerik/sehir-galerisi/@item.CityGalleryImageId/sil" class="d-inline" data-confirm="«@(item.Title ?? item.CityName)» şehir görseli silinsin mi? Bu işlem geri alınamaz.">
                                                @Html.AntiForgeryToken()
                                                <button type="submit" class="btn btn-outline-danger btn-sm" title="Sil">
                                                    <i class="bi bi-trash"></i>
                                                </button>
                                            </form>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        }
                    </div>
                </div>
            }
        }
    </div>
</div>
