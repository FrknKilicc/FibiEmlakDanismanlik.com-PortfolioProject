@using System.Globalization
@model FibiEmlakDanismanlik.AdminUI.Models.Content.SiteContentFormViewModel<FibiEmlakDanismanlik.AdminUI.Models.Content.BankLoanRateForm>
@inject FibiEmlakDanismanlik.AdminUI.Infrastructure.SiteImageUrl SiteImageUrl

@{
    var title = Model.IsNew ? "Yeni Kredi Oranı" : "Kredi Oranını Düzenle";
    ViewData["Title"] = title;

    var errBankName = Model.GetFieldError("BankName");
    var errLogo = Model.GetFieldError("LogoUrl");
    var errHousing = Model.GetFieldError("HousingLoanMonthlyRate");
    var errCommercial = Model.GetFieldError("CommercialLoanMonthlyRate");
    var errMaxTerm = Model.GetFieldError("MaxTermMonths");
    var errFee = Model.GetFieldError("AllocationFeeRate");

    var previewUrl = SiteImageUrl.Preview(Model.Form.LogoUrl);
}

<div class="pagetitle d-flex flex-wrap justify-content-between align-items-center gap-2 mb-3">
    <div>
        <div class="d-flex align-items-center gap-2">
            <h1 class="mb-0">@title</h1>
            @if (!Model.IsNew && Model.Form.BankLoanRateId.HasValue)
            {
                <span class="badge bg-secondary-subtle text-secondary border">#@Model.Form.BankLoanRateId.Value</span>
            }
        </div>
        <nav class="mt-1">
            <ol class="breadcrumb mb-0">
                <li class="breadcrumb-item"><a href="/">Ana Sayfa</a></li>
                <li class="breadcrumb-item"><a href="/icerik">İçerik</a></li>
                <li class="breadcrumb-item"><a href="/icerik/kredi-oranlari">Kredi Oranları</a></li>
                <li class="breadcrumb-item active">@title</li>
            </ol>
        </nav>
    </div>
    <div>
        <a href="/icerik/kredi-oranlari" class="btn btn-outline-secondary btn-sm">
            <i class="bi bi-arrow-left me-1"></i> Kredi Oranlarına Dön
        </a>
    </div>
</div>

@if (TempData["Success"] != null)
{
    <div class="alert alert-success alert-dismissible fade show d-flex align-items-center mb-4" role="alert">
        <i class="bi bi-check-circle-fill flex-shrink-0 me-2 fs-5"></i>
        <div>@TempData["Success"]</div>
        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Kapat"></button>
    </div>
}

@if (TempData["Error"] != null)
{
    <div class="alert alert-danger alert-dismissible fade show d-flex align-items-center mb-4" role="alert">
        <i class="bi bi-exclamation-triangle-fill flex-shrink-0 me-2 fs-5"></i>
        <div>@TempData["Error"]</div>
        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Kapat"></button>
    </div>
}

@if (!string.IsNullOrWhiteSpace(Model.ErrorMessage))
{
    <div class="alert alert-danger alert-dismissible fade show d-flex align-items-center mb-4" role="alert">
        <i class="bi bi-exclamation-triangle-fill flex-shrink-0 me-2 fs-5"></i>
        <div>@Model.ErrorMessage</div>
        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Kapat"></button>
    </div>
}

<partial name="_ContentNav" model="@("kredi-oranlari")" />

<div class="alert alert-info d-flex align-items-center mb-4">
    <i class="bi bi-info-circle-fill flex-shrink-0 me-2 fs-5"></i>
    <div>Aylık faiz yüzde olarak girilir (ör. 2,49). İlan detay sayfasındaki konut ve ticari kredi hesaplama araçları bu oranları baz alır.</div>
</div>

<form method="post" action="@(Model.IsNew ? "/icerik/kredi-oranlari/yeni" : $"/icerik/kredi-oranlari/{Model.Form.BankLoanRateId}")">
    @Html.AntiForgeryToken()
    @if (!Model.IsNew)
    {
        <input type="hidden" name="BankLoanRateId" value="@Model.Form.BankLoanRateId" />
    }

    <div class="row g-4">
        <div class="col-lg-8 col-12">
            <!-- Banka Bilgileri -->
            <div class="card shadow-sm border-0 mb-4">
                <div class="card-body pt-3">
                    <h5 class="card-title p-0 pb-2 border-bottom mb-3">
                        <i class="bi bi-bank me-2 text-primary"></i>Banka Bilgileri
                    </h5>

                    <div class="mb-3">
                        <label for="BankName" class="form-label small fw-semibold">
                            Banka Adı <span class="text-danger">*</span>
                        </label>
                        <input type="text"
                               class="form-control @(errBankName != null ? "is-invalid" : "")"
                               id="BankName"
                               name="BankName"
                               value="@Model.Form.BankName"
                               placeholder="Örn: Ziraat Bankası, Garanti BBVA, Türkiye İş Bankası"
                               required />
                        @if (errBankName != null)
                        {
                            <div class="invalid-feedback d-block">@errBankName</div>
                        }
                    </div>

                    <div class="mb-3">
                        <label for="LogoUrl" class="form-label small fw-semibold">
                            Banka Logosu (URL / Yol)
                        </label>
                        <input type="text"
                               class="form-control @(errLogo != null ? "is-invalid" : "")"
                               id="LogoUrl"
                               name="LogoUrl"
                               value="@Model.Form.LogoUrl"
                               placeholder="https://... veya /uploads/bank/..." />
                        @if (errLogo != null)
                        {
                            <div class="invalid-feedback d-block">@errLogo</div>
                        }

                        <div class="mt-2"
                             data-image-upload
                             data-target="LogoUrl"
                             data-folder="bank"
                             data-preview="bankLogoPreview"></div>

                        <div class="form-text text-muted mt-2">
                            <i class="bi bi-info-circle me-1"></i>Önerilen logo boyutu kare veya yatay şeffaf PNG (ör. 120×60 px veya 48×48 px).
                        </div>

                        <div class="mt-3 p-3 bg-light rounded border text-center d-inline-block" style="min-width: 160px;">
                            <div class="small text-muted mb-2 fw-semibold">Logo Önizleme:</div>
                            <img id="bankLogoPreview"
                                 src="@(previewUrl ?? "")"
                                 alt="@(Model.Form.BankName ?? "Logo Önizleme")"
                                 class="p-1 @(string.IsNullOrEmpty(previewUrl) ? "d-none" : "")"
                                 style="max-height: 50px; max-width: 150px; object-fit: contain;" />
                            <div id="bankLogoPlaceholder" class="text-muted small py-2 @(!string.IsNullOrEmpty(previewUrl) ? "d-none" : "")">
                                <i class="bi bi-image me-1"></i>Görsel yok
                            </div>
                        </div>
                    </div>
                </div>
            </div>

            <!-- Faiz Oranları ve Masraflar -->
            <div class="card shadow-sm border-0 mb-4">
                <div class="card-body pt-3">
                    <h5 class="card-title p-0 pb-2 border-bottom mb-3">
                        <i class="bi bi-percent me-2 text-primary"></i>Kredi Faiz Oranları ve Koşullar
                    </h5>

                    <div class="row g-3">
                        <div class="col-md-6 col-12">
                            <label for="HousingLoanMonthlyRate" class="form-label small fw-semibold">
                                Konut Kredisi Aylık Oranı (%) <span class="text-danger">*</span>
                            </label>
                            <div class="input-group">
                                <span class="input-group-text">%</span>
                                <input type="number"
                                       step="0.0001"
                                       min="0"
                                       class="form-control @(errHousing != null ? "is-invalid" : "")"
                                       id="HousingLoanMonthlyRate"
                                       name="HousingLoanMonthlyRate"
                                       value="@Model.Form.HousingLoanMonthlyRate.ToString(CultureInfo.InvariantCulture)"
                                       placeholder="2.79"
                                       required />
                            </div>
                            <div class="form-text">Aylık faiz oranı (ör. 2,79 veya 2.79).</div>
                            @if (errHousing != null)
                            {
                                <div class="invalid-feedback d-block">@errHousing</div>
                            }
                        </div>

                        <div class="col-md-6 col-12">
                            <label for="CommercialLoanMonthlyRate" class="form-label small fw-semibold">
                                Ticari Kredi Aylık Oranı (%) <span class="text-danger">*</span>
                            </label>
                            <div class="input-group">
                                <span class="input-group-text">%</span>
                                <input type="number"
                                       step="0.0001"
                                       min="0"
                                       class="form-control @(errCommercial != null ? "is-invalid" : "")"
                                       id="CommercialLoanMonthlyRate"
                                       name="CommercialLoanMonthlyRate"
                                       value="@Model.Form.CommercialLoanMonthlyRate.ToString(CultureInfo.InvariantCulture)"
                                       placeholder="3.15"
                                       required />
                            </div>
                            <div class="form-text">İşyeri ve ticari gayrimenkuller için faiz oranı.</div>
                            @if (errCommercial != null)
                            {
                                <div class="invalid-feedback d-block">@errCommercial</div>
                            }
                        </div>

                        <div class="col-md-6 col-12">
                            <label for="MaxTermMonths" class="form-label small fw-semibold">
                                Azami Vade (Ay) <span class="text-danger">*</span>
                            </label>
                            <div class="input-group">
                                <input type="number"
                                       step="1"
                                       min="1"
                                       max="360"
                                       class="form-control @(errMaxTerm != null ? "is-invalid" : "")"
                                       id="MaxTermMonths"
                                       name="MaxTermMonths"
                                       value="@Model.Form.MaxTermMonths"
                                       required />
                                <span class="input-group-text">ay</span>
                            </div>
                            <div class="form-text">Maksimum kredi taksit süresi (genelde 120 ay).</div>
                            @if (errMaxTerm != null)
                            {
                                <div class="invalid-feedback d-block">@errMaxTerm</div>
                            }
                        </div>

                        <div class="col-md-6 col-12">
                            <label for="AllocationFeeRate" class="form-label small fw-semibold">
                                Kredi Tahsis Ücreti Oranı (%) <span class="text-danger">*</span>
                            </label>
                            <div class="input-group">
                                <span class="input-group-text">%</span>
                                <input type="number"
                                       step="0.0001"
                                       min="0"
                                       class="form-control @(errFee != null ? "is-invalid" : "")"
                                       id="AllocationFeeRate"
                                       name="AllocationFeeRate"
                                       value="@Model.Form.AllocationFeeRate.ToString(CultureInfo.InvariantCulture)"
                                       placeholder="0.5"
                                       required />
                            </div>
                            <div class="form-text">Kredi dosya masrafı yüzdesi (yasal üst sınır: binde 5 yani %0.5).</div>
                            @if (errFee != null)
                            {
                                <div class="invalid-feedback d-block">@errFee</div>
                            }
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <div class="col-lg-4 col-12">
            <!-- Yayın Ayarları -->
            <div class="card shadow-sm border-0 mb-4">
                <div class="card-body pt-3">
                    <h5 class="card-title p-0 pb-2 border-bottom mb-3">
                        <i class="bi bi-sliders me-2 text-primary"></i>Yayın Ayarları
                    </h5>

                    <div class="form-check form-switch pt-2 mb-1">
                        <input type="checkbox"
                               class="form-check-input"
                               id="IsActive"
                               name="IsActive"
                               value="true"
                               @(Model.Form.IsActive ? "checked" : "") />
                        <input type="hidden" name="IsActive" value="false" />
                        <label class="form-check-label small fw-semibold" for="IsActive">
                            Yayında
                        </label>
                        <div class="form-text">
                            Aktif olduğunda ilan detay sayfasındaki kredi hesaplama aracında bu banka listelenir.
                        </div>
                    </div>
                </div>
            </div>

            <!-- Kaydet / Vazgeç Butonları -->
            <div class="card shadow-sm border-0 mb-4">
                <div class="card-body p-3">
                    <div class="d-grid gap-2">
                        <button type="submit" class="btn btn-primary">
                            <i class="bi bi-check-lg me-1"></i> Kaydet
                        </button>
                        <a href="/icerik/kredi-oranlari" class="btn btn-outline-secondary">
                            Vazgeç
                        </a>
                    </div>
                </div>
            </div>

            @if (!Model.IsNew && Model.Form.BankLoanRateId.HasValue)
            {
                <div class="card shadow-sm border-0 border-danger-subtle">
                    <div class="card-body p-3">
                        <details class="text-start">
                            <summary class="text-danger fw-semibold" style="cursor: pointer;">
                                <i class="bi bi-trash me-1"></i> Bu kredi oranını sil
                            </summary>
                            <div class="pt-3">
                                <p class="text-muted small mb-3">
                                    Bu bankanın kredi oranını sildiğinizde işlem geri alınamaz. Kredi hesaplayıcıda artık listelenmeyecektir.
                                </p>
                                <button type="submit"
                                        form="deleteForm"
                                        class="btn btn-danger btn-sm w-100">
                                    <i class="bi bi-trash me-1"></i> Kalıcı olarak sil
                                </button>
                            </div>
                        </details>
                    </div>
                </div>
            }
        </div>
    </div>
</form>

@if (!Model.IsNew && Model.Form.BankLoanRateId.HasValue)
{
    <form id="deleteForm"
          method="post"
          action="/icerik/kredi-oranlari/@Model.Form.BankLoanRateId.Value/sil"
          data-confirm="«@(Model.Form.BankName ?? "Kredi oranı")» silinsin mi? Bu işlem geri alınamaz."
          class="d-none">
        @Html.AntiForgeryToken()
    </form>
}

@section Scripts {
    <script src="~/js/image-upload.js" asp-append-version="true"></script>
    <script>
        document.addEventListener('DOMContentLoaded', function () {
            const logoInput = document.getElementById('LogoUrl');
            const logoImg = document.getElementById('bankLogoPreview');
            const placeholder = document.getElementById('bankLogoPlaceholder');

            if (logoInput && logoImg && placeholder) {
                logoInput.addEventListener('input', function () {
                    const val = (logoInput.value || '').trim();
                    if (val.length > 0) {
                        logoImg.src = val;
                        logoImg.classList.remove('d-none');
                        placeholder.classList.add('d-none');
                    } else {
                        logoImg.src = '';
                        logoImg.classList.add('d-none');
                        placeholder.classList.remove('d-none');
                    }
                });
            }
        });
    </script>
}
