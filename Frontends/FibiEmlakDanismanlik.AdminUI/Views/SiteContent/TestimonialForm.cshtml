@model FibiEmlakDanismanlik.AdminUI.Models.Content.SiteContentFormViewModel<FibiEmlakDanismanlik.AdminUI.Models.Content.TestimonialForm>

@{
    var title = Model.IsNew ? "Yeni Müşteri Yorumu" : "Müşteri Yorumunu Düzenle";
    ViewData["Title"] = title;

    var errName = Model.GetFieldError("Name");
    var errTitle = Model.GetFieldError("Title");
    var errComment = Model.GetFieldError("Testimonail");
    var errOrder = Model.GetFieldError("DisplayOrder");
}

<div class="pagetitle d-flex flex-wrap justify-content-between align-items-center gap-2 mb-3">
    <div>
        <div class="d-flex align-items-center gap-2">
            <h1 class="mb-0">@title</h1>
            @if (!Model.IsNew && Model.Form.Id.HasValue)
            {
                <span class="badge bg-secondary-subtle text-secondary border">#@Model.Form.Id.Value</span>
            }
        </div>
        <nav class="mt-1">
            <ol class="breadcrumb mb-0">
                <li class="breadcrumb-item"><a href="/">Ana Sayfa</a></li>
                <li class="breadcrumb-item"><a href="/icerik">İçerik</a></li>
                <li class="breadcrumb-item"><a href="/icerik/yorumlar">Müşteri Yorumları</a></li>
                <li class="breadcrumb-item active">@title</li>
            </ol>
        </nav>
    </div>
    <div>
        <a href="/icerik/yorumlar" class="btn btn-outline-secondary btn-sm">
            <i class="bi bi-arrow-left me-1"></i> Yorum Listesine Dön
        </a>
    </div>
</div>

@if (TempData["Success"] != null)
{
    <div class="alert alert-success alert-dismissible fade show d-flex align-items-center mb-4" role="alert">
        <i class="bi bi-check-circle-fill flex-shrink-0 me-2 fs-5"></i>
        <div>@TempData["Success"]</div>
        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Kapat"></button>
    </div>
}

@if (TempData["Error"] != null)
{
    <div class="alert alert-danger alert-dismissible fade show d-flex align-items-center mb-4" role="alert">
        <i class="bi bi-exclamation-triangle-fill flex-shrink-0 me-2 fs-5"></i>
        <div>@TempData["Error"]</div>
        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Kapat"></button>
    </div>
}

@if (!string.IsNullOrWhiteSpace(Model.ErrorMessage))
{
    <div class="alert alert-danger alert-dismissible fade show d-flex align-items-center mb-4" role="alert">
        <i class="bi bi-exclamation-triangle-fill flex-shrink-0 me-2 fs-5"></i>
        <div>@Model.ErrorMessage</div>
        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Kapat"></button>
    </div>
}

<partial name="_ContentNav" model="@("yorumlar")" />

<form method="post" action="@(Model.IsNew ? "/icerik/yorumlar/yeni" : $"/icerik/yorumlar/{Model.Form.Id}")">
    @Html.AntiForgeryToken()
    @if (!Model.IsNew)
    {
        <input type="hidden" name="Id" value="@Model.Form.Id" />
    }

    <div class="row g-4">
        <div class="col-lg-8 col-12">
            <div class="card shadow-sm border-0 mb-4">
                <div class="card-body pt-3">
                    <h5 class="card-title p-0 pb-2 border-bottom mb-3">
                        <i class="bi bi-chat-quote me-2 text-primary"></i>Yorum Bilgileri
                    </h5>

                    <div class="mb-3">
                        <label for="Name" class="form-label small fw-semibold">
                            Müşteri Adı <span class="text-danger">*</span>
                        </label>
                        <input type="text"
                               class="form-control @(errName != null ? "is-invalid" : "")"
                               id="Name"
                               name="Name"
                               value="@Model.Form.Name"
                               placeholder="Örn: Ahmet Yılmaz"
                               required />
                        @if (errName != null)
                        {
                            <div class="invalid-feedback d-block">@errName</div>
                        }
                    </div>

                    <div class="mb-3">
                        <label for="Title" class="form-label small fw-semibold">
                            Unvan / Kısa Bilgi
                        </label>
                        <input type="text"
                               class="form-control @(errTitle != null ? "is-invalid" : "")"
                               id="Title"
                               name="Title"
                               value="@Model.Form.Title"
                               placeholder="Örn: Kadıköy'de ev aldı" />
                        <div class="form-text">
                            Müşterinin mesleği veya işlemine dair kısa bilgi (ör. "Yatırım Danışmanı", "Beşiktaş'ta daire kiraladı").
                        </div>
                        @if (errTitle != null)
                        {
                            <div class="invalid-feedback d-block">@errTitle</div>
                        }
                    </div>

                    <div class="mb-2">
                        <div class="d-flex justify-content-between align-items-center mb-1">
                            <label for="Testimonail" class="form-label small fw-semibold mb-0">
                                Yorum <span class="text-danger">*</span>
                            </label>
                            <small class="text-muted"><span id="charCount">0</span> / 1000 karakter</small>
                        </div>
                        <textarea class="form-control @(errComment != null ? "is-invalid" : "")"
                                  id="Testimonail"
                                  name="Testimonail"
                                  rows="7"
                                  maxlength="1000"
                                  placeholder="Müşterinizin hizmetlerimiz hakkındaki görüş ve yorumunu yazınız..."
                                  required>@Model.Form.Testimonail</textarea>
                        @if (errComment != null)
                        {
                            <div class="invalid-feedback d-block">@errComment</div>
                        }
                    </div>
                </div>
            </div>
        </div>

        <div class="col-lg-4 col-12">
            <div class="card shadow-sm border-0 mb-4">
                <div class="card-body pt-3">
                    <h5 class="card-title p-0 pb-2 border-bottom mb-3">
                        <i class="bi bi-sliders me-2 text-primary"></i>Yayın Ayarları
                    </h5>

                    <div class="mb-3">
                        <label for="DisplayOrder" class="form-label small fw-semibold">
                            Sıralama
                        </label>
                        <input type="number"
                               class="form-control @(errOrder != null ? "is-invalid" : "")"
                               id="DisplayOrder"
                               name="DisplayOrder"
                               value="@Model.Form.DisplayOrder"
                               min="0" />
                        <div class="form-text">
                            Küçük sayılar sayfada daha önce listelenir.
                        </div>
                        @if (errOrder != null)
                        {
                            <div class="invalid-feedback d-block">@errOrder</div>
                        }
                    </div>

                    <div class="form-check form-switch pt-2 border-top mb-1">
                        <input type="checkbox"
                               class="form-check-input"
                               id="IsActive"
                               name="IsActive"
                               value="true"
                               @(Model.Form.IsActive ? "checked" : "") />
                        <input type="hidden" name="IsActive" value="false" />
                        <label class="form-check-label small fw-semibold" for="IsActive">
                            Sitede göster
                        </label>
                        <div class="form-text">
                            Açık olduğunda yorum web sitesinde ziyaretçilere gösterilir.
                        </div>
                    </div>
                </div>
            </div>

            <div class="card shadow-sm border-0 mb-4">
                <div class="card-body p-3">
                    <div class="d-grid gap-2">
                        <button type="submit" class="btn btn-primary">
                            <i class="bi bi-check-lg me-1"></i> Kaydet
                        </button>
                        <a href="/icerik/yorumlar" class="btn btn-outline-secondary">
                            Vazgeç
                        </a>
                    </div>
                </div>
            </div>

            @if (!Model.IsNew && Model.Form.Id.HasValue)
            {
                <div class="card shadow-sm border-0 border-danger-subtle">
                    <div class="card-body p-3">
                        <details class="text-start">
                            <summary class="text-danger fw-semibold" style="cursor: pointer;">
                                <i class="bi bi-trash me-1"></i> Bu yorumu sil
                            </summary>
                            <div class="pt-3">
                                <p class="text-muted small mb-3">
                                    Bu yorumu sildiğinizde işlem geri alınamaz. Devam etmek istediğinize emin misiniz?
                                </p>
                                <button type="submit"
                                        form="deleteForm"
                                        class="btn btn-danger btn-sm w-100">
                                    <i class="bi bi-trash me-1"></i> Kalıcı olarak sil
                                </button>
                            </div>
                        </details>
                    </div>
                </div>
            }
        </div>
    </div>
</form>

@if (!Model.IsNew && Model.Form.Id.HasValue)
{
    <form id="deleteForm"
          method="post"
          action="/icerik/yorumlar/@Model.Form.Id.Value/sil"
          data-confirm="«@(Model.Form.Name)» adlı müşterinin yorumu silinsin mi? Bu işlem geri alınamaz."
          class="d-none">
        @Html.AntiForgeryToken()
    </form>
}

@section Scripts {
    <script>
        document.addEventListener('DOMContentLoaded', function () {
            var textarea = document.getElementById('Testimonail');
            var charCount = document.getElementById('charCount');
            if (textarea && charCount) {
                function updateCounter() {
                    charCount.textContent = (textarea.value || '').length;
                }
                textarea.addEventListener('input', updateCounter);
                updateCounter();
            }
        });
    </script>
}
