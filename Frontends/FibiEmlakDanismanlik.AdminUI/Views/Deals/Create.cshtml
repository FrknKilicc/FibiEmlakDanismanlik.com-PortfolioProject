@model FibiEmlakDanismanlik.AdminUI.Models.Deals.DealCreateViewModel
@using FibiEmlakDanismanlik.AdminUI.Models.Deals
@using FibiEmlakDanismanlik.AdminUI.Models.Leads
@{
    ViewData["Title"] = "Yeni İşlem";

    var errAgreedPrice = Model.GetFieldError("AgreedPrice");
    var errDepositAmount = Model.GetFieldError("DepositAmount");
    var errDepositDate = Model.GetFieldError("DepositDate");
    var errBuyerRate = Model.GetFieldError("BuyerCommissionRate");
    var errSellerRate = Model.GetFieldError("SellerCommissionRate");
    var errBuyerAmount = Model.GetFieldError("BuyerCommissionAmount");
    var errSellerAmount = Model.GetFieldError("SellerCommissionAmount");
    var errCustomerName = Model.GetFieldError("CustomerName");
    var errCustomerPhone = Model.GetFieldError("CustomerPhone");
    var errNotes = Model.GetFieldError("Notes");
    var errListingId = Model.GetFieldError("ListingId");
    var errLinkedLead = Model.GetFieldError("LinkedLeadId") ?? Model.GetFieldError("LinkedLead");

    var listingUrl = $"/ilanlar/{Model.Form.ListingTypeId}/{Model.Form.ListingId}";
}

<div class="pagetitle d-flex flex-wrap justify-content-between align-items-center gap-2 mb-3">
    <div>
        <h1>Yeni İşlem (Kapora Kaydı)</h1>
        <nav>
            <ol class="breadcrumb mb-0">
                <li class="breadcrumb-item"><a href="/">Ana Sayfa</a></li>
                <li class="breadcrumb-item"><a href="/islemler">İşlemler ve Hak Ediş</a></li>
                <li class="breadcrumb-item active">Yeni İşlem</li>
            </ol>
        </nav>
    </div>
    <div>
        <a href="@listingUrl" class="btn btn-outline-secondary btn-sm">
            <i class="bi bi-arrow-left me-1"></i> İlana Dön
        </a>
    </div>
</div>

@if (!string.IsNullOrWhiteSpace(Model.ErrorMessage))
{
    <div class="alert alert-danger alert-dismissible fade show d-flex align-items-center mb-4" role="alert">
        <i class="bi bi-exclamation-triangle-fill flex-shrink-0 me-2 fs-5"></i>
        <div>@Model.ErrorMessage</div>
        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Kapat"></button>
    </div>
}

@if (errListingId != null)
{
    <div class="alert alert-danger mb-4" role="alert">
        <i class="bi bi-exclamation-octagon me-1"></i> @errListingId
    </div>
}

<!-- İlan Özeti Kartı -->
<div class="card mb-4 shadow-sm border-0 border-start border-primary border-4">
    <div class="card-body p-3">
        <div class="d-flex flex-wrap justify-content-between align-items-center gap-2">
            <div>
                <span class="badge @(Model.IsRent ? "bg-info text-dark" : "bg-primary") mb-1">
                    @(Model.IsRent ? "Kiralama" : "Satış")
                </span>
                <span class="badge bg-secondary mb-1">
                    @(Model.ListingStatus ?? "Durum belirtilmemiş")
                </span>
                <h5 class="mb-0 fw-bold">
                    <a href="@listingUrl" class="text-dark text-decoration-none">
                        @(Model.ListingTitle ?? $"İlan #{Model.Form.ListingId}")
                    </a>
                    <span class="text-muted fs-6 fw-normal ms-1">#@Model.Form.ListingId</span>
                </h5>
            </div>
            <div class="text-end">
                <div class="text-muted small">İlan Liste Fiyatı</div>
                <div class="fs-5 fw-bold text-dark">
                    @DealLabels.Money(Model.ListingPrice)@(Model.IsRent ? " / ay" : "")
                </div>
            </div>
        </div>
    </div>
</div>

<form method="post" action="/islemler/yeni">
    @Html.AntiForgeryToken()
    <input type="hidden" name="ListingTypeId" value="@Model.Form.ListingTypeId" />
    <input type="hidden" name="ListingId" value="@Model.Form.ListingId" />

    <div class="row g-4">
        <!-- 1. Müşteri Bilgileri -->
        <div class="col-lg-6 col-12">
            <div class="card h-100 shadow-sm border-0">
                <div class="card-body pt-3">
                    <h5 class="card-title p-0 pb-2 border-bottom mb-3">
                        <i class="bi bi-person me-2 text-primary"></i>Müşteri Bilgileri
                    </h5>

                    <div class="mb-3">
                        <label for="LinkedLead" class="form-label small fw-semibold">
                            Bağlı talep (isteğe bağlı)
                        </label>
                        <select name="LinkedLead"
                                id="LinkedLead"
                                class="form-select @(errLinkedLead != null ? "is-invalid" : "")"
                                data-help="İşlem açılınca talep Kapora, tamamlanınca Kazanıldı durumuna geçer ve talebin geçmişine yazılır.">
                            <option value="">Talep bağlama</option>
                            @if (Model.Leads != null)
                            {
                                foreach (var lead in Model.Leads)
                                {
                                    var val = $"{lead.Source}-{lead.LeadId}";
                                    var isSelected = Model.Form.LinkedLead == val;
                                    <option value="@val"
                                            data-name="@lead.FullName"
                                            data-phone="@lead.Phone"
                                            selected="@(isSelected ? "selected" : null)">
                                        @($"{lead.FullName} – {lead.Phone} – {LeadLabels.StatusName(lead.Status)} ({lead.CreatedDate:dd.MM.yyyy})")
                                    </option>
                                }
                            }
                        </select>
                        @if (errLinkedLead != null)
                        {
                            <div class="invalid-feedback d-block">@errLinkedLead</div>
                        }
                    </div>

                    <div class="mb-3">
                        <label for="CustomerName" class="form-label small fw-semibold">
                            Müşteri Adı Soyadı <span class="text-danger">*</span>
                        </label>
                        <input type="text"
                               class="form-control @(errCustomerName != null ? "is-invalid" : "")"
                               id="CustomerName"
                               name="CustomerName"
                               value="@Model.Form.CustomerName"
                               placeholder="Örn: Ahmet Yılmaz"
                               required />
                        @if (errCustomerName != null)
                        {
                            <div class="invalid-feedback d-block">@errCustomerName</div>
                        }
                    </div>

                    <div class="mb-3">
                        <label for="CustomerPhone" class="form-label small fw-semibold">
                            Telefon Numarası
                        </label>
                        <input type="text"
                               class="form-control @(errCustomerPhone != null ? "is-invalid" : "")"
                               id="CustomerPhone"
                               name="CustomerPhone"
                               value="@Model.Form.CustomerPhone"
                               placeholder="Örn: 0532 123 45 67" />
                        @if (errCustomerPhone != null)
                        {
                            <div class="invalid-feedback d-block">@errCustomerPhone</div>
                        }
                    </div>

                    <div class="text-muted small pt-2 border-top">
                        <i class="bi bi-shield-check me-1 text-success"></i>Kişisel veri (KVKK); yalnızca işlem takibi için.
                    </div>
                </div>
            </div>
        </div>

        <!-- 2. Bedel ve Kapora -->
        <div class="col-lg-6 col-12">
            <div class="card h-100 shadow-sm border-0">
                <div class="card-body pt-3">
                    <h5 class="card-title p-0 pb-2 border-bottom mb-3">
                        <i class="bi bi-cash-coin me-2 text-primary"></i>Bedel ve Kapora
                    </h5>

                    <div class="mb-3">
                        <label for="AgreedPrice" class="form-label small fw-semibold">
                            @(Model.IsRent ? "Aylık kira (₺)" : "Anlaşılan satış bedeli (₺)") <span class="text-danger">*</span>
                        </label>
                        <input type="text"
                               inputmode="decimal" data-money="true"
                               class="form-control @(errAgreedPrice != null ? "is-invalid" : "")"
                               id="AgreedPrice" data-help="Tarafların anlaştığı nihai işlem bedeli; komisyon oran girildiğinde hesaplama bu tutar üzerinden yapılır."
                               name="AgreedPrice"
                               value="@Model.Form.AgreedPrice"
                               placeholder="Örn: 1.500.000"
                               required />
                        @if (errAgreedPrice != null)
                        {
                            <div class="invalid-feedback d-block">@errAgreedPrice</div>
                        }
                    </div>

                    <div class="row g-2 mb-3">
                        <div class="col-sm-6 col-12">
                            <label for="DepositAmount" class="form-label small fw-semibold">
                                Kapora (₺)
                            </label>
                            <input type="text"
                                   inputmode="decimal" data-money="true"
                                   class="form-control @(errDepositAmount != null ? "is-invalid" : "")"
                                   id="DepositAmount" data-help="Alınan kapora tutarıdır. İşlem kaydedildiğinde ilanın durumu sitede Opsiyonlu olarak güncellenir."
                                   name="DepositAmount"
                                   value="@Model.Form.DepositAmount"
                                   placeholder="Örn: 50.000" />
                            @if (errDepositAmount != null)
                            {
                                <div class="invalid-feedback d-block">@errDepositAmount</div>
                            }
                        </div>

                        <div class="col-sm-6 col-12">
                            <label for="DepositDate" class="form-label small fw-semibold">
                                Kapora Tarihi
                            </label>
                            <input type="date"
                                   class="form-control @(errDepositDate != null ? "is-invalid" : "")"
                                   id="DepositDate" data-help="Kaporanın tahsil edildiği veya sözleşmenin yapıldığı işlem tarihi."
                                   name="DepositDate"
                                   value="@Model.Form.DepositDate" />
                            @if (errDepositDate != null)
                            {
                                <div class="invalid-feedback d-block">@errDepositDate</div>
                            }
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <!-- 3. Komisyon -->
        <div class="col-12">
            <div class="card shadow-sm border-0">
                <div class="card-body pt-3">
                    <h5 class="card-title p-0 pb-2 border-bottom mb-3">
                        <i class="bi bi-percent me-2 text-primary"></i>Komisyon
                    </h5>

                    @if (!Model.IsRent)
                    {
                        <!-- Satış Komisyon Alanları -->
                        <div class="row g-3 mb-2">
                            <!-- Alıcı Tarafı -->
                            <div class="col-md-6 col-12">
                                <div class="p-3 bg-light rounded border">
                                    <h6 class="fw-bold text-dark mb-2">
                                        <i class="bi bi-person-check me-1 text-primary"></i>Alıcıdan Alınacak Komisyon
                                    </h6>
                                    <div class="row g-2">
                                        <div class="col-sm-6 col-12">
                                            <label for="BuyerCommissionRate" class="form-label small text-muted">Oran (%)</label>
                                            <input type="text"
                                                   inputmode="decimal"
                                                   class="form-control form-control-sm @(errBuyerRate != null ? "is-invalid" : "")"
                                                   id="BuyerCommissionRate" data-help="Alıcıdan alınacak komisyon yüzdesidir; girilirse tutar anlaşılan satış bedeli üzerinden hesaplanır."
                                                   name="BuyerCommissionRate"
                                                   value="@Model.Form.BuyerCommissionRate"
                                                   placeholder="Örn: 2" />
                                            @if (errBuyerRate != null)
                                            {
                                                <div class="invalid-feedback d-block">@errBuyerRate</div>
                                            }
                                        </div>
                                        <div class="col-sm-6 col-12">
                                            <label for="BuyerCommissionAmount" class="form-label small text-muted">Tutar (₺)</label>
                                            <input type="text"
                                                   inputmode="decimal" data-money="true"
                                                   class="form-control form-control-sm @(errBuyerAmount != null ? "is-invalid" : "")"
                                                   id="BuyerCommissionAmount" data-help="Alıcı veya kiracıdan tahsil edilecek net komisyon tutarıdır; girilirse oran yerine bu tutar geçerlidir."
                                                   name="BuyerCommissionAmount"
                                                   value="@Model.Form.BuyerCommissionAmount"
                                                   placeholder="Örn: 30.000" />
                                            @if (errBuyerAmount != null)
                                            {
                                                <div class="invalid-feedback d-block">@errBuyerAmount</div>
                                            }
                                        </div>
                                    </div>
                                </div>
                            </div>

                            <!-- Satıcı Tarafı -->
                            <div class="col-md-6 col-12">
                                <div class="p-3 bg-light rounded border">
                                    <h6 class="fw-bold text-dark mb-2">
                                        <i class="bi bi-person-check me-1 text-primary"></i>Satıcıdan Alınacak Komisyon
                                    </h6>
                                    <div class="row g-2">
                                        <div class="col-sm-6 col-12">
                                            <label for="SellerCommissionRate" class="form-label small text-muted">Oran (%)</label>
                                            <input type="text"
                                                   inputmode="decimal"
                                                   class="form-control form-control-sm @(errSellerRate != null ? "is-invalid" : "")"
                                                   id="SellerCommissionRate" data-help="Satıcıdan alınacak komisyon yüzdesidir; girilirse tutar anlaşılan satış bedeli üzerinden hesaplanır."
                                                   name="SellerCommissionRate"
                                                   value="@Model.Form.SellerCommissionRate"
                                                   placeholder="Örn: 2" />
                                            @if (errSellerRate != null)
                                            {
                                                <div class="invalid-feedback d-block">@errSellerRate</div>
                                            }
                                        </div>
                                        <div class="col-sm-6 col-12">
                                            <label for="SellerCommissionAmount" class="form-label small text-muted">Tutar (₺)</label>
                                            <input type="text"
                                                   inputmode="decimal" data-money="true"
                                                   class="form-control form-control-sm @(errSellerAmount != null ? "is-invalid" : "")"
                                                   id="SellerCommissionAmount" data-help="Satıcı veya ev sahibinden alınacak net komisyon tutarıdır; girilirse oran yerine bu tutar geçerlidir."
                                                   name="SellerCommissionAmount"
                                                   value="@Model.Form.SellerCommissionAmount"
                                                   placeholder="Örn: 30.000" />
                                            @if (errSellerAmount != null)
                                            {
                                                <div class="invalid-feedback d-block">@errSellerAmount</div>
                                            }
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>
                    }
                    else
                    {
                        <!-- Kiralama Komisyon Alanları -->
                        <div class="row g-3 mb-2">
                            <div class="col-md-6 col-12">
                                <div class="p-3 bg-light rounded border">
                                    <h6 class="fw-bold text-dark mb-2">
                                        <i class="bi bi-person-check me-1 text-primary"></i>Kiracıdan Alınacak Komisyon
                                    </h6>
                                    <div>
                                        <label for="BuyerCommissionAmount" class="form-label small text-muted">Tutar (₺)</label>
                                        <input type="text"
                                               inputmode="decimal" data-money="true"
                                               class="form-control form-control-sm @(errBuyerAmount != null ? "is-invalid" : "")"
                                               id="BuyerCommissionAmount" data-help="Alıcı veya kiracıdan tahsil edilecek net komisyon tutarıdır; girilirse oran yerine bu tutar geçerlidir."
                                               name="BuyerCommissionAmount"
                                               value="@Model.Form.BuyerCommissionAmount"
                                               placeholder="Örn: 20.000" />
                                        @if (errBuyerAmount != null)
                                        {
                                            <div class="invalid-feedback d-block">@errBuyerAmount</div>
                                        }
                                    </div>
                                </div>
                            </div>
                            <div class="col-md-6 col-12">
                                <div class="p-3 bg-light rounded border">
                                    <h6 class="fw-bold text-dark mb-2">
                                        <i class="bi bi-person-check me-1 text-primary"></i>Ev Sahibinden Alınacak Komisyon
                                    </h6>
                                    <div>
                                        <label for="SellerCommissionAmount" class="form-label small text-muted">Tutar (₺)</label>
                                        <input type="text"
                                               inputmode="decimal" data-money="true"
                                               class="form-control form-control-sm @(errSellerAmount != null ? "is-invalid" : "")"
                                               id="SellerCommissionAmount" data-help="Satıcı veya ev sahibinden alınacak net komisyon tutarıdır; girilirse oran yerine bu tutar geçerlidir."
                                               name="SellerCommissionAmount"
                                               value="@Model.Form.SellerCommissionAmount"
                                               placeholder="Örn: 0" />
                                        @if (errSellerAmount != null)
                                        {
                                            <div class="invalid-feedback d-block">@errSellerAmount</div>
                                        }
                                    </div>
                                </div>
                            </div>
                        </div>
                    }
                </div>
            </div>
        </div>

        <!-- 4. Notlar -->
        <div class="col-12">
            <div class="card shadow-sm border-0">
                <div class="card-body pt-3">
                    <h5 class="card-title p-0 pb-2 border-bottom mb-3">
                        <i class="bi bi-pencil-square me-2 text-primary"></i>Not
                    </h5>

                    <div class="mb-2">
                        <label for="Notes" class="form-label small fw-semibold text-muted">İşlem Notları</label>
                        <textarea class="form-control @(errNotes != null ? "is-invalid" : "")"
                                  id="Notes" data-help="Ödeme planı, tapu randevusu veya özel anlaşma şartlarına dair yalnızca panele özel notlar."
                                  name="Notes"
                                  rows="3"
                                  placeholder="İşleme özel açıklamalar, anlaşılan şartlar...">@Model.Form.Notes</textarea>
                        @if (errNotes != null)
                        {
                            <div class="invalid-feedback d-block">@errNotes</div>
                        }
                    </div>
                </div>
            </div>
        </div>

        <!-- 5. Butonlar ve Uyarı -->
        <div class="col-12">
            <div class="card shadow-sm border-0">
                <div class="card-body p-3">
                    <div class="d-flex flex-wrap align-items-center gap-2 mb-2">
                        <button type="submit" class="btn btn-primary px-4">
                            <i class="bi bi-check-lg me-1"></i> Kaydet (kapora alındı)
                        </button>
                        <a href="@listingUrl" class="btn btn-outline-secondary px-3">
                            Vazgeç
                        </a>
                    </div>
                    <div class="small text-muted">
                        <i class="bi bi-info-circle me-1"></i>Kaydedince ilan "Opsiyonlu" olur. Tamamlanınca "Satıldı/Kiralandı" olur ve sitede yayından kalkar.
                    </div>
                </div>
            </div>
        </div>
    </div>
</form>

@section Scripts {
    <script src="~/js/deal-lead-link.js" asp-append-version="true"></script>
}
