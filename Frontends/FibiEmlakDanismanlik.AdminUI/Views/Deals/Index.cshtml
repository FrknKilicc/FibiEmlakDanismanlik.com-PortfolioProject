@model FibiEmlakDanismanlik.AdminUI.Models.Deals.DealIndexViewModel
@using FibiEmlakDanismanlik.AdminUI.Models.Deals
@using System.Globalization

@{
    ViewData["Title"] = "İşlemler ve Hak Ediş";

    var totalItems = Model.Response.Total;
    var currentPage = Model.Sayfa;
    var pageSize = Model.Response.PageSize > 0 ? Model.Response.PageSize : 25;
    var totalPages = Model.TotalPages;
    var startItem = totalItems == 0 ? 0 : ((currentPage - 1) * pageSize) + 1;
    var endItem = Math.Min(currentPage * pageSize, totalItems);

    int startPage = 1;
    int endPage = totalPages;
    if (totalPages > 7)
    {
        startPage = Math.Max(1, currentPage - 3);
        endPage = Math.Min(totalPages, startPage + 6);
        if (endPage - startPage < 6)
        {
            startPage = Math.Max(1, endPage - 6);
        }
    }

    string BuildPageUrl(int p)
    {
        var q = new Dictionary<string, string?>();
        if (Model.Durum.HasValue) q["durum"] = Model.Durum.Value.ToString(CultureInfo.InvariantCulture);
        if (Model.Tur.HasValue) q["tur"] = Model.Tur.Value.ToString(CultureInfo.InvariantCulture);
        if (Model.Danisman.HasValue) q["danisman"] = Model.Danisman.Value.ToString(CultureInfo.InvariantCulture);
        if (!string.IsNullOrWhiteSpace(Model.Baslangic)) q["baslangic"] = Model.Baslangic;
        if (!string.IsNullOrWhiteSpace(Model.Bitis)) q["bitis"] = Model.Bitis;
        if (!string.IsNullOrWhiteSpace(Model.Ara)) q["ara"] = Model.Ara;
        q["sayfa"] = p.ToString(CultureInfo.InvariantCulture);
        return Microsoft.AspNetCore.WebUtilities.QueryHelpers.AddQueryString("/islemler", q);
    }
}

<div class="pagetitle d-flex flex-wrap justify-content-between align-items-center gap-2 mb-3">
    <div>
        <h1>İşlemler ve Hak Ediş</h1>
        <nav>
            <ol class="breadcrumb mb-0">
                <li class="breadcrumb-item"><a href="/">Ana Sayfa</a></li>
                <li class="breadcrumb-item active">İşlemler ve Hak Ediş</li>
            </ol>
        </nav>
    </div>
</div>

@if (TempData["Success"] != null)
{
    <div class="alert alert-success alert-dismissible fade show d-flex align-items-center mb-4" role="alert">
        <i class="bi bi-check-circle-fill flex-shrink-0 me-2 fs-5"></i>
        <div>@TempData["Success"]</div>
        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Kapat"></button>
    </div>
}

@if (TempData["Error"] != null)
{
    <div class="alert alert-danger alert-dismissible fade show d-flex align-items-center mb-4" role="alert">
        <i class="bi bi-exclamation-triangle-fill flex-shrink-0 me-2 fs-5"></i>
        <div>@TempData["Error"]</div>
        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Kapat"></button>
    </div>
}

@if (!string.IsNullOrWhiteSpace(Model.ErrorMessage))
{
    <div class="alert alert-danger alert-dismissible fade show d-flex align-items-center mb-4" role="alert">
        <i class="bi bi-exclamation-triangle-fill flex-shrink-0 me-2 fs-5"></i>
        <div>@Model.ErrorMessage</div>
        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Kapat"></button>
    </div>
}

<!-- Özet Kartları (Response.Summary) -->
<section class="section dashboard pb-0 deal-summary">
    <div class="row g-2 g-md-3 mb-2">
        <!-- 1. Kapora Aşamasında -->
        <div class="col-xl-2 col-md-4 col-6">
            <div class="card info-card h-100 hover-card mb-0 shadow-sm border-0">
                <div class="card-body">
                    <div class="text-muted small fw-semibold text-truncate mb-1">Kapora aşamasında</div>
                    <div class="d-flex align-items-center">
                        <div class="card-icon rounded-circle d-flex align-items-center justify-content-center flex-shrink-0 text-warning bg-warning-subtle" style="width: 40px; height: 40px; min-width: 40px; font-size: 1.2rem;">
                            <i class="bi bi-hourglass-split"></i>
                        </div>
                        <div class="ps-2 min-w-0">
                            <h6 class="fs-5 fw-bold mb-0 lh-1">@Model.Response.Summary.DepositReceivedCount</h6>
                            <span class="text-muted small text-truncate d-none d-md-block pt-1">Açık işlem</span>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <!-- 2. Tamamlanan -->
        <div class="col-xl-2 col-md-4 col-6">
            <div class="card info-card h-100 hover-card mb-0 shadow-sm border-0">
                <div class="card-body">
                    <div class="text-muted small fw-semibold text-truncate mb-1">Tamamlanan</div>
                    <div class="d-flex align-items-center">
                        <div class="card-icon rounded-circle d-flex align-items-center justify-content-center flex-shrink-0 text-success bg-success-subtle" style="width: 40px; height: 40px; min-width: 40px; font-size: 1.2rem;">
                            <i class="bi bi-check2-circle"></i>
                        </div>
                        <div class="ps-2 min-w-0">
                            <h6 class="fs-5 fw-bold mb-0 lh-1">@Model.Response.Summary.CompletedCount</h6>
                            <span class="text-muted small text-truncate d-none d-md-block pt-1">İşlem kapandı</span>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <!-- 3. Toplam Komisyon -->
        <div class="col-xl-2 col-md-4 col-6">
            <div class="card info-card h-100 hover-card mb-0 shadow-sm border-0">
                <div class="card-body">
                    <div class="text-muted small fw-semibold text-truncate mb-1">Toplam komisyon</div>
                    <div class="d-flex align-items-center">
                        <div class="card-icon rounded-circle d-flex align-items-center justify-content-center flex-shrink-0 text-primary bg-primary-subtle" style="width: 40px; height: 40px; min-width: 40px; font-size: 1.2rem;">
                            <i class="bi bi-cash-stack"></i>
                        </div>
                        <div class="ps-2 min-w-0">
                            <h6 class="fs-6 fw-bold mb-0 lh-1 text-truncate">@DealLabels.Money(Model.Response.Summary.CompletedCommissionTotal)</h6>
                            <span class="text-muted small text-truncate d-none d-md-block pt-1">Toplam ciro</span>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <!-- 4. Dağıtılan Prim -->
        <div class="col-xl-2 col-md-4 col-6">
            <div class="card info-card h-100 hover-card mb-0 shadow-sm border-0">
                <div class="card-body">
                    <div class="text-muted small fw-semibold text-truncate mb-1">Dağıtılan prim</div>
                    <div class="d-flex align-items-center">
                        <div class="card-icon rounded-circle d-flex align-items-center justify-content-center flex-shrink-0 text-info bg-info-subtle" style="width: 40px; height: 40px; min-width: 40px; font-size: 1.2rem;">
                            <i class="bi bi-people"></i>
                        </div>
                        <div class="ps-2 min-w-0">
                            <h6 class="fs-6 fw-bold mb-0 lh-1 text-truncate">@DealLabels.Money(Model.Response.Summary.CompletedSharesTotal)</h6>
                            <span class="text-muted small text-truncate d-none d-md-block pt-1">Hak edişler</span>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <!-- 5. Şirket Payı (Vurgulu) -->
        <div class="col-xl-2 col-md-4 col-6">
            <div class="card info-card h-100 hover-card mb-0 shadow-sm border-0 bg-success-subtle border-start border-success border-4">
                <div class="card-body">
                    <div class="text-success small fw-bold text-truncate mb-1">Şirket payı</div>
                    <div class="d-flex align-items-center">
                        <div class="card-icon rounded-circle d-flex align-items-center justify-content-center flex-shrink-0 text-success bg-white shadow-sm" style="width: 40px; height: 40px; min-width: 40px; font-size: 1.2rem;">
                            <i class="bi bi-bank"></i>
                        </div>
                        <div class="ps-2 min-w-0">
                            <h6 class="fs-6 fw-bold text-success mb-0 lh-1 text-truncate">@DealLabels.Money(Model.Response.Summary.CompanyShareTotal)</h6>
                            <span class="text-muted small text-truncate d-none d-md-block pt-1">Net şirket geliri</span>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <!-- 6. Ödenecek Prim -->
        <div class="col-xl-2 col-md-4 col-6">
            <div class="card info-card h-100 hover-card mb-0 shadow-sm border-0">
                <div class="card-body">
                    <div class="text-muted small fw-semibold text-truncate mb-1">Ödenecek prim</div>
                    <div class="d-flex align-items-center">
                        <div class="card-icon rounded-circle d-flex align-items-center justify-content-center flex-shrink-0 text-danger bg-danger-subtle" style="width: 40px; height: 40px; min-width: 40px; font-size: 1.2rem;">
                            <i class="bi bi-wallet2"></i>
                        </div>
                        <div class="ps-2 min-w-0">
                            <h6 class="fs-6 fw-bold mb-0 lh-1 text-truncate">@DealLabels.Money(Model.Response.Summary.PendingSharesTotal)</h6>
                            <span class="text-muted small text-truncate d-none d-md-block pt-1">Bekleyen ödeme</span>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <div class="small text-muted mb-3 ps-1">
        İptal edilip kaporası geri verilmeyen: <strong class="text-dark">@DealLabels.Money(Model.Response.Summary.KeptDepositTotal)</strong> · Tutarlar KDV hariç, girildiği gibidir. Toplamlar seçili tarih aralığındaki tamamlanmış işlemlerdendir.
    </div>
</section>

<!-- Filtreleme Formu (GET) -->
<div class="card mb-4 shadow-sm border-0">
    <div class="card-body pt-3">
        <form method="get" action="/islemler" class="row g-2 align-items-end">
            <div class="col-xl-2 col-lg-3 col-md-4 col-sm-6 col-12">
                <label for="filterDurum" class="form-label small fw-semibold text-muted mb-1">Durum</label>
                <select class="form-select form-select-sm" id="filterDurum" name="durum">
                    <option value="" selected="@(!Model.Durum.HasValue ? "selected" : null)">Tümü</option>
                    <option value="1" selected="@(Model.Durum == 1 ? "selected" : null)">Kapora alındı</option>
                    <option value="2" selected="@(Model.Durum == 2 ? "selected" : null)">Tamamlandı</option>
                    <option value="3" selected="@(Model.Durum == 3 ? "selected" : null)">İptal</option>
                </select>
            </div>

            <div class="col-xl-2 col-lg-3 col-md-4 col-sm-6 col-12">
                <label for="filterTur" class="form-label small fw-semibold text-muted mb-1">Tür</label>
                <select class="form-select form-select-sm" id="filterTur" name="tur">
                    <option value="" selected="@(!Model.Tur.HasValue ? "selected" : null)">Tümü</option>
                    <option value="1" selected="@(Model.Tur == 1 ? "selected" : null)">Satış</option>
                    <option value="2" selected="@(Model.Tur == 2 ? "selected" : null)">Kiralama</option>
                </select>
            </div>

            <div class="col-xl-2 col-lg-3 col-md-4 col-sm-6 col-12">
                <label for="filterDanisman" class="form-label small fw-semibold text-muted mb-1">Çalışan</label>
                <select class="form-select form-select-sm" id="filterDanisman" name="danisman">
                    <option value="">Tüm Çalışanlar</option>
                    @foreach (var ag in Model.Agents)
                    {
                        <option value="@ag.AgentId" selected="@(Model.Danisman == ag.AgentId ? "selected" : null)">@ag.AgentName</option>
                    }
                </select>
            </div>

            <div class="col-xl-2 col-lg-3 col-md-4 col-sm-6 col-12">
                <label for="filterBaslangic" class="form-label small fw-semibold text-muted mb-1">Başlangıç</label>
                <input type="date" class="form-control form-control-sm" id="filterBaslangic" name="baslangic" value="@Model.Baslangic" />
            </div>

            <div class="col-xl-2 col-lg-3 col-md-4 col-sm-6 col-12">
                <label for="filterBitis" class="form-label small fw-semibold text-muted mb-1">Bitiş</label>
                <input type="date" class="form-control form-control-sm" id="filterBitis" name="bitis" value="@Model.Bitis" />
            </div>

            <div class="col-xl-2 col-lg-3 col-md-4 col-sm-6 col-12">
                <label for="filterAra" class="form-label small fw-semibold text-muted mb-1">Arama</label>
                <div class="input-group input-group-sm">
                    <span class="input-group-text"><i class="bi bi-search"></i></span>
                    <input type="text" class="form-control form-control-sm" id="filterAra" name="ara" value="@Model.Ara" placeholder="Müşteri adı, telefon, ilan no" />
                </div>
            </div>

            <div class="col-auto d-flex gap-2 ms-auto mt-2">
                <button type="submit" class="btn btn-sm btn-primary px-3">
                    <i class="bi bi-funnel me-1"></i> Filtrele
                </button>
                <a href="/islemler" class="btn btn-sm btn-outline-secondary px-3">
                    <i class="bi bi-x-circle me-1"></i> Temizle
                </a>
            </div>
        </form>
    </div>
</div>

@if (Model.Response.Rows == null || !Model.Response.Rows.Any())
{
    <!-- Kayıt Bulunamadı Kutusu -->
    <div class="card border-0 shadow-sm">
        <div class="card-body text-center py-5">
            <i class="bi bi-inbox fs-1 text-muted d-block mb-3"></i>
            <h5 class="fw-semibold text-secondary">Kayıt bulunamadı.</h5>
            <p class="text-muted small mb-0">Yeni işlem, ilan düzenleme sayfasındaki 'İşlemler ve Hak Ediş' kartından eklenir.</p>
        </div>
    </div>
}
else
{
    <!-- Masaüstü Tablo Görünümü (d-none d-md-block) -->
    <div class="card border-0 shadow-sm d-none d-md-block mb-4">
        <div class="card-body p-0">
            <div class="table-responsive">
                <table class="table table-hover align-middle mb-0">
                    <thead class="table-light text-muted small text-uppercase">
                        <tr>
                            <th scope="col" class="ps-3">Tarih</th>
                            <th scope="col">İlan</th>
                            <th scope="col">Müşteri</th>
                            <th scope="col">Durum</th>
                            <th scope="col">Anlaşılan Bedel</th>
                            <th scope="col">Komisyon</th>
                            <th scope="col">Prim</th>
                            <th scope="col">Şirket Payı</th>
                            <th scope="col" class="text-end pe-3">İşlem</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var row in Model.Response.Rows)
                        {
                            var detailUrl = $"/islemler/{row.ListingDealId}";
                            <tr>
                                <td class="ps-3 text-nowrap">
                                    <span class="small fw-medium text-dark">@DealLabels.Date(row.DealDate)</span>
                                </td>
                                <td>
                                    <div>
                                        <a href="/ilanlar/@row.ListingTypeId/@row.ListingId" class="fw-semibold text-dark text-decoration-none">
                                            @row.ListingTitle
                                        </a>
                                    </div>
                                    <div class="small text-muted">
                                        #@row.ListingId · @DealLabels.DealTypeName(row.DealType)
                                    </div>
                                </td>
                                <td>
                                    <span class="small fw-medium text-dark">@(row.CustomerName ?? "—")</span>
                                </td>
                                <td>
                                    <span class="badge bg-@DealLabels.StatusBadge(row.Status)">
                                        @DealLabels.StatusName(row.Status)
                                    </span>
                                </td>
                                <td class="text-nowrap">
                                    <span class="small fw-semibold text-dark">@DealLabels.Money(row.AgreedPrice)</span>
                                </td>
                                <td class="text-nowrap">
                                    <span class="small fw-semibold text-dark">@DealLabels.Money(row.TotalCommission)</span>
                                </td>
                                <td>
                                    <div class="small fw-semibold text-dark text-nowrap">@DealLabels.Money(row.TotalShares)</div>
                                    @if (row.ShareAgentNames != null && row.ShareAgentNames.Any())
                                    {
                                        <div class="small text-muted" style="max-width: 180px;">
                                            @string.Join(", ", row.ShareAgentNames)
                                        </div>
                                    }
                                </td>
                                <td class="text-nowrap">
                                    <strong class="small text-dark">@DealLabels.Money(row.CompanyShare)</strong>
                                </td>
                                <td class="text-end pe-3">
                                    <a href="@detailUrl" class="btn btn-outline-primary btn-sm text-nowrap">
                                        <i class="bi bi-arrow-right me-1"></i> Aç
                                    </a>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>

    <!-- Mobil Kart Görünümü (d-md-none) -->
    <div class="d-md-none mb-4">
        @foreach (var row in Model.Response.Rows)
        {
            var detailUrl = $"/islemler/{row.ListingDealId}";
            <div class="card mb-3 shadow-sm border-0">
                <div class="card-body p-3">
                    <div class="d-flex justify-content-between align-items-start mb-2">
                        <div>
                            <span class="badge bg-@DealLabels.StatusBadge(row.Status) me-1">@DealLabels.StatusName(row.Status)</span>
                            <span class="badge bg-primary-subtle text-primary border border-primary-subtle">@DealLabels.DealTypeName(row.DealType)</span>
                        </div>
                        <span class="small text-muted">
                            <i class="bi bi-clock me-1"></i>@DealLabels.Date(row.DealDate)
                        </span>
                    </div>

                    <h6 class="mb-1 fw-bold">
                        <a href="/ilanlar/@row.ListingTypeId/@row.ListingId" class="text-dark text-decoration-none">
                            @row.ListingTitle
                        </a>
                    </h6>
                    <div class="small text-muted mb-2">İlan #@row.ListingId</div>

                    <div class="small mb-2">
                        <i class="bi bi-person me-1 text-muted"></i><strong>Müşteri:</strong> @(row.CustomerName ?? "—")
                    </div>

                    <div class="d-flex flex-column gap-1 small text-muted p-2 bg-light rounded mb-3">
                        <div class="d-flex justify-content-between">
                            <span>Anlaşılan Bedel:</span>
                            <strong class="text-dark">@DealLabels.Money(row.AgreedPrice)</strong>
                        </div>
                        <div class="d-flex justify-content-between">
                            <span>Komisyon:</span>
                            <strong class="text-dark">@DealLabels.Money(row.TotalCommission)</strong>
                        </div>
                        <div class="d-flex justify-content-between">
                            <span>Dağıtılan Prim:</span>
                            <strong class="text-dark">@DealLabels.Money(row.TotalShares)</strong>
                        </div>
                        @if (row.ShareAgentNames != null && row.ShareAgentNames.Any())
                        {
                            <div class="small text-muted ps-2">
                                (@string.Join(", ", row.ShareAgentNames))
                            </div>
                        }
                        <div class="d-flex justify-content-between border-top pt-1 mt-1">
                            <span class="fw-semibold text-dark">Şirket Payı:</span>
                            <strong class="text-dark">@DealLabels.Money(row.CompanyShare)</strong>
                        </div>
                    </div>

                    <div class="d-flex justify-content-end">
                        <a href="@detailUrl" class="btn btn-primary btn-sm px-3 w-100 text-center">
                            <i class="bi bi-arrow-right me-1"></i> Aç
                        </a>
                    </div>
                </div>
            </div>
        }
    </div>

    <!-- Sayfalama ve Bilgi Çubuğu -->
    <div class="d-flex flex-column flex-md-row justify-content-between align-items-center gap-2 mb-4">
        <div class="text-muted small">
            @totalItems kayıttan @startItem–@endItem arası gösteriliyor
        </div>

        @if (totalPages > 1)
        {
            <nav aria-label="İşlemler sayfalaması">
                <ul class="pagination pagination-sm mb-0">
                    <li class="page-item @(currentPage <= 1 ? "disabled" : "")">
                        <a class="page-link" href="@(currentPage > 1 ? BuildPageUrl(currentPage - 1) : "#")" tabindex="@(currentPage <= 1 ? "-1" : "0")" aria-label="Önceki">
                            <span aria-hidden="true">&laquo;</span>
                        </a>
                    </li>

                    @for (int p = startPage; p <= endPage; p++)
                    {
                        <li class="page-item @(p == currentPage ? "active" : "")">
                            <a class="page-link" href="@BuildPageUrl(p)">@p</a>
                        </li>
                    }

                    <li class="page-item @(currentPage >= totalPages ? "disabled" : "")">
                        <a class="page-link" href="@(currentPage < totalPages ? BuildPageUrl(currentPage + 1) : "#")" tabindex="@(currentPage >= totalPages ? "-1" : "0")" aria-label="Sonraki">
                            <span aria-hidden="true">&raquo;</span>
                        </a>
                    </li>
                </ul>
            </nav>
        }
    </div>
}
