@model FibiEmlakDanismanlik.AdminUI.Models.Deals.DealDetailViewModel
@using FibiEmlakDanismanlik.AdminUI.Models.Deals
@using System.Globalization
@{
    var d = Model.Detail;
    bool isOpen = d.Status == 1;
    bool isCancelled = d.Status == 3;
    bool isRent = d.DealType == 2;

    ViewData["Title"] = $"İşlem #{d.ListingDealId}";

    TimeZoneInfo? tz = null;
    try
    {
        tz = TimeZoneInfo.FindSystemTimeZoneById("Europe/Istanbul");
    }
    catch
    {
        try
        {
            tz = TimeZoneInfo.FindSystemTimeZoneById("Turkey Standard Time");
        }
        catch
        {
            tz = null;
        }
    }
    var createdLocal = tz != null ? TimeZoneInfo.ConvertTimeFromUtc(d.CreatedAtUtc, tz) : d.CreatedAtUtc;
    var createdStr = createdLocal.ToString("dd.MM.yyyy HH:mm");

    var listingUrl = $"/ilanlar/{d.ListingTypeId}/{d.ListingId}";
}

<div class="pagetitle d-flex flex-wrap justify-content-between align-items-center gap-2 mb-3">
    <div>
        <div class="d-flex align-items-center gap-2 flex-wrap">
            <h1 class="mb-0">İşlem <span class="text-muted fs-4 font-monospace">#@d.ListingDealId</span></h1>
            <span class="badge bg-@DealLabels.StatusBadge(d.Status) fs-6">
                @DealLabels.StatusName(d.Status)
            </span>
            <span class="badge bg-primary-subtle text-primary border border-primary-subtle fs-6">
                @DealLabels.DealTypeName(d.DealType)
            </span>
        </div>
        <nav class="mt-1">
            <ol class="breadcrumb mb-0">
                <li class="breadcrumb-item"><a href="/">Ana Sayfa</a></li>
                <li class="breadcrumb-item"><a href="/islemler">İşlemler ve Hak Ediş</a></li>
                <li class="breadcrumb-item active">#@d.ListingDealId</li>
            </ol>
        </nav>
    </div>
    <div>
        <a href="/islemler" class="btn btn-outline-secondary btn-sm">
            <i class="bi bi-arrow-left me-1"></i> Listeye Dön
        </a>
    </div>
</div>

@if (TempData["Success"] != null)
{
    <div class="alert alert-success alert-dismissible fade show d-flex align-items-center mb-4" role="alert">
        <i class="bi bi-check-circle-fill flex-shrink-0 me-2 fs-5"></i>
        <div>@TempData["Success"]</div>
        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Kapat"></button>
    </div>
}

@if (TempData["Error"] != null)
{
    <div class="alert alert-danger alert-dismissible fade show d-flex align-items-center mb-4" role="alert">
        <i class="bi bi-exclamation-triangle-fill flex-shrink-0 me-2 fs-5"></i>
        <div>@TempData["Error"]</div>
        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Kapat"></button>
    </div>
}

@if (!string.IsNullOrWhiteSpace(Model.ErrorMessage))
{
    <div class="alert alert-danger alert-dismissible fade show d-flex align-items-center mb-4" role="alert">
        <i class="bi bi-exclamation-triangle-fill flex-shrink-0 me-2 fs-5"></i>
        <div>@Model.ErrorMessage</div>
        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Kapat"></button>
    </div>
}

<!-- Üst Özet Satırı (4 Küçük Kart) -->
<section class="section dashboard pb-0 deal-summary">
    <div class="row g-2 g-md-3 mb-4">
        <!-- Toplam Komisyon -->
        <div class="col-xl-3 col-sm-6 col-12">
            <div class="card info-card h-100 hover-card mb-0 shadow-sm border-0">
                <div class="card-body">
                    <div class="text-muted small fw-semibold text-truncate mb-1">Toplam Komisyon</div>
                    <div class="d-flex align-items-center">
                        <div class="card-icon rounded-circle d-flex align-items-center justify-content-center flex-shrink-0 text-primary bg-primary-subtle" style="width: 44px; height: 44px; min-width: 44px; font-size: 1.25rem;">
                            <i class="bi bi-cash-stack"></i>
                        </div>
                        <div class="ps-2 ps-md-3 min-w-0">
                            <h6 class="fs-5 fw-bold mb-0 lh-1 text-truncate">@DealLabels.Money(d.TotalCommission)</h6>
                            <span class="text-muted small text-truncate d-none d-md-block pt-1">İşlem cirosu</span>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <!-- Dağıtılan Prim -->
        <div class="col-xl-3 col-sm-6 col-12">
            <div class="card info-card h-100 hover-card mb-0 shadow-sm border-0">
                <div class="card-body">
                    <div class="text-muted small fw-semibold text-truncate mb-1">Dağıtılan Prim</div>
                    <div class="d-flex align-items-center">
                        <div class="card-icon rounded-circle d-flex align-items-center justify-content-center flex-shrink-0 text-info bg-info-subtle" style="width: 44px; height: 44px; min-width: 44px; font-size: 1.25rem;">
                            <i class="bi bi-people"></i>
                        </div>
                        <div class="ps-2 ps-md-3 min-w-0">
                            <h6 class="fs-5 fw-bold mb-0 lh-1 text-truncate">@DealLabels.Money(d.TotalShares)</h6>
                            <span class="text-muted small text-truncate d-none d-md-block pt-1">Çalışan hak edişleri</span>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <!-- Şirket Payı (Vurgulu) -->
        <div class="col-xl-3 col-sm-6 col-12">
            <div class="card info-card h-100 hover-card mb-0 shadow-sm border-0 @(d.CompanyShare < 0 ? "bg-danger-subtle border-start border-danger border-4" : "bg-success-subtle border-start border-success border-4")">
                <div class="card-body">
                    <div class="small fw-bold text-truncate mb-1 @(d.CompanyShare < 0 ? "text-danger" : "text-success")">Şirket Payı</div>
                    <div class="d-flex align-items-center">
                        <div class="card-icon rounded-circle d-flex align-items-center justify-content-center flex-shrink-0 @(d.CompanyShare < 0 ? "text-danger" : "text-success") bg-white shadow-sm" style="width: 44px; height: 44px; min-width: 44px; font-size: 1.25rem;">
                            <i class="bi bi-bank"></i>
                        </div>
                        <div class="ps-2 ps-md-3 min-w-0">
                            <h6 class="fs-5 fw-bold mb-0 lh-1 text-truncate @(d.CompanyShare < 0 ? "text-danger" : "text-success")">
                                @DealLabels.Money(d.CompanyShare)
                            </h6>
                            <span class="text-muted small text-truncate d-none d-md-block pt-1">Net şirket payı</span>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <!-- Kapora -->
        <div class="col-xl-3 col-sm-6 col-12">
            <div class="card info-card h-100 hover-card mb-0 shadow-sm border-0">
                <div class="card-body">
                    <div class="text-muted small fw-semibold text-truncate mb-1">Kapora</div>
                    <div class="d-flex align-items-center">
                        <div class="card-icon rounded-circle d-flex align-items-center justify-content-center flex-shrink-0 text-warning bg-warning-subtle" style="width: 44px; height: 44px; min-width: 44px; font-size: 1.25rem;">
                            <i class="bi bi-wallet2"></i>
                        </div>
                        <div class="ps-2 ps-md-3 min-w-0">
                            <h6 class="fs-5 fw-bold mb-0 lh-1 text-truncate">@DealLabels.Money(d.DepositAmount)</h6>
                            <span class="text-muted small text-truncate d-none d-md-block pt-1">@DealLabels.Date(d.DepositDate)</span>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</section>

<div class="row g-4">
    <!-- SOL SÜTUN (col-lg-8) -->
    <div class="col-lg-8 col-12">
        <!-- 1. İşlem Bilgileri Kartı -->
        <div class="card mb-4 shadow-sm border-0">
            <div class="card-body pt-3">
                <div class="d-flex justify-content-between align-items-center pb-2 border-bottom mb-3 flex-wrap gap-2">
                    <h5 class="card-title p-0 m-0">
                        <i class="bi bi-info-circle me-2 text-primary"></i>İşlem Bilgileri
                    </h5>
                    <div>
                        <a href="@listingUrl" class="small fw-semibold text-decoration-none">
                            <i class="bi bi-link-45deg me-1"></i>@(d.ListingTitle ?? $"İlan #{d.ListingId}")
                        </a>
                        <span class="badge bg-secondary ms-1">@(d.ListingStatus ?? "Durum yok")</span>
                    </div>
                </div>

                @if (!isCancelled)
                {
                    <form method="post" action="/islemler/@d.ListingDealId">
                        @Html.AntiForgeryToken()

                        <div class="row g-3 mb-3">
                            <div class="col-sm-6 col-12">
                                <label for="formCustomerName" class="form-label small fw-semibold">Müşteri Adı</label>
                                <input type="text" class="form-control form-control-sm" id="formCustomerName" name="CustomerName" value="@d.CustomerName" required />
                            </div>
                            <div class="col-sm-6 col-12">
                                <label for="formCustomerPhone" class="form-label small fw-semibold">Telefon Numarası</label>
                                <input type="text" class="form-control form-control-sm" id="formCustomerPhone" name="CustomerPhone" value="@d.CustomerPhone" />
                            </div>

                            <div class="col-sm-4 col-12">
                                <label for="formAgreedPrice" class="form-label small fw-semibold">
                                    @(isRent ? "Aylık Kira (₺)" : "Anlaşılan Bedel (₺)")
                                </label>
                                <input type="text" inputmode="decimal" class="form-control form-control-sm" id="formAgreedPrice" name="AgreedPrice" value="@DealLabels.InputNumber(d.AgreedPrice)" required />
                            </div>
                            <div class="col-sm-4 col-12">
                                <label for="formDepositAmount" class="form-label small fw-semibold">Kapora (₺)</label>
                                <input type="text" inputmode="decimal" class="form-control form-control-sm" id="formDepositAmount" name="DepositAmount" value="@DealLabels.InputNumber(d.DepositAmount)" />
                            </div>
                            <div class="col-sm-4 col-12">
                                <label for="formDepositDate" class="form-label small fw-semibold">Kapora Tarihi</label>
                                <input type="date" class="form-control form-control-sm" id="formDepositDate" name="DepositDate" value="@DealLabels.InputDate(d.DepositDate)" />
                            </div>
                        </div>

                        <!-- Komisyon Bölümü -->
                        <div class="p-3 bg-light rounded border mb-3">
                            <div class="fw-semibold small text-dark mb-2">
                                <i class="bi bi-percent me-1 text-primary"></i>Komisyon Detayları
                            </div>

                            @if (!isRent)
                            {
                                <div class="row g-2 mb-2">
                                    <div class="col-sm-6 col-12">
                                        <label class="form-label small text-muted mb-0">Alıcı Komisyon Oranı (%)</label>
                                        <input type="text" inputmode="decimal" class="form-control form-control-sm" name="BuyerCommissionRate" value="@DealLabels.InputNumber(d.BuyerCommissionRate)" placeholder="Örn: 2" />
                                    </div>
                                    <div class="col-sm-6 col-12">
                                        <label class="form-label small text-muted mb-0">Alıcı Komisyon Tutarı (₺)</label>
                                        <input type="text" inputmode="decimal" class="form-control form-control-sm" name="BuyerCommissionAmount" value="@DealLabels.InputNumber(d.BuyerCommissionAmount)" />
                                    </div>
                                    <div class="col-sm-6 col-12">
                                        <label class="form-label small text-muted mb-0">Satıcı Komisyon Oranı (%)</label>
                                        <input type="text" inputmode="decimal" class="form-control form-control-sm" name="SellerCommissionRate" value="@DealLabels.InputNumber(d.SellerCommissionRate)" placeholder="Örn: 2" />
                                    </div>
                                    <div class="col-sm-6 col-12">
                                        <label class="form-label small text-muted mb-0">Satıcı Komisyon Tutarı (₺)</label>
                                        <input type="text" inputmode="decimal" class="form-control form-control-sm" name="SellerCommissionAmount" value="@DealLabels.InputNumber(d.SellerCommissionAmount)" />
                                    </div>
                                </div>
                            }
                            else
                            {
                                <div class="row g-2 mb-2">
                                    <div class="col-sm-6 col-12">
                                        <label class="form-label small text-muted mb-0">Kiracı Komisyon Tutarı (₺)</label>
                                        <input type="text" inputmode="decimal" class="form-control form-control-sm" name="BuyerCommissionAmount" value="@DealLabels.InputNumber(d.BuyerCommissionAmount)" />
                                    </div>
                                    <div class="col-sm-6 col-12">
                                        <label class="form-label small text-muted mb-0">Ev Sahibi Komisyon Tutarı (₺)</label>
                                        <input type="text" inputmode="decimal" class="form-control form-control-sm" name="SellerCommissionAmount" value="@DealLabels.InputNumber(d.SellerCommissionAmount)" />
                                    </div>
                                </div>
                            }
                        </div>

                        <div class="mb-3">
                            <label for="formNotes" class="form-label small fw-semibold">Notlar</label>
                            <textarea class="form-control form-control-sm" id="formNotes" name="Notes" rows="2">@d.Notes</textarea>
                        </div>

                        <div class="d-flex justify-content-between align-items-center pt-2 border-top">
                            <span class="small text-muted">
                                <i class="bi bi-person me-1"></i>Kaydeden: @(d.CreatedByAgentName ?? "—") · @createdStr
                            </span>
                            <button type="submit" class="btn btn-primary btn-sm px-3">
                                <i class="bi bi-save me-1"></i> Bilgileri Güncelle
                            </button>
                        </div>
                    </form>
                }
                else
                {
                    <!-- İptal Edilmişse Yalnızca Okunur Tanım Listesi -->
                    <dl class="row mb-0 small">
                        <dt class="col-sm-4 text-muted">Müşteri</dt>
                        <dd class="col-sm-8 fw-semibold text-dark">@(d.CustomerName ?? "—")</dd>

                        <dt class="col-sm-4 text-muted">Telefon</dt>
                        <dd class="col-sm-8">
                            @if (!string.IsNullOrWhiteSpace(d.CustomerPhone))
                            {
                                <a href="tel:@d.CustomerPhone" class="text-decoration-none">@d.CustomerPhone</a>
                            }
                            else
                            {
                                <span>—</span>
                            }
                        </dd>

                        <dt class="col-sm-4 text-muted">@(isRent ? "Aylık Kira" : "Anlaşılan Bedel")</dt>
                        <dd class="col-sm-8 fw-semibold text-dark">@DealLabels.Money(d.AgreedPrice)</dd>

                        <dt class="col-sm-4 text-muted">Kapora Tutarı & Tarihi</dt>
                        <dd class="col-sm-8">@DealLabels.Money(d.DepositAmount) (@DealLabels.Date(d.DepositDate))</dd>

                        <dt class="col-sm-4 text-muted">Toplam Komisyon</dt>
                        <dd class="col-sm-8 fw-semibold text-dark">@DealLabels.Money(d.TotalCommission)</dd>

                        @if (!string.IsNullOrWhiteSpace(d.Notes))
                        {
                            <dt class="col-sm-4 text-muted">Notlar</dt>
                            <dd class="col-sm-8 text-muted" style="white-space: pre-wrap;">@d.Notes</dd>
                        }
                    </dl>

                    <div class="small text-muted pt-2 border-top mt-3">
                        <i class="bi bi-person me-1"></i>Kaydeden: @(d.CreatedByAgentName ?? "—") · @createdStr
                    </div>
                }
            </div>
        </div>

        <!-- 2. Primler (Hak Ediş) Kartı -->
        <div class="card mb-4 shadow-sm border-0">
            <div class="card-body pt-3">
                <div class="d-flex justify-content-between align-items-center pb-2 border-bottom mb-3">
                    <h5 class="card-title p-0 m-0">
                        <i class="bi bi-people me-2 text-primary"></i>Primler (Hak Ediş)
                    </h5>
                    <span class="badge bg-secondary">@(d.Shares?.Count ?? 0)</span>
                </div>

                @if (d.Shares == null || !d.Shares.Any())
                {
                    <p class="text-muted small mb-3 py-2">Henüz prim eklenmedi.</p>
                }
                else
                {
                    <!-- Masaüstü Prim Tablosu (d-none d-md-block) -->
                    <div class="table-responsive d-none d-md-block mb-3">
                        <table class="table table-sm table-hover align-middle mb-0">
                            <thead class="table-light text-muted small text-uppercase">
                                <tr>
                                    <th scope="col">Çalışan</th>
                                    <th scope="col">Oran</th>
                                    <th scope="col">Tutar</th>
                                    <th scope="col">Ödeme</th>
                                    <th scope="col">Not</th>
                                    <th scope="col" class="text-end">İşlemler</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var share in d.Shares)
                                {
                                    <tr>
                                        <td>
                                            <div class="fw-semibold text-dark">@share.AgentName</div>
                                            <span class="badge bg-secondary-subtle text-secondary" style="font-size: 0.7rem;">
                                                @DealLabels.RoleName(share.RoleAtDeal)
                                            </span>
                                        </td>
                                        <td class="text-nowrap small">
                                            @(share.SharePercent.HasValue ? $"%{share.SharePercent.Value:0.##}" : "—")
                                        </td>
                                        <td class="text-nowrap small fw-semibold text-dark">
                                            @DealLabels.Money(share.Amount)
                                        </td>
                                        <td>
                                            <span class="badge bg-@DealLabels.PaymentBadge(share.PaymentStatus)">
                                                @DealLabels.PaymentName(share.PaymentStatus)
                                            </span>
                                            @if (share.PaidDate.HasValue)
                                            {
                                                <div class="small text-muted" style="font-size: 0.75rem;">@DealLabels.Date(share.PaidDate)</div>
                                            }
                                        </td>
                                        <td class="small text-muted" style="max-width: 150px;">
                                            @(share.Note ?? "—")
                                        </td>
                                        <td class="text-end">
                                            <div class="d-flex justify-content-end align-items-center gap-1 flex-wrap">
                                                <!-- Ödeme Formu -->
                                                @if (share.PaymentStatus == 1)
                                                {
                                                    <form method="post" action="/islemler/@d.ListingDealId/prim/@share.DealShareId/odeme" class="d-inline-flex align-items-center gap-1">
                                                        @Html.AntiForgeryToken()
                                                        <input type="hidden" name="paid" value="true" />
                                                        <input type="date" name="paidDate" class="form-control form-control-sm py-0 px-1" style="width: 110px; font-size: 0.75rem;" value="@DateTime.Today.ToString("yyyy-MM-dd")" />
                                                        <button type="submit" class="btn btn-sm btn-success py-0 px-2 text-nowrap" style="font-size: 0.75rem;" title="Ödendi olarak işaretle">
                                                            <i class="bi bi-check2"></i> Ödendi
                                                        </button>
                                                    </form>
                                                }
                                                else
                                                {
                                                    <form method="post" action="/islemler/@d.ListingDealId/prim/@share.DealShareId/odeme" class="d-inline">
                                                        @Html.AntiForgeryToken()
                                                        <input type="hidden" name="paid" value="false" />
                                                        <button type="submit" class="btn btn-sm btn-outline-warning py-0 px-2 text-nowrap" style="font-size: 0.75rem;" title="Ödemeyi geri al">
                                                            <i class="bi bi-arrow-counterclockwise"></i> Geri al
                                                        </button>
                                                    </form>
                                                }
                                            </div>

                                            <div class="d-flex justify-content-end align-items-center gap-2 mt-1">
                                                @if (!isCancelled)
                                                {
                                                    <!-- Düzenle Details -->
                                                    <details class="text-start">
                                                        <summary class="small text-primary" style="font-size: 0.75rem;">Düzenle</summary>
                                                        <div class="p-2 border rounded bg-light mt-1 shadow-sm position-absolute end-0" style="min-width: 240px; z-index: 10;">
                                                            <form method="post" action="/islemler/@d.ListingDealId/prim/@share.DealShareId">
                                                                @Html.AntiForgeryToken()
                                                                @if (share.PaymentStatus == 2)
                                                                {
                                                                    <div class="small text-muted mb-1" style="font-size: 0.7rem;">Ödenmiş primde yalnızca not değişir.</div>
                                                                    <input type="hidden" name="sharePercent" value="@DealLabels.InputNumber(share.SharePercent)" />
                                                                    <input type="hidden" name="amount" value="@DealLabels.InputNumber(share.Amount)" />
                                                                    <div class="mb-2">
                                                                        <label class="form-label small mb-0">Not</label>
                                                                        <input type="text" name="note" class="form-control form-control-sm" value="@share.Note" />
                                                                    </div>
                                                                }
                                                                else
                                                                {
                                                                    <div class="mb-1">
                                                                        <label class="form-label small mb-0">Oran (%)</label>
                                                                        <input type="text" inputmode="decimal" name="sharePercent" class="form-control form-control-sm" value="@DealLabels.InputNumber(share.SharePercent)" />
                                                                    </div>
                                                                    <div class="mb-1">
                                                                        <label class="form-label small mb-0">Tutar (₺)</label>
                                                                        <input type="text" inputmode="decimal" name="amount" class="form-control form-control-sm" value="@DealLabels.InputNumber(share.Amount)" />
                                                                    </div>
                                                                    <div class="mb-2">
                                                                        <label class="form-label small mb-0">Not</label>
                                                                        <input type="text" name="note" class="form-control form-control-sm" value="@share.Note" />
                                                                    </div>
                                                                }
                                                                <button type="submit" class="btn btn-sm btn-primary py-0 px-2 w-100" style="font-size: 0.75rem;">Kaydet</button>
                                                            </form>
                                                        </div>
                                                    </details>
                                                }

                                                @if (share.PaymentStatus == 1)
                                                {
                                                    <!-- Sil Details -->
                                                    <details class="text-start">
                                                        <summary class="small text-danger" style="font-size: 0.75rem;">Sil</summary>
                                                        <div class="p-2 border border-danger-subtle rounded bg-danger-subtle mt-1 shadow-sm position-absolute end-0" style="min-width: 200px; z-index: 10;">
                                                            <form method="post" action="/islemler/@d.ListingDealId/prim/@share.DealShareId/sil">
                                                                @Html.AntiForgeryToken()
                                                                <div class="small text-danger mb-1" style="font-size: 0.75rem;">Primi silmek istiyor musunuz?</div>
                                                                <button type="submit" class="btn btn-sm btn-danger py-0 px-2 w-100" style="font-size: 0.75rem;">Evet, sil</button>
                                                            </form>
                                                        </div>
                                                    </details>
                                                }
                                            </div>
                                        </td>
                                    </tr>
                                }
                            </tbody>
                            <tfoot class="table-light small">
                                <tr>
                                    <th colspan="2">Dağıtılan Toplam:</th>
                                    <th>@DealLabels.Money(d.TotalShares)</th>
                                    <th colspan="2" class="text-end">Şirket Payı:</th>
                                    <th class="text-end">@DealLabels.Money(d.CompanyShare)</th>
                                </tr>
                            </tfoot>
                        </table>
                    </div>

                    <!-- Mobil Prim Listesi (d-md-none) -->
                    <div class="d-md-none mb-3">
                        @foreach (var share in d.Shares)
                        {
                            <div class="p-2 border rounded bg-light mb-2">
                                <div class="d-flex justify-content-between align-items-start mb-1">
                                    <div>
                                        <span class="fw-semibold text-dark">@share.AgentName</span>
                                        <span class="badge bg-secondary-subtle text-secondary ms-1">@DealLabels.RoleName(share.RoleAtDeal)</span>
                                    </div>
                                    <span class="badge bg-@DealLabels.PaymentBadge(share.PaymentStatus)">
                                        @DealLabels.PaymentName(share.PaymentStatus)
                                    </span>
                                </div>

                                <div class="small text-muted mb-2">
                                    <span>Tutar: <strong class="text-dark">@DealLabels.Money(share.Amount)</strong></span>
                                    @if (share.SharePercent.HasValue)
                                    {
                                        <span class="ms-2">(%@share.SharePercent.Value.ToString("0.##"))</span>
                                    }
                                    @if (share.PaidDate.HasValue)
                                    {
                                        <span class="d-block mt-1">Ödeme: @DealLabels.Date(share.PaidDate)</span>
                                    }
                                    @if (!string.IsNullOrWhiteSpace(share.Note))
                                    {
                                        <span class="d-block mt-1 text-secondary">Not: @share.Note</span>
                                    }
                                </div>

                                <div class="d-flex flex-wrap gap-2 pt-2 border-top">
                                    @if (share.PaymentStatus == 1)
                                    {
                                        <form method="post" action="/islemler/@d.ListingDealId/prim/@share.DealShareId/odeme" class="d-flex gap-1 align-items-center w-100 mb-1">
                                            @Html.AntiForgeryToken()
                                            <input type="hidden" name="paid" value="true" />
                                            <input type="date" name="paidDate" class="form-control form-control-sm" value="@DateTime.Today.ToString("yyyy-MM-dd")" />
                                            <button type="submit" class="btn btn-sm btn-success py-1 px-2 text-nowrap">
                                                <i class="bi bi-check2"></i> Ödendi
                                            </button>
                                        </form>
                                    }
                                    else
                                    {
                                        <form method="post" action="/islemler/@d.ListingDealId/prim/@share.DealShareId/odeme" class="w-100 mb-1">
                                            @Html.AntiForgeryToken()
                                            <input type="hidden" name="paid" value="false" />
                                            <button type="submit" class="btn btn-sm btn-outline-warning py-1 px-2 w-100">
                                                <i class="bi bi-arrow-counterclockwise"></i> Ödemeyi geri al
                                            </button>
                                        </form>
                                    }

                                    @if (!isCancelled)
                                    {
                                        <details class="w-100 mb-1">
                                            <summary class="small text-primary">Düzenle</summary>
                                            <div class="p-2 border rounded bg-white mt-1">
                                                <form method="post" action="/islemler/@d.ListingDealId/prim/@share.DealShareId">
                                                    @Html.AntiForgeryToken()
                                                    @if (share.PaymentStatus == 2)
                                                    {
                                                        <div class="small text-muted mb-1">Ödenmiş primde yalnızca not değişir.</div>
                                                        <input type="hidden" name="sharePercent" value="@DealLabels.InputNumber(share.SharePercent)" />
                                                        <input type="hidden" name="amount" value="@DealLabels.InputNumber(share.Amount)" />
                                                        <div class="mb-2">
                                                            <label class="form-label small mb-0">Not</label>
                                                            <input type="text" name="note" class="form-control form-control-sm" value="@share.Note" />
                                                        </div>
                                                    }
                                                    else
                                                    {
                                                        <div class="mb-1">
                                                            <label class="form-label small mb-0">Oran (%)</label>
                                                            <input type="text" inputmode="decimal" name="sharePercent" class="form-control form-control-sm" value="@DealLabels.InputNumber(share.SharePercent)" />
                                                        </div>
                                                        <div class="mb-1">
                                                            <label class="form-label small mb-0">Tutar (₺)</label>
                                                            <input type="text" inputmode="decimal" name="amount" class="form-control form-control-sm" value="@DealLabels.InputNumber(share.Amount)" />
                                                        </div>
                                                        <div class="mb-2">
                                                            <label class="form-label small mb-0">Not</label>
                                                            <input type="text" name="note" class="form-control form-control-sm" value="@share.Note" />
                                                        </div>
                                                    }
                                                    <button type="submit" class="btn btn-sm btn-primary w-100">Kaydet</button>
                                                </form>
                                            </div>
                                        </details>
                                    }

                                    @if (share.PaymentStatus == 1)
                                    {
                                        <details class="w-100">
                                            <summary class="small text-danger">Sil</summary>
                                            <div class="p-2 border border-danger-subtle rounded bg-danger-subtle mt-1">
                                                <form method="post" action="/islemler/@d.ListingDealId/prim/@share.DealShareId/sil">
                                                    @Html.AntiForgeryToken()
                                                    <div class="small text-danger mb-1">Primi silmek istiyor musunuz?</div>
                                                    <button type="submit" class="btn btn-sm btn-danger w-100">Evet, sil</button>
                                                </form>
                                            </div>
                                        </details>
                                    }
                                </div>
                            </div>
                        }
                        <div class="p-2 bg-white rounded border small mt-2">
                            <div class="d-flex justify-content-between mb-1">
                                <span>Dağıtılan Toplam:</span>
                                <strong>@DealLabels.Money(d.TotalShares)</strong>
                            </div>
                            <div class="d-flex justify-content-between">
                                <span>Şirket Payı:</span>
                                <strong>@DealLabels.Money(d.CompanyShare)</strong>
                            </div>
                        </div>
                    </div>
                }

                <!-- Prim Ekleme Formu -->
                @if (!isCancelled)
                {
                    <div class="p-3 bg-light rounded border mt-3">
                        <h6 class="fw-bold text-dark mb-2">
                            <i class="bi bi-person-plus me-1 text-primary"></i>Prim Ekle
                        </h6>

                        @if (d.TotalCommission <= 0)
                        {
                            <div class="alert alert-warning py-2 small mb-3">
                                <i class="bi bi-exclamation-triangle me-1"></i>Prim eklemek için önce komisyon tutarını girin.
                            </div>
                        }

                        <form method="post" action="/islemler/@d.ListingDealId/prim">
                            @Html.AntiForgeryToken()

                            <div class="row g-2 mb-2">
                                <div class="col-md-4 col-12">
                                    <label class="form-label small text-muted mb-0">Çalışan <span class="text-danger">*</span></label>
                                    <select name="agentId" class="form-select form-select-sm" required>
                                        <option value="">Çalışan seçin</option>
                                        @foreach (var ag in Model.Agents)
                                        {
                                            <option value="@ag.AgentId">@ag.AgentName</option>
                                        }
                                    </select>
                                </div>
                                <div class="col-md-2 col-sm-6 col-12">
                                    <label class="form-label small text-muted mb-0">Oran (%)</label>
                                    <input type="text" inputmode="decimal" name="sharePercent" class="form-control form-control-sm" placeholder="Örn: 20" />
                                </div>
                                <div class="col-md-3 col-sm-6 col-12">
                                    <label class="form-label small text-muted mb-0">Tutar (₺)</label>
                                    <input type="text" inputmode="decimal" name="amount" class="form-control form-control-sm" placeholder="Örn: 5.000" />
                                </div>
                                <div class="col-md-3 col-12">
                                    <label class="form-label small text-muted mb-0">Not</label>
                                    <input type="text" name="note" class="form-control form-control-sm" placeholder="Açıklama" />
                                </div>
                            </div>

                            <div class="small text-muted mb-2">
                                <i class="bi bi-info-circle me-1"></i>Oran girerseniz tutar komisyondan hesaplanır ve komisyon değişince güncellenir. Varsayılan oran yoktur. Bir çalışan bir işleme bir kez eklenir.
                            </div>

                            <button type="submit" class="btn btn-primary btn-sm px-3">
                                <i class="bi bi-plus-lg me-1"></i> Prim Ekle
                            </button>
                        </form>
                    </div>
                }
            </div>
        </div>
    </div>

    <!-- SAĞ SÜTUN (col-lg-4) -->
    <div class="col-lg-4 col-12">
        <!-- 1. İşlem Durum Kartları -->
        @if (isOpen)
        {
            <!-- İşlemi Tamamla Kartı -->
            <div class="card mb-4 shadow-sm border-0 border-start border-success border-4">
                <div class="card-body pt-3">
                    <h5 class="card-title p-0 pb-2 border-bottom mb-3 text-success">
                        <i class="bi bi-check-circle me-2"></i>İşlemi Tamamla
                    </h5>
                    <form method="post" action="/islemler/@d.ListingDealId/tamamla">
                        @Html.AntiForgeryToken()
                        <div class="mb-3">
                            <label for="completeDate" class="form-label small fw-semibold">Tamamlanma Tarihi</label>
                            <input type="date" class="form-control form-control-sm" id="completeDate" name="completedDate" value="@DateTime.Today.ToString("yyyy-MM-dd")" />
                        </div>
                        <button type="submit" class="btn btn-success btn-sm w-100">
                            <i class="bi bi-check2-circle me-1"></i> Tamamla — ilan @(isRent ? "Kiralandı" : "Satıldı") olsun
                        </button>
                    </form>
                </div>
            </div>

            <!-- İşlemi İptal Et Kartı (<details> içinde) -->
            <details class="card mb-4 shadow-sm border-0 border-start border-danger border-4">
                <summary class="card-body py-3 text-danger fw-semibold">
                    <i class="bi bi-x-circle me-2"></i>İşlemi iptal et
                </summary>
                <div class="card-body pt-0">
                    <form method="post" action="/islemler/@d.ListingDealId/iptal">
                        @Html.AntiForgeryToken()

                        <div class="mb-3">
                            <label for="cancelDate" class="form-label small fw-semibold">İptal Tarihi</label>
                            <input type="date" class="form-control form-control-sm" id="cancelDate" name="cancelledDate" value="@DateTime.Today.ToString("yyyy-MM-dd")" />
                        </div>

                        <div class="mb-3">
                            <label class="form-label small fw-semibold d-block">Kapora Durumu</label>
                            <div class="form-check mb-1">
                                <input class="form-check-input" type="radio" name="depositOutcome" id="outcome1" value="1" checked />
                                <label class="form-check-label small" for="outcome1">
                                    Kapora geri verilmedi (varsayılan)
                                </label>
                            </div>
                            <div class="form-check">
                                <input class="form-check-input" type="radio" name="depositOutcome" id="outcome2" value="2" />
                                <label class="form-check-label small" for="outcome2">
                                    Kapora iade edildi
                                </label>
                            </div>
                        </div>

                        <div class="mb-2">
                            <label for="refundAmount" class="form-label small fw-semibold">İade Tutarı (₺)</label>
                            <input type="text" inputmode="decimal" class="form-control form-control-sm" id="refundAmount" name="depositRefundAmount" placeholder="Örn: 50.000" />
                        </div>

                        <div class="mb-3">
                            <label for="refundDate" class="form-label small fw-semibold">İade Tarihi</label>
                            <input type="date" class="form-control form-control-sm" id="refundDate" name="depositRefundDate" />
                        </div>

                        <div class="small text-muted mb-3">
                            <i class="bi bi-info-circle me-1"></i>İptal edilince ilan yeniden "Aktif" olur.
                        </div>

                        <button type="submit" class="btn btn-danger btn-sm w-100">
                            İşlemi İptal Et
                        </button>
                    </form>
                </div>
            </details>
        }
        else if (d.Status == 2)
        {
            <!-- Tamamlandı Bilgi Kartı -->
            <div class="card mb-4 shadow-sm border-0 border-start border-success border-4">
                <div class="card-body pt-3">
                    <h5 class="card-title p-0 pb-2 border-bottom mb-2 text-success">
                        <i class="bi bi-check-circle-fill me-2"></i>İşlem Tamamlandı
                    </h5>
                    <div class="small text-muted">
                        Tamamlandı: <strong class="text-dark">@DealLabels.Date(d.CompletedDate)</strong>
                    </div>
                </div>
            </div>
        }
        else if (isCancelled)
        {
            <!-- İptal Bilgi Kartı -->
            <div class="card mb-4 shadow-sm border-0 border-start border-secondary border-4">
                <div class="card-body pt-3">
                    <h5 class="card-title p-0 pb-2 border-bottom mb-2 text-secondary">
                        <i class="bi bi-x-octagon-fill me-2"></i>İşlem İptal Edildi
                    </h5>
                    <div class="small text-muted mb-1">
                        İptal Tarihi: <strong class="text-dark">@DealLabels.Date(d.CancelledDate)</strong>
                    </div>
                    <div class="small text-muted mb-1">
                        Kapora: <strong class="text-dark">@DealLabels.DepositOutcomeName(d.DepositOutcome)</strong>
                    </div>
                    @if (d.DepositOutcome == 2 && d.DepositRefundAmount.HasValue)
                    {
                        <div class="small text-muted">
                            İade Tutarı: <strong class="text-dark">@DealLabels.Money(d.DepositRefundAmount)</strong> (@DealLabels.Date(d.DepositRefundDate))
                        </div>
                    }
                </div>
            </div>
        }

        <!-- 2. Müşteri Kartı -->
        <div class="card mb-4 shadow-sm border-0">
            <div class="card-body pt-3">
                <h5 class="card-title p-0 pb-2 border-bottom mb-3">
                    <i class="bi bi-person me-2 text-primary"></i>Müşteri
                </h5>

                <div class="mb-2">
                    <label class="text-muted small d-block">Adı Soyadı</label>
                    <div class="fw-bold text-dark">@(d.CustomerName ?? "—")</div>
                </div>

                <div class="mb-2">
                    <label class="text-muted small d-block">Telefon</label>
                    <div>
                        @if (!string.IsNullOrWhiteSpace(d.CustomerPhone))
                        {
                            <a href="tel:@d.CustomerPhone" class="fw-semibold text-decoration-none text-dark">
                                <i class="bi bi-telephone text-primary me-1"></i>@d.CustomerPhone
                            </a>
                        }
                        else
                        {
                            <span class="text-muted small">—</span>
                        }
                    </div>
                </div>

                @if (!string.IsNullOrWhiteSpace(d.Notes))
                {
                    <div class="pt-2 border-top mt-2">
                        <label class="text-muted small d-block">Not</label>
                        <div class="small text-dark mt-1" style="white-space: pre-wrap;">@d.Notes</div>
                    </div>
                }
            </div>
        </div>
    </div>
</div>
