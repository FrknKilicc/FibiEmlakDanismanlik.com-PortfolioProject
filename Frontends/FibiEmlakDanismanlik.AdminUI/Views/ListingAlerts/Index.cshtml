@model FibiEmlakDanismanlik.AdminUI.Models.ListingAlerts.ListingAlertIndexViewModel
@inject FibiEmlakDanismanlik.AdminUI.Infrastructure.CurrentAdmin CurrentAdmin
@using FibiEmlakDanismanlik.AdminUI.Models.ListingAlerts
@{
    ViewData["Title"] = "Haber Bekleyenler";

    var totalItems = Model.Response.Total;
    var currentPage = Model.Sayfa;
    var pageSize = Model.Response.PageSize > 0 ? Model.Response.PageSize : 25;
    var totalPages = Model.TotalPages;
    var startItem = totalItems == 0 ? 0 : ((currentPage - 1) * pageSize) + 1;
    var endItem = Math.Min(currentPage * pageSize, totalItems);

    // En fazla 7 sayfa numarası hesaplama
    int startPage = 1;
    int endPage = totalPages;
    if (totalPages > 7)
    {
        startPage = Math.Max(1, currentPage - 3);
        endPage = Math.Min(totalPages, startPage + 6);
        if (endPage - startPage < 6)
        {
            startPage = Math.Max(1, endPage - 6);
        }
    }

    var summaryColClass = CurrentAdmin.IsManagerOrAbove ? "col-xl-3 col-md-6 col-6" : "col-xl-4 col-md-4 col-6";
}

<div class="pagetitle d-flex flex-wrap justify-content-between align-items-center gap-2 mb-3">
    <div>
        <h1>Haber Bekleyenler</h1>
        <nav>
            <ol class="breadcrumb mb-0">
                <li class="breadcrumb-item"><a href="/">Ana Sayfa</a></li>
                <li class="breadcrumb-item active">Haber Bekleyenler</li>
            </ol>
        </nav>
    </div>
</div>

@if (TempData["Success"] != null)
{
    <div class="alert alert-success alert-dismissible fade show d-flex align-items-center mb-4" role="alert">
        <i class="bi bi-check-circle-fill flex-shrink-0 me-2 fs-5"></i>
        <div>@TempData["Success"]</div>
        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Kapat"></button>
    </div>
}

@if (TempData["Error"] != null)
{
    <div class="alert alert-danger alert-dismissible fade show d-flex align-items-center mb-4" role="alert">
        <i class="bi bi-exclamation-triangle-fill flex-shrink-0 me-2 fs-5"></i>
        <div>@TempData["Error"]</div>
        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Kapat"></button>
    </div>
}

@if (!string.IsNullOrWhiteSpace(Model.ErrorMessage))
{
    <div class="alert alert-danger alert-dismissible fade show d-flex align-items-center mb-4" role="alert">
        <i class="bi bi-exclamation-triangle-fill flex-shrink-0 me-2 fs-5"></i>
        <div>@Model.ErrorMessage</div>
        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Kapat"></button>
    </div>
}

<!-- Özet Kartları (NiceAdmin info-card) -->
<section class="section dashboard pb-0">
    <div class="row g-2 g-md-3 mb-3">
        <!-- Aktif Talepler Kartı -->
        <div class="@summaryColClass">
            <a href="/haber-bekleyenler?durum=1" class="text-decoration-none text-dark d-block h-100">
                <div class="card info-card sales-card h-100 hover-card mb-0">
                    <div class="card-body p-2 p-md-3">
                        <div class="text-muted small fw-semibold text-truncate mb-1">Aktif Talepler</div>
                        <div class="d-flex align-items-center">
                            <div class="card-icon rounded-circle d-flex align-items-center justify-content-center flex-shrink-0 text-success bg-success-subtle" style="width: 44px; height: 44px; min-width: 44px; font-size: 1.25rem;">
                                <i class="bi bi-bell"></i>
                            </div>
                            <div class="ps-2 ps-md-3 min-w-0">
                                <h6 class="fs-5 fw-bold mb-0 lh-1">@Model.Response.Summary.Active</h6>
                                <span class="text-muted small text-truncate d-none d-md-block pt-1">Haber bekleyen aktif</span>
                            </div>
                        </div>
                    </div>
                </div>
            </a>
        </div>

        <!-- Eşleşen İlanı Olan Kartı -->
        <div class="@summaryColClass">
            <a href="/haber-bekleyenler?bekleyen=true" class="text-decoration-none text-dark d-block h-100">
                <div class="card info-card revenue-card h-100 hover-card mb-0">
                    <div class="card-body p-2 p-md-3">
                        <div class="text-muted small fw-semibold text-truncate mb-1">Eşleşen İlanı Olan</div>
                        <div class="d-flex align-items-center">
                            <div class="card-icon rounded-circle d-flex align-items-center justify-content-center flex-shrink-0 text-primary bg-primary-subtle" style="width: 44px; height: 44px; min-width: 44px; font-size: 1.25rem;">
                                <i class="bi bi-building-check"></i>
                            </div>
                            <div class="ps-2 ps-md-3 min-w-0">
                                <h6 class="fs-5 fw-bold mb-0 lh-1">@Model.Response.Summary.ActiveWithPending</h6>
                                <span class="text-muted small text-truncate d-none d-md-block pt-1">Yeni ilan eşleşmesi var</span>
                            </div>
                        </div>
                    </div>
                </div>
            </a>
        </div>

        @if (CurrentAdmin.IsManagerOrAbove)
        {
            <!-- Atanmamış Talepler Kartı (Sahip / Yönetici) -->
            <div class="@summaryColClass">
                <a href="/haber-bekleyenler?atanmamis=true" class="text-decoration-none text-dark d-block h-100">
                    <div class="card info-card customers-card h-100 hover-card mb-0">
                        <div class="card-body p-2 p-md-3">
                            <div class="text-muted small fw-semibold text-truncate mb-1">Atanmamış</div>
                            <div class="d-flex align-items-center">
                                <div class="card-icon rounded-circle d-flex align-items-center justify-content-center flex-shrink-0 text-danger bg-danger-subtle" style="width: 44px; height: 44px; min-width: 44px; font-size: 1.25rem;">
                                    <i class="bi bi-person-x"></i>
                                </div>
                                <div class="ps-2 ps-md-3 min-w-0">
                                    <h6 class="fs-5 fw-bold mb-0 lh-1">@Model.Response.Summary.Unassigned</h6>
                                    <span class="text-muted small text-truncate d-none d-md-block pt-1">Danışman atanmamış</span>
                                </div>
                            </div>
                        </div>
                    </div>
                </a>
            </div>
        }

        <!-- Kapanan Talepler Kartı -->
        <div class="@summaryColClass">
            <a href="/haber-bekleyenler?durum=2" class="text-decoration-none text-dark d-block h-100">
                <div class="card info-card h-100 hover-card mb-0">
                    <div class="card-body p-2 p-md-3">
                        <div class="text-muted small fw-semibold text-truncate mb-1">Kapanan</div>
                        <div class="d-flex align-items-center">
                            <div class="card-icon rounded-circle d-flex align-items-center justify-content-center flex-shrink-0 text-secondary bg-secondary-subtle" style="width: 44px; height: 44px; min-width: 44px; font-size: 1.25rem;">
                                <i class="bi bi-archive"></i>
                            </div>
                            <div class="ps-2 ps-md-3 min-w-0">
                                <h6 class="fs-5 fw-bold mb-0 lh-1">@Model.Response.Summary.Closed</h6>
                                <span class="text-muted small text-truncate d-none d-md-block pt-1">Sonuçlandırılmış</span>
                            </div>
                        </div>
                    </div>
                </div>
            </a>
        </div>
    </div>
</section>

<!-- Durum Sekmeleri / Butonları -->
<div class="d-flex flex-wrap align-items-center gap-2 mb-3">
    <a href="@Model.StatusFilterUrl(1)" class="btn btn-sm @(Model.Durum == 1 ? "btn-success shadow-sm" : "btn-outline-success")">
        Aktif (@Model.Response.Summary.Active)
    </a>
    <a href="@Model.StatusFilterUrl(2)" class="btn btn-sm @(Model.Durum == 2 ? "btn-secondary shadow-sm" : "btn-outline-secondary")">
        Kapandı (@Model.Response.Summary.Closed)
    </a>
    <a href="@Model.StatusFilterUrl(0)" class="btn btn-sm @(Model.Durum == 0 ? "btn-dark shadow-sm" : "btn-outline-dark")">
        Tümü (@(Model.Response.Summary.Active + Model.Response.Summary.Closed))
    </a>
</div>

<!-- Filtreleme Formu (GET) -->
<div class="card mb-4 shadow-sm border-0">
    <div class="card-body pt-3">
        <form method="get" action="/haber-bekleyenler" class="row g-2 align-items-end">
            <div class="col-lg-3 col-md-6 col-12">
                <label for="filterAra" class="form-label small fw-semibold text-muted mb-1">Arama</label>
                <div class="input-group input-group-sm">
                    <span class="input-group-text"><i class="bi bi-search"></i></span>
                    <input type="text" class="form-control form-control-sm" id="filterAra" name="ara" value="@Model.Ara" placeholder="Müşteri adı, telefon..." />
                </div>
            </div>

            <div class="col-lg-2 col-md-3 col-sm-6 col-12">
                <label for="filterDurumSelect" class="form-label small fw-semibold text-muted mb-1">Durum</label>
                <select class="form-select form-select-sm" id="filterDurumSelect" name="durum">
                    <option value="1" selected="@(Model.Durum == 1 ? "selected" : null)">Aktif</option>
                    <option value="2" selected="@(Model.Durum == 2 ? "selected" : null)">Kapandı</option>
                    <option value="0" selected="@(Model.Durum == 0 ? "selected" : null)">Tümü</option>
                </select>
            </div>

            @if (CurrentAdmin.IsManagerOrAbove)
            {
                <div class="col-lg-2 col-md-3 col-sm-6 col-12">
                    <label for="filterDanisman" class="form-label small fw-semibold text-muted mb-1">Danışman</label>
                    <select class="form-select form-select-sm" id="filterDanisman" name="danisman">
                        <option value="">Tüm Danışmanlar</option>
                        @foreach (var ag in Model.Agents)
                        {
                            <option value="@ag.AgentId" selected="@(Model.DanismanId == ag.AgentId ? "selected" : null)">@ag.AgentName</option>
                        }
                    </select>
                </div>

                <div class="col-lg-2 col-md-4 col-sm-6 col-12 d-flex align-items-center pb-2">
                    <div class="form-check mb-0">
                        <input class="form-check-input" type="checkbox" id="filterAtanmamis" name="atanmamis" value="true" checked="@(Model.Atanmamis == true ? "checked" : null)" />
                        <label class="form-check-label small fw-semibold text-muted" for="filterAtanmamis">
                            Sadece Atanmamışlar
                        </label>
                    </div>
                </div>
            }

            <div class="col-lg-3 col-md-4 col-sm-6 col-12 d-flex align-items-center pb-2">
                <div class="form-check mb-0">
                    <input class="form-check-input" type="checkbox" id="filterBekleyen" name="bekleyen" value="true" checked="@(Model.Bekleyen ? "checked" : null)" />
                    <label class="form-check-label small fw-semibold text-muted" for="filterBekleyen">
                        Yalnızca eşleşen ilanı olanlar
                    </label>
                </div>
            </div>

            <div class="col-auto d-flex gap-2 ms-auto mt-2">
                <button type="submit" class="btn btn-sm btn-primary px-3">
                    <i class="bi bi-funnel me-1"></i> Filtrele
                </button>
                <a href="/haber-bekleyenler" class="btn btn-sm btn-outline-secondary px-3">
                    <i class="bi bi-x-circle me-1"></i> Temizle
                </a>
            </div>
        </form>
    </div>
</div>

@if (Model.Response.Items == null || !Model.Response.Items.Any())
{
    <!-- Kayıt Bulunamadı Kutusu -->
    <div class="card border-0 shadow-sm">
        <div class="card-body text-center py-5">
            <i class="bi bi-inbox fs-1 text-muted d-block mb-3"></i>
            <h5 class="fw-semibold text-secondary">Kayıt bulunamadı.</h5>
            <p class="text-muted small mb-3">Arama kriterlerinizi değiştirerek veya filtreleri temizleyerek tekrar deneyebilirsiniz.</p>
            <a href="/haber-bekleyenler" class="btn btn-sm btn-outline-primary px-4">
                Filtreleri Temizle
            </a>
        </div>
    </div>
}
else
{
    <!-- Masaüstü Tablo Görünümü (d-none d-md-block) -->
    <div class="card border-0 shadow-sm d-none d-md-block mb-4">
        <div class="card-body p-0">
            <div class="table-responsive">
                <table class="table table-hover align-middle mb-0">
                    <thead class="table-light text-muted small text-uppercase">
                        <tr>
                            <th scope="col" class="ps-3">Ad Soyad / Telefon</th>
                            <th scope="col">Aradığı Kriterler</th>
                            <th scope="col">Fiyat Aralığı</th>
                            <th scope="col">Eşleşen İlan</th>
                            <th scope="col">Atanan Danışman</th>
                            <th scope="col">Durum</th>
                            <th scope="col">Tarih</th>
                            <th scope="col" class="text-end pe-3">İşlem</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var item in Model.Response.Items)
                        {
                            var detailUrl = $"/haber-bekleyenler/{item.ListingAlertId}";
                            <tr>
                                <td class="ps-3">
                                    <div class="fw-semibold">
                                        <a href="@detailUrl" class="text-dark text-decoration-none">
                                            @item.FullName
                                        </a>
                                    </div>
                                    <div class="small">
                                        <a href="tel:@item.PhoneNumber" class="text-decoration-none text-muted">
                                            <i class="bi bi-telephone me-1"></i>@item.PhoneNumber
                                        </a>
                                    </div>
                                    @if (!string.IsNullOrWhiteSpace(item.Email))
                                    {
                                        <small class="text-muted d-block">@item.Email</small>
                                    }
                                </td>
                                <td>
                                    <div>
                                        <span class="badge bg-primary-subtle text-primary border border-primary-subtle me-1">
                                            @item.TypeDisplay
                                        </span>
                                        <span class="fw-medium text-dark small">
                                            @item.CityName@(!string.IsNullOrWhiteSpace(item.DistrictName) ? $" / {item.DistrictName}" : "")
                                        </span>
                                    </div>
                                    @if (!string.IsNullOrWhiteSpace(item.RoomCounts))
                                    {
                                        <div class="small text-muted mt-1">
                                            <i class="bi bi-door-open me-1"></i>@item.RoomCounts
                                        </div>
                                    }
                                </td>
                                <td>
                                    <span class="small fw-semibold text-dark text-nowrap">
                                        @ListingAlertLabels.PriceRange(item.MinPrice, item.MaxPrice)
                                    </span>
                                </td>
                                <td>
                                    @if (item.PendingMatchCount > 0)
                                    {
                                        <span class="badge bg-success-subtle text-success border border-success-subtle text-nowrap">
                                            <i class="bi bi-bell-fill me-1"></i>@item.PendingMatchCount yeni ilan
                                        </span>
                                    }
                                    else
                                    {
                                        <span class="text-muted small">—</span>
                                    }
                                    @if (item.NotifiedCount > 0)
                                    {
                                        <div class="text-muted small text-nowrap mt-1">
                                            (@item.NotifiedCount haber verildi)
                                        </div>
                                    }
                                </td>
                                <td>
                                    @if (!string.IsNullOrWhiteSpace(item.AssignedAgentName))
                                    {
                                        <span class="small text-dark fw-medium">@item.AssignedAgentName</span>
                                    }
                                    else
                                    {
                                        <span class="badge bg-light text-secondary border">Atanmamış</span>
                                    }
                                </td>
                                <td>
                                    <span class="badge bg-@ListingAlertLabels.StatusBadge(item.Status)">
                                        @ListingAlertLabels.StatusName(item.Status)
                                    </span>
                                </td>
                                <td>
                                    <small class="text-muted text-nowrap">@item.CreatedDate.ToString("dd.MM.yyyy HH:mm")</small>
                                </td>
                                <td class="text-end pe-3">
                                    <a href="@detailUrl" class="btn btn-outline-primary btn-sm text-nowrap">
                                        <i class="bi bi-eye me-1"></i> Görüntüle
                                    </a>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>

    <!-- Mobil Kart Görünümü (d-md-none) -->
    <div class="d-md-none mb-4">
        @foreach (var item in Model.Response.Items)
        {
            var detailUrl = $"/haber-bekleyenler/{item.ListingAlertId}";
            <div class="card mb-3 shadow-sm border-0">
                <div class="card-body p-3">
                    <div class="d-flex justify-content-between align-items-start mb-2">
                        <div>
                            <span class="badge bg-primary-subtle text-primary border border-primary-subtle me-1">@item.TypeDisplay</span>
                            <span class="badge bg-@ListingAlertLabels.StatusBadge(item.Status)">@ListingAlertLabels.StatusName(item.Status)</span>
                        </div>
                        @if (item.PendingMatchCount > 0)
                        {
                            <span class="badge bg-success-subtle text-success border border-success-subtle">
                                <i class="bi bi-bell-fill me-1"></i>@item.PendingMatchCount yeni
                            </span>
                        }
                    </div>

                    <h6 class="mb-1 fw-bold">
                        <a href="@detailUrl" class="text-dark text-decoration-none">@item.FullName</a>
                    </h6>

                    <div class="small mb-2">
                        <a href="tel:@item.PhoneNumber" class="text-decoration-none text-muted">
                            <i class="bi bi-telephone me-1"></i>@item.PhoneNumber
                        </a>
                    </div>

                    <div class="small text-dark mb-1">
                        <i class="bi bi-geo-alt me-1 text-muted"></i>@item.CityName@(!string.IsNullOrWhiteSpace(item.DistrictName) ? $" / {item.DistrictName}" : "")
                        @if (!string.IsNullOrWhiteSpace(item.RoomCounts))
                        {
                            <span class="text-muted ms-1">(@item.RoomCounts)</span>
                        }
                    </div>

                    <div class="small fw-semibold text-dark mb-2">
                        <i class="bi bi-tag me-1 text-muted"></i>@ListingAlertLabels.PriceRange(item.MinPrice, item.MaxPrice)
                    </div>

                    <div class="d-flex flex-wrap gap-2 small text-muted mb-2 pt-2 border-top">
                        <div>
                            <i class="bi bi-clock me-1"></i>@item.CreatedDate.ToString("dd.MM.yyyy HH:mm")
                        </div>
                        @if (item.NotifiedCount > 0)
                        {
                            <div>
                                <i class="bi bi-check2-all me-1 text-success"></i>@item.NotifiedCount haber verildi
                            </div>
                        }
                    </div>

                    <div class="d-flex justify-content-between align-items-center pt-2 border-top">
                        <span class="small text-muted">
                            <i class="bi bi-person me-1"></i>@(item.AssignedAgentName ?? "Atanmamış")
                        </span>
                        <a href="@detailUrl" class="btn btn-primary btn-sm px-3">
                            <i class="bi bi-eye me-1"></i> İncele
                        </a>
                    </div>
                </div>
            </div>
        }
    </div>

    <!-- Sayfalama ve Bilgi Çubuğu -->
    <div class="d-flex flex-column flex-md-row justify-content-between align-items-center gap-2 mb-4">
        <div class="text-muted small">
            @totalItems kayıttan @startItem–@endItem arası gösteriliyor
        </div>

        @if (totalPages > 1)
        {
            <nav aria-label="Haber bekleyenler sayfalaması">
                <ul class="pagination pagination-sm mb-0">
                    <!-- Önceki Butonu -->
                    <li class="page-item @(currentPage <= 1 ? "disabled" : "")">
                        <a class="page-link" href="@(currentPage > 1 ? Model.PageUrl(currentPage - 1) : "#")" tabindex="@(currentPage <= 1 ? "-1" : "0")" aria-label="Önceki">
                            <span aria-hidden="true">&laquo;</span>
                        </a>
                    </li>

                    @for (int p = startPage; p <= endPage; p++)
                    {
                        <li class="page-item @(p == currentPage ? "active" : "")">
                            <a class="page-link" href="@Model.PageUrl(p)">@p</a>
                        </li>
                    }

                    <!-- Sonraki Butonu -->
                    <li class="page-item @(currentPage >= totalPages ? "disabled" : "")">
                        <a class="page-link" href="@(currentPage < totalPages ? Model.PageUrl(currentPage + 1) : "#")" tabindex="@(currentPage >= totalPages ? "-1" : "0")" aria-label="Sonraki">
                            <span aria-hidden="true">&raquo;</span>
                        </a>
                    </li>
                </ul>
            </nav>
        }
    </div>
}
