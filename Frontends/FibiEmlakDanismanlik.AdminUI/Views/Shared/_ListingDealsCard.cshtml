@model FibiEmlakDanismanlik.AdminUI.Models.Deals.ListingDealsCardModel
@using FibiEmlakDanismanlik.AdminUI.Models.Deals

<!-- İşlemler ve Hak Ediş Kartı -->
<div class="card mb-4 shadow-sm border-0">
    <div class="card-body pt-3">
        <div class="d-flex justify-content-between align-items-center pb-2 border-bottom mb-3">
            <h5 class="card-title p-0 m-0">
                <i class="bi bi-cash-stack me-2 text-primary"></i>İşlemler ve Hak Ediş
            </h5>
            <span class="badge bg-secondary">@(Model?.Deals?.Count ?? 0)</span>
        </div>

        @if (Model?.Deals == null || !Model.Deals.Any())
        {
            <p class="text-muted small mb-0 py-2">Bu ilan için işlem kaydı yok.</p>
        }
        else
        {
            <div class="list-group list-group-flush mb-2">
                @foreach (var deal in Model.Deals)
                {
                    <div class="list-group-item px-0 py-2">
                        <div class="d-flex justify-content-between align-items-start mb-1">
                            <a href="/islemler/@deal.ListingDealId" class="fw-semibold small text-dark text-decoration-none">
                                @(string.IsNullOrWhiteSpace(deal.CustomerName) ? $"İşlem #{deal.ListingDealId}" : deal.CustomerName)
                            </a>
                            <span class="badge bg-@DealLabels.StatusBadge(deal.Status)">
                                @DealLabels.StatusName(deal.Status)
                            </span>
                        </div>

                        <div class="small text-muted mb-1">
                            <i class="bi bi-clock me-1"></i>@DealLabels.Date(deal.DealDate)
                        </div>

                        <div class="small text-muted d-flex flex-column gap-1">
                            <div><span>Anlaşılan:</span> <strong class="text-dark">@DealLabels.Money(deal.AgreedPrice)</strong></div>
                            <div><span>Komisyon:</span> <strong class="text-dark">@DealLabels.Money(deal.TotalCommission)</strong></div>
                            <div><span>Şirket payı:</span> <strong class="text-dark">@DealLabels.Money(deal.CompanyShare)</strong></div>
                        </div>
                    </div>
                }
            </div>
        }

        @if (Model != null && Model.CanCreate)
        {
            <div class="pt-2 @(Model.Deals != null && Model.Deals.Any() ? "border-top" : "")">
                <a class="btn btn-sm btn-primary w-100" href="/islemler/yeni?listingTypeId=@Model.ListingTypeId&listingId=@Model.ListingId">
                    <i class="bi bi-plus-lg me-1"></i>Kapora / işlem kaydı ekle
                </a>
            </div>
        }
        else if (Model?.Deals != null && Model.Deals.Any(d => d.Status == 1))
        {
            <div class="small text-muted border-top pt-2 mt-2">
                <i class="bi bi-info-circle me-1"></i>Açık işlem var; tamamlayın ya da iptal edin.
            </div>
        }
    </div>
</div>
