@model List<FibiEmlakDanismanlik.AdminUI.Models.Leads.LeadRowDto>
@using FibiEmlakDanismanlik.AdminUI.Models.Leads

<!-- Müşteri Talepleri Kartı -->
<div class="card mb-4 shadow-sm border-0">
    <div class="card-body pt-3">
        <div class="d-flex justify-content-between align-items-center pb-2 border-bottom mb-3">
            <h5 class="card-title p-0 m-0">
                <i class="bi bi-chat-square-text me-2 text-primary"></i>Müşteri Talepleri
            </h5>
            <span class="badge bg-secondary">@(Model?.Count ?? 0)</span>
        </div>

        @if (Model == null || !Model.Any())
        {
            <p class="text-muted small mb-0 py-2">Bu ilan için henüz talep yok.</p>
        }
        else
        {
            <div class="list-group list-group-flush">
                @foreach (var lead in Model)
                {
                    <div class="list-group-item px-0 py-2">
                        <div class="d-flex justify-content-between align-items-start mb-1">
                            <span class="fw-semibold small text-dark">@lead.FullName</span>
                            <span class="badge bg-@LeadLabels.StatusBadge(lead.Status)">@LeadLabels.StatusName(lead.Status)</span>
                        </div>
                        <div class="small mb-1">
                            <a href="tel:@lead.Phone" class="text-decoration-none text-muted">
                                <i class="bi bi-telephone me-1"></i>@lead.Phone
                            </a>
                        </div>
                        <div class="d-flex justify-content-between align-items-center small text-muted pt-1">
                            <div>
                                <span title="Oluşturulma Tarihi"><i class="bi bi-clock me-1"></i>@lead.CreatedDate.ToString("dd.MM.yyyy HH:mm")</span>
                                @if (lead.AppointmentDateTime.HasValue)
                                {
                                    <div class="text-warning mt-1" title="Randevu Tarihi">
                                        <i class="bi bi-calendar-event me-1"></i>@lead.AppointmentDateTime.Value.ToString("dd.MM.yyyy HH:mm")
                                    </div>
                                }
                            </div>
                            <a href="/talepler/@LeadLabels.SourceSlug(lead.Source)/@lead.LeadId" class="btn btn-sm btn-outline-primary py-0 px-2 text-nowrap" style="font-size: 0.8rem;">
                                <i class="bi bi-box-arrow-up-right me-1"></i>Aç
                            </a>
                        </div>
                    </div>
                }
            </div>
        }
    </div>
</div>
