@model FibiEmlakDanismanlik.AdminUI.Models.ListingAlerts.ListingAlertsCardModel
@using FibiEmlakDanismanlik.AdminUI.Models.ListingAlerts

<!-- Bu İlanı Bekleyenler Kartı -->
<div class="card mb-4 shadow-sm border-0">
    <div class="card-body pt-3">
        <div class="d-flex justify-content-between align-items-center pb-2 border-bottom mb-3">
            <h5 class="card-title p-0 m-0">
                <i class="bi bi-bell me-2 text-primary"></i>Bu İlanı Bekleyenler
            </h5>
            <span class="badge bg-secondary">@(Model?.Data?.Items?.Count ?? 0)</span>
        </div>

        @if (Model?.Data?.Items == null || !Model.Data.Items.Any())
        {
            <p class="text-muted small mb-0 py-2">Bu ilanın kriterlerine uyan bekleyen yok.</p>
        }
        else
        {
            <div class="list-group list-group-flush">
                @foreach (var alert in Model.Data.Items)
                {
                    <div class="list-group-item px-0 py-2">
                        <div class="d-flex justify-content-between align-items-start mb-1">
                            <a href="/haber-bekleyenler/@alert.ListingAlertId" class="fw-semibold small text-dark text-decoration-none">
                                @alert.FullName
                            </a>
                            @if (alert.MatchStatus.HasValue)
                            {
                                <span class="badge bg-@ListingAlertLabels.MatchStatusBadge(alert.MatchStatus.Value)">
                                    @ListingAlertLabels.MatchStatusName(alert.MatchStatus.Value)
                                </span>
                            }
                        </div>

                        <div class="small mb-1">
                            <a href="tel:@alert.PhoneNumber" class="text-decoration-none text-muted">
                                <i class="bi bi-telephone me-1"></i>@alert.PhoneNumber
                            </a>
                        </div>

                        <div class="d-flex justify-content-between align-items-center small text-muted pt-1 flex-wrap gap-2">
                            <div>
                                <span title="Kayıt Tarihi"><i class="bi bi-clock me-1"></i>@alert.CreatedDate.ToString("dd.MM.yyyy HH:mm")</span>
                                <div class="mt-1">
                                    <i class="bi bi-person me-1"></i>@(alert.AssignedAgentName ?? "Atanmamış")
                                </div>
                            </div>

                            @if (!alert.MatchStatus.HasValue)
                            {
                                <div class="d-flex gap-1">
                                    <form action="/haber-bekleyenler/@alert.ListingAlertId/eslesme" method="post" class="d-inline">
                                        @Html.AntiForgeryToken()
                                        <input type="hidden" name="listingTypeId" value="@Model.ListingTypeId" />
                                        <input type="hidden" name="listingId" value="@Model.ListingId" />
                                        <input type="hidden" name="status" value="1" />
                                        <input type="hidden" name="returnUrl" value="/ilanlar/@Model.ListingTypeId/@Model.ListingId" />
                                        <button type="submit" class="btn btn-sm btn-success py-0 px-2" style="font-size: 0.8rem;" title="Haber verildi olarak işaretle">
                                            <i class="bi bi-check-lg me-1"></i>Haber verildi
                                        </button>
                                    </form>

                                    <form action="/haber-bekleyenler/@alert.ListingAlertId/eslesme" method="post" class="d-inline">
                                        @Html.AntiForgeryToken()
                                        <input type="hidden" name="listingTypeId" value="@Model.ListingTypeId" />
                                        <input type="hidden" name="listingId" value="@Model.ListingId" />
                                        <input type="hidden" name="status" value="2" />
                                        <input type="hidden" name="returnUrl" value="/ilanlar/@Model.ListingTypeId/@Model.ListingId" />
                                        <button type="submit" class="btn btn-sm btn-outline-secondary py-0 px-2" style="font-size: 0.8rem;" title="Uygun değil olarak işaretle">
                                            <i class="bi bi-x-lg me-1"></i>Uygun değil
                                        </button>
                                    </form>
                                </div>
                            }
                        </div>
                    </div>
                }
            </div>
        }

        @if (Model?.Data?.OtherCount > 0)
        {
            <div class="small text-muted border-top pt-2 mt-2">
                <i class="bi bi-info-circle me-1"></i>Size atanmamış @Model.Data.OtherCount kişi daha bu ilanın kriterlerine uyuyor (Sahip/Yönetici görebilir).
            </div>
        }
    </div>
</div>
