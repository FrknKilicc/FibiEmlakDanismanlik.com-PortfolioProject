@inject FibiEmlakDanismanlik.AdminUI.Infrastructure.CurrentAdmin CurrentAdmin
@{
    var currentController = ViewContext.RouteData.Values["controller"]?.ToString() ?? "";
    var currentAction = ViewContext.RouteData.Values["action"]?.ToString() ?? "";
    bool isDashboard = string.Equals(currentController, "Dashboard", StringComparison.OrdinalIgnoreCase);
    var currentTur = Context.Request.Query["tur"].ToString();
    bool isListings = string.Equals(currentController, "Listings", StringComparison.OrdinalIgnoreCase);
    bool isSatilik = isListings && string.Equals(currentTur, "satilik", StringComparison.OrdinalIgnoreCase);
    bool isKiralik = isListings && string.Equals(currentTur, "kiralik", StringComparison.OrdinalIgnoreCase);
    bool isLeads = string.Equals(currentController, "Leads", StringComparison.OrdinalIgnoreCase);
    bool isListingAlerts = string.Equals(currentController, "ListingAlerts", StringComparison.OrdinalIgnoreCase);
    bool isDeals = string.Equals(currentController, "Deals", StringComparison.OrdinalIgnoreCase);
    bool isReports = string.Equals(currentController, "Reports", StringComparison.OrdinalIgnoreCase);
    bool isUsers = string.Equals(currentController, "Users", StringComparison.OrdinalIgnoreCase);
    bool isContent = string.Equals(currentController, "Content", StringComparison.OrdinalIgnoreCase) || string.Equals(currentController, "BlogAdmin", StringComparison.OrdinalIgnoreCase) || string.Equals(currentController, "SiteContent", StringComparison.OrdinalIgnoreCase) || string.Equals(currentController, "BlogAuthors", StringComparison.OrdinalIgnoreCase) || string.Equals(currentController, "BlogCategories", StringComparison.OrdinalIgnoreCase);
    bool isAudit = string.Equals(currentController, "AuditLog", StringComparison.OrdinalIgnoreCase);
    bool isSettings = string.Equals(currentController, "Settings", StringComparison.OrdinalIgnoreCase);
}
<!DOCTYPE html>
<html lang="tr">

<head>
  <meta charset="utf-8">
  <meta content="width=device-width, initial-scale=1.0" name="viewport">

  <title>@ViewData["Title"] | Fibi Yönetim</title>
  <meta name="robots" content="noindex, nofollow">

  <partial name="_ThemeHead" />

  <!-- Favicons -->
  <link href="~/assets/img/favicon.ico" rel="icon">

  <!-- Google Fonts -->
  <link href="https://fonts.gstatic.com" rel="preconnect">
  <link href="https://fonts.googleapis.com/css?family=Open+Sans:300,300i,400,400i,600,600i,700,700i|Nunito:300,300i,400,400i,600,600i,700,700i|Poppins:300,300i,400,400i,500,500i,600,600i,700,700i" rel="stylesheet">

  <!-- Vendor CSS Files -->
  <link href="~/assets/vendor/bootstrap/css/bootstrap.min.css" rel="stylesheet">
  <link href="~/assets/vendor/bootstrap-icons/bootstrap-icons.css" rel="stylesheet">
  <link href="~/assets/vendor/boxicons/css/boxicons.min.css" rel="stylesheet">
  <link href="~/assets/vendor/remixicon/remixicon.css" rel="stylesheet">
  <link href="~/assets/vendor/simple-datatables/style.css" rel="stylesheet">

  <!-- Template Main CSS File -->
  <link href="~/assets/css/style.css" rel="stylesheet">
  <link href="~/css/admin.css" rel="stylesheet" asp-append-version="true">
  @await RenderSectionAsync("Styles", required: false)
  <link href="~/css/theme.css" rel="stylesheet" asp-append-version="true">
</head>

<body>

  <!-- ======= Header ======= -->
  <header id="header" class="header fixed-top d-flex align-items-center">

    <div class="d-flex align-items-center justify-content-between">
      <a href="/" class="logo d-flex align-items-center">
        <img src="~/assets/img/logo.png" alt="Fibi Logo">
        <span class="d-none d-lg-block">Fibi Yönetim</span>
      </a>
      <i class="bi bi-list toggle-sidebar-btn" title="Menüyü Daralt/Genişlet"></i>
    </div><!-- End Logo -->

    <nav class="header-nav ms-auto">
      <ul class="d-flex align-items-center">

        <li class="nav-item dropdown">
          <button class="btn btn-link nav-link nav-icon border-0" id="themeToggle" type="button" data-bs-toggle="dropdown" aria-expanded="false" aria-label="Tema seç" title="Tema">
            <i class="bi bi-circle-half"></i>
          </button>
          <ul class="dropdown-menu dropdown-menu-end dropdown-menu-arrow" aria-labelledby="themeToggle">
            <li>
              <button type="button" class="dropdown-item d-flex align-items-center gap-2" data-theme-value="light">
                <i class="bi bi-sun"></i>
                <span>Açık</span>
                <i class="bi bi-check2 ms-auto theme-check d-none"></i>
              </button>
            </li>
            <li>
              <button type="button" class="dropdown-item d-flex align-items-center gap-2" data-theme-value="dark">
                <i class="bi bi-moon-stars"></i>
                <span>Koyu</span>
                <i class="bi bi-check2 ms-auto theme-check d-none"></i>
              </button>
            </li>
            <li>
              <button type="button" class="dropdown-item d-flex align-items-center gap-2" data-theme-value="auto">
                <i class="bi bi-circle-half"></i>
                <span>Sistem</span>
                <i class="bi bi-check2 ms-auto theme-check d-none"></i>
              </button>
            </li>
          </ul>
        </li>

        <li class="nav-item dropdown pe-3">

          <a class="nav-link nav-profile d-flex align-items-center pe-0" href="#" data-bs-toggle="dropdown">
            <i class="bi bi-person-circle fs-4 text-secondary"></i>
            <span class="d-none d-md-block dropdown-toggle ps-2">@CurrentAdmin.Name</span>
          </a><!-- End Profile Icon -->

          <ul class="dropdown-menu dropdown-menu-end dropdown-menu-arrow profile">
            <li class="dropdown-header">
              <h6>@CurrentAdmin.Name</h6>
              <span>@CurrentAdmin.RoleDisplayName</span>
            </li>
            <li>
              <hr class="dropdown-divider">
            </li>

            <li><a class="dropdown-item d-flex align-items-center py-2" href="/hesabim"><i class="bi bi-person-gear me-2"></i><span>Hesabım</span></a></li><li><hr class="dropdown-divider"></li>

            <li>
              <form action="/cikis" method="post" class="w-100 m-0 p-0">
                @Html.AntiForgeryToken()
                <button type="submit" class="dropdown-item d-flex align-items-center text-danger py-2 border-0 bg-transparent">
                  <i class="bi bi-box-arrow-right me-2"></i>
                  <span>Çıkış Yap</span>
                </button>
              </form>
            </li>

          </ul><!-- End Profile Dropdown Items -->
        </li><!-- End Profile Nav -->

      </ul>
    </nav><!-- End Icons Navigation -->

  </header><!-- End Header -->

  <!-- ======= Sidebar ======= -->
  <aside id="sidebar" class="sidebar">

    <ul class="sidebar-nav" id="sidebar-nav">

      <li class="nav-item">
        <a class="nav-link @(isDashboard ? "" : "collapsed")" href="/">
          <i class="bi bi-grid"></i>
          <span>Kontrol Paneli</span>
        </a>
      </li><!-- End Dashboard Nav -->

      <li class="nav-heading">İlanlar</li>

      <li class="nav-item">
        <a class="nav-link @(isSatilik ? "" : "collapsed")" href="/ilanlar?tur=satilik">
          <i class="bi bi-house-door"></i>
          <span>Satılık İlanlar</span>
        </a>
      </li>

      <li class="nav-item">
        <a class="nav-link @(isKiralik ? "" : "collapsed")" href="/ilanlar?tur=kiralik">
          <i class="bi bi-key"></i>
          <span>Kiralık İlanlar</span>
        </a>
      </li>

      <li class="nav-item">
        <a class="nav-link @(isLeads ? "" : "collapsed")" href="/talepler">
          <i class="bi bi-chat-square-text"></i>
          <span>Talepler</span>
        </a>
      </li>

      <li class="nav-item">
        <a class="nav-link @(isListingAlerts ? "" : "collapsed")" href="/haber-bekleyenler">
          <i class="bi bi-bell"></i>
          <span>Haber Bekleyenler</span>
        </a>
      </li>

      @if (CurrentAdmin.IsManagerOrAbove)
      {
        <li class="nav-item">
          <a class="nav-link @(isDeals ? "" : "collapsed")" href="/islemler">
            <i class="bi bi-cash-stack"></i>
            <span>İşlemler ve Hak Ediş</span>
          </a>
        </li>

        <li class="nav-item">
          <a class="nav-link @(isReports ? "" : "collapsed")" href="/raporlar">
            <i class="bi bi-bar-chart-line"></i>
            <span>Raporlar</span>
          </a>
        </li>

        <li class="nav-heading">Yönetim</li>

        <li class="nav-item">
          <a class="nav-link @(isUsers ? "" : "collapsed")" href="/kullanicilar">
            <i class="bi bi-people"></i>
            <span>Kullanıcılar</span>
          </a>
        </li>

        <li class="nav-item">
          <a class="nav-link @(isContent ? "" : "collapsed")" href="/icerik">
            <i class="bi bi-file-earmark-text"></i>
            <span>İçerik</span>
          </a>
        </li>

        <li class="nav-item">
          <a class="nav-link @(isAudit ? "" : "collapsed")" href="/denetim-kaydi">
            <i class="bi bi-shield-check"></i>
            <span>Denetim Kaydı</span>
          </a>
        </li>
@if (CurrentAdmin.IsOwner)
{
  <li class="nav-item">
    <a class="nav-link @(isSettings ? "" : "collapsed")" href="/ayarlar">
      <i class="bi bi-gear"></i>
      <span>Ayarlar</span>
    </a>
  </li>
}
      }

    </ul>

  </aside><!-- End Sidebar-->

  <main id="main" class="main">
    @RenderBody()
  </main><!-- End #main -->

  <!-- Ortak Silme Onayı Modal -->
  <div class="modal fade" id="confirmModal" tabindex="-1" aria-labelledby="confirmModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
      <div class="modal-content">
        <div class="modal-header">
          <h5 class="modal-title" id="confirmModalLabel">Silme onayı</h5>
          <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Kapat"></button>
        </div>
        <div class="modal-body">
          <p id="confirmModalText" class="mb-0"></p>
        </div>
        <div class="modal-footer">
          <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Vazgeç</button>
          <button type="button" class="btn btn-danger" id="confirmModalOk">Evet, sil</button>
        </div>
      </div>
    </div>
  </div>

  <!-- ======= Footer ======= -->
  <footer id="footer" class="footer">
    <div class="copyright">
      &copy; @DateTime.UtcNow.Year <strong><span>Fibi Yapı Emlak & Danışmanlık</span></strong>. Tüm Hakları Saklıdır
    </div>
    <div class="credits">
      <!-- All the links in the footer should remain intact. -->
      <!-- You can delete the links only if you purchased the pro version. -->
      <!-- Licensing information: https://bootstrapmade.com/license/ -->
      <!-- Purchase the pro version with working PHP/AJAX contact form: https://bootstrapmade.com/nice-admin-bootstrap-admin-html-template/ -->
      Designed by <a href="https://bootstrapmade.com/">BootstrapMade</a>
    </div>
  </footer><!-- End Footer -->

  <a href="#" class="back-to-top d-flex align-items-center justify-content-center"><i class="bi bi-arrow-up-short"></i></a>

  <!-- Vendor JS Files -->
  <script src="~/assets/vendor/bootstrap/js/bootstrap.bundle.min.js"></script>

  <!-- Template Main JS File -->
  <script src="~/assets/js/main.js"></script>
  <script src="~/js/confirm-modal.js" asp-append-version="true"></script>

  @await RenderSectionAsync("Scripts", required: false)

  <script src="~/js/theme.js" asp-append-version="true"></script>

</body>

</html>
