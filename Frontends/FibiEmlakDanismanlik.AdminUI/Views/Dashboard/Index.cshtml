@model FibiEmlakDanismanlik.AdminUI.Models.Dashboard.DashboardViewModel
@inject FibiEmlakDanismanlik.AdminUI.Infrastructure.CurrentAdmin CurrentAdmin
@using FibiEmlakDanismanlik.AdminUI.Models.Deals
@using System.Globalization

@{
    ViewData["Title"] = "Kontrol Paneli";

    string FormatDateTr(string? d)
    {
        if (!string.IsNullOrWhiteSpace(d))
        {
            var trimmed = d.Trim();
            var part = trimmed.Length >= 10 ? trimmed.Substring(0, 10) : trimmed;
            if (DateTime.TryParseExact(part, "yyyy-MM-dd", CultureInfo.InvariantCulture, DateTimeStyles.None, out var dt))
            {
                return dt.ToString("dd.MM.yyyy");
            }
            if (DateTime.TryParse(trimmed, CultureInfo.InvariantCulture, DateTimeStyles.None, out var parsedDt))
            {
                return parsedDt.ToString("dd.MM.yyyy");
            }
            return trimmed;
        }
        return "";
    }

    var fromText = FormatDateTr(Model.Data?.From ?? Model.Baslangic);
    var toText = FormatDateTr(Model.Data?.To ?? Model.Bitis);
    var rangeText = (!string.IsNullOrWhiteSpace(fromText) && !string.IsNullOrWhiteSpace(toText))
        ? $"{fromText} – {toText}"
        : (!string.IsNullOrWhiteSpace(fromText) ? $"{fromText} sonrası" : (!string.IsNullOrWhiteSpace(toText) ? $"{toText} öncesi" : ""));

    var activeCount = 0;
    if (Model.Data?.Listings?.ByStatus != null)
    {
        activeCount = Model.Data.Listings.ByStatus.GetValueOrDefault("Aktif", 0) +
                      Model.Data.Listings.ByStatus.GetValueOrDefault("Opsiyonlu", 0);
    }
}

<div class="pagetitle d-flex flex-wrap justify-content-between align-items-center gap-2 mb-3">
    <div>
        <h1 class="mb-1">Kontrol Paneli</h1>
        <div class="text-muted small">Hoş geldiniz, @CurrentAdmin.Name (@CurrentAdmin.RoleDisplayName)</div>
    </div>
    <div class="d-flex flex-column align-items-sm-end gap-1">
        <form method="get" action="/" class="d-flex flex-wrap align-items-center gap-2">
            <div class="d-flex align-items-center gap-1">
                <label for="filterBaslangic" class="small text-muted mb-0">Başlangıç:</label>
                <input type="date" class="form-control form-control-sm" id="filterBaslangic" name="baslangic" value="@Model.Baslangic" />
            </div>
            <div class="d-flex align-items-center gap-1">
                <label for="filterBitis" class="small text-muted mb-0">Bitiş:</label>
                <input type="date" class="form-control form-control-sm" id="filterBitis" name="bitis" value="@Model.Bitis" />
            </div>
            <button type="submit" class="btn btn-sm btn-primary px-3">Uygula</button>
            @if (!string.IsNullOrWhiteSpace(Model.Baslangic) || !string.IsNullOrWhiteSpace(Model.Bitis))
            {
                <a href="/" class="btn btn-sm btn-outline-secondary">Temizle</a>
            }
        </form>
        @if (!string.IsNullOrWhiteSpace(rangeText))
        {
            <div class="text-muted small">
                <i class="bi bi-calendar3 me-1"></i>Aralık: @rangeText
            </div>
        }
    </div>
</div>

@if (Model.SyncFailures != null && Model.SyncFailures.Count > 0)
{
    <div class="alert alert-warning alert-dismissible fade show mb-4" role="alert">
        <div class="d-flex align-items-center mb-2">
            <i class="bi bi-exclamation-triangle-fill flex-shrink-0 me-2 fs-5"></i>
            <h5 class="alert-heading fs-6 fw-bold mb-0">Veri senkronizasyonu hatası</h5>
        </div>
        <ul class="mb-0 ps-3">
            @foreach (var failure in Model.SyncFailures)
            {
                DateTime trTime;
                try
                {
                    var tz = TimeZoneInfo.FindSystemTimeZoneById(OperatingSystem.IsWindows() ? "Turkey Standard Time" : "Europe/Istanbul");
                    if (failure.FinishedAt.Kind == DateTimeKind.Utc)
                    {
                        trTime = TimeZoneInfo.ConvertTimeFromUtc(failure.FinishedAt, tz);
                    }
                    else if (failure.FinishedAt.Kind == DateTimeKind.Local)
                    {
                        trTime = TimeZoneInfo.ConvertTime(failure.FinishedAt, tz);
                    }
                    else
                    {
                        if (TimeZoneInfo.Local.BaseUtcOffset == TimeSpan.FromHours(3))
                        {
                            trTime = failure.FinishedAt;
                        }
                        else
                        {
                            trTime = TimeZoneInfo.ConvertTime(DateTime.SpecifyKind(failure.FinishedAt, DateTimeKind.Local), tz);
                        }
                    }
                }
                catch
                {
                    trTime = failure.FinishedAt;
                }
                var message = failure.Message ?? string.Empty;
                if (message.Length > 200)
                {
                    message = message.Substring(0, 200);
                }
                <li>@failure.ProviderKey — @trTime.ToString("dd.MM.yyyy HH:mm") — @message</li>
            }
        </ul>
        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Kapat"></button>
    </div>
}

@if (!string.IsNullOrWhiteSpace(Model.ErrorMessage))
{
    <div class="alert alert-danger alert-dismissible fade show d-flex align-items-center mb-4" role="alert">
        <i class="bi bi-exclamation-triangle-fill flex-shrink-0 me-2 fs-5"></i>
        <div>@Model.ErrorMessage</div>
        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Kapat"></button>
    </div>
}

<!-- Sayaç Kartları -->
<section class="section dashboard pb-0">
    <div class="row g-2 g-md-3 mb-4">
        <!-- 1. Aktif İlan -->
        <div class="col-xxl-3 col-md-6 col-6">
            <div class="card info-card h-100 hover-card mb-0 shadow-sm border-0">
                <div class="card-body p-3">
                    <div class="text-muted small fw-semibold text-truncate mb-1">Aktif ilan</div>
                    <div class="d-flex align-items-center">
                        <div class="card-icon rounded-circle d-flex align-items-center justify-content-center flex-shrink-0 text-primary bg-primary-subtle" style="width: 40px; height: 40px; min-width: 40px; font-size: 1.2rem;">
                            <i class="bi bi-house-check"></i>
                        </div>
                        <div class="ps-2 min-w-0">
                            <h6 class="fs-5 fw-bold mb-0 lh-1">
                                <span class="js-counter" data-count="@activeCount">@activeCount</span>
                            </h6>
                            <span class="text-muted small text-truncate d-block pt-1">
                                Satılık @(Model.Data?.Listings.SaleTotal ?? 0) · Kiralık @(Model.Data?.Listings.RentTotal ?? 0)
                            </span>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <!-- 2. Yeni Talep (7 Gün) -->
        <div class="col-xxl-3 col-md-6 col-6">
            <div class="card info-card h-100 hover-card mb-0 shadow-sm border-0">
                <div class="card-body p-3">
                    <div class="text-muted small fw-semibold text-truncate mb-1">Yeni talep (7 gün)</div>
                    <div class="d-flex align-items-center">
                        <div class="card-icon rounded-circle d-flex align-items-center justify-content-center flex-shrink-0 text-info bg-info-subtle" style="width: 40px; height: 40px; min-width: 40px; font-size: 1.2rem;">
                            <i class="bi bi-chat-left-dots"></i>
                        </div>
                        <div class="ps-2 min-w-0">
                            <h6 class="fs-5 fw-bold mb-0 lh-1">
                                <span class="js-counter" data-count="@(Model.Data?.Leads.NewLast7Days ?? 0)">@(Model.Data?.Leads.NewLast7Days ?? 0)</span>
                            </h6>
                            <span class="text-muted small text-truncate d-block pt-1">
                                Toplam @(Model.Data?.Leads.Total ?? 0) talep
                            </span>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <!-- 3. Bugünkü Randevu -->
        <div class="col-xxl-3 col-md-6 col-6">
            <div class="card info-card h-100 hover-card mb-0 shadow-sm border-0">
                <div class="card-body p-3">
                    <div class="text-muted small fw-semibold text-truncate mb-1">Bugünkü randevu</div>
                    <div class="d-flex align-items-center">
                        <div class="card-icon rounded-circle d-flex align-items-center justify-content-center flex-shrink-0 text-warning bg-warning-subtle" style="width: 40px; height: 40px; min-width: 40px; font-size: 1.2rem;">
                            <i class="bi bi-calendar-check"></i>
                        </div>
                        <div class="ps-2 min-w-0">
                            <h6 class="fs-5 fw-bold mb-0 lh-1">
                                <span class="js-counter" data-count="@(Model.Data?.LeadStats.TodayAppointments ?? 0)">@(Model.Data?.LeadStats.TodayAppointments ?? 0)</span>
                            </h6>
                            <span class="text-muted small text-truncate d-block pt-1">
                                7 gün içinde @(Model.Data?.LeadStats.UpcomingAppointments7Days ?? 0)
                            </span>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <!-- 4. Haber Bekleyen -->
        <div class="col-xxl-3 col-md-6 col-6">
            <div class="card info-card h-100 hover-card mb-0 shadow-sm border-0">
                <div class="card-body p-3">
                    <div class="text-muted small fw-semibold text-truncate mb-1">Haber bekleyen</div>
                    <div class="d-flex align-items-center">
                        <div class="card-icon rounded-circle d-flex align-items-center justify-content-center flex-shrink-0 text-secondary bg-secondary-subtle" style="width: 40px; height: 40px; min-width: 40px; font-size: 1.2rem;">
                            <i class="bi bi-bell"></i>
                        </div>
                        <div class="ps-2 min-w-0">
                            <h6 class="fs-5 fw-bold mb-0 lh-1">
                                <span class="js-counter" data-count="@(Model.Data?.Alerts.Active ?? 0)">@(Model.Data?.Alerts.Active ?? 0)</span>
                            </h6>
                            <span class="text-muted small text-truncate d-block pt-1">
                                @(Model.Data?.Alerts.ActiveWithPending ?? 0) yeni eşleşmeli
                            </span>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        @if (Model.CanSeeFinance && Model.Data?.Finance != null)
        {
            var fin = Model.Data.Finance;
            <!-- 5. Bu Ay Kapora -->
            <div class="col-xxl-3 col-md-6 col-6">
                <div class="card info-card h-100 hover-card mb-0 shadow-sm border-0">
                    <div class="card-body p-3">
                        <div class="text-muted small fw-semibold text-truncate mb-1">Bu ay kapora</div>
                        <div class="d-flex align-items-center">
                            <div class="card-icon rounded-circle d-flex align-items-center justify-content-center flex-shrink-0 text-warning bg-warning-subtle" style="width: 40px; height: 40px; min-width: 40px; font-size: 1.2rem;">
                                <i class="bi bi-hourglass-split"></i>
                            </div>
                            <div class="ps-2 min-w-0">
                                <h6 class="fs-5 fw-bold mb-0 lh-1">
                                    <span class="js-counter" data-count="@fin.ThisMonth.DepositCount">@fin.ThisMonth.DepositCount</span>
                                </h6>
                                <span class="text-muted small text-truncate d-block pt-1">
                                    @DealLabels.Money(fin.ThisMonth.DepositTotal)
                                </span>
                            </div>
                        </div>
                    </div>
                </div>
            </div>

            <!-- 6. Bu Ay Tamamlanan -->
            <div class="col-xxl-3 col-md-6 col-6">
                <div class="card info-card h-100 hover-card mb-0 shadow-sm border-0">
                    <div class="card-body p-3">
                        <div class="text-muted small fw-semibold text-truncate mb-1">Bu ay tamamlanan</div>
                        <div class="d-flex align-items-center">
                            <div class="card-icon rounded-circle d-flex align-items-center justify-content-center flex-shrink-0 text-success bg-success-subtle" style="width: 40px; height: 40px; min-width: 40px; font-size: 1.2rem;">
                                <i class="bi bi-check2-circle"></i>
                            </div>
                            <div class="ps-2 min-w-0">
                                <h6 class="fs-5 fw-bold mb-0 lh-1">
                                    <span class="js-counter" data-count="@fin.ThisMonth.CompletedCount">@fin.ThisMonth.CompletedCount</span>
                                </h6>
                                <span class="text-muted small text-truncate d-block pt-1">
                                    @DealLabels.Money(fin.ThisMonth.CompletedCommission)
                                </span>
                            </div>
                        </div>
                    </div>
                </div>
            </div>

            <!-- 7. Aralıkta Komisyon -->
            <div class="col-xxl-3 col-md-6 col-6">
                <div class="card info-card h-100 hover-card mb-0 shadow-sm border-0">
                    <div class="card-body p-3">
                        <div class="text-muted small fw-semibold text-truncate mb-1">Aralıkta komisyon</div>
                        <div class="d-flex align-items-center">
                            <div class="card-icon rounded-circle d-flex align-items-center justify-content-center flex-shrink-0 text-primary bg-primary-subtle" style="width: 40px; height: 40px; min-width: 40px; font-size: 1.2rem;">
                                <i class="bi bi-cash-stack"></i>
                            </div>
                            <div class="ps-2 min-w-0">
                                <h6 class="fs-6 fw-bold mb-0 lh-1 text-truncate">
                                    <span class="js-counter" data-count="@((long)Math.Round(fin.Range.CompletedCommissionTotal))" data-money="1">@DealLabels.Money(fin.Range.CompletedCommissionTotal)</span>
                                </h6>
                                <span class="text-muted small text-truncate d-block pt-1">
                                    Net: @DealLabels.Money(fin.Range.CompanyShareTotal)
                                </span>
                            </div>
                        </div>
                    </div>
                </div>
            </div>

            <!-- 8. Ödenecek Prim -->
            <div class="col-xxl-3 col-md-6 col-6">
                <div class="card info-card h-100 hover-card mb-0 shadow-sm border-0">
                    <div class="card-body p-3">
                        <div class="text-muted small fw-semibold text-truncate mb-1">Ödenecek prim</div>
                        <div class="d-flex align-items-center">
                            <div class="card-icon rounded-circle d-flex align-items-center justify-content-center flex-shrink-0 text-danger bg-danger-subtle" style="width: 40px; height: 40px; min-width: 40px; font-size: 1.2rem;">
                                <i class="bi bi-wallet2"></i>
                            </div>
                            <div class="ps-2 min-w-0">
                                <h6 class="fs-6 fw-bold mb-0 lh-1 text-truncate">
                                    <span class="js-counter" data-count="@((long)Math.Round(fin.Range.PendingSharesTotal))" data-money="1">@DealLabels.Money(fin.Range.PendingSharesTotal)</span>
                                </h6>
                                <span class="text-muted small text-truncate d-block pt-1">
                                    Dağıtılan: @DealLabels.Money(fin.Range.CompletedSharesTotal)
                                </span>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        }
    </div>
</section>

<!-- Grafik Bölümü -->
<section class="section dashboard">
    <div class="row g-3 mb-4">
        @if (Model.CanSeeFinance)
        {
            <!-- Aylık İşlem ve Komisyon -->
            <div class="col-12 col-xl-8">
                <div class="card border-0 shadow-sm h-100">
                    <div class="card-header bg-transparent border-0 pt-3 pb-0 d-flex justify-content-between align-items-center">
                        <h5 class="card-title p-0 m-0 fs-6">Aylık işlem ve komisyon (son 12 ay)</h5>
                    </div>
                    <div class="card-body pt-2">
                        <div class="chart-box">
                            <canvas id="chartMonthly"></canvas>
                        </div>
                    </div>
                </div>
            </div>

            <!-- İlan Dağılımı -->
            <div class="col-12 col-xl-4">
                <div class="card border-0 shadow-sm h-100">
                    <div class="card-header bg-transparent border-0 pt-3 pb-0 d-flex justify-content-between align-items-center">
                        <h5 class="card-title p-0 m-0 fs-6">İlan dağılımı</h5>
                    </div>
                    <div class="card-body pt-2">
                        <div class="chart-box">
                            <canvas id="chartListings"></canvas>
                        </div>
                    </div>
                </div>
            </div>

            <!-- Talep Hunisi -->
            <div class="col-12 col-lg-6">
                <div class="card border-0 shadow-sm h-100">
                    <div class="card-header bg-transparent border-0 pt-3 pb-0 d-flex justify-content-between align-items-center">
                        <h5 class="card-title p-0 m-0 fs-6">Talep hunisi (aralıkta)</h5>
                    </div>
                    <div class="card-body pt-2">
                        <div class="chart-box">
                            <canvas id="chartFunnel"></canvas>
                        </div>
                    </div>
                </div>
            </div>

            <!-- Danışman Performansı -->
            <div class="col-12 col-lg-6">
                <div class="card border-0 shadow-sm h-100">
                    <div class="card-header bg-transparent border-0 pt-3 pb-0 d-flex justify-content-between align-items-center">
                        <h5 class="card-title p-0 m-0 fs-6">Danışman performansı</h5>
                    </div>
                    <div class="card-body pt-2">
                        <div class="chart-box">
                            <canvas id="chartAgents"></canvas>
                        </div>
                    </div>
                </div>
            </div>
        }
        else
        {
            <!-- Danışman için İlan Dağılımı -->
            <div class="col-12 col-md-6">
                <div class="card border-0 shadow-sm h-100">
                    <div class="card-header bg-transparent border-0 pt-3 pb-0 d-flex justify-content-between align-items-center">
                        <h5 class="card-title p-0 m-0 fs-6">İlan dağılımı</h5>
                    </div>
                    <div class="card-body pt-2">
                        <div class="chart-box">
                            <canvas id="chartListings"></canvas>
                        </div>
                    </div>
                </div>
            </div>

            <!-- Danışman için Talep Hunisi -->
            <div class="col-12 col-md-6">
                <div class="card border-0 shadow-sm h-100">
                    <div class="card-header bg-transparent border-0 pt-3 pb-0 d-flex justify-content-between align-items-center">
                        <h5 class="card-title p-0 m-0 fs-6">Talep hunisi (aralıkta)</h5>
                    </div>
                    <div class="card-body pt-2">
                        <div class="chart-box">
                            <canvas id="chartFunnel"></canvas>
                        </div>
                    </div>
                </div>
            </div>

            <!-- Danışman Performansı (Kendi satırı) -->
            <div class="col-12">
                <div class="card border-0 shadow-sm h-100">
                    <div class="card-header bg-transparent border-0 pt-3 pb-0 d-flex justify-content-between align-items-center">
                        <h5 class="card-title p-0 m-0 fs-6">Danışman performansı</h5>
                    </div>
                    <div class="card-body pt-2">
                        <div class="chart-box">
                            <canvas id="chartAgents"></canvas>
                        </div>
                    </div>
                </div>
            </div>
        }

        <!-- En Çok Talep Alan İlanlar -->
        <div class="col-12">
            <div class="card border-0 shadow-sm">
                <div class="card-header bg-transparent border-0 pt-3 pb-0 d-flex justify-content-between align-items-center">
                    <h5 class="card-title p-0 m-0 fs-6">En çok talep alan ilanlar</h5>
                    <span class="text-muted small">Seçili aralıkta</span>
                </div>
                <div class="card-body pt-2">
                    @if (Model.Data?.TopListings != null && Model.Data.TopListings.Any())
                    {
                        <div class="table-responsive">
                            <table class="table table-hover align-middle mb-0">
                                <thead class="table-light text-muted small text-uppercase">
                                    <tr>
                                        <th scope="col" class="ps-2">İlan</th>
                                        <th scope="col" class="text-end pe-2">Talep Sayısı</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    @foreach (var item in Model.Data.TopListings)
                                    {
                                        <tr>
                                            <td class="ps-2">
                                                <a href="/ilanlar/@item.ListingTypeId/@item.ListingId" class="fw-semibold text-dark text-decoration-none">
                                                    @item.ListingTitle
                                                </a>
                                                <div class="text-muted small">#@item.ListingId</div>
                                            </td>
                                            <td class="text-end pe-2">
                                                <span class="badge bg-primary-subtle text-primary border border-primary-subtle px-2 py-1 fs-6">
                                                    @item.LeadCount
                                                </span>
                                            </td>
                                        </tr>
                                    }
                                </tbody>
                            </table>
                        </div>
                    }
                    else
                    {
                        <p class="text-muted small mb-0 py-3 text-center">Bu aralıkta ilan talebi yok.</p>
                    }
                </div>
            </div>
        </div>
    </div>
</section>

@{
    var json = Model.Data != null
        ? System.Text.Json.JsonSerializer.Serialize(Model.Data, new System.Text.Json.JsonSerializerOptions
        {
            PropertyNamingPolicy = System.Text.Json.JsonNamingPolicy.CamelCase
        })
        : "null";
}
<script type="application/json" id="dashboard-data">@Html.Raw(json)</script>

@section Scripts {
    <script src="~/assets/vendor/chart.js/chart.umd.js"></script>
    <script src="~/js/dashboard.js" asp-append-version="true"></script>
}
