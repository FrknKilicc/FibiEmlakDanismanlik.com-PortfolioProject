@model FibiEmlakDanismanlik.AdminUI.Models.Content.BlogAuthorsViewModel
@using FibiEmlakDanismanlik.AdminUI.Models.Content
@inject FibiEmlakDanismanlik.AdminUI.Infrastructure.SiteImageUrl SiteImageUrl

@{
    ViewData["Title"] = "Blog Yazarları";
}

<div class="pagetitle d-flex flex-wrap justify-content-between align-items-center gap-2 mb-3">
    <div>
        <h1>Blog Yazarları</h1>
        <nav>
            <ol class="breadcrumb mb-0">
                <li class="breadcrumb-item"><a href="/">Ana Sayfa</a></li>
                <li class="breadcrumb-item"><a href="/icerik">İçerik</a></li>
                <li class="breadcrumb-item"><a href="/icerik/blog">Blog</a></li>
                <li class="breadcrumb-item active">Yazarlar</li>
            </ol>
        </nav>
    </div>
    <div>
        <a href="/icerik/blog" class="btn btn-outline-secondary btn-sm">
            <i class="bi bi-arrow-left me-1"></i> Blog Yazılarına Dön
        </a>
    </div>
</div>

@if (TempData["Success"] != null)
{
    <div class="alert alert-success alert-dismissible fade show d-flex align-items-center mb-4" role="alert">
        <i class="bi bi-check-circle-fill flex-shrink-0 me-2 fs-5"></i>
        <div>@TempData["Success"]</div>
        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Kapat"></button>
    </div>
}

@if (TempData["Error"] != null)
{
    <div class="alert alert-danger alert-dismissible fade show d-flex align-items-center mb-4" role="alert">
        <i class="bi bi-exclamation-triangle-fill flex-shrink-0 me-2 fs-5"></i>
        <div>@TempData["Error"]</div>
        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Kapat"></button>
    </div>
}

@if (!string.IsNullOrWhiteSpace(Model.ErrorMessage))
{
    <div class="alert alert-danger alert-dismissible fade show d-flex align-items-center mb-4" role="alert">
        <i class="bi bi-exclamation-triangle-fill flex-shrink-0 me-2 fs-5"></i>
        <div>@Model.ErrorMessage</div>
        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Kapat"></button>
    </div>
}

<!-- Yazarlar Listesi Kartı -->
<div class="card border-0 shadow-sm mb-4">
    <div class="card-body p-0">
        @if (Model.Authors == null || !Model.Authors.Any())
        {
            <div class="text-center py-5">
                <i class="bi bi-people fs-1 text-muted d-block mb-2"></i>
                <h6 class="fw-semibold text-secondary">Henüz kayıtlı yazar bulunmuyor.</h6>
                <p class="text-muted small mb-0">Aşağıdaki formu kullanarak yeni bir yazar ekleyebilirsiniz.</p>
            </div>
        }
        else
        {
            <div class="table-responsive">
                <table class="table table-hover align-middle mb-0">
                    <thead class="table-light text-muted small text-uppercase">
                        <tr>
                            <th scope="col" class="ps-3" style="width: 60px;">Görsel</th>
                            <th scope="col">Yazar Adı</th>
                            <th scope="col" class="text-center" style="width: 140px;">Yazı Sayısı</th>
                            <th scope="col" class="text-end pe-3" style="width: 220px;">İşlemler</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var author in Model.Authors)
                        {
                            var previewUrl = SiteImageUrl.Preview(author.AuthorImgUrl);
                            var isEditing = Model.EditingId.HasValue && Model.EditingId.Value == author.AuthorId;
                            var editNameError = isEditing ? Model.GetFieldError("edit", "AuthorName") : null;
                            var editImgError = isEditing ? Model.GetFieldError("edit", "AuthorImgUrl") : null;

                            <tr>
                                <td class="ps-3">
                                    @if (!string.IsNullOrEmpty(previewUrl))
                                    {
                                        <img src="@previewUrl"
                                             alt="@author.AuthorName"
                                             class="rounded-circle border"
                                             style="width: 40px; height: 40px; object-fit: cover;" />
                                    }
                                    else
                                    {
                                        <div class="rounded-circle border bg-light d-flex align-items-center justify-content-center text-muted"
                                             style="width: 40px; height: 40px;">
                                            <i class="bi bi-person-circle fs-4"></i>
                                        </div>
                                    }
                                </td>
                                <td>
                                    <span class="fw-semibold text-dark">@author.AuthorName</span>
                                </td>
                                <td class="text-center">
                                    <span class="badge bg-secondary-subtle text-secondary border">
                                        @author.BlogCount yazı
                                    </span>
                                </td>
                                <td class="text-end pe-3">
                                    <div class="d-inline-flex justify-content-end gap-2">
                                        <!-- Satır Düzenleme -->
                                        <details class="text-start position-relative" @(isEditing ? "open" : "")>
                                            <summary class="btn btn-outline-primary btn-sm py-1 px-2" style="cursor: pointer; list-style: none;">
                                                <i class="bi bi-pencil me-1"></i> Düzenle
                                            </summary>
                                            <div class="border rounded p-3 bg-light mt-2 shadow-sm position-absolute end-0" style="min-width: 290px; max-width: 340px; z-index: 1000;">
                                                <form method="post" action="/icerik/blog/yazarlar/@author.AuthorId">
                                                    @Html.AntiForgeryToken()
                                                    <div class="mb-2">
                                                        <label class="form-label small fw-semibold mb-1" for="authorName_@author.AuthorId">
                                                            Yazar Adı <span class="text-danger">*</span>
                                                        </label>
                                                        <input type="text"
                                                               class="form-control form-control-sm @(editNameError != null ? "is-invalid" : "")"
                                                               id="authorName_@author.AuthorId"
                                                               name="AuthorName"
                                                               value="@author.AuthorName"
                                                               required />
                                                        @if (editNameError != null)
                                                        {
                                                            <div class="invalid-feedback d-block small">@editNameError</div>
                                                        }
                                                    </div>
                                                    <div class="mb-2">
                                                        <label class="form-label small fw-semibold mb-1" for="authorImg_@author.AuthorId">
                                                            Görsel URL
                                                        </label>
                                                        <input type="text"
                                                               class="form-control form-control-sm @(editImgError != null ? "is-invalid" : "")"
                                                               id="authorImg_@author.AuthorId"
                                                               name="AuthorImgUrl"
                                                               value="@author.AuthorImgUrl"
                                                               placeholder="https://... veya /uploads/..." />
                                                        <div class="mt-2" data-image-upload data-target="authorImg_@author.AuthorId" data-folder="author"></div>
                                                        @if (editImgError != null)
                                                        {
                                                            <div class="invalid-feedback d-block small">@editImgError</div>
                                                        }
                                                    </div>
                                                    <div class="d-flex justify-content-end gap-2 mt-3">
                                                        <button type="submit" class="btn btn-primary btn-sm px-3">
                                                            <i class="bi bi-check-lg me-1"></i> Güncelle
                                                        </button>
                                                    </div>
                                                </form>
                                            </div>
                                        </details>

                                        <!-- Silme Onayı -->
                                        <details class="text-start position-relative">
                                            <summary class="btn btn-outline-danger btn-sm py-1 px-2" style="cursor: pointer; list-style: none;">
                                                <i class="bi bi-trash me-1"></i> Sil
                                            </summary>
                                            <div class="border rounded p-3 bg-light mt-2 shadow-sm position-absolute end-0" style="min-width: 260px; max-width: 300px; z-index: 1000;">
                                                @if (author.BlogCount > 0)
                                                {
                                                    <div class="small text-danger">
                                                        <i class="bi bi-exclamation-octagon me-1"></i>
                                                        Bu yazarın @author.BlogCount yazısı var, silinemez.
                                                    </div>
                                                }
                                                else
                                                {
                                                    <p class="small text-muted mb-2">
                                                        <strong>@author.AuthorName</strong> adlı yazarı silmek istediğinize emin misiniz?
                                                    </p>
                                                    <form method="post" action="/icerik/blog/yazarlar/@author.AuthorId/sil">
                                                        @Html.AntiForgeryToken()
                                                        <button type="submit" class="btn btn-danger btn-sm w-100">
                                                            <i class="bi bi-trash me-1"></i> Evet, Sil
                                                        </button>
                                                    </form>
                                                }
                                            </div>
                                        </details>
                                    </div>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }
    </div>
</div>

<!-- Yeni Yazar Kartı -->
<div class="card border-0 shadow-sm">
    <div class="card-body pt-3">
        <h5 class="card-title p-0 pb-2 border-bottom mb-3">
            <i class="bi bi-person-plus me-2 text-primary"></i>Yeni Yazar Ekle
        </h5>
        <form method="post" action="/icerik/blog/yazarlar">
            @Html.AntiForgeryToken()
            <div class="row g-3">
                <div class="col-md-6 col-12">
                    <label for="newAuthorName" class="form-label small fw-semibold">
                        Yazar Adı <span class="text-danger">*</span>
                    </label>
                    <input type="text"
                           class="form-control @(Model.GetFieldError("new", "AuthorName") != null ? "is-invalid" : "")"
                           id="newAuthorName"
                           name="AuthorName"
                           value="@Model.NewForm.AuthorName"
                           placeholder="Örn: Ahmet Yılmaz"
                           required />
                    @if (Model.GetFieldError("new", "AuthorName") != null)
                    {
                        <div class="invalid-feedback d-block">@Model.GetFieldError("new", "AuthorName")</div>
                    }
                </div>

                <div class="col-md-6 col-12">
                    <label for="newAuthorImg" class="form-label small fw-semibold">
                        Görsel URL
                    </label>
                    <input type="text"
                           class="form-control @(Model.GetFieldError("new", "AuthorImgUrl") != null ? "is-invalid" : "")"
                           id="newAuthorImg"
                           name="AuthorImgUrl"
                           value="@Model.NewForm.AuthorImgUrl"
                           placeholder="https://... veya /uploads/..." />
                    <div class="mt-2" data-image-upload data-target="newAuthorImg" data-folder="author"></div>
                    @if (Model.GetFieldError("new", "AuthorImgUrl") != null)
                    {
                        <div class="invalid-feedback d-block">@Model.GetFieldError("new", "AuthorImgUrl")</div>
                    }
                </div>

                <div class="col-12 text-end">
                    <button type="submit" class="btn btn-primary px-4">
                        <i class="bi bi-plus-lg me-1"></i> Yazar Ekle
                    </button>
                </div>
            </div>
        </form>
    </div>
</div>

@section Scripts {
    <script src="~/js/image-upload.js" asp-append-version="true"></script>
}
