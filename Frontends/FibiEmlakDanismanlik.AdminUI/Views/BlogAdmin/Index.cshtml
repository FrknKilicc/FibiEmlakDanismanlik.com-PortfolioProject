@model FibiEmlakDanismanlik.AdminUI.Models.Content.BlogIndexViewModel
@using FibiEmlakDanismanlik.AdminUI.Models.Content
@inject FibiEmlakDanismanlik.AdminUI.Infrastructure.SiteImageUrl SiteImageUrl

@{
    ViewData["Title"] = "Blog Yazıları";
}

<div class="pagetitle d-flex flex-wrap justify-content-between align-items-center gap-2 mb-3">
    <div>
        <h1>Blog Yazıları</h1>
        <nav>
            <ol class="breadcrumb mb-0">
                <li class="breadcrumb-item"><a href="/">Ana Sayfa</a></li>
                <li class="breadcrumb-item"><a href="/icerik">İçerik</a></li>
                <li class="breadcrumb-item active">Blog</li>
            </ol>
        </nav>
    </div>
    <div>
        <a href="/icerik/blog/yeni" class="btn btn-primary btn-sm">
            <i class="bi bi-plus-lg me-1"></i> Yeni Yazı
        </a>
    </div>
</div>

@if (TempData["Success"] != null)
{
    <div class="alert alert-success alert-dismissible fade show d-flex align-items-center mb-4" role="alert">
        <i class="bi bi-check-circle-fill flex-shrink-0 me-2 fs-5"></i>
        <div>@TempData["Success"]</div>
        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Kapat"></button>
    </div>
}

@if (TempData["Error"] != null)
{
    <div class="alert alert-danger alert-dismissible fade show d-flex align-items-center mb-4" role="alert">
        <i class="bi bi-exclamation-triangle-fill flex-shrink-0 me-2 fs-5"></i>
        <div>@TempData["Error"]</div>
        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Kapat"></button>
    </div>
}

@if (!string.IsNullOrWhiteSpace(Model.ErrorMessage))
{
    <div class="alert alert-danger alert-dismissible fade show d-flex align-items-center mb-4" role="alert">
        <i class="bi bi-exclamation-triangle-fill flex-shrink-0 me-2 fs-5"></i>
        <div>@Model.ErrorMessage</div>
        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Kapat"></button>
    </div>
}

<!-- Filtre Formu (GET) -->
<div class="card mb-4 shadow-sm border-0">
    <div class="card-body pt-3">
        <form method="get" action="/icerik/blog" class="row g-2 align-items-end">
            <div class="col-xl-5 col-md-6 col-12">
                <label for="filterAra" class="form-label small fw-semibold text-muted mb-1">Arama</label>
                <div class="input-group input-group-sm">
                    <span class="input-group-text"><i class="bi bi-search"></i></span>
                    <input type="text"
                           class="form-control form-control-sm"
                           id="filterAra"
                           name="ara"
                           value="@Model.Ara"
                           placeholder="Başlıkta ara..." />
                </div>
            </div>

            <div class="col-xl-4 col-md-4 col-sm-6 col-12">
                <label for="filterKategori" class="form-label small fw-semibold text-muted mb-1">Kategori</label>
                <select class="form-select form-select-sm" id="filterKategori" name="kategori">
                    <option value="" selected="@(!Model.Kategori.HasValue ? "selected" : null)">Tüm Kategoriler</option>
                    @foreach (var cat in Model.Categories)
                    {
                        <option value="@cat.BlogCategoryId" selected="@(Model.Kategori == cat.BlogCategoryId ? "selected" : null)">
                            @cat.CategoryName
                        </option>
                    }
                </select>
            </div>

            <div class="col-auto d-flex gap-2 ms-auto mt-2">
                <button type="submit" class="btn btn-sm btn-primary px-3">
                    <i class="bi bi-funnel me-1"></i> Filtrele
                </button>
                <a href="/icerik/blog" class="btn btn-sm btn-outline-secondary px-3">
                    <i class="bi bi-x-circle me-1"></i> Temizle
                </a>
            </div>
        </form>
    </div>
</div>

@if (Model.Blogs == null || !Model.Blogs.Any())
{
    <div class="card border-0 shadow-sm">
        <div class="card-body text-center py-5">
            <i class="bi bi-journal-x fs-1 text-muted d-block mb-3"></i>
            <h5 class="fw-semibold text-secondary">Kayıt bulunamadı.</h5>
            <p class="text-muted small mb-0">Arama kriterlerine uygun blog yazısı bulunamadı.</p>
        </div>
    </div>
}
else
{
    <!-- Masaüstü Tablo Görünümü -->
    <div class="card border-0 shadow-sm d-none d-md-block mb-4">
        <div class="card-body p-0">
            <div class="table-responsive">
                <table class="table table-hover align-middle mb-0">
                    <thead class="table-light text-muted small text-uppercase">
                        <tr>
                            <th scope="col" class="ps-3" style="width: 70px;">Görsel</th>
                            <th scope="col">Başlık ve Özet</th>
                            <th scope="col">Kategori</th>
                            <th scope="col">Yazar</th>
                            <th scope="col">Tarih</th>
                            <th scope="col" class="text-center">Durum</th>
                            <th scope="col" class="text-end pe-3">İşlem</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var blog in Model.Blogs)
                        {
                            var imgUrl = blog.BlogImgUrl?.Trim();
                            var previewUrl = SiteImageUrl.Preview(imgUrl);

                            var catName = Model.Categories.FirstOrDefault(c => c.BlogCategoryId == blog.BlogCategoryId)?.CategoryName ?? "Kategorisiz";
                            var authorName = Model.Authors.FirstOrDefault(a => a.AuthorId == blog.AuthorId)?.AuthorName ?? "—";
                            var excerpt = BlogText.Excerpt(blog.BlogDescription);

                            <tr>
                                <td class="ps-3">
                                    @if (!string.IsNullOrEmpty(previewUrl))
                                    {
                                        <img src="@previewUrl"
                                             alt="@blog.BlogTitle"
                                             class="rounded border"
                                             style="width: 54px; height: 54px; object-fit: cover;" />
                                    }
                                    else
                                    {
                                        <div class="rounded border bg-light d-flex align-items-center justify-content-center text-muted"
                                             style="width: 54px; height: 54px;">
                                            <i class="bi bi-image fs-5"></i>
                                        </div>
                                    }
                                </td>
                                <td>
                                    <div class="fw-semibold text-dark mb-1">
                                        @blog.BlogTitle
                                    </div>
                                    @if (!string.IsNullOrWhiteSpace(excerpt))
                                    {
                                        <div class="small text-muted text-break" style="max-width: 560px;">
                                            @excerpt
                                        </div>
                                    }
                                </td>
                                <td>
                                    <span class="badge bg-secondary-subtle text-secondary border">
                                        @catName
                                    </span>
                                </td>
                                <td>
                                    <span class="small text-dark fw-medium">@authorName</span>
                                </td>
                                <td class="text-nowrap small text-muted">
                                    @blog.CreatedDate.ToString("dd.MM.yyyy")
                                </td>
                                <td class="text-center text-nowrap">
                                    @if (blog.TopNews)
                                    {
                                        <span class="badge bg-warning text-dark border border-warning-subtle">
                                            <i class="bi bi-star-fill me-1"></i> Manşet
                                        </span>
                                    }
                                    else
                                    {
                                        <span class="text-muted small">—</span>
                                    }
                                </td>
                                <td class="text-end pe-3">
                                    <a href="/icerik/blog/@blog.BlogId" class="btn btn-outline-primary btn-sm text-nowrap">
                                        <i class="bi bi-pencil me-1"></i> Düzenle
                                    </a>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>

    <!-- Mobil Kart Görünümü (d-md-none) -->
    <div class="d-md-none mb-4">
        @foreach (var blog in Model.Blogs)
        {
            var imgUrl = blog.BlogImgUrl?.Trim();
            var previewUrl = SiteImageUrl.Preview(imgUrl);

            var catName = Model.Categories.FirstOrDefault(c => c.BlogCategoryId == blog.BlogCategoryId)?.CategoryName ?? "Kategorisiz";
            var authorName = Model.Authors.FirstOrDefault(a => a.AuthorId == blog.AuthorId)?.AuthorName ?? "—";
            var excerpt = BlogText.Excerpt(blog.BlogDescription);

            <div class="card mb-3 shadow-sm border-0">
                <div class="card-body p-3">
                    <div class="d-flex justify-content-between align-items-start mb-2">
                        <span class="badge bg-secondary-subtle text-secondary border">@catName</span>
                        @if (blog.TopNews)
                        {
                            <span class="badge bg-warning text-dark border border-warning-subtle">
                                <i class="bi bi-star-fill me-1"></i> Manşet
                            </span>
                        }
                    </div>

                    <div class="d-flex gap-3 mb-2">
                        @if (!string.IsNullOrEmpty(previewUrl))
                        {
                            <img src="@previewUrl"
                                 alt="@blog.BlogTitle"
                                 class="rounded border flex-shrink-0"
                                 style="width: 64px; height: 64px; object-fit: cover;" />
                        }
                        <div class="flex-grow-1 min-w-0">
                            <h6 class="fw-bold text-dark mb-1 text-break">
                                @blog.BlogTitle
                            </h6>
                            <div class="small text-muted">
                                <i class="bi bi-calendar3 me-1"></i>@blog.CreatedDate.ToString("dd.MM.yyyy")
                            </div>
                        </div>
                    </div>

                    @if (!string.IsNullOrWhiteSpace(excerpt))
                    {
                        <p class="small text-secondary mb-3 text-break">
                            @excerpt
                        </p>
                    }

                    <div class="d-flex justify-content-between align-items-center small text-muted p-2 bg-light rounded mb-3">
                        <span>Yazar:</span>
                        <span class="text-dark fw-medium text-truncate ms-2">@authorName</span>
                    </div>

                    <a href="/icerik/blog/@blog.BlogId" class="btn btn-outline-primary btn-sm w-100 text-center">
                        <i class="bi bi-pencil me-1"></i> Düzenle
                    </a>
                </div>
            </div>
        }
    </div>

    <!-- Sayfalama (Pagination) -->
    @if (Model.TotalPages > 1)
    {
        <nav aria-label="Blog sayfaları" class="mt-4">
            <ul class="pagination pagination-sm justify-content-center flex-wrap gap-1">
                <li class="page-item @(Model.Sayfa <= 1 ? "disabled" : "")">
                    <a class="page-link"
                       href="/icerik/blog?sayfa=@(Model.Sayfa - 1)&ara=@Model.Ara&kategori=@Model.Kategori"
                       aria-label="Önceki">
                        &laquo; Önceki
                    </a>
                </li>

                @for (int p = 1; p <= Model.TotalPages; p++)
                {
                    <li class="page-item @(p == Model.Sayfa ? "active" : "")">
                        <a class="page-link"
                           href="/icerik/blog?sayfa=@p&ara=@Model.Ara&kategori=@Model.Kategori">
                            @p
                        </a>
                    </li>
                }

                <li class="page-item @(Model.Sayfa >= Model.TotalPages ? "disabled" : "")">
                    <a class="page-link"
                       href="/icerik/blog?sayfa=@(Model.Sayfa + 1)&ara=@Model.Ara&kategori=@Model.Kategori"
                       aria-label="Sonraki">
                        Sonraki &raquo;
                    </a>
                </li>
            </ul>
        </nav>
    }
}
