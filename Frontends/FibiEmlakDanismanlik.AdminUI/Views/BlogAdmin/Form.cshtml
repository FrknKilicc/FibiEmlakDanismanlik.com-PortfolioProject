@model FibiEmlakDanismanlik.AdminUI.Models.Content.BlogFormViewModel
@using FibiEmlakDanismanlik.AdminUI.Models.Content
@inject FibiEmlakDanismanlik.AdminUI.Infrastructure.SiteImageUrl SiteImageUrl

@{
    var title = Model.IsNew ? "Yeni Blog Yazısı" : "Blog Yazısını Düzenle";
    ViewData["Title"] = title;

    var errTitle = Model.GetFieldError("BlogTitle");
    var errDesc = Model.GetFieldError("BlogDescription");
    var errImg = Model.GetFieldError("BlogImgUrl");
    var errDate = Model.GetFieldError("CreatedDate");
    var errAuthor = Model.GetFieldError("AuthorId");
    var errCategory = Model.GetFieldError("BlogCategoryId");
    var errTags = Model.GetFieldError("Tags") ?? Model.GetFieldError("TagsText");

    var imgUrl = Model.Form.BlogImgUrl?.Trim();
}

<div class="pagetitle d-flex flex-wrap justify-content-between align-items-center gap-2 mb-3">
    <div>
        <div class="d-flex align-items-center gap-2">
            <h1 class="mb-0">@title</h1>
            @if (!Model.IsNew && Model.Form.BlogId.HasValue)
            {
                <span class="badge bg-secondary-subtle text-secondary border">Blog #@Model.Form.BlogId.Value</span>
            }
        </div>
        <nav class="mt-1">
            <ol class="breadcrumb mb-0">
                <li class="breadcrumb-item"><a href="/">Ana Sayfa</a></li>
                <li class="breadcrumb-item"><a href="/icerik">İçerik</a></li>
                <li class="breadcrumb-item"><a href="/icerik/blog">Blog</a></li>
                <li class="breadcrumb-item active">@title</li>
            </ol>
        </nav>
    </div>
    <div>
        <a href="/icerik/blog" class="btn btn-outline-secondary btn-sm">
            <i class="bi bi-arrow-left me-1"></i> Blog Yazılarına Dön
        </a>
    </div>
</div>

@if (TempData["Success"] != null)
{
    <div class="alert alert-success alert-dismissible fade show d-flex align-items-center mb-4" role="alert">
        <i class="bi bi-check-circle-fill flex-shrink-0 me-2 fs-5"></i>
        <div>@TempData["Success"]</div>
        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Kapat"></button>
    </div>
}

@if (TempData["Error"] != null)
{
    <div class="alert alert-danger alert-dismissible fade show d-flex align-items-center mb-4" role="alert">
        <i class="bi bi-exclamation-triangle-fill flex-shrink-0 me-2 fs-5"></i>
        <div>@TempData["Error"]</div>
        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Kapat"></button>
    </div>
}

@if (!string.IsNullOrWhiteSpace(Model.ErrorMessage))
{
    <div class="alert alert-danger alert-dismissible fade show d-flex align-items-center mb-4" role="alert">
        <i class="bi bi-exclamation-triangle-fill flex-shrink-0 me-2 fs-5"></i>
        <div>@Model.ErrorMessage</div>
        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Kapat"></button>
    </div>
}

<form method="post" action="@(Model.IsNew ? "/icerik/blog/yeni" : $"/icerik/blog/{Model.Form.BlogId}")">
    @Html.AntiForgeryToken()
    @if (!Model.IsNew)
    {
        <input type="hidden" name="BlogId" value="@Model.Form.BlogId" />
    }

    <div class="row g-4">
        <!-- Sol Kolon: Başlık ve İçerik Metni -->
        <div class="col-lg-8 col-12">
            <div class="card shadow-sm border-0 mb-4">
                <div class="card-body pt-3">
                    <h5 class="card-title p-0 pb-2 border-bottom mb-3">
                        <i class="bi bi-journal-text me-2 text-primary"></i>Yazı İçeriği
                    </h5>

                    <div class="mb-3">
                        <label for="BlogTitle" class="form-label small fw-semibold">
                            Başlık <span class="text-danger">*</span>
                        </label>
                        <input type="text"
                               class="form-control @(errTitle != null ? "is-invalid" : "")"
                               id="BlogTitle"
                               name="BlogTitle"
                               value="@Model.Form.BlogTitle"
                               placeholder="Örn: Konut Alırken Dikkat Edilmesi Gereken Hukuki Noktalar"
                               required />
                        @if (errTitle != null)
                        {
                            <div class="invalid-feedback d-block">@errTitle</div>
                        }
                    </div>

                    <div class="mb-2">
                        <label for="BlogDescription" class="form-label small fw-semibold">
                            İçerik (HTML)
                        </label>
                        <textarea class="form-control font-monospace @(errDesc != null ? "is-invalid" : "")"
                                  id="BlogDescription" data-help="Blog yazısının detay metnidir; HTML etiketleri desteklenir ve sitede güvenli biçimde render edilir."
                                  name="BlogDescription"
                                  rows="18"
                                  placeholder="<p>Blog içeriğini buraya yazınız...</p>">@Model.Form.BlogDescription</textarea>
                        <div class="form-text text-muted">
                            <i class="bi bi-info-circle me-1"></i>HTML kullanılabilir (p, h2, h3, ul, li, strong, a, img). Sitede güvenli hale getirilerek gösterilir.
                        </div>
                        @if (errDesc != null)
                        {
                            <div class="invalid-feedback d-block">@errDesc</div>
                        }
                    </div>
                </div>
            </div>
        </div>

        <!-- Sağ Kolon: Meta Bilgiler, Görsel ve Yayın Durumu -->
        <div class="col-lg-4 col-12">
            <!-- Yayın Ayarları Kartı -->
            <div class="card shadow-sm border-0 mb-4">
                <div class="card-body pt-3">
                    <h5 class="card-title p-0 pb-2 border-bottom mb-3">
                        <i class="bi bi-sliders me-2 text-primary"></i>Yayın Ayarları
                    </h5>

                    <div class="mb-3">
                        <label for="CreatedDate" class="form-label small fw-semibold">
                            Yayın Tarihi <span class="text-danger">*</span>
                        </label>
                        <input type="date"
                               class="form-control @(errDate != null ? "is-invalid" : "")"
                               id="CreatedDate" data-help="Yazının sitede gösterilecek yayınlanma tarihidir; blog listesinde sıralamayı etkiler."
                               name="CreatedDate"
                               value="@Model.Form.CreatedDate"
                               required />
                        @if (errDate != null)
                        {
                            <div class="invalid-feedback d-block">@errDate</div>
                        }
                    </div>

                    <div class="mb-3">
                        <label for="AuthorId" class="form-label small fw-semibold">
                            Yazar <span class="text-danger">*</span>
                        </label>
                        <select class="form-select @(errAuthor != null ? "is-invalid" : "")"
                                id="AuthorId" data-help="Blog yazısının altında ve yazar detayında görünecek içerik üreticisi danışman."
                                name="AuthorId"
                                required>
                            @if (!Model.Authors.Any())
                            {
                                <option value="0">Yazar bulunamadı</option>
                            }
                            @foreach (var author in Model.Authors)
                            {
                                <option value="@author.AuthorId" selected="@(Model.Form.AuthorId == author.AuthorId ? "selected" : null)">
                                    @author.AuthorName
                                </option>
                            }
                        </select>
                        @if (errAuthor != null)
                        {
                            <div class="invalid-feedback d-block">@errAuthor</div>
                        }
                    </div>

                    <div class="mb-3">
                        <label for="BlogCategoryId" class="form-label small fw-semibold">
                            Kategori
                        </label>
                        <select class="form-select @(errCategory != null ? "is-invalid" : "")"
                                id="BlogCategoryId" data-help="Yazının sitede listeleneceği konu kategorisi; ziyaretçilerin filtrelemesini kolaylaştırır."
                                name="BlogCategoryId">
                            <option value="" selected="@(!Model.Form.BlogCategoryId.HasValue ? "selected" : null)">
                                Kategorisiz
                            </option>
                            @foreach (var cat in Model.Categories)
                            {
                                <option value="@cat.BlogCategoryId" selected="@(Model.Form.BlogCategoryId == cat.BlogCategoryId ? "selected" : null)">
                                    @cat.CategoryName
                                </option>
                            }
                        </select>
                        @if (errCategory != null)
                        {
                            <div class="invalid-feedback d-block">@errCategory</div>
                        }
                    </div>

                    <div class="mb-3">
                        <label for="TagsText" class="form-label small fw-semibold">
                            Etiketler
                        </label>
                        <input type="text"
                               class="form-control @(errTags != null ? "is-invalid" : "")"
                               id="TagsText" data-help="Yazıyla ilgili anahtar kelimeler; virgülle ayırarak en fazla 10 adet girebilirsiniz."
                               name="TagsText"
                               value="@Model.Form.TagsText"
                               placeholder="Örn: Emlak, Yatırım, Konut" />
                        <div class="form-text">
                            Virgülle ayırın, en fazla 10 etiket.
                        </div>
                        @if (errTags != null)
                        {
                            <div class="invalid-feedback d-block">@errTags</div>
                        }
                        @if (Model.AllTags != null && Model.AllTags.Any())
                        {
                            <div class="d-flex flex-wrap gap-1 mt-2 align-items-center">
                                <span class="small text-muted me-1">Mevcut etiketler:</span>
                                @foreach (var tag in Model.AllTags)
                                {
                                    <button type="button" class="btn btn-light btn-sm border py-0 px-2 small text-secondary" data-tag="@tag">
                                        + @tag
                                    </button>
                                }
                            </div>
                        }
                    </div>

                    <div class="form-check form-switch pt-2 border-top mb-1">
                        <input type="checkbox"
                               class="form-check-input"
                               id="TopNews" data-help="İşaretlendiğinde blog yazısı ana sayfada ve blog vitrininde öne çıkarılan manşet alanında gösterilir."
                               name="TopNews"
                               value="true"
                               @(Model.Form.TopNews ? "checked" : "") />
                        <input type="hidden" name="TopNews" value="false" />
                        <label class="form-check-label small fw-semibold" for="TopNews">
                            Manşette göster
                        </label>
                        <div class="form-text">
                            İşaretlendiğinde yazıyı ana sayfada veya manşet alanında öne çıkarır.
                        </div>
                    </div>
                </div>
            </div>

            <!-- Görsel Kartı -->
            <div class="card shadow-sm border-0 mb-4">
                <div class="card-body pt-3">
                    <h5 class="card-title p-0 pb-2 border-bottom mb-3">
                        <i class="bi bi-image me-2 text-primary"></i>Kapak Görseli
                    </h5>

                    <div class="mb-2">
                        <label for="BlogImgUrl" class="form-label small fw-semibold">
                            Görsel URL <span class="text-danger">*</span>
                        </label>
                        <input type="text"
                               class="form-control @(errImg != null ? "is-invalid" : "")"
                               id="BlogImgUrl" data-help="Site içi yol (/...) veya https adresi girilebilir ya da Bilgisayardan yükle ile eklenebilir."
                               name="BlogImgUrl"
                               value="@Model.Form.BlogImgUrl"
                               placeholder="https://... veya /uploads/..."
                               required />
                        @if (errImg != null)
                        {
                            <div class="invalid-feedback d-block">@errImg</div>
                        }
                        <div class="mt-2" data-image-upload data-target="BlogImgUrl" data-folder="blog" data-preview="blogImgPreview"></div>
                    </div>

                    @{
                        var blogPreview = SiteImageUrl.Preview(imgUrl);
                    }
                    <div class="mt-3 p-2 border rounded bg-light">
                        <div class="small text-muted mb-1 fw-semibold">Görsel Önizleme:</div>
                        <img id="blogImgPreview"
                             src="@(blogPreview ?? "")"
                             alt="@(Model.Form.BlogTitle ?? "Önizleme")"
                             class="img-fluid rounded border @(string.IsNullOrEmpty(blogPreview) ? "d-none" : "")"
                             style="max-height: 160px; width: 100%; object-fit: cover;" />
                    </div>
                </div>
            </div>
        </div>

        <!-- İşlem Butonları -->
        <div class="col-12">
            <div class="card shadow-sm border-0">
                <div class="card-body p-3">
                    <div class="d-flex flex-wrap align-items-center gap-2">
                        <button type="submit" class="btn btn-primary px-4">
                            <i class="bi bi-check-lg me-1"></i> Kaydet
                        </button>
                        <a href="/icerik/blog" class="btn btn-outline-secondary px-3">
                            Vazgeç
                        </a>
                    </div>
                </div>
            </div>
        </div>
    </div>
</form>

@if (!Model.IsNew && Model.Form.BlogId.HasValue)
{
    <div class="card shadow-sm border-0 mt-4 border-danger-subtle">
        <div class="card-body p-3">
            <details class="text-start">
                <summary class="text-danger fw-semibold" style="cursor: pointer;">
                    <i class="bi bi-trash me-1"></i> Yazıyı sil
                </summary>
                <div class="pt-3" style="max-width: 480px;">
                    <p class="text-muted small mb-3">
                        Bu blog yazısını sildiğinizde işlem geri alınamaz. Devam etmek istediğinize emin misiniz?
                    </p>
                    <form method="post" action="/icerik/blog/@Model.Form.BlogId.Value/sil">
                        @Html.AntiForgeryToken()
                        <button type="submit" class="btn btn-danger btn-sm px-3">
                            Evet, kalıcı olarak sil
                        </button>
                    </form>
                </div>
            </details>
        </div>
    </div>
}

@section Scripts {
    <script src="~/js/image-upload.js" asp-append-version="true"></script>
    <script src="~/js/blog-tags.js" asp-append-version="true"></script>
}
